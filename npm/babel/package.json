{
  "name": "@vizejs/babel-plugin",
  "version": "0.639.0",
  "description": "Vue JSX and TSX compilation through the shared Vize compiler",
  "homepage": "https://github.com/ubugeeei-prod/vize",
  "bugs": {
    "url": "https://github.com/ubugeeei-prod/vize/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei-prod/vize",
    "directory": "npm/babel"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check src vite.config.ts && tsc -p test/tsconfig.json",
    "test": "node --test test/packed-hosts.test.ts test/runtime-renderers.test.ts test/style-guards.test.ts"
  },
  "dependencies": {
    "@jridgewell/remapping": "2.3.5",
    "@vizejs/native": "workspace:*",
    "convert-source-map": "2.0.0"
  },
  "devDependencies": {
    "@babel/core": "catalog:babel-plugin-host",
    "@types/convert-source-map": "catalog:babel-plugin-host",
    "@types/node": "catalog:typescript",
    "playwright": "catalog:testing",
    "typescript": "catalog:typescript",
    "vite-plus": "catalog:vite-stack",
    "vue": "3.6.0-rc.11"
  },
  "peerDependencies": {
    "@babel/core": "^7.29.7 || ^8.0.9"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "metadata": {
    "vize": {
      "stability": "compatibility-preview",
      "stabilityDocs": "https://github.com/ubugeeei-prod/vize/blob/main/docs/content/stability.md#package-support-tiers"
    }
  }
}
