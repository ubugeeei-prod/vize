{
  "name": "@vizejs/content-mapper",
  "version": "0.796.0",
  "description": "Vize content mapper: type-check .vue files with tsc, tsgo and tsrs",
  "keywords": [
    "content-mapper",
    "tsgo",
    "typescript",
    "vize",
    "vue"
  ],
  "homepage": "https://github.com/ubugeeei-prod/vize",
  "bugs": {
    "url": "https://github.com/ubugeeei-prod/vize/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei-prod/vize",
    "directory": "npm/entry/content-mapper"
  },
  "bin": {
    "vize-content-mapper": "bin/vize-content-mapper"
  },
  "files": [
    "README.md",
    "bin"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "vize": "workspace:*"
  },
  "typescript": {
    "contentMapper": {
      "compilerOptions": [
        "checkJs",
        "noUnusedLocals",
        "rootDir",
        "module",
        "moduleResolution",
        "resolvePackageJsonExports",
        "customConditions",
        "baseUrl",
        "paths",
        "moduleSuffixes",
        "noDtsResolution",
        "preserveSymlinks"
      ],
      "dynamicConfig": true,
      "exec": [
        "node",
        "./bin/vize-content-mapper"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "metadata": {
    "vize": {
      "stability": "experimental",
      "stabilityDocs": "https://github.com/ubugeeei-prod/vize/blob/main/docs/content/stability.md#package-support-tiers"
    }
  }
}
