{
  "name": "@vizejs/parcel-resolver",
  "version": "0.474.0",
  "description": "Immutable native Vue component modules for Parcel",
  "keywords": [
    "parcel",
    "resolver",
    "sfc",
    "vize",
    "vue"
  ],
  "homepage": "https://github.com/ubugeeei-prod/vize",
  "bugs": {
    "url": "https://github.com/ubugeeei-prod/vize/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei-prod/vize",
    "directory": "npm/builder/parcel-resolver"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/resolver.cjs",
  "types": "./dist/resolver.d.cts",
  "exports": {
    ".": {
      "types": "./dist/resolver.d.cts",
      "default": "./dist/resolver.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check src vite.config.ts",
    "fmt": "vp fmt --write src vite.config.ts",
    "test": "pnpm build && node --test src/*.test.ts"
  },
  "dependencies": {
    "@parcel/plugin": "2.16.4"
  },
  "devDependencies": {
    "@parcel/types": "2.16.4",
    "@types/node": "catalog:typescript",
    "vite-plus": "catalog:vite-stack"
  },
  "engines": {
    "node": ">=22.18",
    "parcel": "^2.16.4"
  },
  "metadata": {
    "vize": {
      "stability": "compatibility-preview",
      "stabilityDocs": "https://github.com/ubugeeei-prod/vize/blob/main/docs/content/stability.md#package-support-tiers"
    }
  }
}
