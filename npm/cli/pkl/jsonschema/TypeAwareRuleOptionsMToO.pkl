/// JSON Schema for the typescript-eslint type-aware rule options (no-meaningless-void-operator through only-throw-error).
///
/// Generated from the rule schemas and defaults of @typescript-eslint/eslint-plugin
/// 8.72.1; keep it in step with
/// davinci/vize_l0/src/config/model/linter_rule_options/type_aware.rs.
module vize.jsonschema.TypeAwareRuleOptionsMToO

import "@json_schema/JsonSchema.pkl"

noMeaninglessVoidOperatorDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["checkNever"] = new JsonSchema {
      description = "Whether to suggest removing `void` when a call's return type is `never`."
      type = "boolean"
      default = false
    }
  }
  additionalProperties = false
}

noMisusedPromisesDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["checksConditionals"] = new JsonSchema {
      description = "Whether to warn when a Promise is provided to conditional statements."
      oneOf = new Listing {
        new JsonSchema {
          description = "Whether to check conditionals."
          type = "boolean"
        }
        new JsonSchema {
          description = "Detailed settings for conditional inspection."
          type = "object"
          properties {
            ["flagUnions"] = new JsonSchema {
              description = "Configures how union types containing Promise-like types are checked."
              type = "string"
              enum = new Listing { "all"; "strict"; "none" }
            }
          }
          additionalProperties = false
        }
      }
      default = true
    }
    ["checksSpreads"] = new JsonSchema {
      description = "Whether to warn when `...` spreading a `Promise`."
      type = "boolean"
      default = true
    }
    ["checksVoidReturn"] = new JsonSchema {
      description = "Whether to warn when a Promise is returned from a function typed as returning `void`."
      oneOf = new Listing {
        new JsonSchema {
          description = "Whether to disable checking all asynchronous functions."
          type = "boolean"
        }
        new JsonSchema {
          description = "Which forms of functions may have checking disabled."
          type = "object"
          properties {
            ["arguments"] = new JsonSchema {
              description = "Disables checking an asynchronous function passed as argument where the parameter type expects a function that returns `void`."
              type = "boolean"
            }
            ["attributes"] = new JsonSchema {
              description = "Disables checking an asynchronous function passed as a JSX attribute expected to be a function that returns `void`."
              type = "boolean"
            }
            ["inheritedMethods"] = new JsonSchema {
              description = "Disables checking an asynchronous method in a type that extends or implements another type expecting that method to return `void`."
              type = "boolean"
            }
            ["properties"] = new JsonSchema {
              description = "Disables checking an asynchronous function passed as an object property expected to be a function that returns `void`."
              type = "boolean"
            }
            ["returns"] = new JsonSchema {
              description = "Disables checking an asynchronous function returned in a function whose return type is a function that returns `void`."
              type = "boolean"
            }
            ["variables"] = new JsonSchema {
              description = "Disables checking an asynchronous function used as a variable whose return type is a function that returns `void`."
              type = "boolean"
            }
          }
          additionalProperties = false
        }
      }
      default = true
    }
  }
  additionalProperties = false
}

noMisusedSpreadDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["allow"] = new JsonSchema {
      description = "An array of type specifiers that are known to be safe to spread."
      type = "array"
      items = new JsonSchema {
        oneOf = new Listing {
          new JsonSchema {
            type = "string"
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "file" }
              }
              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
              ["path"] = new JsonSchema {
                type = "string"
              }
            }
            required = new Listing { "from"; "name" }
            additionalProperties = false
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "lib" }
              }
              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
            }
            required = new Listing { "from"; "name" }
            additionalProperties = false
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "package" }
              }
              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
              ["package"] = new JsonSchema {
                type = "string"
              }
            }
            required = new Listing { "from"; "name"; "package" }
            additionalProperties = false
          }
        }
      }
      default = new Listing {  }
    }
  }
  additionalProperties = false
}

noUnnecessaryBooleanLiteralCompareDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["allowComparingNullableBooleansToFalse"] = new JsonSchema {
      description = "Whether to allow comparisons between nullable boolean variables and `false`."
      type = "boolean"
      default = true
    }
    ["allowComparingNullableBooleansToTrue"] = new JsonSchema {
      description = "Whether to allow comparisons between nullable boolean variables and `true`."
      type = "boolean"
      default = true
    }
    ["allowRuleToRunWithoutStrictNullChecksIKnowWhatIAmDoing"] = new JsonSchema {
      description = "Unless this is set to `true`, the rule will error on every file whose `tsconfig.json` does _not_ have the `strictNullChecks` compiler option (or `strict`) set to `true`."
      type = "boolean"
      default = false
    }
  }
  additionalProperties = false
}

noUnnecessaryConditionDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["allowConstantLoopConditions"] = new JsonSchema {
      description = "Whether to ignore constant loop conditions, such as `while (true)`."
      oneOf = new Listing {
        new JsonSchema {
          description = "Always ignore or not ignore the loop conditions"
          type = "boolean"
        }
        new JsonSchema {
          description = "Which situations to ignore constant conditions in."
          type = "string"
          enum = new Listing { "always"; "never"; "only-allowed-literals" }
        }
      }
      default = "never"
    }
    ["allowRuleToRunWithoutStrictNullChecksIKnowWhatIAmDoing"] = new JsonSchema {
      description = "Whether to not error when running with a tsconfig that has strictNullChecks turned."
      type = "boolean"
      default = false
    }
    ["checkTypePredicates"] = new JsonSchema {
      description = "Whether to check the asserted argument of a type predicate function for unnecessary conditions"
      type = "boolean"
      default = false
    }
  }
  additionalProperties = false
}

noUnnecessaryTypeAssertionDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["checkLiteralConstAssertions"] = new JsonSchema {
      description = "Whether to check literal const assertions."
      type = "boolean"
    }
    ["typesToIgnore"] = new JsonSchema {
      description = "A list of type names to ignore."
      type = "array"
      items = new JsonSchema {
        type = "string"
      }
    }
  }
  additionalProperties = false
}

noUnsafeMemberAccessDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["allowOptionalChaining"] = new JsonSchema {
      description = "Whether to allow `?.` optional chains on `any` values."
      type = "boolean"
      default = false
    }
  }
  additionalProperties = false
}

onlyThrowErrorDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["allow"] = new JsonSchema {
      description = "Type specifiers that can be thrown."
      type = "array"
      items = new JsonSchema {
        oneOf = new Listing {
          new JsonSchema {
            type = "string"
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "file" }
              }
              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
              ["path"] = new JsonSchema {
                type = "string"
              }
            }
            required = new Listing { "from"; "name" }
            additionalProperties = false
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "lib" }
              }
              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
            }
            required = new Listing { "from"; "name" }
            additionalProperties = false
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "package" }
              }
              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
              ["package"] = new JsonSchema {
                type = "string"
              }
            }
            required = new Listing { "from"; "name"; "package" }
            additionalProperties = false
          }
        }
      }
      default = new Listing {  }
    }
    ["allowRethrowing"] = new JsonSchema {
      description = "Whether to allow rethrowing caught values that are not `Error` objects."
      type = "boolean"
      default = true
    }
    ["allowThrowingAny"] = new JsonSchema {
      description = "Whether to always allow throwing values typed as `any`."
      type = "boolean"
      default = true
    }
    ["allowThrowingUnknown"] = new JsonSchema {
      description = "Whether to always allow throwing values typed as `unknown`."
      type = "boolean"
      default = true
    }
  }
  additionalProperties = false
}
