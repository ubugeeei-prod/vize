            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "file" }
              }
              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
              ["path"] = new JsonSchema {
                type = "string"
              }
            }
            required = new Listing { "from"; "name" }
            additionalProperties = false
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "lib" }
              }
              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
            }
            required = new Listing { "from"; "name" }
            additionalProperties = false
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "package" }
              }
              ["name"] = new JsonSchema {
