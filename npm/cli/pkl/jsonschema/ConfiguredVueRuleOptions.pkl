/// JSON Schema for configurable eslint-plugin-vue rule options.
module vize.jsonschema.ConfiguredVueRuleOptions

import "@json_schema/JsonSchema.pkl"

restrictedNamesDef: JsonSchema = new JsonSchema {
  oneOf = new Listing {
    new JsonSchema { type = "string" }
    new JsonSchema {
      type = "array"
      items = new JsonSchema { type = "string" }
    }
  }
}

maxPropsDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["maxProps"] = new JsonSchema { type = "integer" }
  }
  additionalProperties = false
}

maxTemplateDepthDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["maxDepth"] = new JsonSchema { type = "integer" }
  }
  additionalProperties = false
}

callAfterAwaitSpecDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["module"] = new JsonSchema { type = "string" }
    ["path"] = restrictedNamesDef
    ["message"] = new JsonSchema { type = "string" }
  }
  required = new Listing { "module" }
  additionalProperties = false
}

callAfterAwaitDef: JsonSchema = new JsonSchema {
  oneOf = new Listing {
    callAfterAwaitSpecDef
    new JsonSchema {
      type = "array"
      items = callAfterAwaitSpecDef
    }
  }
}

unsupportedFeaturesDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["version"] = new JsonSchema { type = "string" }
    ["ignores"] = new JsonSchema {
      type = "array"
      items = new JsonSchema { type = "string" }
    }
  }
  additionalProperties = false
}

noUnusedScriptVarsDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["vars"] = new JsonSchema { type = "string"; enum = new Listing { "all"; "local" } }
    ["varsIgnorePattern"] = new JsonSchema { type = "string" }
    ["args"] = new JsonSchema { type = "string"; enum = new Listing { "all"; "after-used"; "none" } }
    ["argsIgnorePattern"] = new JsonSchema { type = "string" }
    ["caughtErrors"] = new JsonSchema { type = "string"; enum = new Listing { "all"; "none" } }
    ["caughtErrorsIgnorePattern"] = new JsonSchema { type = "string" }
    ["destructuredArrayIgnorePattern"] = new JsonSchema { type = "string" }
    ["ignoreRestSiblings"] = new JsonSchema { type = "boolean" }
    ["ignoreClassWithStaticInitBlock"] = new JsonSchema { type = "boolean" }
    ["reportUsedIgnorePattern"] = new JsonSchema { type = "boolean" }
  }
  additionalProperties = false
}

preferConstDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["destructuring"] = new JsonSchema { type = "string"; enum = new Listing { "any"; "all" } }
    ["ignoreReadBeforeAssign"] = new JsonSchema { type = "boolean" }
  }
  additionalProperties = false
}

local namesDef: JsonSchema = new JsonSchema {
  type = "array"
  items = new JsonSchema { type = "string" }
  default = new Listing {}
}

/// `a11y/anchor-has-content` and `a11y/heading-has-content`.
hasContentDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["components"] = namesDef
    ["accessibleChildren"] = namesDef
    ["accessibleDirectives"] = namesDef
  }
  additionalProperties = false
}

local vOnHandlerKindDef: JsonSchema = new JsonSchema {
  type = "string"
  enum = new Listing { "method"; "inline"; "inline-function" }
}

/// `"method"`, `"inline"`, `"inline-function"`, or `["method", "inline" | "inline-function"]`.
local vOnHandlerAllowedDefs: Listing<JsonSchema> = new Listing {
  vOnHandlerKindDef
  new JsonSchema {
    type = "array"
    items = vOnHandlerKindDef
    uniqueItems = true
  }
}

vOnHandlerStyleDef: JsonSchema = new JsonSchema {
  oneOf = new Listing {
    ...vOnHandlerAllowedDefs
    new JsonSchema {
      type = "object"
      properties {
        ["style"] = new JsonSchema { oneOf = vOnHandlerAllowedDefs }
        ["ignoreIncludesComment"] = new JsonSchema { type = "boolean"; default = false }
      }
      additionalProperties = false
    }
  }
}
