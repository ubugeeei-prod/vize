/// Import sorting schemas shared by the generated config artifact.
module vize.jsonschema.ImportSortSchemaDefinitions
import "@json_schema/JsonSchema.pkl"

local booleanDef: JsonSchema = new JsonSchema { type = "boolean" }
local stringList: JsonSchema = new JsonSchema { type = "array"; items = new JsonSchema { type = "string" } }

customGroupDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["groupName"] = new JsonSchema { type = "string" }
    ["elementNamePattern"] = stringList
    ["selector"] = new JsonSchema { type = "string" }
    ["modifiers"] = stringList
  }
  required = new Listing { "groupName" }
  additionalProperties = false
}

sortImportsConfigDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["partitionByNewline"] = booleanDef
    ["partitionByComment"] = booleanDef
    ["sortSideEffects"] = booleanDef
    ["order"] = new JsonSchema { type = "string"; enum = new Listing { "asc"; "desc" } }
    ["ignoreCase"] = booleanDef
    ["newlinesBetween"] = booleanDef
    ["internalPattern"] = stringList
    ["groups"] = new JsonSchema {
      type = "array"
      items = new JsonSchema {
        oneOf = new Listing {
          new JsonSchema { type = "string" }
          stringList
          new JsonSchema {
            type = "object"
            properties { ["newlinesBetween"] = booleanDef }
            required = new Listing { "newlinesBetween" }
            additionalProperties = false
          }
        }
      }
    }
    ["customGroups"] = new JsonSchema { type = "array"; items = new JsonSchema { `$ref` = "#/definitions/ImportSortCustomGroup" } }
  }
  additionalProperties = false
}

sortImportsSettingDef: JsonSchema = new JsonSchema {
  description = "Oxfmt-compatible import sorting; false disables it"
  oneOf = new Listing {
    new JsonSchema { type = "boolean"; enum = new Listing { false } }
    new JsonSchema { `$ref` = "#/definitions/SortImportsConfig" }
  }
}
