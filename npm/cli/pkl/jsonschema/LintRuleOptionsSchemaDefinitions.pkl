/// Typed lint rule options schema.
module vize.jsonschema.LintRuleOptionsSchemaDefinitions

import "@json_schema/JsonSchema.pkl"
import "ConfigArtifactDefinitions.pkl"

definePropsDestructuringOptionsDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["destructure"] = new JsonSchema {
      type = "string"
      enum = new Listing { "only-when-assigned"; "always"; "never" }
      default = "always"
    }
  }
  additionalProperties = false
}

defineMacrosOrderOptionsDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["order"] = new JsonSchema {
      type = "array"
      items = new JsonSchema { type = "string"; minLength = 1 }
      uniqueItems = true
      default = new Listing { "defineProps"; "defineEmits" }
    }
    ["defineExposeLast"] = new JsonSchema { type = "boolean"; default = false }
  }
  additionalProperties = false
}

blockLangNamesDef: JsonSchema = new JsonSchema {
  oneOf = new Listing {
    new JsonSchema { type = "string" }
    new JsonSchema {
      type = "array"
      items = new JsonSchema { type = "string" }
      uniqueItems = true
    }
  }
}

blockLangBlockDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["lang"] = blockLangNamesDef
    ["allowNoLang"] = new JsonSchema { type = "boolean" }
    ["required"] = new JsonSchema { type = "boolean" }
  }
  additionalProperties = false
}

lintRuleOptionsDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["script/define-macros-order"] = defineMacrosOrderOptionsDef
    ["script/define-props-destructuring"] = definePropsDestructuringOptionsDef
    ["html/no-empty-palpable-content"] = new JsonSchema {
      type = "object"
      properties {
        ["contentDirectives"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
        }
      }
      additionalProperties = false
    }
    ["type/strict-boolean-expressions"] = strictBooleanExpressionsOptionsDef
    ["script/no-restricted-globals"] = new JsonSchema { `$ref` = "#/definitions/NoRestrictedGlobalsOptions" }
    ["script/no-restricted-members"] = new JsonSchema { `$ref` = "#/definitions/NoRestrictedMembersOptions" }
    ["vue/component-name-in-template-casing"] = componentNameInTemplateCasingOptionsDef
    ["script/custom-event-name-casing"] = ConfigArtifactDefinitions.customEventNameCasingOptionsDef
    ["vue/prop-name-casing"] = new JsonSchema {
      type = "object"
      properties {
        ["casing"] = new JsonSchema {
          type = "string"
          enum = new Listing { "camelCase"; "snake_case" }
          default = "camelCase"
        }
      }
      additionalProperties = false
    }
    ["vue/slot-name-casing"] = new JsonSchema {
      type = "string"
      enum = new Listing { "camelCase"; "kebab-case"; "singleword" }
      default = "camelCase"
    }
    ["vue/no-mutating-props"] = ConfigArtifactDefinitions.noMutatingPropsOptionsDef
    ["vue/multi-word-component-names"] = new JsonSchema {
      type = "object"
      properties {
        ["ignores"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
          uniqueItems = true
          default = new Listing {}
        }
      }
      additionalProperties = false
    }
    ["vue/warn-custom-directive"] = new JsonSchema {
      type = "object"
      properties {
        ["ignore"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
          default = new Listing {}
        }
      }
      additionalProperties = false
    }
    ["vue/no-bare-strings-in-template"] = new JsonSchema {
      type = "object"
      properties {
        ["allowlist"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
        }
      }
      additionalProperties = false
    }
    ["a11y/anchor-has-content"] = new JsonSchema {
      type = "object"
      properties {
        ["accessibleChildren"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
          default = new Listing {}
        }
      }
      additionalProperties = false
    }
    ["a11y/label-has-for"] = new JsonSchema {
      type = "object"
      properties {
        ["controlComponents"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
          default = new Listing {}
        }
      }
      additionalProperties = false
    }
    ["vue/block-lang"] = new JsonSchema {
      type = "object"
      properties {
        ["script"] = blockLangBlockDef
        ["template"] = blockLangBlockDef
        ["style"] = blockLangBlockDef
      }
      additionalProperties = false
    }
    ["vue/enforce-style-attribute"] = new JsonSchema {
      type = "object"
      properties {
        ["allow"] = new JsonSchema {
          type = "array"
          items = new JsonSchema {
            type = "string"
            enum = new Listing { "plain"; "scoped"; "module" }
          }
          uniqueItems = true
          default = new Listing { "scoped" }
        }
      }
      additionalProperties = false
    }
    ["vue/no-restricted-syntax"] = new JsonSchema {
      oneOf = new Listing {
        restrictedSyntaxSelectors
        new JsonSchema {
          type = "object"
          properties {
            ["selectors"] = restrictedSyntaxSelectors
          }
          additionalProperties = false
        }
      }
    }
    ["vue/quote-props"] = new JsonSchema {
      type = "string"
      enum = new Listing { "as-needed" }
    }
    ["vue/sort-keys"] = new JsonSchema {
      type = "object"
      properties {
        ["order"] = new JsonSchema {
          type = "string"
          enum = new Listing { "asc"; "desc" }
          default = "asc"
        }
        ["caseSensitive"] = new JsonSchema { type = "boolean"; default = true }
        ["natural"] = new JsonSchema { type = "boolean"; default = false }
      }
      additionalProperties = false
    }
    ["vue/require-component-registration"] = new JsonSchema {
      type = "object"
      properties {
        ["globals"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
        }
        ["ignorePatterns"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
        }
      }
      additionalProperties = false
    }
    ["vue/sfc-element-order"] = ConfigArtifactDefinitions.sfcElementOrderOptionsDef
    ["vue/html-self-closing"] = ConfigArtifactDefinitions.htmlSelfClosingOptionsDef
    ["vue/html-button-has-type"] = new JsonSchema {
      type = "object"
      properties {
        ["button"] = new JsonSchema { type = "boolean"; default = true }
        ["submit"] = new JsonSchema { type = "boolean"; default = true }
        ["reset"] = new JsonSchema { type = "boolean"; default = true }
      }
      additionalProperties = false
    }
    ["vue/no-use-v-if-with-v-for"] = new JsonSchema {
      type = "object"
      properties {
        ["allowUsingIterationVar"] = new JsonSchema { type = "boolean"; default = false }
      }
      additionalProperties = false
    }
    ["vue/html-quotes"] = new JsonSchema {
      oneOf = new Listing {
        new JsonSchema {
          type = "string"
          enum = new Listing { "double"; "single" }
        }
        new JsonSchema {
          type = "object"
          properties {
            ["style"] = new JsonSchema {
              type = "string"
              enum = new Listing { "double"; "single" }
              default = "double"
            }
            ["avoidEscape"] = new JsonSchema { type = "boolean"; default = false }
          }
          additionalProperties = false
        }
      }
    }
    ["vue/mustache-interpolation-spacing"] = new JsonSchema {
      type = "string"
      enum = new Listing { "always"; "never" }
    }
    ["vue/v-on-event-hyphenation"] = new JsonSchema {
      oneOf = new Listing {
        ConfigArtifactDefinitions.hyphenationStyleDef
        new JsonSchema {
          type = "object"
          properties {
            ["style"] = new JsonSchema {
              type = "string"
              enum = new Listing { "always"; "never" }
              default = "always"
            }
            ["ignore"] = new JsonSchema {
              type = "array"
              items = new JsonSchema { type = "string"; pattern = #"^(?!\s*$)(?![\s\S]*:exit$)"# }
              uniqueItems = true
              default = new Listing {}
            }
            ["autofix"] = new JsonSchema {
              type = "boolean"
              default = false
            }
          }
          additionalProperties = false
        }
      }
    }
    ["vue/v-bind-style"] = new JsonSchema {
      type = "string"
      enum = new Listing { "shorthand"; "longform" }
    }
    ["vue/v-on-style"] = new JsonSchema {
      type = "string"
      enum = new Listing { "shorthand"; "longform" }
    }
    ["vue/v-slot-style"] = new JsonSchema {
      oneOf = new Listing {
        new JsonSchema {
          type = "string"
          enum = new Listing { "shorthand"; "longform" }
        }
        new JsonSchema {
          type = "object"
          properties {
            ["atComponent"] = new JsonSchema {
              type = "string"
              enum = new Listing { "shorthand"; "longform"; "v-slot" }
              default = "v-slot"
            }
            ["default"] = new JsonSchema {
              type = "string"
              enum = new Listing { "shorthand"; "longform"; "v-slot" }
              default = "shorthand"
            }
            ["named"] = new JsonSchema {
              type = "string"
              enum = new Listing { "shorthand"; "longform" }
              default = "shorthand"
            }
          }
          additionalProperties = false
        }
      }
    }
    ["vue/attribute-hyphenation"] = new JsonSchema {
      oneOf = new Listing {
        ConfigArtifactDefinitions.hyphenationStyleDef
        new JsonSchema {
          type = "object"
          properties {
            ["style"] = new JsonSchema {
              type = "string"
              enum = new Listing { "always"; "never" }
              default = "always"
            }
            ["ignore"] = new JsonSchema {
              type = "array"
              items = new JsonSchema { type = "string"; pattern = #"^(?!\s*$)(?![\s\S]*:exit$)"# }
              uniqueItems = true
              default = new Listing {}
            }
            ["ignoreTags"] = new JsonSchema {
              type = "array"
              items = new JsonSchema { type = "string" }
              uniqueItems = true
              default = new Listing {}
            }
          }
          additionalProperties = false
        }
      }
    }
    ["vue/valid-v-on"] = new JsonSchema {
      type = "object"
      properties {
        ["modifiers"] = new JsonSchema {
          type = "array"
          items = new JsonSchema { type = "string" }
        }
      }
      additionalProperties = false
    }
    ["vue/valid-v-slot"] = new JsonSchema {
      type = "object"
      properties {
        ["allowModifiers"] = new JsonSchema { type = "boolean"; default = false }
      }
      additionalProperties = false
    }
    ["musea/prefer-design-tokens"] = new JsonSchema { `$ref` = "#/definitions/MuseaPreferDesignTokensOptions" }
  }
  additionalProperties = false
}

strictBooleanExpressionsOptionsDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["allowString"] = new JsonSchema { type = "boolean"; default = true }
    ["allowNumber"] = new JsonSchema { type = "boolean"; default = true }
    ["allowNullableObject"] = new JsonSchema { type = "boolean"; default = true }
    ["allowNullableBoolean"] = new JsonSchema { type = "boolean"; default = false }
    ["allowNullableString"] = new JsonSchema { type = "boolean"; default = false }
    ["allowNullableNumber"] = new JsonSchema { type = "boolean"; default = false }
    ["allowNullableEnum"] = new JsonSchema { type = "boolean"; default = false }
    ["allowAny"] = new JsonSchema { type = "boolean"; default = false }
  }
  additionalProperties = false
}

componentNameInTemplateCasingOptionsDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["casing"] = new JsonSchema {
      type = "string"
      enum = new Listing { "PascalCase"; "kebab-case" }
      default = "PascalCase"
    }
    ["registeredComponentsOnly"] = new JsonSchema {
      type = "boolean"
      default = true
    }
    ["globals"] = new JsonSchema {
      type = "array"
      items = new JsonSchema { type = "string" }
      default = new Listing {}
    }
  }
  additionalProperties = false
}

restrictedSyntaxSelectors: JsonSchema = new JsonSchema {
  type = "array"
  items = new JsonSchema {
    oneOf = new Listing {
      new JsonSchema { type = "string"; minLength = 1 }
      new JsonSchema {
        type = "object"
        properties {
          ["selector"] = new JsonSchema { type = "string"; minLength = 1 }
          ["message"] = new JsonSchema { type = "string" }
        }
        required = new Listing { "selector" }
        additionalProperties = false
      }
    }
  }
  default = new Listing {}
}
