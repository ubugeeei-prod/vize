                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
              ["path"] = new JsonSchema {
                type = "string"
              }
            }
            required = new Listing { "from"; "name" }
            additionalProperties = false
          }
          new JsonSchema {
            type = "object"
            properties {
              ["from"] = new JsonSchema {
                type = "string"
                enum = new Listing { "lib" }
