              ["name"] = new JsonSchema {
                oneOf = new Listing {
                  new JsonSchema {
                    type = "string"
                  }
                  new JsonSchema {
                    type = "array"
                    items = new JsonSchema {
                      type = "string"
                    }
                    minItems = 1
                    uniqueItems = true
                  }
                }
              }
              ["package"] = new JsonSchema {
                type = "string"
              }
            }
            required = new Listing { "from"; "name"; "package" }
            additionalProperties = false
          }
        }
      }
