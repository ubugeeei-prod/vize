restrictPlusOperandsDef: JsonSchema = new JsonSchema {
  type = "object"
  properties {
    ["allowAny"] = new JsonSchema {
      description = "Whether to allow `any` typed values."
      type = "boolean"
      default = true
    }
    ["allowBoolean"] = new JsonSchema {
      description = "Whether to allow `boolean` typed values."
      type = "boolean"
      default = true
    }
    ["allowNullish"] = new JsonSchema {
      description = "Whether to allow potentially `null` or `undefined` typed values."
      type = "boolean"
      default = true
    }
    ["allowNumberAndString"] = new JsonSchema {
      description = "Whether to allow `bigint`/`number` typed values and `string` typed values to be added together."
      type = "boolean"
      default = true
    }
    ["allowRegExp"] = new JsonSchema {
      description = "Whether to allow `regexp` typed values."
      type = "boolean"
      default = true
    }
    ["skipCompoundAssignments"] = new JsonSchema {
      description = "Whether to skip compound assignments such as `+=`."
      type = "boolean"
      default = false
    }
  }
  additionalProperties = false
}

