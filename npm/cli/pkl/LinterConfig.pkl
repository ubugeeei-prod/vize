/// Linter configuration for Vize.
module vize.LinterConfig
import "LintRuleOptionTypes.pkl"

typealias RuleSeverity = "off" | "warn" | "error"

typealias RuleCategory = "correctness" | "suspicious" | "style" | "perf" | "a11y" | "security"

typealias LintPreset =
  "general-recommended"
    | "general_recommended"
    | "generalRecommended"
    | "happy-path"
    | "happy_path"
    | "happy"
    | "default"
    | "recommended"
    | "opinionated"
    | "strict"
    | "all"
    | "essential"
    | "incremental"
    | "ecosystem"
    | "nuxt"
typealias TemplateComponentNameCasing = "PascalCase" | "kebab-case"
typealias CustomEventNameCasing = "lowercase" | "camelCase" | "kebab-case"
typealias PropNameCasingStyle = "camelCase" | "snake_case"
typealias SlotNameCasingStyle = "camelCase" | "kebab-case" | "singleword"
typealias HtmlSelfClosingStyle = "always" | "never" | "any"
typealias HtmlQuoteStyle = "double" | "single"
typealias MustacheInterpolationSpacingStyle = "always" | "never"
typealias HyphenationStyle = "always" | "never"
typealias VBindStyle = "shorthand" | "longform"
typealias VOnStyle = "shorthand" | "longform"
typealias VSlotUniformStyle = "shorthand" | "longform"
typealias VSlotStyleValue = VSlotUniformStyle | "v-slot"

/// A restricted global identifier for `script/no-restricted-globals`.
class RestrictedGlobal {
  /// Identifier name to forbid (e.g. `process`).
  name: String

  /// Optional advisory message shown in the diagnostic.
  message: String? = null
}

/// A restricted `object.property` member access for `script/no-restricted-members`.
class RestrictedMember {
  /// Object identifier (e.g. `window`).
  object: String

  /// Property name accessed on the object (e.g. `localStorage`).
  property: String

  /// Optional advisory message shown in the diagnostic.
  message: String? = null
}

/// Options for `script/no-restricted-globals`. A non-empty `globals` list
/// replaces the built-in default deny list.
class NoRestrictedGlobalsOptions {
  globals: Listing<RestrictedGlobal>? = null
}

/// Options for `script/no-restricted-members`. The rule is off unless `members`
/// is configured.
class NoRestrictedMembersOptions {
  members: Listing<RestrictedMember>? = null
}

/// Options for `vue/component-name-in-template-casing`.
class ComponentNameInTemplateCasingOptions {
  casing: TemplateComponentNameCasing = "PascalCase"
  registeredComponentsOnly: Boolean = true
  globals: Listing<String> = new Listing {}
}

/// Options for `script/custom-event-name-casing`.
class CustomEventNameCasingOptions {
  casing: CustomEventNameCasing = "camelCase"
}

/// Casing of the component's own declared props, without an automatic rename.
class PropNameCasingOptions {
  casing: PropNameCasingStyle = "camelCase"
}

class RequireComponentRegistrationOptions {
  globals: Listing<String> = new Listing {}
  ignorePatterns: Listing<String> = new Listing {}
}

/// Options for `vue/no-mutating-props`.
class NoMutatingPropsOptions {
  shallowOnly: Boolean = false
}

/// Exact custom directive names without the `v-` prefix.
class WarnCustomDirectiveOptions {
  ignore: Listing<String> = new Listing {}
}

/// Literal strings and `/pattern/flags` entries accepted in authored text.
class NoBareStringsInTemplateOptions {
  allowlist: Listing<String>? = null
}

/// Components that always provide an accessible name to their parent anchor.
class AnchorHasContentOptions {
  accessibleChildren: Listing<String> = new Listing {}
}

/// Components that render a native form control inside a label.
class LabelHasForOptions {
  controlComponents: Listing<String> = new Listing {}
}

/// Options for `vue/sfc-element-order`.
class SfcElementOrderOptions {
  order: Listing<String | Listing<String>> = new Listing {
    new Listing { "script"; "template" }
    "style"
  }
}

/// HTML-family options for `vue/html-self-closing`.
class HtmlSelfClosingHtmlOptions {
  `void`: HtmlSelfClosingStyle = "always"
  normal: HtmlSelfClosingStyle = "any"
  component: HtmlSelfClosingStyle = "always"
}

/// Options for `vue/html-self-closing`.
class HtmlSelfClosingOptions {
  html: HtmlSelfClosingHtmlOptions = new HtmlSelfClosingHtmlOptions {}
  svg: HtmlSelfClosingStyle = "always"
  math: HtmlSelfClosingStyle = "always"
}

/// Detailed options for `vue/html-quotes`.
class HtmlQuotesOptions {
  style: HtmlQuoteStyle = "double"
  avoidEscape: Boolean = false
}

/// Position-specific options for `vue/v-slot-style`.
class VSlotStyleOptions {
  atComponent: VSlotStyleValue = "v-slot"
  `default`: VSlotStyleValue = "shorthand"
  named: VSlotUniformStyle = "shorthand"
}

/// A design token recognized by `musea/prefer-design-tokens`.
class MuseaDesignToken {
  /// Token path (e.g. `color.primary`).
  path: String

  /// Primitive CSS value to match (e.g. `#3b82f6`).
  value: String

  /// Token tier shown in diagnostics.
  tier: String = "primitive"
}

/// Options for `musea/prefer-design-tokens`.
class MuseaPreferDesignTokensOptions {
  tokens: Listing<MuseaDesignToken>? = null
}

/// Typed per-rule options for rules that accept project-local configuration.
class StrictBooleanExpressionsOptions {
  allowString: Boolean = true
  allowNumber: Boolean = true
  allowNullableObject: Boolean = true
  allowNullableBoolean: Boolean = false
  allowNullableString: Boolean = false
  allowNullableNumber: Boolean = false
  allowNullableEnum: Boolean = false
  allowAny: Boolean = false
}

/// Style for props destructuring; matches eslint-plugin-vue's default.
class DefinePropsDestructuringOptions {
  destructure: "only-when-assigned" | "always" | "never" = "always"
}

/// Options for `script/define-macros-order`.
class DefineMacrosOrderOptions {
  order: Listing<String> = new Listing { "defineProps"; "defineEmits" }
  defineExposeLast: Boolean = false
}

class VOnEventHyphenationOptions {
  style: HyphenationStyle = "always"
  ignore: Listing<String> = new Listing {}
  autofix: Boolean = false
}

class AttributeHyphenationOptions {
  style: HyphenationStyle = "always"
  ignore: Listing<String> = new Listing {}
  ignoreTags: Listing<String> = new Listing {}
}

class ValidVOnOptions {
  modifiers: Listing<String> = new Listing {}
}

class ValidVSlotOptions {
  allowModifiers: Boolean = false
}

class EnforceStyleAttributeOptions {
  allow: Listing<"plain" | "scoped" | "module"> = new Listing { "scoped" }
}

class BlockLangBlock {
  lang: (String | Listing<String>)? = null
  allowNoLang: Boolean? = null
  required: Boolean? = null
}

class BlockLangOptions {
  script: BlockLangBlock? = null
  template: BlockLangBlock? = null
  style: BlockLangBlock? = null
}

class MaxLinesObject {
  max: Int? = null
  skipComments: Boolean? = null
  skipBlankLines: Boolean? = null
}

typealias MaxLinesOptions = Int | MaxLinesObject

class MaxLinesPerBlockOptions {
  style: Int? = null
  template: Int? = null
  script: Int? = null
  skipBlankLines: Boolean? = null
}

class RestrictedSyntaxSelector {
  /// esquery selector from the supported subset (see the rule options docs).
  selector: String

  /// Message reported instead of the default one.
  message: String?
}

typealias RestrictedSyntaxEntry = String | RestrictedSyntaxSelector

class NoRestrictedSyntaxOptions {
  selectors: Listing<RestrictedSyntaxEntry> = new Listing {}
}

class SortKeysOptions {
  order: "asc" | "desc" = "asc"
  caseSensitive: Boolean = true
  natural: Boolean = false
}

class LintRuleOptions {
  `script/define-macros-order`: DefineMacrosOrderOptions? = null
  `script/define-props-destructuring`: DefinePropsDestructuringOptions? = null
  `type/strict-boolean-expressions`: StrictBooleanExpressionsOptions? = null
  `script/no-restricted-globals`: NoRestrictedGlobalsOptions? = null
  `script/no-restricted-members`: NoRestrictedMembersOptions? = null
  `vue/component-name-in-template-casing`: ComponentNameInTemplateCasingOptions? = null
  `script/custom-event-name-casing`: CustomEventNameCasingOptions? = null
  `vue/prop-name-casing`: PropNameCasingOptions? = null
  `vue/slot-name-casing`: SlotNameCasingStyle? = null
  `vue/no-mutating-props`: NoMutatingPropsOptions? = null
  `vue/warn-custom-directive`: WarnCustomDirectiveOptions? = null
  `vue/no-bare-strings-in-template`: NoBareStringsInTemplateOptions? = null
  `a11y/anchor-has-content`: AnchorHasContentOptions? = null
  `a11y/label-has-for`: LabelHasForOptions? = null
  `vue/block-lang`: BlockLangOptions? = null
  `max-lines`: MaxLinesOptions? = null
  `vue/max-lines-per-block`: MaxLinesPerBlockOptions? = null
  `vue/max-props`: LintRuleOptionTypes.MaxPropsOptions? = null
  `vue/max-template-depth`: LintRuleOptionTypes.MaxTemplateDepthOptions? = null
  `vue/no-restricted-block`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-restricted-call-after-await`: LintRuleOptionTypes.CallAfterAwaitOptions? = null
  `vue/no-restricted-class`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-restricted-component-names`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-restricted-component-options`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-restricted-custom-event`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-restricted-html-elements`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-restricted-props`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-restricted-static-attribute`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-restricted-v-on`: LintRuleOptionTypes.RestrictedNames? = null
  `vue/no-unsupported-features`: LintRuleOptionTypes.UnsupportedFeaturesOptions? = null
  `type/await-thenable`: LintRuleOptionTypes.AwaitThenableOptions? = null
  `type/no-base-to-string`: LintRuleOptionTypes.NoBaseToStringOptions? = null
  `type/no-confusing-void-expression`: LintRuleOptionTypes.NoConfusingVoidExpressionOptions? = null
  `type/no-deprecated`: LintRuleOptionTypes.AllowListOptions? = null
  `type/no-duplicate-type-constituents`: LintRuleOptionTypes.NoDuplicateTypeConstituentsOptions? = null
  `type/no-floating-promises`: LintRuleOptionTypes.NoFloatingPromisesOptions? = null
  `type/no-meaningless-void-operator`: LintRuleOptionTypes.NoMeaninglessVoidOperatorOptions? = null
  `type/no-misused-promises`: LintRuleOptionTypes.NoMisusedPromisesOptions? = null
  `type/no-misused-spread`: LintRuleOptionTypes.AllowListOptions? = null
  `type/no-unnecessary-boolean-literal-compare`: LintRuleOptionTypes.NoUnnecessaryBooleanLiteralCompareOptions? = null
  `type/no-unnecessary-condition`: LintRuleOptionTypes.NoUnnecessaryConditionOptions? = null
  `type/no-unnecessary-type-assertion`: LintRuleOptionTypes.NoUnnecessaryTypeAssertionOptions? = null
  `type/no-unsafe-member-access`: LintRuleOptionTypes.NoUnsafeMemberAccessOptions? = null
  `type/only-throw-error`: LintRuleOptionTypes.OnlyThrowErrorOptions? = null
  `type/prefer-promise-reject-errors`: LintRuleOptionTypes.PreferPromiseRejectErrorsOptions? = null
  `type/restrict-plus-operands`: LintRuleOptionTypes.RestrictPlusOperandsOptions? = null
  `type/restrict-template-expressions`: LintRuleOptionTypes.RestrictTemplateExpressionsOptions? = null
  `type/return-await`: LintRuleOptionTypes.ReturnAwaitOption? = null
  `type/unbound-method`: LintRuleOptionTypes.UnboundMethodOptions? = null
  `vue/enforce-style-attribute`: EnforceStyleAttributeOptions? = null
  `vue/no-restricted-syntax`: (Listing<RestrictedSyntaxEntry> | NoRestrictedSyntaxOptions)? = null
  `vue/quote-props`: "as-needed"? = null
  `vue/sort-keys`: SortKeysOptions? = null
  `vue/require-component-registration`: RequireComponentRegistrationOptions? = null
  `vue/sfc-element-order`: SfcElementOrderOptions? = null
  `vue/html-self-closing`: HtmlSelfClosingOptions? = null
  `vue/html-quotes`: (HtmlQuoteStyle | HtmlQuotesOptions)? = null
  `vue/mustache-interpolation-spacing`: MustacheInterpolationSpacingStyle? = null
  `vue/v-on-event-hyphenation`: (HyphenationStyle | VOnEventHyphenationOptions)? = null
  `vue/v-bind-style`: VBindStyle? = null
  `vue/v-on-style`: VOnStyle? = null
  `vue/v-slot-style`: (VSlotUniformStyle | VSlotStyleOptions)? = null
  `vue/attribute-hyphenation`: (HyphenationStyle | AttributeHyphenationOptions)? = null
  `vue/valid-v-on`: ValidVOnOptions? = null
  `vue/valid-v-slot`: ValidVSlotOptions? = null
  `musea/prefer-design-tokens`: MuseaPreferDesignTokensOptions? = null
}

class LinterConfig {
  /// Enable linting.
  enabled: Boolean = true

  /// Built-in lint preset.
  preset: LintPreset = "happy-path"

  /// Enable native type-aware lint rules from the active lint configuration.
  typeAware: Boolean = false

  /// Analyze relationships between input components.
  crossFile: Boolean = false

  /// Display the provide/inject tree; enables cross-file analysis.
  crossFileTree: Boolean = false

  /// Display cross-file complexity; enables cross-file analysis.
  crossFileComplexity: Boolean = false

  /// Enable the native reactivity-loss rule unless rules explicitly disable it.
  strictReactivity: Boolean = false

  /// Fail when warnings exceed this non-negative limit; absent means unlimited.
  maxWarnings: Int(isBetween(0, 9007199254740991))? = null

  /// Report template eslint/oxlint disable comments that suppress no active rule
  reportUnusedDisableDirectives: Boolean? = null

  /// Ignore eslint-disable comments in source files
  noInlineConfig: Boolean? = null

  /// Rules to enable/disable.
  rules: Mapping<String, RuleSeverity> = new Mapping {}

  /// Typed per-rule options for rules that accept project-local configuration.
  ruleOptions: LintRuleOptions? = null

  /// Category-level severity overrides.
  categories: Mapping<RuleCategory, RuleSeverity> = new Mapping {}
}
