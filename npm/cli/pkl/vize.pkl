/// Shared schema for `vize.config.pkl`.
///
/// Example:
/// amends "node_modules/vize/pkl/vize.pkl"
///
/// compiler {
///   sourceMap = true
/// }
module vize.Config
import "SortImportsConfig.pkl"
typealias CompilerMode = "module" | "function"
typealias TemplateSyntax = "standard" | "strict" | "quirks"
typealias Whitespace = "condense" | "preserve" | "vue2-line-breaks"
typealias JsxMode = "vdom" | "vapor"
typealias JsxCompat = "native" | "babel"
typealias ScriptExt = "ts" | "js"
typealias RuleSeverity = "off" | "warn" | "error"
typealias LintPreset = "happy-path" | "opinionated" | "essential" | "incremental" | "ecosystem" | "nuxt"
typealias TemplateComponentNameCasing = "PascalCase" | "kebab-case"
typealias CustomEventNameCasing = "camelCase" | "kebab-case"
typealias HtmlSelfClosingStyle = "always" | "never" | "any"
typealias HyphenationStyle = "always" | "never"
typealias TrailingComma = "all" | "none" | "es5"
typealias FilterPattern = String | Listing<String>
typealias GlobalTypeValue = String | GlobalTypeDeclaration
typealias ConfigExtends = String | Listing<String>
class CompilerCompatibilityConfig {
  vueVersion: ("3" | "2.7" | "2" | "1" | "0.11" | "0.10")? = null
  hostCompiler: Boolean? = null
  scriptSetupInStandalone: Boolean? = null
  optionsApiVapor: Boolean? = null
  nuxtVersion: Number? = null
  webpackVersion: Number? = null
}
class CompilerConfig {
  mode: CompilerMode? = null
  vapor: Boolean? = null
  jsxMode: JsxMode? = null
  jsxCompat: JsxCompat? = null
  customRenderer: Boolean? = null
  customElements: Listing<String>? = null
  ssr: Boolean? = null
  templateSyntax: TemplateSyntax? = null
  whitespace: Whitespace? = null
  sourceMap: Boolean? = null
  prefixIdentifiers: Boolean? = null
  hoistStatic: Boolean? = null
  cacheHandlers: Boolean? = null
  isTs: Boolean? = null
  scriptExt: ScriptExt? = null
  runtimeModuleName: String? = null
  runtimeGlobalName: String? = null
  compatibility: CompilerCompatibilityConfig?
}
class ExperimentalsConfig {
  vapor: Boolean? = null
  jsxVapor: Boolean? = null
  intagComment: Boolean? = null
  inTagComment: Boolean? = null
  pattenedTemplate: Boolean? = null
  patternedTemplate: Boolean? = null
  selfComponent: Boolean? = null
  strictSlotChildren: Boolean? = null
  serverScript: Boolean? = null
}
class VitePluginConfig {
  include: FilterPattern? = null
  exclude: FilterPattern? = null
  scanPatterns: Listing<String>? = null
  precompileBatchSize: Int? = null
  ignorePatterns: Listing<String>? = null
}

class RestrictedGlobal {
  name: String
  message: String? = null
}

class RestrictedMember {
  object: String
  property: String
  message: String? = null
}

class NoRestrictedGlobalsOptions {
  globals: Listing<RestrictedGlobal>? = null
}

class NoRestrictedMembersOptions {
  members: Listing<RestrictedMember>? = null
}

class ComponentNameInTemplateCasingOptions {
  casing: TemplateComponentNameCasing = "PascalCase"
  registeredComponentsOnly: Boolean = true
  globals: Listing<String> = new Listing {}
}

class CustomEventNameCasingOptions {
  casing: CustomEventNameCasing = "camelCase"
}

class RequireComponentRegistrationOptions {
  globals: Listing<String> = new Listing {}
}

class NoMutatingPropsOptions {
  shallowOnly: Boolean = false
}

class SfcElementOrderOptions {
  order: Listing<String | Listing<String>> = new Listing {
    new Listing { "script"; "template" }
    "style"
  }
}

class HtmlSelfClosingHtmlOptions {
  `void`: HtmlSelfClosingStyle = "always"
  normal: HtmlSelfClosingStyle = "any"
  component: HtmlSelfClosingStyle = "always"
}

class HtmlSelfClosingOptions {
  html: HtmlSelfClosingHtmlOptions = new HtmlSelfClosingHtmlOptions {}
  svg: HtmlSelfClosingStyle = "always"
  math: HtmlSelfClosingStyle = "always"
}

class MuseaDesignToken {
  path: String
  value: String
  tier: String? = null
}

class MuseaPreferDesignTokensOptions {
  tokens: Listing<MuseaDesignToken>? = null
}

class StrictBooleanExpressionsOptions {
  allowString: Boolean = true
  allowNumber: Boolean = true
  allowNullableObject: Boolean = true
  allowNullableBoolean: Boolean = false
  allowNullableString: Boolean = false
  allowNullableNumber: Boolean = false
  allowNullableEnum: Boolean = false
  allowAny: Boolean = false
}

class ContentDirectivesOptions {
  contentDirectives: Listing<String> = new Listing {}
}

/// Style for props destructuring; matches eslint-plugin-vue's default.
class DefinePropsDestructuringOptions {
  destructure: "only-when-assigned"|"always"|"never" = "only-when-assigned"
}

class LintRuleOptions {
  `script/define-props-destructuring`: DefinePropsDestructuringOptions? = null
  `html/no-empty-palpable-content`: ContentDirectivesOptions? = null
  `type/strict-boolean-expressions`: StrictBooleanExpressionsOptions? = null
  `script/no-restricted-globals`: NoRestrictedGlobalsOptions? = null
  `script/no-restricted-members`: NoRestrictedMembersOptions? = null
  `vue/component-name-in-template-casing`: ComponentNameInTemplateCasingOptions? = null
  `script/custom-event-name-casing`: CustomEventNameCasingOptions? = null
  `vue/no-mutating-props`: NoMutatingPropsOptions? = null
  `vue/require-component-registration`: RequireComponentRegistrationOptions? = null
  `vue/sfc-element-order`: SfcElementOrderOptions? = null
  `vue/html-self-closing`: HtmlSelfClosingOptions? = null
  `vue/v-on-event-hyphenation`: HyphenationStyle? = null
  `vue/attribute-hyphenation`: HyphenationStyle? = null
  `musea/prefer-design-tokens`: MuseaPreferDesignTokensOptions? = null
}

class LinterConfig {
  enabled: Boolean? = null
  preset: LintPreset? = null
  typeAware: Boolean? = null
  /// Analyze relationships between input components.
  crossFile: Boolean? = null

  /// Display the provide/inject tree; enables cross-file analysis.
  crossFileTree: Boolean? = null

  /// Display cross-file complexity; enables cross-file analysis.
  crossFileComplexity: Boolean? = null

  /// Enable the native reactivity-loss rule unless rules explicitly disable it.
  strictReactivity: Boolean? = null

  /// Fail when warnings exceed this non-negative limit; absent means unlimited.
  maxWarnings: Int(isBetween(0, 9007199254740991))? = null

  rules: Mapping<String, RuleSeverity>? = null
  ruleOptions: LintRuleOptions? = null
  categories: Mapping<String, RuleSeverity>? = null
}

class TypeCheckerConfig {
  enabled: Boolean? = null
  strict: Boolean? = null
  checkProps: Boolean? = null
  checkEmits: Boolean? = null
  checkTemplateBindings: Boolean? = null
  checkReactivity: Boolean? = null
  checkSetupContext: Boolean? = null
  checkInvalidExports: Boolean? = null
  checkFallthroughAttrs: Boolean? = null
  optionsApi: Boolean? = null
  legacyVue2: Boolean? = null
  jsxTypecheck: Boolean? = null
  tsconfig: String? = null
  corsaPath: String? = null
  tsgoPath: String? = null
  globalsFile: String? = null
  servers: Int? = null
  lspRequestTimeoutMs: Int? = null
}

class FormatterConfig {
  /// Oxfmt-compatible import sorting; false disables it.
  sortImports: Boolean(this == false) | SortImportsConfig.SortImportsConfig? = null

  printWidth: Int? = null
  tabWidth: Int? = null
  useTabs: Boolean? = null
  semi: Boolean? = null
  singleQuote: Boolean? = null
  trailingComma: TrailingComma? = null
  jsxSingleQuote: Boolean? = null
  bracketSpacing: Boolean? = null
  bracketSameLine: Boolean? = null
  arrowParens: ("always"|"avoid")? = null
  endOfLine: ("lf"|"crlf"|"cr"|"auto")? = null
  quoteProps: ("as-needed"|"consistent"|"preserve")? = null
  singleAttributePerLine: Boolean? = null
  vueIndentScriptAndStyle: Boolean? = null
  sortAttributes: Boolean? = null
  attributeSortOrder: ("alphabetical"|"as-written")? = null
  mergeBindAndNonBindAttrs: Boolean? = null
  maxAttributesPerLine: Int? = null
  attributeGroups: Listing<Listing<String>>? = null
  normalizeDirectiveShorthands: Boolean? = null
  sortBlocks: Boolean? = null
}

class LspConfig {
  enabled: Boolean? = null
  lint: Boolean? = null
  /// Deprecated: use `lint`.
  diagnostics: Boolean? = null
  typecheck: Boolean? = null
  editor: Boolean? = null
  ecosystem: Boolean? = null
  legacyVue2: Boolean? = null
  completion: Boolean? = null
  signatureHelp: Boolean? = null
  hover: Boolean? = null
  definition: Boolean? = null
  references: Boolean? = null
  documentSymbols: Boolean? = null
  workspaceSymbols: Boolean? = null
  formatting: Boolean? = null
  codeActions: Boolean? = null
  rename: Boolean? = null
  codeLens: Boolean? = null
  semanticTokens: Boolean? = null
  documentLinks: Boolean? = null
  foldingRanges: Boolean? = null
  inlayHints: Boolean? = null
  fileRename: Boolean? = null
  corsa: Boolean? = null
  /// Deprecated: use `corsa`.
  tsgo: Boolean? = null
}

class MuseaViewport {
  width: Number
  height: Number
  name: String? = null
}

class MuseaVrtConfig {
  threshold: Number? = null
  outDir: String? = null
  viewports: Listing<MuseaViewport>? = null
}

class MuseaA11yConfig {
  enabled: Boolean? = null
  rules: Mapping<String, Boolean>? = null
}

class MuseaAutogenConfig {
  enabled: Boolean? = null
  maxVariants: Int? = null
}

class MuseaConfig {
  include: Listing<String>? = null
  exclude: Listing<String>? = null
  basePath: String? = null
  storybookCompat: Boolean? = null
  inlineArt: Boolean? = null
  vrt: MuseaVrtConfig?
  a11y: MuseaA11yConfig?
  autogen: MuseaAutogenConfig?
}

class GlobalTypeDeclaration {
  type: String
  defaultValue: String? = null
}

class ConfigEntry {
  name: String? = null
  basePath: String? = null
  files: Listing<String>? = null
  ignores: Listing<String>? = null
  `extends`: ConfigExtends? = null
  compiler: CompilerConfig?
  experimentals: ExperimentalsConfig?
  vite: VitePluginConfig?
  linter: LinterConfig?
  typeChecker: TypeCheckerConfig?
  formatter: FormatterConfig?
  languageServer: LspConfig?
  /// Deprecated: use `languageServer`.
  lsp: LspConfig?
  musea: MuseaConfig?
  globalTypes: Mapping<String, GlobalTypeValue>? = null
}

name: String? = null
basePath: String? = null
files: Listing<String>? = null
ignores: Listing<String>? = null
`extends`: ConfigExtends? = null
compiler: CompilerConfig?
experimentals: ExperimentalsConfig?
vite: VitePluginConfig?
linter: LinterConfig?
typeChecker: TypeCheckerConfig?
formatter: FormatterConfig?
languageServer: LspConfig?
/// Deprecated: use `languageServer`.
lsp: LspConfig?
musea: MuseaConfig?
globalTypes: Mapping<String, GlobalTypeValue>? = null
entries: Listing<ConfigEntry>? = null
