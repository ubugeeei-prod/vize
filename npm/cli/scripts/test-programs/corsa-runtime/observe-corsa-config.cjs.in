const fs = require("node:fs");
exports.runCli = (args) => {
  const result = {
    args,
    environment: Object.fromEntries(
      @@ENVIRONMENT_KEYS@@.map((name) => [name, process.env[name] ?? null]),
    ),
  };
  if (args.includes("--config-stdin")) result.configPayload = fs.readFileSync(0, "utf8");
  process.stdout.write(JSON.stringify(result));
};
