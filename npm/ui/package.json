  "scripts": {
    "build": "vp pack && vp exec node scripts/build-source-registry.ts",
    "dev": "vp pack --watch",
    "lint:sfc": "vp exec node scripts/lint-sfc.ts src && vp exec node scripts/check-renderers.ts src",
    "pretest": "vp pack && pnpm check:size && pnpm check:tree-shaking",
    "test": "vp test run",
    "check:catalog": "vp test run src/catalog/family-catalog.test.ts",
    "check:static": "vp check src scripts vite.config.ts tsconfig.typecheck.json && vue-tsc --noEmit -p tsconfig.typecheck.json",
    "check:vapor-runtime": "vp exec node scripts/check-vapor-runtime.ts",
    "check:story-testbed": "vp exec node scripts/story-testbed.ts check --format json",
    "check": "pnpm lint:sfc && pnpm check:static && pnpm check:story-testbed && pnpm check:vapor-runtime",
    "check:fix": "vp check --fix src scripts vite.config.ts tsconfig.typecheck.json",
    "build:registry": "vp exec node scripts/build-source-registry.ts",
    "check:examples": "vp exec node scripts/generate-gallery.ts --check",
    "check:size": "node scripts/check-size.mjs",
    "docs:reference": "vp exec node scripts/generate-reference-docs.ts",
    "generate:resolver": "vp exec node scripts/generate-resolver-manifest.ts",
    "check:tree-shaking": "node scripts/check-tree-shaking.mjs",
    "fmt": "vp fmt --write src scripts vite.config.ts"
  },
