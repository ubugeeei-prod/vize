{
  "name": "@vizejs/fresco",
  "version": "0.751.0",
  "description": "Vue TUI framework - Build terminal UIs with Vue.js",
  "keywords": [
    "cli",
    "fresco",
    "ink",
    "terminal",
    "tui",
    "vize",
    "vue"
  ],
  "homepage": "https://github.com/ubugeeei-prod/vize",
  "bugs": {
    "url": "https://github.com/ubugeeei-prod/vize/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei-prod/vize",
    "directory": "npm/fresco"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./components": {
      "import": "./dist/components/index.mjs",
      "types": "./dist/components/index.d.mts"
    },
    "./ascii-font": {
      "import": "./dist/ascii-font/index.mjs",
      "types": "./dist/ascii-font/index.d.mts"
    },
    "./composables": {
      "import": "./dist/composables/index.mjs",
      "types": "./dist/composables/index.d.mts"
    },
    "./testing": {
      "import": "./dist/testing/index.mjs",
      "types": "./dist/testing/index.d.mts"
    },
    "./qr-code": {
      "import": "./dist/qr-code/index.mjs",
      "types": "./dist/qr-code/index.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check src vite.config.ts && vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.examples.json && vue-tsc --noEmit -p tsconfig.external-plugin.json",
    "check:fix": "vp check --fix src vite.config.ts",
    "check:types": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.examples.json",
    "fmt": "vp fmt --write src vite.config.ts",
    "test": "vp test run"
  },
  "dependencies": {
    "@vizejs/fresco-native": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:typescript",
    "@vitejs/plugin-vue": "catalog:vite-stack",
    "@vue/compiler-sfc": "catalog:vue-stable",
    "happy-dom": "catalog:testing",
    "tsx": "catalog:typescript",
    "typescript": "catalog:typescript",
    "vite-plus": "catalog:vite-stack",
    "vitest": "catalog:vite-stack",
    "vue": "catalog:vue-stable",
    "vue-tsc": "catalog:typescript"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "metadata": {
    "vize": {
      "stability": "incubating",
      "stabilityDocs": "https://github.com/ubugeeei-prod/vize/blob/main/docs/content/stability.md#package-support-tiers"
    }
  }
}
