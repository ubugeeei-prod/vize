{
  "name": "oxlint-plugin-vize",
  "version": "0.474.0",
  "description": "Oxlint JS plugin bridge for Vize Patina",
  "keywords": [
    "lint",
    "oxlint",
    "plugin",
    "vize",
    "vue"
  ],
  "homepage": "https://github.com/ubugeeei-prod/vize",
  "bugs": {
    "url": "https://github.com/ubugeeei-prod/vize/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei-prod/vize",
    "directory": "npm/linter/oxlint"
  },
  "bin": {
    "oxlint-vize": "bin/oxlint-vize"
  },
  "files": [
    "bin",
    "dist",
    "scripts/package-tasks.cjs"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./eslint": {
      "import": "./dist/eslint.mjs",
      "types": "./dist/eslint.d.mts"
    },
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "node ./scripts/package-tasks.cjs test",
    "check": "vp check src vite.config.ts",
    "check:fix": "vp check --fix src vite.config.ts",
    "fmt": "vp fmt --write src vite.config.ts"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:linting"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:nuxt-eslint-oracle",
    "@nuxt/eslint-config": "catalog:nuxt-eslint-oracle",
    "@tsdown/css": "catalog:content",
    "@types/node": "catalog:typescript",
    "@typescript-eslint/parser": "8.72.1",
    "@vizejs/native": "workspace:*",
    "ajv": "catalog:repo-tooling",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "oxlint": "catalog:linting",
    "tsdown": "catalog:vite-stack",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite-stack",
    "vite-plus": "catalog:vite-stack",
    "vue-eslint-parser": "10.4.2"
  },
  "optionalDependencies": {
    "@vizejs/native-darwin-arm64": "catalog:native-binaries",
    "@vizejs/native-darwin-x64": "catalog:native-binaries",
    "@vizejs/native-linux-arm64-gnu": "catalog:native-binaries",
    "@vizejs/native-linux-arm64-musl": "catalog:native-binaries",
    "@vizejs/native-linux-x64-gnu": "catalog:native-binaries",
    "@vizejs/native-linux-x64-musl": "catalog:native-binaries",
    "@vizejs/native-win32-arm64-msvc": "catalog:native-binaries",
    "@vizejs/native-win32-x64-msvc": "catalog:native-binaries"
  },
  "engines": {
    "node": "^22 || >= 24"
  },
  "metadata": {
    "vize": {
      "stability": "experimental",
      "stabilityDocs": "https://github.com/ubugeeei-prod/vize/blob/main/docs/content/stability.md#package-support-tiers",
      "channel": "v1-alpha"
    }
  }
}
