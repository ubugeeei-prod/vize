#!@@NODE@@
const fs = require("node:fs"),
  root = process.env.VIZE_REFERENCE_CONTROL,
  args = process.argv.slice(2);
fs.appendFileSync(root + "/commands.jsonl", JSON.stringify({ pid: process.pid, args }) + "\n");
if (args[0] === "cat-file") {
  process.stdout.write("whole exists stdout");
  process.stderr.write("whole exists stderr");
  if (process.env.VIZE_REFERENCE_MODE === "cancel") {
    fs.writeFileSync(root + "/ready", String(process.pid));
    setInterval(() => {}, 1000);
  } else process.exitCode = 128;
} else if (args[0] === "fetch") process.exitCode = 0;
else {
  process.stdout.write("refuse invalid tree authority");
  process.exitCode = 0;
}
