{
  "name": "vize-workspace",
  "private": true,
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "bench:levels": "cargo bench -p level_harness"
  },
  "devDependencies": {
    "@types/node": "catalog:typescript",
    "oxfmt": "catalog:linting",
    "oxlint": "catalog:linting",
    "pkg-pr-new": "catalog:repo-tooling",
    "vite": "catalog:vite-stack",
    "vite-plus": "catalog:vite-stack"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "catalog:corsa-runtime",
    "@typescript/typescript-darwin-x64": "catalog:corsa-runtime",
    "@typescript/typescript-linux-arm64": "catalog:corsa-runtime",
    "@typescript/typescript-linux-x64": "catalog:corsa-runtime",
    "@typescript/typescript-win32-arm64": "catalog:corsa-runtime",
    "@typescript/typescript-win32-x64": "catalog:corsa-runtime"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.1.0"
