for (const [file, bytes] of @@EXPECTED_FILES@@)
  assert.deepEqual(fs.readFileSync(file), Buffer.from(bytes, "base64"));
fs.mkdirSync("out");
fs.writeFileSync(
  "out/Layout.json",
  JSON.stringify({
    filename: "Layout.vue",
    code: @@EXPECTED@@,
    css: null,
    errors: [],
    warnings: [],
    script_lang: "js",
    macro_artifacts: [],
