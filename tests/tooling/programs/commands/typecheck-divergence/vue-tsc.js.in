#!/usr/bin/env node
import fs from "node:fs";
if (process.argv.includes("--version")) {
  console.log("3.3.4");
  process.exit(0);
}
const invocationPath = @@INVOCATION_PATH@@;
if (invocationPath !== null)
  fs.writeFileSync(
    invocationPath,
    JSON.stringify({ cwd: process.cwd(), args: process.argv.slice(2) }),
  );
if (process.argv.includes("--noCheck")) {
  process.stdout.write(@@PRE_SEMANTIC_OUTPUT@@);
  process.exit(@@PRE_SEMANTIC_EXIT_CODE@@);
}
@@RUN@@
