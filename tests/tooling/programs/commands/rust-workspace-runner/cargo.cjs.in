#!@@NODE@@
const fs = require('node:fs'); const args = process.argv.slice(2); if (args.join(' ') === 'nextest --version') { console.log('cargo-nextest @@VERSION@@'); } else if (args.join(' ') === '-Vv') { console.log('cargo 1.99.1 (fixture)'); } else { fs.appendFileSync(process.env.CALLS, JSON.stringify(args)+'\n'); if (args.includes(process.env.FAIL)) process.exit(37); if (args.includes('list')) console.log(JSON.stringify({'rust-suites':{fixture:{'binary-id':'fixture',status:'listed','package-name':'fixture','binary-name':'fixture',testcases:{case:{ignored:false,'filter-match':{status:'matches'}}}}}})); }
