#!@@NODE@@
const fs = require("node:fs");
const { pathToFileURL } = require("node:url");
const mode = @@BEHAVIOR@@;
const filename = process.argv[4];
const legacy = filename === "vize.config.json";
const output = @@CONFIG_PROBE_OUTPUT@@;
(async () => {
  if (mode === "changed-binary") fs.appendFileSync(__filename, "\n");
  if (
    legacy &&
    mode !== "old" &&
    mode !== "both" &&
    mode !== "wrong-legacy" &&
    mode !== "changed-binary"
  ) {
    if (mode === "extra-stdout") process.stdout.write("unexpected\n");
    if (mode === "modified-input") fs.writeFileSync("Probe.vue", output);
    process.stderr.write(
      mode === "unknown"
        ? "permission denied\n"
        : mode === "partial-retirement"
          ? "prefix " + @@RETIRED_FORMATTER_ERROR@@
          : @@RETIRED_FORMATTER_ERROR@@,
    );
    process.exitCode = 2;
    return;
  }
  let policy;
  if (legacy) policy = JSON.parse(fs.readFileSync(filename, "utf8"));
  else
    policy = (await import(pathToFileURL(require("node:path").resolve(filename)).href)).default.vue;
  const supports = legacy || (mode !== "old" && mode !== "ignored-canonical");
  if (mode === "wrong-legacy" && legacy) fs.writeFileSync("Probe.vue", "wrong\n");
  else
    fs.writeFileSync(
      "Probe.vue",
      supports && policy.formatter.tabWidth === 3
        ? output
        : "<template>\n  <p>hello</p>\n</template>\n",
    );
})().catch((error) => {
  process.stderr.write(String(error));
  process.exitCode = 2;
});
