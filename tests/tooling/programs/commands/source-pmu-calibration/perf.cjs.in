#!@@NODE@@
const fs = require("node:fs"),
  a = process.argv.slice(2);
if (a[0] === "--version") {
  console.log("fixture-perf 1");
  process.exit(0);
}
const sep = a.indexOf("--"),
  mode = a[sep + 2],
  iterations = Number(a[sep + 3]),
  bytes = Number(a[sep + 4]);
const signals = {
  baseline: [100, 100, 10, 1],
  instructions: [100000000, 400000000, 2000000, 200],
  branches: [50000000, 100000000, 10000000, 300000],
};
const values = signals[mode] ?? [7, 7, 7, 7];
const events = a[a.indexOf("-e") + 1].split(",");
const setup = mode.startsWith("cache-setup"),
  large = mode.endsWith("large");
const refs =
  (large ? 5000 : 50) +
  (!setup && !process.env.PMU_FIXTURE_CACHE_SETUP_ONLY ? (large ? 10000 : 100) : 0);
const misses =
  (large ? 100 : 1) +
  (!setup && !process.env.PMU_FIXTURE_CACHE_SETUP_ONLY ? (large ? 1000 : 2) : 0);
const count = (e) =>
  e === "instructions"
    ? values[0]
    : e === "cycles"
      ? process.env.PMU_FIXTURE_ZERO_CYCLES
        ? "0"
        : values[1]
      : e === "branches"
        ? values[2]
        : e === "branch-misses"
          ? values[3]
          : e === "cache-references"
            ? refs
            : e === "cache-misses"
              ? misses
              : 123;
fs.writeFileSync(
  a[a.indexOf("--output") + 1],
  events.map((e) => count(e) + ",," + e + ",100,100.00").join("\n"),
);
console.log(
  JSON.stringify({
    schema: "vize-pmu-calibration",
    mode,
    iterations,
    bytes,
    checksum: "1234567890abcdef",
    dependentLoads: mode.startsWith("cache-") ? (setup ? 0 : iterations) : null,
    completed: !process.env.PMU_FIXTURE_BAD_WORKLOAD,
  }),
);
