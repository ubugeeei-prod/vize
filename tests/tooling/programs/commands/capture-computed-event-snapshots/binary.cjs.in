#!@@NODE@@
const fs = require("node:fs");
if (process.argv.includes("--list")) {
  console.log(@@COMPUTED_EVENT_FILTER_TEST@@);
} else {
  const assert = require("node:assert/strict");
  assert.deepEqual(process.argv.slice(2), @@NOCAPTURE@@);
  assert.equal(process.env.INSTA_UPDATE, "new");
  assert.equal(process.env.INSTA_FORCE_PASS, "1");
  fs.writeFileSync(@@PENDING@@, @@FRESH_OBSERVED_BODY_N@@);
  console.log("test result: ok. 1 passed; 0 failed; 0 ignored;");
}
