const fs = require("node:fs");
const path = require("node:path");
const args = process.argv.slice(2);
fs.appendFileSync(process.env.CARGO_LOG, args.join(" ") + "\n");
const [command] = args;
@@CHECK_MANIFEST@@
if (command === "publish")
  fs.appendFileSync(
    path.join(process.cwd(), "Cargo.lock"),
    "\n# fake cargo publish lock mutation\n",
  );
if (command === "publish" && args.includes("--dry-run") && process.env.TEST_FAIL_PUBLISH_DRY_RUN)
  process.exit(1);
const unresolved = (process.env.TEST_UNRESOLVED_CRATES || "").split(",");
if (command === "info" && unresolved.includes(args.at(-1).split("@")[0])) {
  console.error("not in registry index");
  process.exit(1);
}
if (command === "package" || command === "publish" || command === "info") process.exit(0);
process.exit(1);
