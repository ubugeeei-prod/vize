const { fakeDist } = require(@@ARCHIVE_MODULE@@);
const fs = require("node:fs");
const path = require("node:path");
const { spawnSync } = require("node:child_process");
const url = process.argv.at(-1);
const probe = Number(
  new URL(url).searchParams.get("vize-publish-check").replace("staged-order-1-", ""),
);
const role = url.includes("/1.2.3?") ? "version" : "metadata";
const first = @@FIRST@@;
const marker = path.join(process.env.STAGED_ORDER_ROOT, probe + "-" + first);
if (probe > 0 && role !== first && !fs.existsSync(marker)) {
  await new Promise((resolve, reject) => {
    const watcher = fs.watch(process.env.STAGED_ORDER_ROOT, () => {
      if (fs.existsSync(marker)) done();
