      watcher.close();
      reject(Error("registry peer did not finish"));
    }, 10000);
    function done() {
      watcher.close();
      clearTimeout(timer);
      resolve();
    }
    if (fs.existsSync(marker)) done();
  });
}
const result = spawnSync(process.execPath, [@@ORIGINAL@@, ...process.argv.slice(2)], {
  encoding: "utf8",
});
process.stdout.write(result.stdout ?? "");
process.stderr.write(result.stderr ?? "");
if (probe > 0 && role === first) fs.writeFileSync(marker, "complete");
process.exitCode = result.status ?? 1;
