  if (process.env.NAMESPACE === "exists") {
    console.error("  Namespace ubugeeei ALREADY Exists  ");
    process.exit(1);
  }
  console.log(" out ");
  console.error("denied\n");
  process.exit(3);
}
process.exit(4);
