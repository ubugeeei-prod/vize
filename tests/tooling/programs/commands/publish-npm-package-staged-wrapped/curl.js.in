  process.env.WRAP_HIDDEN !== "1" &&
  (state.published || (state.publishCalls === 1 && (!exact || state.versionChecks >= 3)));
if (!visible) {
  process.stdout.write("{}VIZE_HTTP_STATUS:404");
  process.exit(0);
}
const name = "@vizejs/native-darwin-arm64";
const tag = process.env.WRAP_WRONG_TAG === "1" ? "0.434.0" : "0.433.0";
