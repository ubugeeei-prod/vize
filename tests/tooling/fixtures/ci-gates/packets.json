[
  {
    "name": "all-needed-success",
    "mode": "needs",
    "needs": { "fmt-rust": { "result": "success" }, "check-js": { "result": "success" } },
    "expected": {
      "result": {
        "exitCode": 0,
        "message": "test-report gate: all 2 needed jobs are accounted for. 2 succeeded; 0 skipped on a pull request by design."
      }
    }
  },
  {
    "name": "whole-sorted-red-packet",
    "mode": "needs",
    "needs": {
      "z-cancelled": { "result": "cancelled" },
      "b-success": { "result": "success" },
      "a-failure": { "result": "failure" }
    },
    "expected": {
      "result": {
        "exitCode": 1,
        "message": "test-report gate: 2 of 3 needed jobs did not succeed.\n  - a-failure: failure\n  - z-cancelled: cancelled\ntest-report is a required status check, so it must not pass while a job it aggregates is red.\nOnly these jobs may skip on a pull request: ."
      }
    }
  },
  {
    "name": "needed-skipped-is-red",
    "mode": "needs",
    "needs": { "check-js": { "result": "skipped" } },
    "expected": {
      "result": {
        "exitCode": 1,
        "message": "test-report gate: 1 of 1 needed jobs did not succeed.\n  - check-js: skipped\ntest-report is a required status check, so it must not pass while a job it aggregates is red.\nOnly these jobs may skip on a pull request: ."
      }
    }
  },
  {
    "name": "declared-skip-exact",
    "mode": "needs",
    "needs": { "wit-contracts": { "result": "skipped" } },
    "skippable": { "wit-contracts": "queue-only" },
    "expected": {
      "result": {
        "exitCode": 0,
        "message": "test-report gate: all 1 needed jobs are accounted for. 0 succeeded; 1 skipped on a pull request by design: wit-contracts."
      }
    }
  },
  {
    "name": "null-needs",
    "mode": "needs",
    "needs": null,
    "expected": {
      "error": { "name": "Error", "message": "The needs context must be an object of job results" }
    }
  },
  {
    "name": "array-needs",
    "mode": "needs",
    "needs": [],
    "expected": {
      "error": { "name": "Error", "message": "The needs context must be an object of job results" }
    }
  },
  {
    "name": "empty-needs",
    "mode": "needs",
    "needs": {},
    "expected": {
      "error": {
        "name": "Error",
        "message": "The needs context is empty: test-report must depend on the jobs it gates"
      }
    }
  },
  {
    "name": "missing-job-result",
    "mode": "needs",
    "needs": { "check-js": {} },
    "expected": {
      "error": {
        "name": "Error",
        "message": "Job check-js reported no result in the needs context"
      }
    }
  },
  {
    "name": "null-job-result",
    "mode": "needs",
    "needs": { "check-js": null },
    "expected": {
      "error": {
        "name": "Error",
        "message": "Job check-js reported no result in the needs context"
      }
    }
  },
  {
    "name": "empty-job-result",
    "mode": "needs",
    "needs": { "check-js": { "result": "" } },
    "expected": {
      "error": {
        "name": "Error",
        "message": "Job check-js reported no result in the needs context"
      }
    }
  },
  {
