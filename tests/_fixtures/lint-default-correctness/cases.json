      "id": "sync",
      "filename": "sync.vue",
      "kind": "vue",
      "source": "<template><Widget :title.sync=\"title\" /></template>\n",
      "diagnostics": [
        {
          "rule_name": "vue/no-deprecated-v-bind-sync",
          "severity": "error",
          "message": "the .sync modifier on v-bind was removed in Vue 3; use v-model:<prop> instead",
          "start": 25,
          "end": 29,
          "help": null,
          "labels": [],
          "fix": null
        }
      ],
      "lspDiagnostics": [
        {
          "range": {
            "start": {
              "line": 0,
              "character": 25
            },
            "end": {
              "line": 0,
              "character": 29
            }
          },
          "severity": 1,
          "code": "vue/no-deprecated-v-bind-sync",
          "codeDescription": {
            "href": "https://eslint.vuejs.org/rules/no-deprecated-v-bind-sync.html"
          },
          "source": "vize/lint",
          "message": "the .sync modifier on v-bind was removed in Vue 3; use v-model:<prop> instead\n\nHelp: Vue 3 removed the .sync modifier and folded its two-way binding into argumented v-model. Replace it with v-model:<prop> (e.g. :title.sync=\"title\" -> v-model:title=\"title\")."
        }
      ]
    },
