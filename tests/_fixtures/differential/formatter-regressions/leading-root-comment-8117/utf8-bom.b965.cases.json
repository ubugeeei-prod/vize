{
  "schema": "vize.formatter-regression-corpus",
  "version": 1,
  "issue": 7870,
  "native": "unsupported",
  "source": {
    "issueUrl": "https://github.com/ubugeeei-prod/vize/issues/7870",
    "reporter": "ubugeeei",
    "userId": 71201308,
    "version": "0.432.0"
  },
  "cases": [
    {
      "id": "reported-vue",
      "api": "sfc",
      "file": "Bom.vue",
      "source": "\ufeff<template>\n  <div>x</div>\n</template>\n",
      "expected": "\ufeff<template>\n  <div>x</div>\n</template>\n"
    },
    {
      "id": "reported-json",
      "api": "json",
      "file": "bom.json",
      "source": "\ufeff{\"a\":1}\n",
      "expected": "\ufeff{\n  \"a\": 1\n}\n"
    },
    {
      "id": "jsonc-comment",
      "api": "jsonc",
      "file": "comment.jsonc",
      "source": "\ufeff// encoding marker\n{\"a\":1,}\n",
      "expected": "\ufeff// encoding marker\n{\n  \"a\": 1\n}\n"
    },
    {
      "id": "vue-crlf-auto",
      "api": "sfc",
      "file": "Auto.vue",
      "eol": "auto",
      "source": "\ufeff<template>\r\n  <div>x</div>\r\n</template>\r\n",
      "expected": "\ufeff<template>\r\n  <div>x</div>\r\n</template>\r\n"
    },
    {
      "id": "json-crlf-auto",
      "api": "json",
      "file": "auto.json",
      "eol": "auto",
      "source": "\ufeff{\"a\":1}\r\n",
      "expected": "\ufeff{\r\n  \"a\": 1\r\n}\r\n"
    },
    {
      "id": "vue-explicit-crlf",
      "api": "sfc",
      "file": "Explicit.vue",
      "eol": "crlf",
      "source": "\ufeff<template>\n  <div>x</div>\n</template>\n",
      "expected": "\ufeff<template>\r\n  <div>x</div>\r\n</template>\r\n"
    },
    {
      "id": "json-explicit-crlf",
      "api": "json",
      "file": "explicit.json",
      "eol": "crlf",
      "source": "\ufeff{\"a\":1}\n",
      "expected": "\ufeff{\r\n  \"a\": 1\r\n}\r\n"
    },
    {
      "id": "vue-comment-prologue",
      "api": "sfc",
      "file": "Comment.vue",
      "source": "\ufeff<!-- document note -->\n<template>\n  <div>x</div>\n</template>\n",
      "expected": "\ufeff<!-- document note -->\n\n<template>\n  <div>x</div>\n</template>\n"
    },
    {
      "id": "json-authored-scalar-bom",
      "api": "json",
      "file": "scalar.json",
      "source": "\ufeff{\"label\":\"\ufeffx\"}\n",
      "expected": "\ufeff{\n  \"label\": \"\ufeffx\"\n}\n"
    },
    {
      "id": "plain-vue-control",
      "api": "sfc",
      "file": "Plain.vue",
      "source": "<template>\n  <div>x</div>\n</template>\n",
      "expected": "<template>\n  <div>x</div>\n</template>\n"
    },
    {
      "id": "plain-json-control",
      "api": "json",
      "file": "plain.json",
      "source": "{\"a\":1}\n",
      "expected": "{\n  \"a\": 1\n}\n"
    },
    {
      "id": "reported-typescript-control",
      "api": "script",
      "file": "bom.ts",
      "source": "\ufeffconst value = 1;\n",
      "expected": "\ufeffconst value = 1;\n"
    },
    {
      "id": "interior-json-bom-refused",
      "api": "json",
      "file": "interior.json",
      "source": " \ufeff{\"a\":1}\n",
      "outcome": "error"
    },
    {
      "id": "bom-json-malformed-refused",
      "api": "json",
      "file": "malformed.json",
      "source": "\ufeff{\"a\":}\n",
      "outcome": "error"
    }
  ]
}
