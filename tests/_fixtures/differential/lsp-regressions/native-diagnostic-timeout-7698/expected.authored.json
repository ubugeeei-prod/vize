{
  "timeout": {
    "jsonrpc": "2.0",
    "method": "textDocument/publishDiagnostics",
    "params": {
      "uri": "file:///public-native-diagnostic-timeout/App.vue",
      "version": 7,
      "diagnostics": [
        {
          "range": {
            "start": { "line": 0, "character": 0 },
            "end": { "line": 0, "character": 0 }
          },
          "severity": 2,
          "code": "typecheck-timed-out",
          "source": "vize/types",
          "message": "Type checking timed out for this file: the Corsa runtime did not answer within the request timeout, so type errors are missing from these diagnostics."
        }
      ]
    }
  },
  "completedClean": [],
  "completedNative": [
    {
      "range": {
        "start": { "line": 1, "character": 6 },
        "end": { "line": 1, "character": 11 }
      },
      "severity": 1,
      "code": 2322,
      "source": "vize/types",
      "message": "Type 'number' is not assignable to type 'string'."
    }
  ]
}
