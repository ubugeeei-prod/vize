{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": [],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue"]
}
