{
  "plugins": ["vue"],
  "jsPlugins": [{ "name": "vize", "specifier": "oxlint-plugin-vize" }],
  "settings": { "vize": { "preset": "incremental" } },
  "ignorePatterns": ["../**/dist"],
  "overrides": [
    { "files": ["../**/*.vue"], "rules": { "vize/vue/no-inline-style": "warn" } },
    { "files": ["../app/pages/**/*.vue"], "rules": { "vize/vue/no-inline-style": "off" } }
  ]
}
