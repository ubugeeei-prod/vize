{
  "linter": {
    "preset": "incremental",
    "rules": {
      "ecosystem/vue-router-unknown-route": "error"
    }
  },
  "entries": [
    {
      "files": [
        "src/matching/*.vue"
      ],
      "ignores": [
        "src/matching/Ignored.vue"
      ],
      "linter": {
        "rules": {
          "cross-file": "warn"
        }
      }
    },
    {
      "files": [
        "src/matching/First.vue"
      ],
      "linter": {
        "rules": {
          "ecosystem/vue-router-unknown-route": "off"
        }
      }
    },
    {
      "files": [
        "src/matching/First.vue"
      ],
      "linter": {
        "rules": {
          "ecosystem/vue-router-unknown-route": "error"
        }
      }
    }
  ]
}
