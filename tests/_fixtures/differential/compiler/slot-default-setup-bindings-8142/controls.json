{
  "schema": 1,
  "scope": "Only inline LiteralConst/SetupConst reads change; all authored parameter outputs fixed before product implementation or execution",
  "controlCount": 24,
  "cases": [
    {
      "id": "literal-const",
      "source": "{ item = fallback }",
      "bindings": {
        "fallback": "literal-const"
      },
      "inline": true,
      "expectedWholeParameters": "{ item = fallback }",
      "law": "positive inline immutable read"
    },
    {
      "id": "setup-const-call",
      "source": "{ item = makeValue(seed) }",
      "bindings": {
        "makeValue": "setup-const",
        "seed": "literal-const"
      },
      "inline": true,
      "expectedWholeParameters": "{ item = makeValue(seed) }",
      "law": "positive inline immutable read"
    },
    {
      "id": "mixed-shorthand",
      "source": "{ item = { fallback, missing } }",
      "bindings": {
        "fallback": "literal-const"
      },
      "inline": true,
      "expectedWholeParameters": "{ item = { fallback, missing: _ctx.missing } }",
      "law": "positive inline immutable read"
    },
    {
      "id": "nested-pattern",
      "source": "{ nested: { item = fallback } }",
      "bindings": {
        "fallback": "literal-const"
      },
      "inline": true,
      "expectedWholeParameters": "{ nested: { item = fallback } }",
      "law": "positive inline immutable read"
    },
