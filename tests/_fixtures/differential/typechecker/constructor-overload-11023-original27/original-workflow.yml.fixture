name: Debug Vue slot framework oracle
on:
  workflow_dispatch:
    inputs:
      source_sha:
        required: true
        type: string
      role:
        required: true
        type: choice
        options: [slot-framework-triage]
permissions: { contents: read }
jobs:
  framework:
    if: github.ref == 'refs/heads/debug/canon-slot-framework-11013' && inputs.role == 'slot-framework-triage'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      SOURCE_BASE: ${{ inputs.source_sha }}
      GOMAXPROCS: "2"
      RAYON_NUM_THREADS: "2"
      NODE_DISABLE_COMPILE_CACHE: "1"
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with: { fetch-depth: 2, persist-credentials: false }
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          ref: 190257dbe52a7d4942be4496403a55b32c24426f
          path: .slot-driver
          persist-credentials: false
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            /package.json
            /tools/benchmarks/scripts/canon-slot-constructor-cases.ts
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with: { node-version: "24.14.0", package-manager-cache: false }
      - name: Install one public framework provider without a Rust build
        run: |
          set -euo pipefail
          [[ "$SOURCE_BASE" == b6127a994f7e2a75eb2c89de44d54cf8a0f17fcd ]]
          [[ "$(git rev-parse HEAD^1)" == "$SOURCE_BASE" ]]
          mkdir "$RUNNER_TEMP/slot-framework-provider"
          cd "$RUNNER_TEMP/slot-framework-provider"
          node --input-type=module -e 'import fs from "node:fs";fs.writeFileSync("package.json",JSON.stringify({private:true,type:"module",dependencies:{vize:"0.602.0","@vizejs/native":"0.602.0",vue:"3.5.42",typescript:"6.0.3","typescript-native":"npm:typescript@7.1.0-beta","vue-tsc":"3.3.13"},overrides:{"@vue/compiler-dom":"3.5.42","@vue/compiler-core":"3.5.42","@vue/compiler-sfc":"3.5.42","@vue/shared":"3.5.42"}}));'
          npm install --ignore-scripts --no-audit --no-fund
      - name: Compare the official framework oracle with public CLI and mapper
        run: |
          set -euo pipefail
          node tools/benchmarks/scripts/canon-slot-framework-oracle.ts "$RUNNER_TEMP/slot-framework-provider" "$GITHUB_WORKSPACE/.slot-driver" "$RUNNER_TEMP/slot-framework"
      - name: Preserve the exact provider lock and raw evidence
        if: always()
        run: |
          set -euo pipefail
          if [[ -d "$RUNNER_TEMP/slot-framework" ]]; then
            cp "$RUNNER_TEMP/slot-framework-provider/package.json" "$RUNNER_TEMP/slot-framework-provider/package-lock.json" "$RUNNER_TEMP/slot-framework/"
            cd "$RUNNER_TEMP"
            tar --exclude=project --exclude=node_modules -czf slot-framework-raw.tgz slot-framework
          fi
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        if: always()
        with:
          name: slot-framework-summary-${{ github.sha }}
          path: |
            ${{ runner.temp }}/slot-framework/summary.json
            ${{ runner.temp }}/slot-framework/missing-invalid-probes.json
          retention-days: 14
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        if: always()
        with:
          name: slot-framework-raw-${{ github.sha }}
          path: ${{ runner.temp }}/slot-framework-raw.tgz
          retention-days: 14
