{
  "authority": "Preserve the exact existing Vize generated-root and codegen-declaration policy; stock TypeScript selection is separately unqualified.",
  "files": {
    "src/ordinary.ts": "export const sourceValue: number = 1;\n",
    "src/types/codegen/generated.d.ts": "declare const sourceGenerated: number;\n",
    "target/ordinary.ts": "export const targetValue: number = 2;\n",
    "target/types/plain.d.ts": "declare const targetPlain: number;\n",
    "target/types/codegen/generated.d.ts": "declare const targetGenerated: number;\n"
  },
  "cases": {
    "ordinary-root": {
      "relativeRoot": ".",
      "includes": ["src/**/*", "target/**/*"],
      "expected": ["src/ordinary.ts"]
    },
    "generated-root": {
      "relativeRoot": "target",
      "includes": ["**/*"],
      "expected": ["ordinary.ts", "types/plain.d.ts"]
    },
    "codegen-root": {
      "relativeRoot": "target/types/codegen",
      "includes": ["**/*"],
      "expected": []
    }
  }
}
