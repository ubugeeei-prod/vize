{
    "compilerOptions": {
        "strict": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "rootDir": "./src/first",
        "allowJs": true,
        "declaration": true,
        "declarationMap": false,
        "declarationDir": "./types-first",
        "outDir": "./dist-first",
        "noEmit": true,
        "noUnusedParameters": true
    },
    "files": [
        "./src/first/first.ts"
    ],
    "include": [
        "configs/../src/first/**/*"
    ],
    "exclude": [
        "configs/../src/first/skip.ts"
    ]
}
