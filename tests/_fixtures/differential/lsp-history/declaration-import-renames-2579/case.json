{
  "version": 1,
  "commit": "9fa08e49a5e1b11f9936c6d0965554aa1e6b1a22",
  "id": "lsp/fix-history/declaration-import-renames-2579",
  "requirement": "Renaming a .d.ts declaration rewrites extensionless importers to the new name without a declaration suffix.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": false,
    "fileRename": true
  },
  "recordInitialize": true,
  "capabilities": {
    "textDocument": {
      "completion": {
        "completionItem": {
          "documentationFormat": [
            "markdown",
            "plaintext"
          ]
        }
      }
    },
    "workspace": {
      "workspaceEdit": {
        "documentChanges": true,
        "resourceOperations": [
          "create",
          "rename",
          "delete"
        ]
      }
    }
  },
  "files": {
    "src/types/schema.d.mts": "export interface Schema { value: string }\n",
    "src/types/legacy.d.cts": "export interface Legacy { b: 1 }\n",
    "src/types/plain.d.ts": "export interface C { c: 1 }\n",
    "src/entry.ts": "import type { Schema } from \"./types/schema\";\ntype Lazy = import(\"./types/schema\").Schema;\nimport type { Legacy } from \"./types/legacy\";\nimport type { C } from \"./types/plain\";\n",
    "src/App.vue": "<script setup lang=\"ts\">\nimport type { Schema } from './types/schema'\n</script>\n"
  },
  "steps": [
    {
      "open": "src/App.vue"
    },
    {
      "request": "workspace/willRenameFiles",
      "params": {
        "files": [
          {
            "oldUri": "${workspace}/src/types/plain.d.ts",
            "newUri": "${workspace}/src/types/basic.d.ts"
          }
        ]
      }
    }
  ]
}
