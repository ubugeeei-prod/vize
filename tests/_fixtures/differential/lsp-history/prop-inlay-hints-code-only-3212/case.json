  },
  "files": {
    "App.vue": "<script setup lang=\"ts\">\nconst props = defineProps<{ size: number; label: string }>()\nconst { size } = props\n</script>\n<template><p :title=\"'size ' + size\">{{ size }} size `size ${size}` <!-- size --></p></template>\n"
  },
  "steps": [
    {
      "open": "App.vue"
    },
    {
      "request": "textDocument/inlayHint",
      "uri": "App.vue",
      "params": {
        "range": {
          "start": {
            "line": 0,
            "character": 0
          },
          "end": {
            "line": 5,
            "character": 0
          }
        }
      }
    }
  ]
