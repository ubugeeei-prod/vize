  "id": "lsp/fix-history/sfc-compile-diagnostics-675",
  "requirement": "A props-destructure default that conflicts with the declared prop type publishes the vize/sfc-compile diagnostic with lint and typecheck off; a matching default stays clean.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": false
  },
  "files": {
    "Bad.vue": "<script setup lang=\"ts\">\nconst { msg = 0 } = defineProps<{ msg?: string }>();\n</script>\n<template>\n  <div>{{ msg }}</div>\n</template>\n",
    "Good.vue": "<script setup lang=\"ts\">\nconst { msg = 'x' } = defineProps<{ msg?: string }>();\n</script>\n<template>\n  <div>{{ msg }}</div>\n</template>\n"
  },
  "steps": [
    {
      "open": "Bad.vue"
    },
    {
      "diagnostics": "Bad.vue"
    },
    {
      "open": "Good.vue"
    },
    {
      "diagnostics": "Good.vue"
    }
  ]
