{
  "version": 1,
  "commit": "6a4cf395a53eddd68b2f817f71d4726035ac3789",
  "id": "lsp/fix-history/file-rename-aliased-imports-3919",
  "requirement": "Moving a directory re-spells paths-aliased importer specifiers while subtree-relative imports stay untouched.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": false,
    "fileRename": true
  },
  "capabilities": {
    "textDocument": {
      "completion": {
        "completionItem": {
          "documentationFormat": [
            "markdown",
            "plaintext"
          ]
        }
      }
    },
    "workspace": {
      "workspaceEdit": {
        "documentChanges": true,
        "resourceOperations": [
          "create",
          "rename",
          "delete"
        ]
      }
    }
  },
  "files": {
    "tsconfig.json": "{ \"compilerOptions\": { \"baseUrl\": \".\", \"paths\": { \"@/*\": [\"src/*\"] } }, \"include\": [\"src/**/*\"] }\n",
    "src/widgets/Card.vue": "<script setup lang=\"ts\">\nimport { tone } from './tone'\n</script>\n<template><div /></template>\n",
    "src/widgets/tone.ts": "export const tone = 1\n",
    "src/App.vue": "<script setup lang=\"ts\">\nimport Card from '@/widgets/Card.vue'\nimport { tone } from '@/widgets/tone'\n</script>\n<template><Card /></template>\n"
  },
  "steps": [
    {
      "open": "src/App.vue"
    },
    {
      "request": "workspace/willRenameFiles",
      "params": {
        "files": [
          {
            "oldUri": "${workspace}/src/widgets",
            "newUri": "${workspace}/src/ui"
          }
        ]
      }
    },
    {
      "request": "workspace/willRenameFiles",
      "params": {
        "files": [
          {
            "oldUri": "${workspace}/src/widgets/Card.vue",
            "newUri": "${workspace}/src/cards/Card.vue"
          }
        ]
      }
    }
  ]
}
