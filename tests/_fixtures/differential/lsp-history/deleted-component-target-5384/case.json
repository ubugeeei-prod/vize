{
  "version": 1,
  "commit": "c200b692c480607e7555cddf3966bd0705746f7a",
  "id": "lsp/fix-history/deleted-component-target-5384",
  "requirement": "After the imported component file is deleted, its definition disappears immediately unless an open unsaved buffer keeps it alive.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": false
  },
  "files": {
    "Parent.vue": "<script setup lang=\"ts\">\nimport Child from './Child.vue'\n</script>\n<template><Child /></template>\n",
    "Child.vue": "<template><span /></template>\n"
  },
  "steps": [
    {
      "open": "Parent.vue"
    },
    {
      "request": "textDocument/definition",
      "uri": "Parent.vue",
      "at": {
        "find": "<Child",
        "delta": 2,
        "nth": 0
      }
    },
    {
      "remove": "Child.vue"
    },
    {
      "notify": "workspace/didChangeWatchedFiles",
      "params": {
        "changes": [
          {
            "uri": "${workspace}/Child.vue",
            "type": 3
          }
        ]
      }
    },
    {
      "request": "textDocument/definition",
      "uri": "Parent.vue",
      "at": {
        "find": "<Child",
        "delta": 2,
        "nth": 0
      },
      "retry": true
    },
    {
      "open": "Child.vue",
      "text": "<template><em /></template>\n"
    },
    {
      "request": "textDocument/definition",
      "uri": "Parent.vue",
      "at": {
        "find": "<Child",
        "delta": 2,
        "nth": 0
      },
      "retry": true
    }
  ]
}
