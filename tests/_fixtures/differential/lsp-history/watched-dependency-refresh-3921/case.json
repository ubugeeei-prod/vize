{
  "version": 1,
  "commit": "014a2912fa3a631343b28f8fb6dfc739cf6385b2",
  "id": "lsp/fix-history/watched-dependency-refresh-3921",
  "requirement": "Any watched dependency change (not only global component declarations) refreshes the open importer's diagnostics.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": true
  },
  "files": {
    "tsconfig.json": "{ \"compilerOptions\": { \"strict\": true, \"module\": \"ESNext\", \"moduleResolution\": \"bundler\", \"target\": \"ESNext\", \"noEmit\": true, \"jsx\": \"preserve\", \"lib\": [\"ESNext\", \"DOM\"] }, \"include\": [\"**/*.vue\", \"**/*.ts\", \"**/*.tsx\"] }\n",
    "helpers.ts": "export const limit: number = 1\n",
    "App.vue": "<script setup lang=\"ts\">\nimport { limit } from './helpers'\nconst n: number = limit\n</script>\n"
  },
  "steps": [
    {
      "open": "App.vue"
    },
    {
      "diagnostics": "App.vue"
    },
    {
      "write": "helpers.ts",
      "text": "export const limit: string = 'x'\n"
    },
    {
      "notify": "workspace/didChangeWatchedFiles",
      "params": {
        "changes": [
          {
            "uri": "${workspace}/helpers.ts",
            "type": 2
          }
        ]
      }
    },
    {
      "diagnostics": "App.vue",
      "version": null
    }
  ]
}
