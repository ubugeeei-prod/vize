{
  "version": 1,
  "commit": "6ae3d84c5e861e145298ab3885ff24400c7054d0",
  "id": "lsp/fix-history/module-declaration-renames-2580",
  "requirement": "Renaming .d.mts/.d.cts declarations rewrites extensionless importers (static and import() types) without introducing declaration suffixes; registration covers the declaration extensions.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": false,
    "fileRename": true
  },
  "recordInitialize": true,
  "capabilities": {
    "textDocument": {
      "completion": {
        "completionItem": {
          "documentationFormat": [
            "markdown",
            "plaintext"
          ]
        }
      }
    },
    "workspace": {
      "workspaceEdit": {
        "documentChanges": true,
        "resourceOperations": [
          "create",
          "rename",
          "delete"
        ]
      }
    }
  },
  "files": {
    "src/types/schema.d.mts": "export interface Schema { value: string }\n",
    "src/types/legacy.d.cts": "export interface Legacy { b: 1 }\n",
    "src/types/plain.d.ts": "export interface C { c: 1 }\n",
    "src/entry.ts": "import type { Schema } from \"./types/schema\";\ntype Lazy = import(\"./types/schema\").Schema;\nimport type { Legacy } from \"./types/legacy\";\nimport type { C } from \"./types/plain\";\n",
    "src/App.vue": "<script setup lang=\"ts\">\nimport type { Schema } from './types/schema'\n</script>\n"
  },
  "steps": [
    {
      "open": "src/App.vue"
    },
    {
      "request": "workspace/willRenameFiles",
      "params": {
        "files": [
          {
            "oldUri": "${workspace}/src/types/schema.d.mts",
            "newUri": "${workspace}/src/types/generated-schema.d.mts"
          }
        ]
      }
    },
    {
      "request": "workspace/willRenameFiles",
      "params": {
        "files": [
          {
            "oldUri": "${workspace}/src/types/legacy.d.cts",
            "newUri": "${workspace}/src/types/old.d.cts"
          }
        ]
      }
    }
  ]
}
