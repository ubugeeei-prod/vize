{
  "version": 1,
  "commit": "1bcafef051e03f162ba08d0322f4600d4e2dd231",
  "id": "lsp/fix-history/excluded-reference-queries",
  "requirement": "References queried from a configured project do not receive Vue sources the tsconfig excludes; a query from the excluded file stays in its own inferred project.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": true
  },
  "files": {
    "tsconfig.json": "{ \"compilerOptions\": { \"strict\": true, \"module\": \"ESNext\", \"moduleResolution\": \"bundler\", \"target\": \"ESNext\", \"noEmit\": true }, \"include\": [\"src/**/*\"] }\n",
    "src/shared.ts": "export const sharedValue = 1\n",
    "src/Used.vue": "<script setup lang=\"ts\">\nimport { sharedValue } from './shared'\n</script>\n<template>{{ sharedValue }}</template>\n",
    "ignored/Stray.vue": "<script setup lang=\"ts\">\nimport { sharedValue } from '../src/shared'\nconst x = sharedValue\n</script>\n"
  },
  "steps": [
    {
      "open": "src/Used.vue"
    },
    {
      "request": "textDocument/references",
      "uri": "src/Used.vue",
      "at": {
        "find": "{ sharedValue }",
        "delta": 2,
        "nth": 0
      },
      "params": {
        "context": {
          "includeDeclaration": true
        }
      },
      "retry": true
    },
    {
      "open": "ignored/Stray.vue"
    },
    {
      "request": "textDocument/references",
      "uri": "ignored/Stray.vue",
      "at": {
        "find": "const x = sharedValue",
        "delta": 10,
        "nth": 0
      },
      "params": {
        "context": {
          "includeDeclaration": true
        }
      },
      "retry": true
    }
  ]
}
