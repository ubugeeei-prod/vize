  "id": "lsp/fix-history/closed-stderr-pipe-6321",
  "requirement": "After the editor closes the server's stderr pipe, the stdio server keeps answering requests and still shuts down cleanly on exit.",
  "files": {
    "App.vue": "<script setup lang=\"ts\">\nconst count = 1\n</script>\n<template><p>{{ count }}</p></template>\n"
  },
  "steps": [
    {
      "open": "App.vue"
    },
    {
      "closeStderr": true
    },
    {
      "request": "textDocument/hover",
      "uri": "App.vue",
      "at": {
        "find": "{{ count",
        "delta": 4
      }
    },
    {
      "request": "textDocument/foldingRange",
      "uri": "App.vue"
    }
  ]
}
