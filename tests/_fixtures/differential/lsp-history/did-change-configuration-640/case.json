  "id": "lsp/fix-history/did-change-configuration-640",
  "requirement": "workspace/didChangeConfiguration is accepted without mutating the running configuration; requests keep answering.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": false
  },
  "files": {
    "App.vue": "<script setup lang=\"ts\">\nconst count = 1\n</script>\n<template>{{ count }}</template>\n"
  },
  "steps": [
    {
      "open": "App.vue"
    },
    {
      "notify": "workspace/didChangeConfiguration",
      "params": {
        "settings": {
          "vize": {
            "languageServer": {
              "editor": false
            }
          }
        }
      }
    },
    {
      "request": "textDocument/hover",
      "uri": "App.vue",
      "at": {
        "find": "{{ count",
        "delta": 3,
        "nth": 0
      }
    }
  ]
