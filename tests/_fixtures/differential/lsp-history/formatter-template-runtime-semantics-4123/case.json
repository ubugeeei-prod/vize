    "Range.vue": "<script setup lang=\"ts\">\nconst   a=1\nconst   b=2\n</script>\n\n<template>\n  <div   class=\"x\"   >{{ a }}</div>\n</template>\n",
    "Inline.vue": "<template><span>a</span><b>b</b>text<i>c</i></template>\n"
  },
  "steps": [
