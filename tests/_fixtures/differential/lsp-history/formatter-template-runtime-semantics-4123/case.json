    {
      "request": "textDocument/rangeFormatting",
      "uri": "Range.vue",
      "params": {
        "range": {
          "start": {
            "line": 1,
            "character": 0
          },
          "end": {
            "line": 2,
            "character": 11
          }
        },
        "options": {
          "tabSize": 2,
          "insertSpaces": true
        }
      }
    },
    {
      "open": "Inline.vue"
    },
    {
      "request": "textDocument/formatting",
      "uri": "Inline.vue",
      "params": {
