{
  "version": 1,
  "commit": "d01f6b1d7384cd296eb3d87ec3750c7db1616c93",
  "id": "lsp/fix-history/package-export-conditions-longest-prefix",
  "requirement": "Dependency refresh picks the longest wildcard export prefix: changing the special declaration refreshes its importer.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": true
  },
  "files": {
    "tsconfig.json": "{ \"compilerOptions\": { \"strict\": true, \"module\": \"ESNext\", \"moduleResolution\": \"bundler\", \"target\": \"ESNext\", \"noEmit\": true, \"jsx\": \"preserve\", \"lib\": [\"ESNext\", \"DOM\"] }, \"include\": [\"**/*.vue\", \"**/*.ts\", \"**/*.tsx\"] }\n",
    "node_modules/cond/package.json": "{ \"name\": \"cond\", \"exports\": { \"./blocked\": null, \"./feature/*\": { \"types\": \"./types/feature/*.d.ts\" }, \"./feature/special/*\": { \"types\": \"./types/special/*.d.ts\" }, \".\": [{ \"types\": \"./types/index.d.ts\" }, \"./index.js\"] } }\n",
    "node_modules/cond/types/index.d.ts": "export declare const root: number\n",
    "node_modules/cond/types/feature/a.d.ts": "export declare const featureA: string\n",
    "node_modules/cond/types/special/a.d.ts": "export declare const specialA: string\n",
    "node_modules/cond/index.js": "export const root = 1\n",
    "App.vue": "<script setup lang=\"ts\">\nimport { specialA } from 'cond/feature/special/a'\nconst n: boolean = specialA\n</script>\n"
  },
  "steps": [
    {
      "open": "App.vue"
    },
    {
      "diagnostics": "App.vue"
    },
    {
      "write": "node_modules/cond/types/special/a.d.ts",
      "text": "export declare const specialA: boolean\n"
    },
    {
      "notify": "workspace/didChangeWatchedFiles",
      "params": {
        "changes": [
          {
            "uri": "${workspace}/node_modules/cond/types/special/a.d.ts",
            "type": 2
          }
        ]
      }
    },
    {
      "diagnostics": "App.vue",
      "version": null
    }
  ]
}
