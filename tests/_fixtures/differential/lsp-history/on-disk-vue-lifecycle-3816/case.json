{
  "version": 1,
  "commit": "9fceff289e3feaeb92449cebb40c291e6989a71a",
  "id": "lsp/fix-history/on-disk-vue-lifecycle-3816",
  "requirement": "Created and deleted closed Vue files join and leave workspace symbols without opening buffers. Watched-file registration includes Vue files independently of typecheck/fileRename.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": false
  },
  "files": {
    "A.vue": "<script setup lang=\"ts\">\nfunction lifecycleAlpha() {}\n</script>\n"
  },
  "steps": [
    {
      "open": "A.vue"
    },
    {
      "serverRequests": "client/registerCapability"
    },
    {
      "request": "workspace/symbol",
      "params": {
        "query": "lifecycle"
      },
      "retry": true
    },
    {
      "write": "B.vue",
      "text": "<script setup lang=\"ts\">\nfunction lifecycleBeta() {}\n</script>\n"
    },
    {
      "notify": "workspace/didChangeWatchedFiles",
      "params": {
        "changes": [
          {
            "uri": "${workspace}/B.vue",
            "type": 1
          }
        ]
      }
    },
    {
      "request": "workspace/symbol",
      "params": {
        "query": "lifecycle"
      },
      "retry": true
    },
    {
      "remove": "B.vue"
    },
    {
      "notify": "workspace/didChangeWatchedFiles",
      "params": {
        "changes": [
          {
            "uri": "${workspace}/B.vue",
            "type": 3
          }
        ]
      }
    },
    {
      "request": "workspace/symbol",
      "params": {
        "query": "lifecycle"
      },
      "retry": true
    }
  ],
  "capabilities": {
    "workspace": {
      "didChangeWatchedFiles": {
        "dynamicRegistration": true
      }
    }
  }
}
