{
  "version": 1,
  "commit": "df512303bbea4ee354dea25179b54ddf145e85b0",
  "id": "lsp/fix-history/sfc-resource-file-renames-2670",
  "requirement": "File renames rewrite SFC block src attributes, CSS @import and url() resources when a target moves or the importer moves.",
  "initializationOptions": {
    "editor": true,
    "lint": false,
    "typecheck": false,
    "fileRename": true
  },
  "capabilities": {
    "textDocument": {
      "completion": {
        "completionItem": {
          "documentationFormat": [
            "markdown",
            "plaintext"
          ]
        }
      }
    },
    "workspace": {
      "workspaceEdit": {
        "documentChanges": true,
        "resourceOperations": [
          "create",
          "rename",
          "delete"
        ]
      }
    }
  },
  "files": {
    "src/App.vue": "<template src=\"./App.html\"></template>\n<script setup lang=\"ts\" src=\"./app.ts\"></script>\n<style src=\"./app.css\"></style>\n<style>\n@import './theme.css';\n.logo { background: url('./logo.png'); }\n</style>\n",
    "src/App.html": "<p />\n",
    "src/app.ts": "export {}\n",
    "src/app.css": "p {}\n",
    "src/theme.css": "p {}\n",
    "src/logo.png": "png\n"
  },
  "steps": [
    {
      "open": "src/App.vue"
    },
    {
      "request": "workspace/willRenameFiles",
      "params": {
        "files": [
          {
            "oldUri": "${workspace}/src/app.css",
            "newUri": "${workspace}/src/styles/app.css"
          }
        ]
      }
    },
    {
      "request": "workspace/willRenameFiles",
      "params": {
        "files": [
          {
            "oldUri": "${workspace}/src/App.vue",
            "newUri": "${workspace}/src/pages/App.vue"
          }
        ]
      }
    }
  ]
}
