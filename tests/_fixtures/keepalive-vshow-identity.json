      "transition": "type",
      "source": "<KeepAlive><div v-show=\"opened\"><component :is=\"view\" /></div></KeepAlive>",
      "repair": "<KeepAlive><component :is=\"view\" v-show=\"opened\" /></KeepAlive>",
      "warning": true
    },
    {
      "id": "conditional-removal",
      "transition": "condition",
      "source": "<KeepAlive><div v-show=\"opened\"><PanelA v-if=\"visible\" /></div></KeepAlive>",
      "repair": "<KeepAlive><PanelA v-if=\"visible\" v-show=\"opened\" /></KeepAlive>",
      "warning": true
    },
    {
