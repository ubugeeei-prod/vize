{
  "schema": "vize.patina.keepalive-vshow-identity",
  "version": 1,
  "authority": "Authored templates shared verbatim by whole Patina warning packets and installed Vue compiler/runtime lifecycle controls. Vue runtime receipts do not establish Vize candidate execution. Static visibility exclusion from #5966 is intentional.",
  "listBoundary": "The repair selects one component to cache. Removing a list wrapper still leaves a Fragment and does not make KeepAlive cache arbitrary lists.",
