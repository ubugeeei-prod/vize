 \t\t\tif (props.folder && droppedFolder.id === props.folder.id) return;\n  \t\t\tmisskeyApi('drive/folders/update', {\n  \t\t\t\tfolderId: droppedFolder.id,\n  \t\t\t\tparentId: props.folder ? props.folder.id : null,\n  \t\t\t}).then(() => {\n  \t\t\t\tglobalEvents.emit('driveFoldersUpdated', [droppedFolder].map(x => ({\n  \t\t\t\t\t...x,\n  \t\t\t\t\tparentId: props.folder ? props.folder.id : null,\n  \t\t\t\t\tparent: props.folder ?? null,\n  \t\t\t\t})));\n  \t\t\t});\n  \t\t}\n  \t}\n  \t//#endregion\n  }\n  \n  // @vize-map: 1442:4295 -> 0:2910\n\n  // ========== Template Scope (inherits from setup) ==========\n  // Ref type captures (before template scope shadows them)\n  type __R_draghover = typeof draghover;\n  ;(function __template() {\n    // Auto-unwrap Vue refs in template scope\n    type __U<T> = T extends import('vue').Ref ? T['value'] : T;\n    var draghover: __U<__R_draghover> = undefined as any;\n    // Vue template context (delegates to ComponentPublicInstance)\n    type __Ctx = import('vue').ComponentPublicInstance;\n    type __Global<K extends string, F = unknown> = K extends keyof __Ctx ? __Ctx[K] : F;\n    const __ctx = undefined as unknown as __Ctx;\n    const $attrs = __ctx.$attrs;\n    const $slots = __ctx.$slots;\n    const $refs = __ctx.$refs;\n    const $emit = __ctx.$emit;\n    // CSS modules (from <style module>)\n    const $style: __Global<'$style', Record<string, string>> = undefined as any;\n    void __ctx; void $attrs; void $slots; void $refs; void $emit;\n    void $style;\n\n  // Props are available in template as variables\n  // Access via `propName` or `props.propName`\n  const props: Props = {} as Props;\n  void props; // Mark as used to avoid TS6133\n  const folder = props[\"folder\"];\n  void folder;\n  const parentFolder = props[\"parentFolder\"];\n  void parentFolder;\n\n  void ([$style.root, { [$style.draghover]: draghover }]); // VBind\n  // @vize-map: expr -> 125:173\n  if ((folder == null)) {\n    // @vize-map: expr -> 