      "virtualTs": "/// <reference lib=\"es2022\" />\n/// <reference lib=\"dom\" />\n/// <reference lib=\"dom.iterable\" />\n// ============================================\n// Virtual TypeScript for Vue SFC Type Checking\n// Generated by vize\n// ============================================\n\n// Shared preamble hoisted to the program-wide __vize_helpers.d.ts\n// ========== Module Scope (imports) ==========\nimport { ref, useTemplateRef, computed, onMounted, onBeforeUnmount, onDeactivated, onActivated } from 'vue';\nimport * as Misskey from 'misskey-js';\nimport { getScrollContainer } from '@@/js/scroll.js';\nimport XMessage from './XMessage.vue.ts';\nimport XForm from './room.form.vue.ts';\nimport XSearch from './room.search.vue.ts';\nimport XMembers from './room.members.vue.ts';\nimport XInfo from './room.info.vue.ts';\nimport type { MenuItem } from '@/types/menu.js';\nimport type { PageHeaderItem } from '@/types/page-header.js';\nimport * as os from '@/os.js';\nimport { useStream } from '@/stream.js';\nimport * as sound from '@/utility/sound.js';\nimport { i18n } from '@/i18n.js';\nimport { ensureSignin } from '@/i.js';\nimport { misskeyApi } from '@/utility/misskey-api.js';\nimport { definePage } from '@/page.js';\nimport { prefer } from '@/preferences.js';\nimport MkButton from '@/components/MkButton.vue.ts';\nimport { useRouter } from '@/router.js';\nimport { useMutationObserver } from '@/composables/use-mutation-observer.js';\nimport MkInfo from '@/components/MkInfo.vue.ts';\nimport { makeDateSeparatedTimelineComputedRef } from '@/utility/timeline-date-separate.js';\nexport type NormalizedChatMessage = Omit<Misskey.entities.ChatMessageLite, 'fromUser' | 'reactions'> & {\n\tfromUser: Misskey.entities.UserLite;\n\treactions: (Misskey.entities.ChatMessageLite['reactions'][number] & {\n\t\tuser: Misskey.entities.UserLite;\n\t})[];\n};\n// Prevent TS6133 for imports shadowed by setup-scope compiler macros\nvoid useTemplateRef;\n\n// ========== Exported Types ====