      "virtualTs": "/// <reference lib=\"es2022\" />\n/// <reference lib=\"dom\" />\n/// <reference lib=\"dom.iterable\" />\n// ============================================\n// Virtual TypeScript for Vue SFC Type Checking\n// Generated by vize\n// ============================================\n\n// Shared preamble hoisted to the program-wide __vize_helpers.d.ts\n// ========== Module Scope (imports) ==========\nimport { nextTick, onActivated, onBeforeUnmount, onMounted, ref, useTemplateRef, watch, computed, TransitionGroup, markRaw } from 'vue';\nimport * as Misskey from 'misskey-js';\nimport MkButton from './MkButton.vue.ts';\nimport type { MenuItem } from '@/types/menu.js';\nimport XNavFolder from '@/components/MkDrive.navFolder.vue.ts';\nimport XFolder from '@/components/MkDrive.folder.vue.ts';\nimport XFile from '@/components/MkDrive.file.vue.ts';\nimport * as os from '@/os.js';\nimport { misskeyApi } from '@/utility/misskey-api.js';\nimport { useStream } from '@/stream.js';\nimport { i18n } from '@/i18n.js';\nimport { claimAchievement } from '@/utility/achievements.js';\nimport { prefer } from '@/preferences.js';\nimport { chooseFileFromPcAndUpload, selectDriveFolder } from '@/utility/drive.js';\nimport { store } from '@/store.js';\nimport { makeDateGroupedTimelineComputedRef } from '@/utility/timeline-date-separate.js';\nimport { globalEvents, useGlobalEvent } from '@/events.js';\nimport { checkDragDataType, getDragData, setDragData } from '@/drag-and-drop.js';\nimport { getDriveFileMenu } from '@/utility/get-drive-file-menu.js';\nimport { Paginator } from '@/utility/paginator.js';\n// Prevent TS6133 for imports shadowed by setup-scope compiler macros\nvoid useTemplateRef;\n\n// ========== Exported Types ==========\nexport type Props = {\n\tinitialFolder?: Misskey.entities.DriveFolder | Misskey.entities.DriveFolder['id'] | null;\n\ttype?: string;\n\tmultiple?: boolean;\n\tselect?: 'file' | 'folder' | null;\n\tforceDisableInfiniteScroll?: boolean;\n};\n\n// =====