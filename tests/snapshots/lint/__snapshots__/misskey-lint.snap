  {
    "file": "src/components/MkEmojiPicker.section.vue",
    "messages": [
      {
        "ruleId": "vue/component-definition-name-casing",
        "ruleDocsPath": "docs/content/rules/vue.md",
        "severity": 1,
        "message": "[vize:vue/component-definition-name-casing] Component file name 'MkEmojiPicker.section' should be PascalCase or kebab-case",
        "line": 6,
        "column": 11,
        "endLine": 6,
        "endColumn": 11,
        "help": "Rename the file to PascalCase or kebab-case:\n  myComponent.vue  -> MyComponent.vue\n  my-Component.vue -> my-component.vue"
      },
      {
        "ruleId": "a11y/click-events-have-key-events",
        "ruleDocsPath": "docs/content/rules/accessibility.md",
        "severity": 1,
        "message": "[vize:a11y/click-events-have-key-events] Non-interactive elements with @click must also have keyboard event handlers",
        "line": 10,
        "column": 2,
        "endLine": 10,
        "endColumn": 51,
        "help": "Why: Keyboard users cannot activate click-only handlers.\nBest solution: Use semantic elements:\n  <button @click=\"handleClick\">Click me</button>\nIf you must use a div:\n  <div\n  role=\"button\"\n  tabindex=\"0\"\n  @click=\"handleClick\"\n  @keydown.enter=\"handleClick\"\n  @keydown.space=\"handleClick\"\n  >\n  Click me\n  </div>"
      },
      {
        "ruleId": "a11y/no-static-element-interactions",
        "ruleDocsPath": "docs/content/rules/accessibility.md",
        "severity": 1,
        "message": "[vize:a11y/no-static-element-interactions] <header> is a static element and should not have interactive event handlers",
        "line": 10,
        "column": 2,
        "endLine": 10,
        "endColumn": 51,
        "help": "Why: Non-interactive elements (div, span, etc.) should not have click/keyboard handlers without a role.\nFix options:\n1. Use a native interactive element:\n  <button @click=\"handle\">Click me</button>\n2. Add role and tabindex:\n  <div role=\"button\" tabindex=\"0\" @click=\"handle\">\n  Click me\n  </div>"
      },
      {
        "ruleId": "a11y/no-i-for-icon",
        "ruleDocsPath": "docs/content/rules/accessibility.md",
        "severity": 1,
        "message": "[vize:a11y/no-i-for-icon] <i> element with icon CSS class should not be used for icons. Use a semantic element instead",
        "line": 11,
        "column": 106,
        "endLine": 11,
        "endColumn": 129,
        "help": "Why: The <i> element semantically represents *italic text*, not icons. Using it for icon fonts creates accessibility issues — screen readers may announce meaningless content.\nFix: Use <span> with aria-hidden=\"true\" instead:\n  <span class=\"fas fa-home\" aria-hidden=\"true\"></span>\n  <span class=\"sr-only\">Home</span>\nOr use an SVG icon component for best accessibility."
      },
      {
        "ruleId": "vue/attribute-hyphenation",
        "ruleDocsPath": "docs/content/rules/vue.md",
        "severity": 1,
        "message": "[vize:vue/attribute-hyphenation] Attribute should be hyphenated",
