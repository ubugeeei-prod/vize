      "generated": "                                                                                                    klmno                                                                                               abcdefghijklmnopqrstuvwxy",
      "candidates": [
        {
          "generated": [200, 225],
          "original": [0, 25],
          "kind": "verbatim"
        },
        {
          "generated": [100, 105],
          "original": [10, 15],
          "kind": "verbatim"
        }
      ],
      "expected": [
        {
          "generated": [100, 105],
          "original": [10, 15],
          "kind": "verbatim"
        },
        {
          "generated": [200, 210],
          "original": [0, 10],
          "kind": "verbatim"
        },
        {
          "generated": [210, 215],
          "original": [10, 15],
          "kind": "verbatim"
        },
        {
          "generated": [215, 225],
          "original": [15, 25],
          "kind": "verbatim"
        }
      ]
    },
