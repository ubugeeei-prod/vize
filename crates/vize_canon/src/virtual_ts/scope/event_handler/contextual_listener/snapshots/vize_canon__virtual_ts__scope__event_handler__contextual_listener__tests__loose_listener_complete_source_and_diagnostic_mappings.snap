    "source": "<script setup lang=\"ts\">\ntype Component = new (...args: any[]) => { $emit: (...args: any[]) => void }\ninterface VNode { readonly __v_isVNode: true }\ndeclare const target: Component\ndeclare const node: VNode\ndeclare const loose: any\ndeclare const tag: string\nconst take = (value: unknown) => value\nconst forward = (value: string) => value\nconst forwardMany = (...values: unknown[]) => values\nfunction generic<T>(value: T): T { return value }\nfunction overloaded(value: string): string\nfunction overloaded(value: number): number\nfunction overloaded(value: string | number) { return value }\n</script>\n<template>\n<component :is=\"target\" @pick=\"(v) => take(v)\" />\n<component :is=\"node\" @pick=\"(v) => take(v)\" />\n<component :is=\"loose\" @pick=\"(v) => take(v)\" />\n<component :is=\"tag\" @pick=\"(v) => take(v)\" />\n<component :is=\"'span'\" @pick=\"(v) => take(v)\" />\n<component :is=\"target\" @pick=\"forward($event); $event.foo; forwardMany($event)\" />\n<component :is=\"node\" @pick=\"forward($event); $event.foo; forwardMany($event)\" />\n<component :is=\"loose\" @pick=\"forward($event); $event.foo; forwardMany($event)\" />\n<component :is=\"tag\" @pick=\"forward($event); $event.foo; forwardMany($event)\" />\n<component :is=\"'span'\" @pick=\"forward($event); $event.foo; forwardMany($event)\" />\n<component :is=\"loose\" @pick=\"(...values: unknown[]) => forwardMany(...values)\" />\n<component :is=\"loose\" @pick=\"generic\" />\n<component :is=\"loose\" @pick=\"overloaded\" />\n</template>\n",
