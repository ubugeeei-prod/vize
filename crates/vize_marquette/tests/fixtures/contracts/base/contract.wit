package fixture:contracts@0.1.0;

interface types {
  record span {
    start: u32,
    end: u32,
  }

  enum severity {
    error,
    warning,
  }

  variant witness {
    exempt(string),
    none,
  }
}

interface host-log {
  log: func(message: string);
}

interface lowering {
  use types.{span, severity, witness};

  record answer {
    span: span,
    severity: severity,
    witness: option<witness>,
    notes: list<string>,
  }

  lower: func(source: string, base: u32) -> answer;
}

world dialect {
  import host-log;
  export lowering;
}
