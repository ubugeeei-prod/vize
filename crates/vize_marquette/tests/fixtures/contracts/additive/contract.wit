package fixture:contracts@0.1.1;

// Purely additive over `base`: a new type, a host-provided function on an
// imported interface, a new imported interface, and a new world.

interface types {
  record span {
    start: u32,
    end: u32,
  }

  enum severity {
    error,
    warning,
  }

  variant witness {
    exempt(string),
    none,
  }

  type bytes = list<u8>;
}

interface host-log {
  log: func(message: string);
  flush: func() -> result<_, string>;
}

interface clock {
  now: func() -> u64;
}

interface lowering {
  use types.{span, severity, witness};

  record answer {
    span: span,
    severity: severity,
    witness: option<witness>,
    notes: list<string>,
  }

  lower: func(source: string, base: u32) -> answer;
}

world dialect {
  import host-log;
  import clock;
  export lowering;
}

world probe {
  export lowering;
}
