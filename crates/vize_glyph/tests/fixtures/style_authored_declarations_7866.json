      "options": {},
      "cli": false
    },
    {
      "id": "custom-value-braces",
      "api": "style",
      "input": ".a{--theme:{ color:red; nested:{ accent:blue } };opacity:.5}",
      "expected": ".a {\n  --theme: { color:red; nested:{ accent:blue } };\n  opacity: .5;\n}\n",
      "options": {},
      "cli": false
    },
    {
      "id": "custom-value-punctuation",
      "api": "style",
      "input": ".a{--data:\"x:;{}\";--list:[a:b;c];opacity:.5}",
      "expected": ".a {\n  --data: \"x:;{}\";\n  --list: [a:b;c];\n  opacity: .5;\n}\n",
      "options": {},
      "cli": false
    },
    {
      "id": "unicode-and-escaped-selector",
      "api": "style",
      "input": ".日本\\:active{color:red;opacity:.5}",
      "expected": ".日本\\:active {\n  color: red;\n  opacity: .5;\n}\n",
      "options": {},
      "cli": false
    },
    {
      "id": "nested-comment-existing-policy",
      "api": "style",
      "input": ".a{ /* (}; */ color:red; opacity:.5 }",
      "expected": ".a{ /* (}; */ color:red; opacity:.5 }",
      "options": {},
      "cli": false
    },
    {
      "id": "top-comment",
      "api": "sfc",
      "input": "<style>/* heading */\n.a{color:red;opacity:.5}</style>\n",
      "expected": "<style>\n/* heading */\n.a {\n  color: red;\n  opacity: .5;\n}\n</style>\n",
      "options": {},
      "cli": true
    },
    {
      "id": "four-space-layout",
      "api": "style",
