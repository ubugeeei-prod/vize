      "expected": ".a {\n\tcolor: red;\n\topacity: .5;\n}\n",
      "options": {
        "useTabs": true
      },
      "cli": false
    },
    {
      "id": "crlf-layout",
      "api": "style",
      "input": ".a{color:red;opacity:.5}",
      "expected": ".a {\r\n  color: red;\r\n  opacity: .5;\r\n}\r\n",
      "options": {
        "endOfLine": "crlf"
      },
      "cli": false
    },
    {
      "id": "authored-color-value",
      "api": "style",
      "input": ".a{color:#D3D3D3;opacity:.5}",
      "expected": ".a {\n  color: #D3D3D3;\n  opacity: .5;\n}\n",
      "options": {},
      "cli": false
    },
    {
      "id": "original-captured-box-values",
      "api": "style",
      "input": "hr{border:solid;border-width:thin 0 0 0;margin:0 0 0 0}.wrap{color:red;.item{color:blue}}",
      "expected": "hr {\n  border: solid;\n  border-width: thin 0 0 0;\n  margin: 0 0 0 0;\n}\n\n.wrap {\n  color: red;\n  .item {\n    color: blue;\n  }\n}\n",
      "options": {},
      "cli": false
    },
    {
      "id": "escaped-custom-value-braces",
      "api": "style",
      "input": ".a{\\2d \\-theme:{ color:red; nested:{ accent:blue } };opacity:.5}",
      "expected": ".a {\n  \\2d \\-theme: { color:red; nested:{ accent:blue } };\n  opacity: .5;\n}\n",
      "options": {},
      "cli": false
    },
    {
      "id": "empty-and-whitespace-custom-values",
      "api": "style",
      "input": ".a{--empty:;--space: ;opacity:.5}",
      "expected": ".a {\n  --empty:;\n  --space: ;\n  opacity: .5;\n}\n",
      "options": {},
      "cli": false
    }
  ]
