{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "contentMappers": [{ "package": "vize", "extensions": [".vue"] }],
  "vueCompilerOptions": {
    "checkUnknownComponents": true,
    "checkUnknownDirectives": true
  },
  "include": ["src"]
}
