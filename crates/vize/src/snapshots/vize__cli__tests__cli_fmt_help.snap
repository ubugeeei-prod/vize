---
source: crates/vize/src/cli.rs
expression: "command_help(\"fmt\")"
---
Format Vue, JSX, and TSX files

Usage: fmt [OPTIONS] [PATTERNS]...

Arguments:
  [PATTERNS]...
          Vue/JS/TS/JSON/JSONC globs; YAML/Markdown formatting is not implemented

          [default: ./**/*.vue ./**/*.js ./**/*.mjs ./**/*.cjs ./**/*.ts ./**/*.mts ./**/*.cts ./**/*.jsx ./**/*.tsx ./**/*.json ./**/*.jsonc]

Options:
      --check
          Check formatting without writing (exit with error if files need formatting)

  -w, --write
          Write formatted output to files

  -c, --config <CONFIG>
          Config file path

      --no-config
          Do not load a config file

      --single-quote[=<SINGLE_QUOTE>]
          Use single quotes instead of double quotes

          [possible values: true, false]

      --jsx-single-quote[=<JSX_SINGLE_QUOTE>]
          Use single quotes in JSX attributes

          [possible values: true, false]

      --quote-props <QUOTE_PROPS>
          Change when object properties are quoted

          Possible values:
          - as-needed:  Quote only properties that require quotes
          - consistent: Quote every property when one property requires quotes
          - preserve:   Preserve whether each property was authored with quotes

      --trailing-comma <TRAILING_COMMA>
          Change where trailing commas are printed

          Possible values:
          - all:  Print trailing commas wherever possible
          - es5:  Print trailing commas where valid in ES5
          - none: Do not print trailing commas

      --arrow-parens <ARROW_PARENS>
          Change parentheses around a sole arrow function parameter

          Possible values:
          - always: Always include parentheses around a sole parameter
          - avoid:  Omit parentheses when a sole parameter permits it

      --bracket-spacing[=<BRACKET_SPACING>]
          Print spaces inside object literal braces

          [possible values: true, false]

      --bracket-same-line[=<BRACKET_SAME_LINE>]
          Put the closing bracket of a multi-line tag on its last attribute line

          [possible values: true, false]

      --end-of-line <END_OF_LINE>
          Choose the line ending written by the formatter

          Possible values:
          - lf:   Line feed
          - crlf: Carriage return followed by line feed
          - cr:   Carriage return
          - auto: Preserve the first line ending found in the source

      --print-width <PRINT_WIDTH>
          Print width (line length) for formatting

      --tab-width <TAB_WIDTH>
          Number of spaces per indentation level

      --use-tabs[=<USE_TABS>]
          Use tabs instead of spaces for indentation

          [possible values: true, false]

      --no-semi
          Do not print semicolons at the ends of statements

      --sort-attributes[=<SORT_ATTRIBUTES>]
          Sort HTML attributes in template

          [possible values: true, false]

      --single-attribute-per-line[=<SINGLE_ATTRIBUTE_PER_LINE>]
          Put each HTML attribute on its own line

          [possible values: true, false]

      --max-attributes-per-line <MAX_ATTRIBUTES_PER_LINE>
          Maximum number of attributes per line before wrapping

      --normalize-directive-shorthands[=<NORMALIZE_DIRECTIVE_SHORTHANDS>]
          Normalize directive shorthands (v-bind: → :, v-on: → @, v-slot: → #)

          [possible values: true, false]

      --preset <PRESET>
          Apply a named set of defaults before the flags above

          Possible values:
          - vize:          The Vize defaults
          - prettier:      Prettier's Vue layout, as listed in the formatter guide
          - compact:       Dense application layout that preserves authored order
          - documentation: Readable documentation examples with one attribute per line

      --profile
          Show detailed timing profile

      --slow-threshold <SLOW_THRESHOLD>
          Slow file threshold in milliseconds for profile output

          [default: 100]

  -h, --help
          Print help (see a summary with '-h')
