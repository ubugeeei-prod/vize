{
  "schema": "vize.native-ssr.direct-child-inputs",
  "modules": [
    {
      "name": "original-nested",
      "filename": "NativeNestedOriginal.vue",
      "source": "<script setup>const value=1</script><template><i>{{value}}</i></template>",
      "expectedPlainHtml": "<i>1</i>"
    },
    {
      "name": "nested-let-js",
      "filename": "NativeNestedLet.vue",
      "source": "<script setup>let value='initial & <one>'</script><template><div>{{value}}</div></template>",
      "updates": {
        "value": "updated <雪> & 🦀"
      },
      "expectedPlainHtml": "<div>initial &amp; &lt;one&gt;</div>",
      "expectedUpdatedPlainHtml": "<div>updated &lt;雪&gt; &amp; 🦀</div>"
    },
    {
      "name": "nested-ts-let",
      "filename": "NativeNestedTs.vue",
      "source": "<script setup lang='ts'>let value:number=1</script><template><span>{{value}}</span></template>",
      "updates": {
        "value": 42
      },
      "expectedPlainHtml": "<span>1</span>",
      "expectedUpdatedPlainHtml": "<span>42</span>"
    },
    {
      "name": "nested-unicode-var",
      "filename": "NativeNestedUnicode.vue",
      "source": "<script setup>var 雪='🦀 & <one>'</script><template><section>{{雪}}</section></template>",
      "updates": {
        "雪": "雪😀 & <two>"
      },
      "expectedPlainHtml": "<section>🦀 &amp; &lt;one&gt;</section>",
      "expectedUpdatedPlainHtml": "<section>雪😀 &amp; &lt;two&gt;</section>"
    },
    {
      "name": "nested-const-attrs",
      "filename": "NativeNestedAttrs.vue",
      "source": "<script setup>const value='雪🌸 & <one>'</script><template><div class=' a  b ' title='&amp;雪'>{{value}}</div></template>",
      "expectedPlainHtml": "<div class=\"a b\" title=\"&amp;雪\">雪🌸 &amp; &lt;one&gt;</div>"
    },
    {
      "name": "nested-ts-literal",
      "filename": "NativeNestedLiteral.vue",
      "source": "<script setup lang='ts'>const idle:number=0</script><template><i>{{null}}</i></template>",
      "expectedPlainHtml": "<i></i>"
    },
    {
      "name": "nested-literal-escaping",
      "filename": "NativeNestedEscape.vue",
      "source": "<script setup>const idle=0</script><template><span>{{ '&<雪>' }}</span></template>",
      "expectedPlainHtml": "<span>&amp;&lt;雪&gt;</span>"
    },
    {
      "name": "nested-retained-comments",
      "filename": "NativeNestedComments.vue",
      "source": "<script setup>const value=42</script><template><div>{{/*retained*/ value /*tail*/}}</div></template>",
      "expectedPlainHtml": "<div>42</div>"
    }
