{
  "babelExempt": {
    "options/pragma": "literal",
    "options/is_custom_element_default": "literal",
    "options/is_custom_element_fn": "literal",
    "elements/intrinsic": "literal",
    "elements/component_pascal": "literal",
    "elements/unknown_lowercase": "literal",
    "elements/dashed_lowercase": "literal",
    "elements/svg_tag": "literal",
    "elements/mathml_tag": "literal",
    "elements/member_tag": "literal",
    "elements/namespaced_tag": "literal",
    "elements/fragment": "literal",
    "elements/nested_fragment_child": "literal",
    "props/xlink_camel": "literal",
    "props/dollar_prefixed": "literal",
    "children/static_text": "literal",
    "children/comment_only": "literal",
    "children/empty_expr": "literal",
    "optimize/static": "literal",
    "optimize/fragment": "literal",
    "errors/v_model_non_lval": "compile-error",
    "errors/v_model_no_value": "compile-error",
    "errors/v_models_not_array": "compile-error",
    "errors/v_models_entry_not_array": "compile-error",
    "errors/v_slots_not_object": "compile-error",
    "errors/v_slots_static_template": "compile-error",
    "errors/v_slots_not_object_with_children": "compile-error"
  },
  "vapor": {
    "children/dynamic-text": "children/dynamic-value",
    "props/dynamic-attributes": "props/dynamic-value",
    "props/spread-updates": "props/spread-only-value",
    "events/click-closure": "events/plain-value",
    "props/live-input-value": "props/dynamic-value",
    "directives/v-model-text": "directives/v-model-input-value",
    "components/scoped-default-slot": "slots/scoped-param-value",
    "components/named-slot-updates": "slots/v-slots-object-literal-value",
    "props/spread-before-static": "props/spread-then-static-value",
    "props/spread-after-static": "props/spread-then-static-value",
    "props/ordered-spread-chain": "props/spread-only-value",
    "props/spread-class-style": "props/style-merge-value",
    "events/spread-listener-order": "props/on-merge-value",
    "props/ordered-spread-reads": "props/spread-only-value",
    "elements/fragment-updates": "children/dynamic-value",
    "slots/object-children": "slots/object-children-value",
    "directives/v-model-component": "directives/v-model-component-value",
    "directives/v-model-component-arg": "directives/v-model-component-arg-mods-value",
    "directives/v-model-checkbox": "directives/v-model-checkbox-value",
    "directives/v-model-radio": "directives/v-model-radio-value",
    "directives/v-model-select": "directives/v-model-select-value",
    "directives/v-model-modifier-array": "directives/v-model-modifier-array-value",
    "directives/v-model-trim": "directives/v-model-trim-value",
    "directives/v-model-lazy": "directives/v-model-lazy-value",
    "directives/v-model-number": "directives/v-model-number-value",
    "directives/v-text": "directives/v-text-value",
    "directives/v-if-chain": "directives/v-if-value",
    "directives/v-for-keyed": "directives/v-for-value",
    "directives/v-slot-default": "directives/v-slot-value",
    "directives/v-slot-named": "slots/v-slots-object-with-children-value",
    "directives/custom": "directives/custom-arg-value",
    "directives/v-pre": "children/dynamic-value",
    "directives/v-cloak": "children/dynamic-value",
    "props/key-replacement": "props/key-value",
    "tsx/typed-expressions": "tsx/child-value"
  }
}
