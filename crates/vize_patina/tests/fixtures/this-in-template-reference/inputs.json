      "source": "<template>\n  <transition name=\"fade\">\n    <div class=\"play-feedback\" v-if=\"modelValue\">\n      <div class=\"feedback-header\">\n        <span>&nbsp;</span>\n        <div class=\"title\">播放反馈</div>\n        <dy-back mode=\"dark\" img=\"close\" @click=\"cancel\"></dy-back>\n      </div>\n      <div class=\"content\">\n        <div class=\"notice\">请选择要反馈的问题</div>\n        <div\n          class=\"l-row\"\n          @click=\"\n            falseOther(() => {\n              this.type1 = true\n            })\n          \"\n        >\n          <Check\n            mode=\"red\"\n            :modelValue=\"type1\"\n            @change=\"\n              falseOther(() => {\n                this.type1 = true\n              })\n            \"\n          />\n          <span>网络正常无法播放视频</span>\n        </div>\n        <div\n          class=\"l-row\"\n          @click=\"\n            falseOther(() => {\n              this.type2 = true\n            })\n          \"\n        >\n          <Check\n            mode=\"red\"\n            :modelValue=\"type2\"\n            @change=\"\n              falseOther(() => {\n                this.type2 = true\n              })\n            \"\n          />\n          <span>视频画面正常没声音</span>\n        </div>\n        <div\n          class=\"l-row\"\n          @click=\"\n            falseOther(() => {\n              this.type3 = true\n            })\n          \"\n        >\n          <Check\n            mode=\"red\"\n            :modelValue=\"type3\"\n            @change=\"\n              falseOther(() => {\n                this.type3 = true\n              })\n            \"\n          />\n          <span>播放几秒/中途卡信</span>\n        </div>\n        <div\n          class=\"l-row\"\n          @click=\"\n            falseOther(() => {\n              this.type4 = true\n            })\n          \"\n        >\n          <Check\n            mode=\"red\"\n            :modelValue=\"type4\"\n            @change=\"\n              falseOther(() => {\n                this.type4 = true\n              })\n            \"\n          />\n          <span>画面内容不全</span>\n        </div>\n        <div\n          class=\"l-row\"\n          @click=\"\n            falseOther(() => {\n              this.type5 = true\n            })\n          \"\n        >\n          <Check\n            mode=\"red\"\n            :modelValue=\"type5\"\n            @change=\"\n              falseOther(() => {\n                this.type5 = true\n              })\n            \"\n          />\n          <span>播放过程中闪退回桌面</span>\n        </div>\n        <div\n          class=\"l-row\"\n          @click=\"\n            falseOther(() => {\n              this.type6 = true\n            })\n          \"\n        >\n          <Check\n            mode=\"red\"\n            :modelValue=\"type6\"\n            @change=\"\n              falseOther(() => {\n                this.type6 = true\n              })\n            \"\n          />\n          <span>画面模糊不清晰</span>\n        </div>\n        <div\n          class=\"l-row\"\n          @click=\"\n            falseOther(() => {\n              this.type7 = true\n            })\n          \"\n        >\n          <Check\n            mode=\"red\"\n            :modelValue=\"type7\"\n            @change=\"\n              falseOther(() => {\n                this.type7 = true\n              })\n            \"\n          />\n          <span>视频播放其他问题或建议</span>\n        </div>\n        <div v-if=\"type7\" class=\"other\">\n          <div class=\"textarea-ctn\">\n            <textarea\n              name=\"\"\n              id=\"\"\n              cols=\"30\"\n              rows=\"10\"\n              v-model=\"desc\"\n              placeholder=\"详输入内容\"\n            ></textarea>\n          </div>\n          <div class=\"text-num\">{{ desc.length }}/300</div>\n        </div>\n        <dy-button type=\"primary\" :disabled=\"!disabled\" @click=\"submit\">提交</dy-button>\n      </div>\n    </div>\n  </transition>\n</template>\n<script>\nimport Check from '../../../components/Check'\nimport { _hideLoading, _notice, _showLoading, _sleep } from '@/utils'\n\nexport default {\n  name: 'Test',\n  props: {\n    modelValue: {\n      type: Boolean,\n      default() {\n        return false\n      }\n    }\n  },\n  components: {\n    Check\n  },\n  watch: {\n    modelValue() {\n      this.type1 = false\n      this.type2 = false\n      this.type3 = false\n      this.type4 = false\n      this.type5 = false\n      this.type6 = false\n      this.type7 = false\n      this.desc = ''\n    }\n  },\n  data() {\n    return {\n      type1: false,\n      type2: false,\n      type3: false,\n      type4: false,\n      type5: false,\n      type6: false,\n      type7: false,\n      desc: ''\n    }\n  },\n  computed: {\n    disabled() {\n      if (this.type7 && this.desc) return true\n      return this.type1 || this.type2 || this.type3 || this.type4 || this.type5 || this.type6\n    }\n  },\n  created() {},\n  methods: {\n    falseOther(cb) {\n      this.type1 = false\n      this.type2 = false\n      this.type3 = false\n      this.type4 = false\n      this.type5 = false\n      this.type6 = false\n      this.type7 = false\n      cb()\n    },\n    cancel() {\n      this.$emit('update:modelValue', false)\n    },\n    async submit() {\n      this.cancel()\n      _showLoading()\n      await _sleep(1000)\n      _hideLoading()\n      _notice('感谢你的反馈，我们会尽快答复！')\n    }\n  }\n}\n</script>\n\n<style scoped lang=\"less\">\n@import '../../../assets/less/index';\n\n.play-feedback {\n  max-height: 490rem;\n  overflow: auto;\n  background: #fff;\n  color: black;\n  position: fixed;\n  bottom: 50rem;\n  left: 0;\n  right: 0;\n\n  .feedback-header {\n    position: fixed;\n    left: 0;\n    right: 0;\n    background: white;\n    height: 30rem;\n    padding: 15rem;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    font-weight: bold;\n    font-size: 18rem;\n  }\n\n  .content {\n    padding: 60rem 15rem 15rem 15rem;\n  }\n\n  .notice {\n    font-size: 12rem;\n    color: var(--second-text-color);\n  }\n\n  .l-row {\n    display: flex;\n    align-items: center;\n    min-height: 50rem;\n    font-size: 14rem;\n    border-bottom: 1px solid #f1f1f1;\n\n    .check {\n      width: 20rem;\n      height: 20rem;\n      margin-right: 10rem;\n    }\n  }\n\n  .no-border {\n    border-bottom: none;\n  }\n\n  .other {\n    .textarea-ctn {\n      width: 100%;\n      background: #eae8e8;\n      padding: 15rem;\n      box-sizing: border-box;\n      margin-top: 10rem;\n      border-radius: 2px;\n\n      textarea {\n        font-family: 'Microsoft YaHei UI';\n        outline: none;\n        width: 100%;\n        border: none;\n        background: transparent;\n        color: black;\n\n        &::placeholder {\n          color: var(--second-text-color);\n        }\n      }\n    }\n\n    .text-num {\n      margin-top: 8rem;\n      margin-bottom: 8rem;\n      font-size: 10rem;\n      color: var(--second-text-color);\n      text-align: right;\n    }\n  }\n}\n</style>\n",
