lowers","following_url":"https://api.github.com/users/ubugeeei/following{/other_user}","gists_url":"https://api.github.com/users/ubugeeei/gists{/gist_id}","starred_url":"https://api.github.com/users/ubugeeei/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ubugeeei/subscriptions","organizations_url":"https://api.github.com/users/ubugeeei/orgs","repos_url":"https://api.github.com/users/ubugeeei/repos","events_url":"https://api.github.com/users/ubugeeei/events{/privacy}","received_events_url":"https://api.github.com/users/ubugeeei/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2026-10-12T07:08:06Z","updated_at":"2026-10-12T07:08:22Z","closed_at":null,"assignee":{"login":"ubugeeei","id":71201308,"node_id":"MDQ6VXNlcjcxMjAxMzA4","avatar_url":"https://avatars.githubusercontent.com/u/71201308?v=4","gravatar_id":"","url":"https://api.github.com/users/ubugeeei","html_url":"https://github.com/ubugeeei","followers_url":"https://api.github.com/users/ubugeeei/followers","following_url":"https://api.github.com/users/ubugeeei/following{/other_user}","gists_url":"https://api.github.com/users/ubugeeei/gists{/gist_id}","starred_url":"https://api.github.com/users/ubugeeei/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ubugeeei/subscriptions","organizations_url":"https://api.github.com/users/ubugeeei/orgs","repos_url":"https://api.github.com/users/ubugeeei/repos","events_url":"https://api.github.com/users/ubugeeei/events{/privacy}","received_events_url":"https://api.github.com/users/ubugeeei/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Summary\n\nA bound attribute whose value starts on a new line is reported as resolving to `any` / `unknown`. The same template literal on one line is not reported. A formatter wraps a long binding this way, so a long `:style` or `:aria-label` trips it.\n\n### Version\n\n- `vize` 0.443.0 (npm, bundled `@typescript/typescript-darwin-arm64` 7.0.2)\n- Node v26.10.0, macOS arm64\n\n`vize check` reports no type errors for the same file.\n\n### Reproduction\n\n`vize.config.json`\n\n```json\n{\n  \"linter\": {\n    \"preset\": \"opinionated\",\n    \"typeAware\": true\n  }\n}\n```\n\n`tsconfig.json`\n\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ESNext\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"skipLibCheck\": true,\n    \"lib\": [\"ESNext\", \"DOM\"]\n  },\n  \"include\": [\"*.vue\", \"*.ts\"]\n}\n```\n\n`MultilineAttr.vue`\n\n```vue\n<script setup lang=\"ts\">\nconst x = 1;\n</script>\n\n<template>\n  <p :title=\"`x: ${x}px`\">not reported</p>\n  <p\n    :title=\"\n      `x: ${x}px`\n    \"\n  >\n    reported\n  </p>\n</template>\n```\n\n`vize lint --format plain MultilineAttr.vue`\n\n```\n  MultilineAttr.vue:8:13 warning type/no-unsafe-template-binding Template binding resolves to an unsafe `any` or `unknown` type\n```","closed_by":null,"reactions":{"url":"https://api.github.com/repos/ubugeeei-prod/vize/issues/8753/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/ubugeeei-prod/vize/issues/8753/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}