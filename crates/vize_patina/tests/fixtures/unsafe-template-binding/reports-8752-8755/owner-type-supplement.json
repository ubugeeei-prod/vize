      "filename": "UnsafeAnyConsequentTypedObjectAlternate.vue",
      "source": "<script setup lang=\"ts\">\nconst flag: boolean = Math.random() > 0.5;\nconst t = (p: {text: string}): string => p.text;\nconst value: any = \"x\";\n</script>\n<template>\n<p>{{ flag\n ? value\n : t({text: 'safe'}) }}</p>\n</template>\n",
