<script setup lang="ts">
import { computed } from "vue";

function useField(options: { value: () => number; clear: () => void }): void {
  void options;
}

const count = computed(() => 1);

useField({ clear: () => {}, value: () => count.value });

function declared(): number {
  return 1;
}
</script>

<template>
  <p>{{ declared() }}</p>
</template>
