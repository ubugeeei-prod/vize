  "authority": "Independently authored source and complete diagnostics. Byte spans identify original tokens; no captured product output. Explicit type rule selection enters the native driver, and a missing Corsa path rejects accidental queries.",
  "cases": [
    {
      "id": "scripted-foreign-fragment",
      "filename": "TypeAwareOwnership.vue",
      "source": "<script setup lang=\"ts\">\ndefineProps(['value']);\n</script>\n<template><div class=\"local\"></div><aside></aside></template>\n<style scoped>\n:global(.foreign) { display: none; }\n</style>\n",
      "expected": [
        {
          "rule": "type/require-typed-props",
          "message": "Prop should have a type definition",
          "help": "Use `defineProps<Props>()` or a runtime prop object with concrete constructor types.",
          "start": 25,
          "end": 47,
          "severity": "warning"
        }
      ]
    },
