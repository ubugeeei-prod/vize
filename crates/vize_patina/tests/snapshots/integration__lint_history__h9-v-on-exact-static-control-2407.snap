        diagnostics: [
            LintDiagnostic {
                rule_name: "vue/use-v-on-exact",
                severity: Warning,
                message: "@click without .exact can also fire with additional system modifiers",
                start: 8,
                end: 14,
                help: Some(
                    "**Why:** Handlers can overlap when additional Ctrl/Shift/Alt/Meta keys are held. `.exact` allows the declared system modifiers and rejects additional ones.\n\n**Fix:**\n```vue\n<!-- Before -->\n<button @click=\"onClick\" @click.ctrl=\"onCtrlClick\" />\n\n<!-- After -->\n<button @click.exact=\"onClick\" @click.ctrl=\"onCtrlClick\" />\n```",
                ),
                labels: [],
                fix: None,
            },
        ],
