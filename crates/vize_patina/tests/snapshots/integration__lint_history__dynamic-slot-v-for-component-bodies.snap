    history: "71c157ded6632df04b61c96f44c25b11097b928c",
    source: "<script setup lang=\"ts\">\nimport { useSlots } from \"vue\";\n\nimport MyList from \"./my-list.vue\";\nimport MyItem from \"./my-item.vue\";\n\nconst slots = useSlots();\nconst names = Object.keys(slots);\n</script>\n\n<template>\n  <MyList>\n    <template v-for=\"name in names\" #[name]=\"scope\">\n      <slot :name=\"name\" v-bind=\"scope\" />\n    </template>\n  </MyList>\n\n  <MyList>\n    <template v-for=\"name in names\" #[name]=\"scope\">\n      <component :is=\"slots[name]\" v-bind=\"scope\" />\n    </template>\n  </MyList>\n\n  <MyList>\n    <template v-for=\"name in names\" #[name]>\n      <MyItem :label=\"name\" />\n    </template>\n  </MyList>\n</template>\n",
