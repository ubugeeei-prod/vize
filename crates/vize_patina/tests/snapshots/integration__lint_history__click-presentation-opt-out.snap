            LintDiagnostic {
                rule_name: "a11y/click-events-have-key-events",
                severity: Warning,
                message: "Non-interactive elements with @click must also have keyboard event handlers",
                start: 76,
                end: 98,
                help: Some(
                    "**Why:** Keyboard users cannot activate click-only handlers.\n\n**Best solution:** Use semantic elements:\n```vue\n<button @click=\"handleClick\">Click me</button>\n```\n\n**If you must use a div:**\n```vue\n<div \n  role=\"button\"\n  tabindex=\"0\"\n  @click=\"handleClick\"\n  @keydown.enter=\"handleClick\"\n  @keydown.space=\"handleClick\"\n>\n  Click me\n</div>\n```",
                ),
                labels: [],
                fix: None,
            },
        ],
