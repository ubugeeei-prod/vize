    source: "<script setup lang=\"ts\">\nconst { count } = defineProps<{ count: number }>()\n\nconst alias = count\nconst second = alias\nlet assigned: number\nassigned = second\n\nuseMyComposable(second)\nuseMyComposable(assigned)\nassigned++\n\nconst ctx = useMyComposable(() => second)\nconst a = ctx.second()\n</script>",
    filename: "Component.vue",
    entry: "sfc",
    rule: "type/no-reactivity-loss",
    vue_version: None,
    vapor: None,
