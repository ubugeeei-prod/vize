package vize:contracts@0.1.1;

/// The expression-dialect boundary: one block's expressions and the
/// bindings in scope in, analysis facts and a checkable projection out.
///
/// The call is coarse-grained: every expression of a block crosses at once,
/// never one call per expression. The answer is the P2-5b capability duties
/// (referenced bindings, exactness, const-ness) as an `expression-facts` α
/// page, and a projection of the expressions into the dialect's checkable
/// language with P4-5a span links back to the authored text (charter #14).
interface expression-analysis {
  use types.{diagnostic, page, span};

  /// One binding in scope for the expressions.
  record binding {
    /// The binding's name as authored.
    name: string,
    /// Its kind, in `BindingType` spelling (`setup-ref`, `props`, ...).
    kind: string,
  }

  /// One authored expression.
  record expression {
    /// The id the host assigned; facts and projection rows name it.
    id: u32,
    /// The expression's authored text.
    source: string,
    /// Where `source` sits in the file (file-absolute).
    span: span,
  }

  /// One block's expressions and their environment, whole.
  record expression-batch {
    environment: list<binding>,
    expressions: list<expression>,
  }

  /// Everything the dialect answers about a batch.
  record analysis {
    /// `facts-page@1`: the `expression-facts` α document, one entry per
    /// expression id.
    facts: page,
    /// `projection-page@1`: the generated checkable text and its span links;
    /// authored ranges are file-absolute and lie inside the expressions.
    projection: page,
    /// Findings about the expressions, in authored spans.
    diagnostics: list<diagnostic>,
  }

  /// Analyze one batch.
  analyze: func(batch: expression-batch) -> analysis;
}

/// What an expression-dialect guest component implements.
world expression-dialect {
  export handshake;
  export expression-analysis;
}
