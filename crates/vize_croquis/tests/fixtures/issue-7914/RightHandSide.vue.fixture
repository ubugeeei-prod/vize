<script setup lang="ts">
// 雪😀: a snapshot crosses the call boundary before the local binding changes.
const props = defineProps<{ modelValue: string }>();
function useFeature(value: string): string { return value; }
let last = props.modelValue;
last = useFeature(last);
const copy = last;
useFeature(last);
</script>
<template><div>{{ last }} {{ copy }}</div></template>
