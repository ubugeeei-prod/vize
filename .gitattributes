# Keep GitHub language statistics focused on authored source code.
*.snap linguist-generated=true
**/__snapshots__/** linguist-generated=true
npm/fresco-native/index.d.ts linguist-generated=true text eol=lf

# Formatter history references compare exact bytes, including CR/LF and final LF.
tests/_fixtures/differential/formatter-history/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
crates/vize_glyph/tests/snapshots/history_*.snap.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Native script CLI oracles retain exact captured bytes and authored CRLF.
crates/vize/tests/fixtures/dump_script_cli/** -text whitespace=cr-at-eol
crates/vize/tests/fixtures/dump_cli/help*.stdout -text

# Embedded third-party repositories are fixtures, not part of the project source.
tests/_fixtures/_git/** linguist-vendored=true

# Preserve the pinned upstream source bytes, including existing trailing spaces.
tests/_fixtures/pattern-reference/upstream/** linguist-vendored whitespace=-blank-at-eol
tests/_fixtures/vue-language-tools/upstream/** linguist-vendored whitespace=-blank-at-eol

# Keep the authored CRLF response fixture byte-exact across Git checkouts.
tests/_fixtures/differential/lsp/on-type-crlf/App.vue.txt -text whitespace=cr-at-eol
tests/_fixtures/differential/lsp/highlight-original-crlf/Crlf.vue.txt -text whitespace=cr-at-eol
tests/_fixtures/differential/lsp/highlight-original/witness.test.ts.txt -text

# Original type-checker sources and diff context keep their pinned bytes.
tests/_fixtures/differential/typechecker/split-script-original/**/*.txt -text whitespace=-blank-at-eol
tests/_fixtures/differential/typechecker/v-for-source-original/**/*.txt -text whitespace=-blank-at-eol
tests/_fixtures/differential/typechecker/vite-plus-relative-tsconfig/** -text

# Immutable formatter regressions include literal CRLF/CRCRLF output bytes.
tests/_fixtures/differential/formatter/sfc-vue*/** -text whitespace=-blank-at-eol

# Original linter report fixtures retain authored LF/CRLF bytes on every checkout.
crates/vize_patina/tests/fixtures/issue-7977/** -text whitespace=cr-at-eol

# Macro ownership laws retain pinned LF, Unicode and authored CRLF bytes.
tests/_fixtures/differential/lint-with-defaults/** -text whitespace=cr-at-eol
