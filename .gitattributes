# Keep GitHub language statistics focused on authored source code.
*.snap linguist-generated=true
**/__snapshots__/** linguist-generated=true
npm/fresco-native/index.d.ts linguist-generated=true text eol=lf

# Formatter history references compare exact bytes, including CR/LF and final LF.
tests/_fixtures/differential/formatter-history/** -text
crates/vize_glyph/tests/snapshots/history_*.snap.txt -text

# Embedded third-party repositories are fixtures, not part of the project source.
tests/_fixtures/_git/** linguist-vendored=true

# Preserve the pinned upstream source bytes, including existing trailing spaces.
tests/_fixtures/pattern-reference/upstream/** linguist-vendored whitespace=-blank-at-eol
tests/_fixtures/vue-language-tools/upstream/** linguist-vendored whitespace=-blank-at-eol
