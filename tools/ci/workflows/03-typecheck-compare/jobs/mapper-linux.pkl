import "../../../lib/Actions.pkl" as ci
local buildSteps = import("mapper-build.pkl").steps

needs = "mapper-build-linux"
`runs-on` = ci.linux
`timeout-minutes` = 90
env {
  VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/03-typecheck-compare/scripts"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { `persist-credentials` = false }
  }
  new Dynamic {
    uses = ci.setupNode
    with {
      `node-version-file` = "package.json"
      `package-manager-cache` = false
    }
  }
  new Dynamic {
    uses = ci.downloadArtifact
    with {
      name = "pair-bin-linux"
      path = "pair-bin"
    }
  }
  new Dynamic {
    name = "Measure"
    env {
      SIZES = "${{ inputs.sizes }}"
      RUNS = "${{ inputs.runs }}"
      ALLOW = "${{ inputs.allow_output_change && '--allow-output-change' || '' }}"
      REFERENCE = "${{ inputs.reference_mapper }}"
    }
    run = ci.workflowScript("mapper-measure.sh")
  }
  new Dynamic {
    name = "Memory probe"
    `if` = "inputs.memory_probe"
    env { SIZES = "${{ inputs.sizes }}" }
    run = ci.workflowScript("mapper-memory-probe.sh")
  }
  new Dynamic {
    name = "Syscall census"
    `if` = "inputs.syscall_census"
    env { SIZES = "${{ inputs.sizes }}" }
    run = ci.workflowScript("mapper-syscall-census.sh")
  }
  new Dynamic {
    uses = ci.uploadArtifact
    `if` = "always()"
    with {
      name = "pair-linux"
      path = "${{ runner.temp }}/pair-out/"
      `if-no-files-found` = "warn"
    }
  }
}
