import "../../../lib/Actions.pkl" as ci

needs = List("replay-resolve", "replay-build")
`runs-on` = ci.linux
`timeout-minutes` = 120
env {

  BASE = "${{ needs.replay-resolve.outputs.base }}"
  HEAD = "${{ needs.replay-resolve.outputs.head }}"
  CORPORA = "${{ inputs.corpora || 'misskey,n8n,reka-ui,nuxt-ui' }}"
  RUNS = "${{ inputs.runs || '5' }}"
  LAUNCHER = "${{ github.event_name == 'push' || inputs.launcher }}"
  PROFILE = "${{ github.event_name == 'push' || inputs.profile }}"
  ALLOW = "${{ inputs.allow_output_change && '--allow-output-change' || '' }}"
  HOST_RUNS = "${{ inputs.host_runs || '3' }}"
}
steps = new Listing {
  ...ci.stageWorkflow("03-typecheck-compare")
  new Dynamic {
    name = "Validate inputs"
    run = ci.workflowScript("replay-validate-inputs-2.sh")
  }
  new Dynamic {
    uses = ci.checkout
    with { `persist-credentials` = false }
  }
  ci.workspaceVp()
  new Dynamic {
    uses = ci.setupRust
    `if` = "env.LAUNCHER == 'true'"
    with { toolchain = "1.100.0" }
  }
  new Dynamic {
    uses = ci.setupWild
    `if` = "env.LAUNCHER == 'true'"
    with { `wild-version` = "0.9.0" }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-script"
    `if` = "env.LAUNCHER == 'true'"
  }
  new Dynamic {
    uses = ci.downloadArtifact
    with {
      pattern = "replay-bin-*"
      path = "replay-bin"
      `merge-multiple` = true
    }
  }
  new Dynamic {
    name = "Hydrate the corpora and install the locked hosts and corpus packages"
    run = ci.workflowScript("replay-hydrate-the-corpora-and-install-the-locked-hosts-and-corpus-packages.sh")
  }
  new Dynamic {
    name = "Build the npm launcher and the native binding for base and head"
    `if` = "env.LAUNCHER == 'true'"
    run = ci.workflowScript("replay-build-the-npm-launcher-and-the-native-binding-for-base-and-head.sh")
  }
  new Dynamic {
    name = "Record tsc's request streams"
    run = ci.workflowScript("replay-record-tsc-s-request-streams.sh")
  }
  new Dynamic {
    name = "Replay"
    run = ci.workflowScript("replay-replay.sh")
  }
  new Dynamic {
    name = "Host runs through a timing proxy"
    `if` = "env.HOST_RUNS != '0'"
    run = ci.workflowScript("replay-host-runs-through-a-timing-proxy.sh")
  }
  new Dynamic {
    name = "Count allocations"
    `if` = "env.PROFILE == 'true'"
    run = ci.workflowScript("replay-count-allocations.sh")
  }
  new Dynamic {
    name = "Profile the head CLI and count syscalls"
    `if` = "env.PROFILE == 'true'"
    run = ci.workflowScript("replay-profile-the-head-cli-and-count-syscalls.sh")
  }
  new Dynamic {
    uses = ci.uploadArtifact
    `if` = "always()"
    with {
      name = "replay-out"
      path = "${{ runner.temp }}/replay-out/"
      `if-no-files-found` = "warn"
    }
  }
}
