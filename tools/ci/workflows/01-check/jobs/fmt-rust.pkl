import "../../../lib/Actions.pkl" as ci

`runs-on` = ci.linux
`timeout-minutes` = 10
steps = new Listing {
  ci.use(ci.checkout)
  new Dynamic {
    uses = ci.setupRust
    with {
      toolchain = "stable"
      components = "rustfmt"
    }
  }
  ci.command("Format Rust", "cargo fmt --all -- --check")
}
