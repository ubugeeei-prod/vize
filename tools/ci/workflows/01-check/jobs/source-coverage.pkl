import "../../../lib/Actions.pkl" as ci

`runs-on` = ci.linux
`timeout-minutes` = 50
// Keep daily and ordinary manual measurement; immutable release qualification
// retains all correctness jobs without repeating the instrumented trend run.
`if` = "${{ github.event_name == 'schedule' || (github.event_name == 'workflow_dispatch' && !(inputs.release-qualification && (startsWith(github.ref, 'refs/heads/release/v') || startsWith(github.ref, 'refs/tags/v')))) }}"
env {
  VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/01-check/scripts"
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
  VIZE_NUXT_CONFIG_ITERATIONS = "100"
}
steps = new Listing {
  ci.use(ci.checkout)
  ci.workspaceVp()
  new Dynamic {
    uses = ci.setupRust
    with {
      toolchain = "stable"
      components = "llvm-tools-preview"
    }
  }
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    with { `wild-version` = "0.9.0" }
  }
  ci.use("./.github/actions/setup-rust-script")
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "coverage-source"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
      // A manual Full off main reads the scheduled run's instrumented disk.
      `restore-trusted` = "${{ github.event_name == 'workflow_dispatch' }}"
    }
  }
  ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
  new Dynamic {
    name = "Install Pkl CLI and hydrate pinned native fixture"
    run = #". "${{ env.VIZE_CI_FILES }}/install-pkl-cli-and-hydrate-pinned-native-fixture.sh""#
  }
  new Dynamic {
    name = "Install cargo-llvm-cov"
    uses = "taiki-e/install-action@184183c2401be73c3bf42c2e61268aa5855379c1"  // v2
    with { tool = "cargo-llvm-cov,cargo-nextest@0.9.146" }
  }
  ci.command("Provision the locked Full Rust native runtime", "node tools/support/compat/github/full-rust-runtime.ts")
  new Dynamic {
    name = "Source coverage report"
    env { VIZE_NATIVE_SYNTAX_CAPTURE_DIR = "${{ runner.temp }}/source-coverage-native-syntax" }
    run = "vp run --workspace-root coverage:source"
  }
  new Dynamic {
    name = "Retain raw source coverage native syntax packets"
    `if` = "${{ always() }}"
    uses = ci.uploadArtifact
    with {
      name = "source-coverage-native-syntax-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}"
      path = "${{ runner.temp }}/source-coverage-native-syntax/"
      `if-no-files-found` = "warn"
    }
  }
  new Dynamic {
    name = "Retain source coverage native runtime provider"
    `if` = "${{ always() }}"
    uses = ci.uploadArtifact
    with {
      name = "source-coverage-native-runtime-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}"
      path = "target/nextest/full/native-runtime-provider.json"
      `if-no-files-found` = "warn"
      `retention-days` = 14
    }
  }
  ci.command("Verify source coverage summary", #". "${{ env.VIZE_CI_FILES }}/verify-source-coverage-summary.sh""#)
  new Dynamic {
    name = "Upload source coverage summary"
    `continue-on-error` = true
    uses = ci.uploadArtifact
    with {
      name = "rust-source-coverage-summary"
      path = "target/llvm-cov/source-summary.json"
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
}
