import "../../../lib/Actions.pkl" as ci

name = "cargo-semver-checks (${{ matrix.crate }})"
// Check published APIs before tag promotion and when resuming an exact release tag.
`if` = "${{ github.event_name == 'workflow_dispatch' && (startsWith(github.ref, 'refs/heads/release/v') || startsWith(github.ref, 'refs/tags/v')) }}"
`runs-on` = ci.linux
`timeout-minutes` = 25
permissions { contents = "read" }
// Keep this list in sync with crates published by tools/support/release/publish_crates.
strategy {
  `fail-fast` = false
  matrix {
    crate = new Listing {
      "vize_armature"
      "vize_atelier_core"
      "vize_atelier_dom"
      "vize_atelier_sfc"
      "vize_atelier_ssr"
      "vize_atelier_vapor"
      "vize_carton"
      "vize_croquis"
      "vize_fresco"
      "vize_musea"
      "vize_relief"
      "vize_l1_to_l2"
    }
  }
}
env {
  VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/01-check/scripts"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { `fetch-depth` = 0 }
  }
  ci.rust("1.100.0")
  ci.use("./.github/actions/setup-rust-script")
  new Dynamic {
    uses = ci.setupNode
    with {
      `node-version-file` = "package.json"
      `package-manager-cache` = false
    }
  }
  new Dynamic {
    name = "Use candidate version for SemVer classification"
    // cargo-semver-checks derives the release type from the bumped version.
    run = #". "${{ env.VIZE_CI_FILES }}/use-candidate-version-for-semver-classification.sh""#
  }
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    with { `wild-version` = "0.9.0" }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "semver-checks"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    name = "Install cargo-semver-checks"
    uses = "taiki-e/install-action@184183c2401be73c3bf42c2e61268aa5855379c1"  // v2
    with {
      tool = "cargo-semver-checks@0.51.0"  // 0.50.0+ reads rustdoc JSON v61, which Rust 1.99 and 1.100 emit
    }
  }
  new Dynamic {
    name = "Check public API SemVer compatibility"
    env {
      BASELINE_REV = "${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || (github.event_name == 'push' && github.event.before || '') }}"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    run = #"node tools/ci/commands/github/check-semver.ts "${{ matrix.crate }}""#
  }
}
