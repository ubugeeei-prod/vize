import "../../lib/Actions.pkl" as ci

name = "Rspack SFC HMR"

on {
  workflow_dispatch = null
  pull_request {
    paths = new Listing {
      ".github/workflows/08-rspack.yml"
      "tools/ci/workflows/08-rspack/scripts/**"
      "npm/builder/rspack/**"
      "npm/builder/shared/**"
      "npm/native/**"
      "crates/vize_atelier_sfc/**"
      "crates/vize_vitrine/src/napi/sfc/**"
      "crates/vize_croquis/src/sfc/**"
      "tools/ci/workflows/08-rspack/jobs/**"
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "rspack-hmr-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

jobs {
  browser {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/08-rspack/scripts"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.workspaceVp()
      ci.rust("1.100.0")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "rspack-hmr"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-ubuntu-archive")
      new Dynamic { run = "vp install --frozen-lockfile --prefer-offline" }
      ci.command("Build the source native image", "vp run --filter @vizejs/native build:ci")
      new Dynamic {
        name = "Check CSS module HMR identity without a browser"
        run = "node --test npm/builder/rspack/src/shared/output.test.ts npm/builder/rspack/src/shared/hotReload.test.ts"
      }
      new Dynamic {
        name = "Install the isolated Rspack 2 runtime from the HMR docs"
        `working-directory` = "npm/builder/rspack"
        run = ci.workflowScript("install-the-isolated-rspack-2-runtime-from-the-hmr-docs.sh")
      }
      new Dynamic {
        name = "Run browser HMR"
        // A live browser session needs the selected runtime environment and fresh execution.
        run = "vp run --no-cache --filter @vizejs/rspack-plugin test:hmr"
      }
    }
  }

  `source-ranges` = import("jobs/source-ranges.pkl")
}
