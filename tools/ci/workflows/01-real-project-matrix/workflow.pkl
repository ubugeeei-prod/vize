import "../../lib/Actions.pkl" as ci

name = "Real Project Matrix"
// "enforced" gates every surface. "release-gated" is the exact release dispatch:
// tool surfaces and the Davinci corpus enforce, lint and LSP parity record their
// raw outcomes, and typecheck divergence is skipped. Every other combination is
// "observational".
`run-name` = "Real Project Matrix ${{ inputs.project && 'scoped-diagnostic' || (inputs.core_tools_mode || 'enforce') == 'enforce' && (inputs.typecheck_dependencies_mode || 'enforce') == 'enforce' && (inputs.davinci_dom_corpus_mode || 'enforce') == 'enforce' && ((inputs.lint_divergence_mode || 'enforce') == 'enforce' && (inputs.lsp_mode || 'enforce') == 'enforce' && (inputs.typecheck_divergence_mode || 'enforce') == 'enforce' && 'enforced' || (inputs.lint_divergence_mode || 'enforce') == 'record-only' && (inputs.lsp_mode || 'enforce') == 'record-only' && (inputs.typecheck_divergence_mode || 'enforce') == 'skip' && 'release-gated') || 'observational' }} @ ${{ github.sha }}"

on {
  workflow_dispatch {
    inputs {
      project {
        description = "Optional exact fixture ID for a scoped diagnostic; empty runs the full matrix"
        required = false
        ["default"] = ""
        type = "string"
      }
      core_tools_mode {
        description = "Core tool surface handling"
        required = false
        ["default"] = "enforce"
        type = "choice"
        options = List("enforce", "record-only")
      }
      core_tools_timeout_ms {
        description = "Per-project core tool timeout in milliseconds"
        required = false
        ["default"] = "2400000"
        type = "string"
      }
      typecheck_dependencies_mode {
        description = "Typecheck baseline dependency preparation handling"
        required = false
        ["default"] = "enforce"
        type = "choice"
        options = List("enforce", "record-only")
      }
      lint_divergence_mode {
        description = "Patina lint divergence gate handling"
        required = false
        ["default"] = "enforce"
        type = "choice"
        options = List("enforce", "record-only")
      }
      lint_baseline_reference_mode {
        description = "ESLint scorecard memory mode; unbounded-6g is diagnostic only"
        required = false
        ["default"] = "bounded"
        type = "choice"
        options = List("bounded", "unbounded-6g")
      }
      lsp_mode {
        description = "LSP lifecycle gate handling"
        required = false
        ["default"] = "enforce"
        type = "choice"
        options = List("enforce", "record-only")
      }
      typecheck_divergence_mode {
        description = "Typechecker baseline divergence gate handling"
        required = false
        ["default"] = "enforce"
        type = "choice"
        options = List("enforce", "record-only", "skip")
      }
      davinci_dom_corpus_mode {
        description = "Davinci L2 DOM corpus gate handling"
        required = false
        ["default"] = "enforce"
        type = "choice"
        options = List("enforce", "record-only")
      }
    }
  }
  // Nightly full ecosystem sweep. Manual dispatches provide on-demand release evidence.
  schedule = new Listing {
    new Dynamic { cron = "37 5 * * *" }
  }
}

concurrency {
  group = "real-project-matrix-${{ github.ref }}${{ inputs.project && format('-scoped-{0}', inputs.project) || '' }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }
env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}

jobs {
  `plan-projects` = import("jobs/plan-projects.pkl")
  `real-project-matrix` = import("jobs/real-project-matrix.pkl")
  `davinci-dom-corpus` = import("jobs/davinci-dom-corpus.pkl")
  `dom-divergence` = import("jobs/dom-divergence.pkl")
  `ssr-divergence` = import("jobs/ssr-divergence.pkl")
  `reach-divergence` = import("jobs/reach-divergence.pkl")
}
