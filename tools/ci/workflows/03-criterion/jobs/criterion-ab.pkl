import "../../../lib/Actions.pkl" as ci

`if` = "${{ !inputs.production_only && !inputs.level_memory_only }}"
name = "criterion-ab"
`runs-on` = ci.linux
`timeout-minutes` = 120
permissions { contents = "read" }
steps = new Listing {
  ...ci.stageWorkflow("03-criterion")
  new Dynamic {
    name = "Checkout head"
    uses = ci.checkout
    with {
      path = "head"
      ref = "${{ inputs.head_sha }}"
      `fetch-depth` = 0
      `persist-credentials` = false
    }
  }
  new Dynamic {
    name = "Checkout base"
    uses = ci.checkout
    with {
      path = "base"
      ref = "${{ inputs.base_sha }}"
      `persist-credentials` = false
    }
  }
  new Dynamic {
    name = "Validate exact benchmark commits"
    env {
      BASE_SHA = "${{ inputs.base_sha }}"
      HEAD_SHA = "${{ inputs.head_sha }}"
      DISPATCH_SHA = "${{ github.sha }}"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/validate-exact-benchmark-commits.sh""#
  }
  ci.rust("stable")
  // The A/B driver is plain Node (no npm deps); pin the runtime so the
  // script never runs under an unexpected runner-default Node version.
  new Dynamic {
    uses = ci.setupVp
    with {
      version = ci.vpVersion
      `node-version-file` = "head/package.json"
      cache = true
      `run-install` = false
    }
  }
  new Dynamic {
    name = "Select affected Criterion suites"
    id = "impact"
    env {
      PR_BASE_SHA = "${{ inputs.base_sha }}"
      PR_HEAD_SHA = "${{ inputs.head_sha }}"
      VAPOR_ONLY = "${{ inputs.vapor_only }}"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/select-affected-criterion-suites.sh""#
  }
  new Dynamic {
    name = "Setup Wild linker"
    uses = ci.setupWild
    `if` = "steps.impact.outputs.has_suites == 'true'"
    with { `wild-version` = "0.9.0" }
  }
  // Criterion stores base/head build artifacts in isolated subdirectories
  // under head/target, while the surrounding cache keeps both sides warm.
  // The cache action's nested local action resolves from the workspace root,
  // and this job checks the repository out under head/.
  new Dynamic {
    name = "Expose the nested target action at the workspace root"
    run = #". "${{ env.VIZE_CI_FILES }}/expose-the-nested-target-action-at-the-workspace-root.sh""#
  }
  new Dynamic {
    name = "Mount Criterion cache"
    uses = "./head/.github/actions/setup-rust-sticky-cache"
    `if` = "steps.impact.outputs.has_suites == 'true'"
    with {
      key = "criterion-bench"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
      `target-path` = "head/target"
    }
  }
  new Dynamic {
    name = "Cache critcmp"
    id = "cache-critcmp"
    `if` = "steps.impact.outputs.has_suites == 'true'"
    uses = ci.cache
    with {
      path = "~/.cargo/bin/critcmp"
      key = "${{ runner.os }}-critcmp-0.1.8"
    }
  }
  new Dynamic {
    name = "Install critcmp"
    `if` = "steps.impact.outputs.has_suites == 'true' && steps.cache-critcmp.outputs.cache-hit != 'true'"
    run = "cargo install critcmp --version 0.1.8 --locked"
  }
  // The runner compares exported baseline snapshots, so base/head builds do
  // not share one Cargo target graph.
  new Dynamic {
    name = "Run criterion A/B"
    run = #". "${{ env.VIZE_CI_FILES }}/run-criterion-a-b.sh""#
  }
  new Dynamic {
    name = "Install pinned official compiler-vapor"
    `if` = "steps.impact.outputs.vapor_selected == 'true'"
    `working-directory` = "head"
    run = "vp install --filter @vize/bench... --frozen-lockfile --prefer-offline"
  }
  new Dynamic {
    name = "Compare Vapor L3, retained and official compiler on exact head"
    `if` = "steps.impact.outputs.vapor_selected == 'true'"
    env { HEAD_SHA = "${{ inputs.head_sha }}" }
    run = #". "${{ env.VIZE_CI_FILES }}/compare-vapor-l3-retained-and-official-compiler-on-exact-head.sh""#
  }
  new Dynamic {
    name = "Upload criterion A/B summary"
    uses = ci.uploadArtifact
    with {
      name = "criterion-ab"
      path = """
      criterion-ab-summary.md
      head/target/criterion-ab-base.json
      head/target/criterion-ab-head.json
      vapor-compiler-comparison.json
      vapor-compiler-comparison.md

      """
      `if-no-files-found` = "warn"
      `retention-days` = 14
    }
  }
}
