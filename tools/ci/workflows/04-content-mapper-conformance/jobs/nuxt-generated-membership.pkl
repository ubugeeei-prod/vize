import "../../../lib/Actions.pkl" as ci

// Nuxt-generated declarations keep configured membership: the unreferenced,
// referenced, typed-invalid and repair controls run against the native checker
// and stock vue-tsc, and each must exit with its reviewed status.
name = "Nuxt generated declaration membership"
`if` = "${{ github.event_name == 'schedule' || inputs.targeted-test == 'full' }}"
`runs-on` = ci.linux
`timeout-minutes` = 45
env {
  VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/04-content-mapper-conformance/scripts"
  CARGO_INCREMENTAL = "0"
  CARGO_BUILD_JOBS = "12"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { `persist-credentials` = false }
  }
  ci.rust("1.100.0")
  ci.wild()
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "nuxt-generated-membership"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.workspaceVp()
  ci.command("Install pinned stock and native providers", "vp install --frozen-lockfile --prefer-offline")
  new Dynamic {
    name = "Run the native and stock Nuxt membership controls"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_STOCK_VUE_TSC = "${{ github.workspace }}/tests/node_modules/vue-tsc/bin/vue-tsc.js"
      VIZE_NUXT_MEMBERSHIP_ARTIFACTS = "${{ runner.temp }}/nuxt-membership-packets"
    }
    run = "cargo test --locked --profile ci -p vize --test integration check_cli::check_nuxt_generated_computed_map_values_preserve_record_types -- --exact --nocapture"
  }
  new Dynamic {
    name = "Require every executed native and stock control"
    env { PACKETS = "${{ runner.temp }}/nuxt-membership-packets" }
    run = ci.workflowScript("nuxt-membership-require-every-executed-native-stock-and-graph-control.sh")
  }
}
