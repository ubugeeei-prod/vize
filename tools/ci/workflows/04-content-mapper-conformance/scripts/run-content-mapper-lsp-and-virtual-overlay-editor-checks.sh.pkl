amends "../../../lib/ShellScript.pkl"

interpreter = "bash"

commands {
  module.command("cargo", List("test", "-p", "vize", "--test", "integration", "--", "content_mapper_tsgo_lsp::", "--nocapture", "content_mapper_tsgo_lsp_hover::"))
  module.command("cargo", List("test", "-p", "vize", "--test", "integration", "--", "content_mapper_lsp_shutdown::", "--nocapture"))
  module.command("cargo", List("test", "-p", "vize", "--test", "integration", "--", "content_mapper_tsgo_declaration_lsp::", "--nocapture"))
  module.command("cargo", List("test", "-p", "vize", "--test", "integration", "--", "content_mapper_tsgo_lsp_event_forms::", "--nocapture"))
  module.command("cargo", List("test", "-p", "vize_canon", "--test", "lsp_import_resolution", "--", "--nocapture"))
  #"""
  # These package-condition and stale/cancel laws use the installed production
  # native provider, independently of the upstream Content Mapper host above.
  env -u VIZE_TEST_DISABLE_TSGO \
    VIZE_TEST_REQUIRE_TSGO=1 \
    VIZE_TEST_TSGO_PATH="$GITHUB_WORKSPACE/node_modules/@typescript/typescript-linux-x64/lib/tsc" \
    cargo test -p vize_maestro --lib -- \
      ide::definition::component_import::native_target::tests:: \
      server::native_requests::tests::component_targets:: --nocapture
  """#
}
