import "../../lib/Actions.pkl" as ci

name = "Lint reference coverage contracts"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/09-lint-reference-coverage.yml"
      ".github/workflows/real-project-matrix.yml"
      ".github/scripts/workflows/real-project-matrix/**"
      "tools/commands/fixtures/lint-divergence-report.*"
      "tools/support/fixtures/lint_reference_coverage.ts"
      "tools/support/fixtures/lint_divergence/**"
      "tools/support/compat/fixtures/lint-divergence*"
      "tests/_fixtures/differential/linter/reference-coverage-8849/**"
      "tests/_fixtures/differential/lint/**"
      "tests/_fixtures/patina-eslint-vue-rule-map.json"
      "tests/_fixtures/patina-lint-documented-divergences.json"
      "tests/_fixtures/vue-ecosystem-fixtures.json"
      "tests/tooling/docs-all-lint-rules.test.ts"
      "tests/tooling/support/docs-*.ts"
      "docs/scripts/*.ts"
      "docs/scripts/generate-patina-rules-page.ts"
      "docs/scripts/rules/**"
      "docs/content/rules/**"
      "docs/content/ja/rules/**"
      "docs/content/*/rules/**"
      "crates/vize_patina/src/rule.rs"
      "crates/vize_patina/src/rule/**"
      "crates/vize_patina/src/rules/**"
      "crates/vize_patina/src/preset.rs"
      "crates/vize_patina/src/preset/**"
      "crates/vize_patina/src/linter/script_rules/registry.rs"
      "crates/vize_patina/src/linter/script_rules/registry/**"
      "tests/_fixtures/lint-preset-default-warnings/**"
      "tests/tooling/lint-reference-*.test.*"
      "tests/tooling/lint-divergence*.test.*"
      "tests/tooling/lint-baseline-*.test.*"
      "tests/tooling/lint-preset-default-warnings-source.test.mjs"
      "tests/tooling/patina-legacy-instance-api-reference.test.mjs"
      ".config/nextest.toml"
      "crates/vize_patina/src/preset/snapshots/vize_patina__preset__tests__lint_preset_rule_membership.snap"
      "tests/tooling/support/lint-report-parity*"
      "tests/tooling/support/lint-report-scorecard-parity.ts"
      "tests/tooling/_helpers/lint-report-*"
      "tests/tooling/real-project-matrix-workflow.test.ts"
      "tools/benchmarks/scripts/package.json"
      "pnpm-lock.yaml"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "lint-reference-coverage-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }
jobs {
  contracts {
    name = "Actual lint report parity and reference coverage"
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      ci.rust("1.100.0")
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        uses = ci.cache
        with {
          path = """
          ~/.cache/rust-script
          ~/.cargo/registry

          """
          key = "lint-report-reference-${{ runner.os }}-${{ runner.arch }}-1.100.0-49545646-7421901d"
        }
      }
      ci.use("./.github/actions/cache-vp-bootstrap")
      new Dynamic {
        uses = ci.setupBun
        with { `bun-version` = "1.3.14" }
      }
      ci.workspaceVp()
      new Dynamic {
        name = "Install the unchanged pinned reference providers"
        run = "vp install --frozen-lockfile --prefer-offline --ignore-scripts"
      }
      new Dynamic {
        name = "Fetch only the two immutable report references"
        run = "git fetch --no-tags --depth=1 origin 49545646fde08ade1000c4a33b38c9dd1ac4fb99 7421901d05ac2e252636dd8ee426e8783255378d"
      }
      new Dynamic {
        name = "Require strict TypeScript for the actual report and classifier"
        run = "node_modules/@typescript/typescript-linux-x64/lib/tsc --ignoreConfig --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --types node --skipLibCheck --allowImportingTsExtensions tools/commands/fixtures/lint-divergence-report.ts tools/support/fixtures/lint_reference_coverage.ts tests/tooling/lint-baseline-shards.test.ts tests/tooling/lint-composed-contract-bounds.test.ts tests/tooling/lint-divergence-component-registration-intentional.test.ts tests/tooling/lint-divergence-rule-location.test.ts tests/tooling/lint-reference-classifier.test.ts tests/tooling/lint-reference-coverage-workflow.test.ts tests/tooling/_helpers/lint-report-rust-parity.ts tests/tooling/support/lint-report-parity.ts"
      }
      new Dynamic {
        name = "Require actual frozen Rust and TypeScript subprocess parity"
        env { VIZE_LINT_REPORT_PARITY_DIR = "${{ runner.temp }}/lint-report-parity" }
        run = "env -u GITHUB_SHA node --test tests/tooling/support/lint-report-parity.ts"
      }
      new Dynamic {
        name = "Require complete pinned packets, visitors and actual report integrity"
        // pull_request GITHUB_SHA names the synthetic merge; report evidence must
        // resolve the actual authored checkout above through git rev-parse HEAD.
        run = "env -u GITHUB_SHA node --test tests/tooling/lint-reference-classifier.test.ts tests/tooling/lint-reference-coverage-workflow.test.ts tests/tooling/lint-reference-coverage.test.mjs tests/tooling/lint-baseline-script-language.test.mjs tests/tooling/lint-baseline-shards.test.ts tests/tooling/lint-composed-contract-bounds.test.ts tests/tooling/lint-preset-default-warnings-source.test.mjs tests/tooling/patina-legacy-instance-api-reference.test.mjs tests/tooling/lint-divergence-processor.test.mjs tests/tooling/lint-divergence-component-registration-intentional.test.ts tests/tooling/lint-divergence-raw-errors.test.ts tests/tooling/lint-divergence-rule-location.test.ts tests/tooling/lint-divergence-surface-classes.test.ts tests/tooling/lint-divergence-pug-surface.test.ts tests/tooling/lint-divergence-zero-vue-runner.test.ts tests/tooling/lint-divergence-report-runner.test.ts tests/tooling/lint-divergence-report.test.ts tests/tooling/real-project-matrix-workflow.test.ts tests/tooling/docs-all-lint-rules.test.ts"
      }
      new Dynamic {
        name = "Require bounded aggregation and report custody on Bun"
        run = "bun test tests/tooling/lint-baseline-shards.test.ts tests/tooling/lint-composed-contract-bounds.test.ts tests/tooling/lint-divergence-zero-vue-runner.test.ts"
      }
      new Dynamic {
        name = "Retain every real process and whole report comparison"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "lint-report-parity-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/lint-report-parity"
          `if-no-files-found` = "error"
        }
      }
    }
  }
}
