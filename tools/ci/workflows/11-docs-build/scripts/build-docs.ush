# Build the docs site and require the component-preview evidence the build records.
use $bin::{vp}
use std::fs::size

let previews = "docs-render-evidence/component-previews"

vp "run" "--no-cache" "--filter" "./docs" "build"
for evidence in ["browser-evidence.json", "unavailable-storage-evidence.json"] {
  if size (previews + "/" + evidence) == 0 {
    fail 1 ("The docs build recorded an empty " + evidence)
  }
}
