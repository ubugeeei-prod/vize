import "../../lib/Actions.pkl" as ci

name = "Davinci Plugin SDK"

on {
  pull_request {
    branches = List("main", "davinci")
    paths = new Listing {
      "crates/vize/tests/plugin_template_baseline/**"
      "npm/plugin-sdk/**"
      "npm/devtools/**"
      "crates/vize_vitrine/**"
      "crates/vize_croquis/**"
      "tests/tooling/davinci-plugin-*.test.ts"
      "tests/tooling/fixtures/davinci-plugin-sdk/**"
      ".github/workflows/07-plugin-sdk.yml"
    }
  }
  push {
    branches = List("main", "davinci")
    paths = new Listing {
      "crates/vize/tests/plugin_template_baseline/**"
      "npm/plugin-sdk/**"
      "npm/devtools/**"
      "crates/vize_vitrine/**"
      "crates/vize_croquis/**"
      "tests/tooling/davinci-plugin-*.test.ts"
      "tests/tooling/fixtures/davinci-plugin-sdk/**"
      ".github/workflows/07-plugin-sdk.yml"
    }
  }
  workflow_dispatch = null
}
concurrency {
  group = "davinci-plugin-sdk-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }

jobs {
  `plugin-contracts` {
    name = "Native JS plugin contracts (TS-51)"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    steps = new Listing {
      ci.use(ci.checkout)
      ci.workspaceVp()
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "davinci-plugin-sdk"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic { run = "vp install --frozen-lockfile --prefer-offline" }
      new Dynamic {
        name = "Build the actual native JS host"
        `working-directory` = "npm/native"
        run = "vp run build:ci"
      }
      ci.command("Prepare the pinned isolation runtime", "vp exec node tools/support/compat/davinci/plugin-sandbox-image.ts")
      ci.command("Run the author package and native plugin contracts", "vp exec node --test tests/tooling/davinci-plugin-*.test.ts")
      new Dynamic {
        name = "Qualify original plugin records and Doctor component facts"
        run = "cargo test --locked --profile ci-opt -p vize --test plugin_template_baseline -- --nocapture --test-threads=1"
      }
    }
  }
}
