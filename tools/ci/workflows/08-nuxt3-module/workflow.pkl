import "../../lib/Actions.pkl" as ci

name = "Nuxt 3 module build"
// #6830: off the PR tier; merge candidates call it and main runs it per commit.
on {
  push {
    branches = List("main")
    paths = new Listing {
      ".github/workflows/08-nuxt3-module.yml"
      "tools/ci/workflows/08-nuxt3-module/scripts/**"
      "npm/framework/nuxt/**"
      "npm/framework/nuxt-lint-config/**"
      "npm/linter/oxlint/**"
      "npm/builder/vite/**"
      "tools/support/compat/nuxt/fixtures/nuxt3-module-build/**"
      "tools/support/compat/nuxt/nuxt3-module-build.ts"
      "tools/support/compat/nuxt/fixtures/nuxt-component-modes/**"
      "tools/support/compat/nuxt/nuxt-component-modes*"
      "tools/support/compat/nuxt/fixtures/nuxt-environment-api-generate/**"
      "tools/support/compat/nuxt/nuxt-environment-api-generate.ts"
      "tools/support/compat/nuxt/fixtures/nuxt5-runtime-build/**"
      "tools/support/compat/nuxt/nuxt5-runtime-build.ts"
      "tools/support/node-runtime-identity.cjs"
      "tests/tooling/nuxt5-runtime.test.ts"
      "tools/support/compat/nuxt/fixtures/nuxt5-dev-runtime/**"
      "tools/support/compat/nuxt/nuxt5-dev-runtime-build.ts"
      "tools/support/compat/nuxt/development-response.ts"
      "tools/support/compat/nuxt/development-processes.ts"
      "tools/support/compat/nuxt/host-types.ts"
      "tools/support/json-value.ts"
      "tests/tooling/nuxt5-dev-runtime.test.ts"
      "tools/support/compat/nuxt/source-binding*"
      "tools/support/compat/nuxt/prefetch-manifest-*"
      "tools/support/compat/nuxt/lint-config-*"
      "tools/support/compat/nuxt/compiler-defaults-*"
      "tools/support/compat/nuxt/javascript-workspace-*"
      "tests/_fixtures/differential/compat/javascript-workspace-products/**"
      "tests/tooling/support/lsp/javascript-workspace.ts"
      "tools/support/compat/nuxt/relative-glob-*"
      "tools/support/compat/nuxt/fixtures/vite-relative-glob/**"
      "tests/_fixtures/differential/compiler/vite-relative-glob/**"
      "tests/tooling/vite-relative-glob.test.ts"
      "tests/_fixtures/differential/compiler/nuxt-compiler-defaults/**"
      "tests/tooling/nuxt-compiler-defaults.test.mjs"
      "tests/_fixtures/differential/linter/nuxt-oxlint-config-root/**"
      "tests/tooling/nuxt-oxlint-config-root.test.mjs"
      "tools/support/compat/nuxt/fixtures/nuxt-prefetch-manifest/**"
      "tests/_fixtures/differential/compiler/nuxt-prefetch-manifest/**"
      "tests/tooling/nuxt-prefetch-manifest.test.ts"
      "tests/tooling/nuxt-source-binding.test.mjs"
      "tests/tooling/vue-config-nuxt-host-context.test.ts"
      "tests/_fixtures/differential/config/nuxt-elk-host-options/**"
      "npm/native/**"
      "crates/**"
      "davinci/**"
      "Cargo.toml"
      "Cargo.lock"
      ".cargo/**"
    }
  }
  // Merge candidates call this workflow through the required source report.
  workflow_call = null
  workflow_dispatch = null
}
permissions { contents = "read" }

concurrency {
  group = "nuxt3-module-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }

jobs {
  `nuxt3-module-build` {
    name = "Nuxt 3 build and SSR"
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/08-nuxt3-module/scripts"
    }
    steps = new Listing {
      ci.use(ci.checkout)
      ci.workspaceVp()
      ci.command("Install workspace tooling", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // master
        with { toolchain = "1.100.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "nuxt3-source-native"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      ci.command("Build and capture the actual source native compiler", "vp run --no-cache --filter './npm/native' build:debug")
      new Dynamic {
        name = "Build the candidate Vite adapter"
        `working-directory` = "npm/builder/vite"
        run = "vp pack"
      }
      new Dynamic {
        name = "Build the candidate Nuxt lint preset"
        `working-directory` = "npm/framework/nuxt-lint-config"
        run = "vp pack"
      }
      new Dynamic {
        name = "Build the candidate Oxlint bridge"
        `working-directory` = "npm/linter/oxlint"
        run = "vp pack"
      }
      new Dynamic {
        name = "Build the candidate Nuxt integration"
        `working-directory` = "npm/framework/nuxt"
        run = "vp pack"
      }
      new Dynamic {
        name = "Verify inherited compiler option precedence"
        run = "vp env exec node --test npm/framework/nuxt/src/compiler-defaults.test.ts"
      }
      new Dynamic {
        name = "Verify complete Nuxt host filter projection and strict native boundaries"
        run = "vp env exec node --test tests/tooling/vue-config-nuxt-host-context.test.ts"
      }
      new Dynamic {
        name = "Install the pinned Nuxt 3 reproduction"
        `working-directory` = "tools/support/compat/nuxt/fixtures/nuxt3-module-build"
        run = "npm ci --no-audit --no-fund"
      }
      ci.use("./.github/actions/setup-ubuntu-archive")
      new Dynamic {
        name = "Install Chromium for the PR Nuxt runtime check"
        `if` = "${{ github.event_name == 'pull_request' }}"
        `working-directory` = "tests"
        run = "vize-ci-apt-retry vp exec playwright install --with-deps chromium"
      }
      new Dynamic {
        name = "Download Chromium dependencies while building the current CLI"
        `if` = "${{ github.event_name != 'pull_request' }}"
        run = ci.workflowScript("download-chromium-dependencies-while-building-the-current-cli.sh")
      }
      new Dynamic {
        name = "Verify candidate build and SSR routes"
        run = #"vp env exec node tools/support/compat/nuxt/nuxt3-module-build.ts "$RUNNER_TEMP/nuxt3-module-proof""#
      }
      // Source-bound Nuxt 3 SSR, hydration and navigation remain on every
      // affected PR. The complete historical and multi-host campaign runs
      // before merging, and on main/manual qualification.
      new Dynamic {
        name = "Install the unchanged pinned Nuxt 4 dependency cohort"
        `if` = "${{ github.event_name != 'pull_request' }}"
        `working-directory` = "tests/_fixtures/_projects/nuxt-critical-css-build"
        run = "npm ci --no-audit --no-fund"
      }
      new Dynamic {
        name = "Verify original SPA manifest and physical prefetch with the source compiler"
        `if` = "${{ github.event_name != 'pull_request' }}"
        run = #"vp env exec node tools/support/compat/nuxt/prefetch-manifest-build.mjs "$RUNNER_TEMP/nuxt-prefetch-proof""#
      }
      new Dynamic {
        name = "Verify original Nuxt lint configuration with the source linter"
        `if` = "${{ github.event_name != 'pull_request' }}"
        run = ci.workflowScript("verify-original-nuxt-lint-configuration-with-the-source.sh")
      }
      new Dynamic {
        name = "Verify original Nuxt scoped compiler defaults and whole rendered outputs"
        `if` = "${{ github.event_name != 'pull_request' }}"
        run = ci.workflowScript("verify-original-nuxt-scoped-compiler-defaults-and-whole.sh")
      }
      new Dynamic {
        name = "Install the unchanged reported Vite 8.2.2 dependency cohort"
        `if` = "${{ github.event_name != 'pull_request' }}"
        `working-directory` = "tools/support/compat/nuxt/fixtures/vite-relative-glob"
        run = "npm ci --no-audit --no-fund"
      }
      new Dynamic {
        name = "Verify original relative glob keys and outside-root Vite and Nuxt runtime"
        `if` = "${{ github.event_name != 'pull_request' }}"
        run = ci.workflowScript("verify-original-relative-glob-keys-and-outside-root-vite.sh")
      }
      new Dynamic {
        name = "Capture the current CLI for the JavaScript workspace consumers"
        `if` = "${{ github.event_name != 'pull_request' }}"
        run = "vp env exec node tests/differential/build-receipt.ts"
      }
      new Dynamic {
        name = "Verify real JavaScript Nuxt and Vite workspace products"
        `if` = "${{ github.event_name != 'pull_request' }}"
        run = ci.workflowScript("verify-real-javascript-nuxt-and-vite-workspace-products.sh")
      }
      new Dynamic {
        name = "Capture the source producer Node executable"
        id = "nuxt-source-runtime"
        run = ci.workflowScript("capture-the-source-producer-node-executable.sh")
      }
      new Dynamic {
        name = "Use the reported Node version for the additional Nuxt 5 consumer"
        uses = ci.setupNode
        with {
          `node-version` = "26.13.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Install the pinned Nuxt component-mode reproduction"
        `working-directory` = "tools/support/compat/nuxt/fixtures/nuxt-component-modes"
        run = "npm ci --no-audit --no-fund"
      }
      new Dynamic {
        name = "Verify server component selection in development and production"
        run = #"node tools/support/compat/nuxt/nuxt-component-modes.ts "$RUNNER_TEMP/nuxt-component-modes-proof""#
      }
      new Dynamic {
        name = "Verify client-only generate through the Vite Environment API"
        run = #"node tools/support/compat/nuxt/nuxt-environment-api-generate.ts "$RUNNER_TEMP/nuxt-environment-api-proof""#
      }
      new Dynamic {
        name = "Verify SSR environment ownership and original Nuxt 5 inputs"
        run = ci.workflowScript("verify-ssr-environment-ownership-and-original-nuxt-5.sh")
      }
      // The peer declaration and Nitro dev compatibility remain separate #11795 gates.
      new Dynamic {
        name = "Install the frozen Nuxt 5 production reproduction"
        `working-directory` = "tools/support/compat/nuxt/fixtures/nuxt5-runtime-build"
        shell = "bash"
        run = ci.workflowScript("install-the-frozen-nuxt-5-production-reproduction.sh")
      }
      new Dynamic {
        name = "Verify source-bound Nuxt 5 browser and isolated server output"
        env {
          VIZE_NUXT_SOURCE_NODE = "${{ steps.nuxt-source-runtime.outputs.path }}"
          VIZE_NUXT_SOURCE_NODE_SHA256 = "${{ steps.nuxt-source-runtime.outputs.sha256 }}"
        }
        run = ci.workflowScript("verify-source-bound-nuxt-5-browser-and-isolated-server-output.sh")
      }
      new Dynamic {
        name = "Verify Nitro plugin ownership and frozen development inputs"
        run = ci.workflowScript("verify-nitro-plugin-ownership-and-frozen-development.sh")
      }
      new Dynamic {
        name = "Install the frozen Nuxt 5 development reproduction"
        `working-directory` = "tools/support/compat/nuxt/fixtures/nuxt5-dev-runtime"
        shell = "bash"
        run = ci.workflowScript("install-the-frozen-nuxt-5-development-reproduction.sh")
      }
      new Dynamic {
        name = "Verify source-bound Nuxt 5 development stylesheets and hydration"
        env {
          VIZE_NUXT_SOURCE_NODE = "${{ steps.nuxt-source-runtime.outputs.path }}"
          VIZE_NUXT_SOURCE_NODE_SHA256 = "${{ steps.nuxt-source-runtime.outputs.sha256 }}"
        }
        run = ci.workflowScript("verify-source-bound-nuxt-5-development-stylesheets-and-hydration.sh")
      }
      new Dynamic {
        name = "Upload Nuxt 3 build and SSR evidence"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "nuxt3-module-proof-${{ github.sha }}"
          path = """
          ${{ runner.temp }}/nuxt3-module-proof
          ${{ runner.temp }}/nuxt-component-modes-proof
          ${{ runner.temp }}/nuxt-environment-api-proof
          ${{ runner.temp }}/nuxt-prefetch-proof
          ${{ runner.temp }}/nuxt-lint-config-proof
          ${{ runner.temp }}/nuxt-compiler-defaults-proof
          ${{ runner.temp }}/vite-relative-glob-proof
          ${{ runner.temp }}/javascript-workspace-proof
          ${{ runner.temp }}/nuxt5-runtime-proof
          ${{ runner.temp }}/nuxt5-dev-runtime-proof

          """
          `if-no-files-found` = "ignore"
        }
      }
    }
  }
}
