import "../../lib/Actions.pkl" as ci

name = "Fresco"

// Cross-platform lanes for the Fresco terminal UI stack (#3113 M0).
//
// The Linux workspace gates in 01-check.yml already run the Fresco JS
// check/build/test tasks and `cargo test --workspace`. Terminal behavior is
// platform-sensitive (console backends, IME platform modules, path and shell
// differences), so this workflow re-runs the focused Fresco suites nightly
// and on explicit dispatch across Linux, macOS, and Windows.
//
on {
  schedule = new Listing {
    new Dynamic { cron = "11 6 * * *" }
  }
  workflow_dispatch = null
}
concurrency {
  group = "fresco-${{ github.workflow }}-${{ github.event.pull_request.number || format('{0}-{1}', github.event_name, github.sha) }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}

jobs {
  `fresco-js` {
    name = "Fresco JS (${{ matrix.platform.target }})"
    `runs-on` = "${{ matrix.platform.runner }}"
    `timeout-minutes` = 20
    strategy {
      `fail-fast` = false
      matrix {
        platform = new Listing {
          new Dynamic {
            runner = ci.linux
            target = "linux-x64-gnu"
          }
          new Dynamic {
            runner = ci.macos
            target = "darwin-arm64"
          }
          new Dynamic {
            runner = ci.windows
            target = "win32-x64-msvc"
          }
        }
      }
    }
    env { NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169" }
    // Windows runner images enable autocrlf globally; a CRLF checkout makes
    // the formatter flag every file, so normalize before checking out.
    steps = new Listing {
      new Dynamic {
        name = "Force LF line endings on checkout (Windows)"
        `if` = "runner.os == 'Windows'"
        run = "git config --global core.autocrlf false"
      }
      ci.use(ci.checkout)
      ci.workspaceVp()
      ci.command("Install Fresco JS dependencies", "vp install --frozen-lockfile --prefer-offline --filter './npm/fresco...'")
      ci.command("Check Fresco JS", "vp run --filter './npm/fresco' check")
      ci.command("Build Fresco JS", "vp run --filter './npm/fresco' build")
      ci.command("Test Fresco JS", "vp run --filter './npm/fresco' test")
    }
  }

  `fresco-rust` {
    name = "Fresco Rust (${{ matrix.platform.target }})"
    `runs-on` = "${{ matrix.platform.runner }}"
    `timeout-minutes` = 30
    strategy {
      `fail-fast` = false
      matrix {
        platform = new Listing {
          new Dynamic {
            runner = ci.linux
            target = "linux-x64-gnu"
          }
          new Dynamic {
            runner = ci.macos
            target = "darwin-arm64"
          }
          new Dynamic {
            runner = ci.windows
            target = "win32-x64-msvc"
          }
        }
      }
    }
    // Keep both lanes on byte-identical LF sources (see the JS lane note).
    steps = new Listing {
      new Dynamic {
        name = "Force LF line endings on checkout (Windows)"
        `if` = "runner.os == 'Windows'"
        run = "git config --global core.autocrlf false"
      }
      ci.use(ci.checkout)
      new Dynamic {
        name = "Setup MSVC toolchain (Windows)"
        `if` = "runner.os == 'Windows'"
        uses = "ilammy/msvc-dev-cmd@0b201ec74fa43914dc39ae48a89fd1d8cb592756"  // v1
        with { arch = "amd64" }
      }
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        `if` = "runner.os == 'Linux'"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        `if` = "runner.os == 'Linux'"
        with {
          key = "fresco-rust"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        uses = "Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32"  // v2
        `if` = "runner.os != 'Linux'"
        with {
          `shared-key` = "fresco-rust-${{ matrix.platform.target }}"
          `cache-workspace-crates` = "true"
        }
      }
      ci.command("Test vize_fresco", "cargo test -p vize_fresco")
    }
  }
}
