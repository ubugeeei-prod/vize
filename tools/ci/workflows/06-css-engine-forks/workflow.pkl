import "../../lib/Actions.pkl" as ci

name = "CSS engine forks"
on {
  pull_request {
    paths = new Listing {
      "Cargo.lock"
      "upstream/forks/lightningcss/**"
      "upstream/forks/parcel_sourcemap/**"
      ".github/workflows/06-css-engine-forks.yml"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
defaults {
  run { shell = "bash" }
}
concurrency {
  group = "css-vendor-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
env {
  CARGO_TERM_COLOR = "never"
  CARGO_BUILD_JOBS = "12"
  CARGO_PROFILE_DEV_DEBUG = "0"
  CARGO_PROFILE_TEST_DEBUG = "0"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}

// The workspace test archive builds the vendored CSS engine forks with their
// default features. This job runs their complete upstream suites with every
// feature enabled, in both the debug-assertion and the release profile, when
// the forks or the locked dependency graph change.
jobs {
  engine {
    name = "CSS engines (${{ matrix.profile }})"
    `runs-on` = ci.linux
    `timeout-minutes` = 35
    strategy {
      `fail-fast` = false
      matrix {
        profile = List("dev", "release")
      }
    }
    steps = new Listing {
      ci.use(ci.checkout)
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "engines-${{ matrix.profile }}"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Run the complete LightningCSS fork suite"
        run = "cargo test --locked -p vize_lightningcss --all-features --profile ${{ matrix.profile }} --lib --tests"
      }
      new Dynamic {
        name = "Run the source-map fork archive contracts"
        `if` = "${{ !cancelled() }}"
        run = "cargo test --locked -p vize_parcel_sourcemap --features json --profile ${{ matrix.profile }}"
      }
    }
  }
}
