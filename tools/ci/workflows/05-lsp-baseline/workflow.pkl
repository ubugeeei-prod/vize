import "../../lib/Actions.pkl" as ci

name = "Current-source LSP baseline"

// Finite, manually approved RPC baseline. Ordinary PR checks run pure controls.
on {
  workflow_dispatch {
    inputs {
      source_sha {
        description = "Exact reviewed source SHA (must equal the dispatched ref)"
        required = true
        type = "string"
      }
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "lsp-current-baseline-${{ inputs.source_sha }}"
  `cancel-in-progress` = false
}

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
}

jobs {
  misskey {
    `runs-on` = ci.linux
    `timeout-minutes` = 40
    env {

      VIZE_BASELINE_EXPECTED_SOURCE = "${{ inputs.source_sha }}"
      VIZE_PERF_BUDGET_SCALE = "1"
      RAYON_NUM_THREADS = "4"
    }
    steps = new Listing {
      ...ci.stageWorkflow("05-lsp-baseline")
      ci.checkoutAt("${{ inputs.source_sha }}")
      new Dynamic {
        name = "Refuse a stale or different dispatch source"
        shell = "bash"
        run = ci.workflowScript("refuse-a-stale-or-different-dispatch-source.sh")
      }
      ci.workspaceVp()
      ci.command("Install locked JavaScript and native TypeScript dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.command("Hydrate only the pinned Misskey fixture", "git submodule update --init --depth 1 tests/_fixtures/_git/misskey")
      new Dynamic {
        name = "Install repository Rust toolchain"
        run = ci.workflowScript("install-repository-rust-toolchain.sh")
      }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "lsp-current-baseline"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Build and receipt the exact current source server"
        run = ci.workflowScript("build-and-receipt-the-exact-current-source-server.sh")
      }
      new Dynamic {
        name = "Qualify pure observation and refusal laws"
        run = "node --test tests/tooling/lsp-current-baseline*.test.ts tests/tooling/lsp-session-capture.test.ts"
      }
      ci.command("Measure three serial fresh sessions with all original checks", "node tests/performance/lsp-current-baseline.ts")
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "lsp-current-baseline-${{ github.run_id }}-${{ github.run_attempt }}-${{ inputs.source_sha }}"
          path = """
          target/vize-tests/lsp-current-baseline/
          target/differential/lsp-sessions/

          """
          `if-no-files-found` = "error"
          `retention-days` = 3
        }
      }
    }
  }
}
