amends "../../../lib/ShellScript.pkl"

interpreter = "bash"

commands {
  module.command("cargo", List("test", "-p", "vize_armature", "--features", "native-lex-parity,legacy", "--lib", "--test", "markup_lex_parity", "--no-run"))
  module.command("cargo", List("test", "-p", "vize_l1", "--features", "legacy-differential", "--test", "surface_corpus", "--no-run"))
}
