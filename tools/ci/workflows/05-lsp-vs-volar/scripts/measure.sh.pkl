amends "../../../lib/ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  tools="$RUNNER_TEMP/tools/node_modules"
  rounds="$ROUNDS"
  cycles="$CYCLES"
  # Keep the 10,000-block SFC in PR correctness coverage without making
  # every benchmark change repeat its full dispatch-only sample budget.
  if [ "$GITHUB_EVENT_NAME" = pull_request ] && [ "$JOB" = scale-giant-sfc ]; then
    rounds=1
    cycles=1
  fi
  tsrs_fast="$RUNNER_TEMP/tsrs-fast"
  printf '#!/bin/sh\nexport TSRS_FAST=1\nexec "%s" "$@"\n' "$tools/.bin/tsrs" > "$tsrs_fast"
  chmod +x "$tsrs_fast"
  args=(
    --vize "head=$RUNNER_TEMP/vize-head"
    --vize "head-tsrs-fast=$RUNNER_TEMP/vize-head"
    --vize-env "head-tsrs-fast:CORSA_PATH=$tsrs_fast"
  )
  for id in $FIXTURE_IDS; do args+=(--fixture "$id"); done
  if [ -n "$COMPARE_REF" ]; then
    args+=(
      --vize "compare=$RUNNER_TEMP/vize-compare"
      --vize "compare-tsrs-fast=$RUNNER_TEMP/vize-compare"
      --vize-env "compare-tsrs-fast:CORSA_PATH=$tsrs_fast"
      --meta "compare=$COMPARE_REF"
    )
  fi
  if [ -n "$TSGO_MAPPER" ]; then
    # The mapper row reads the project's own TypeScript native host, not vize's pin.
    args+=(--tsgo-mapper "$RUNNER_TEMP/mapper/node_modules/@typescript/typescript-linux-x64/lib/tsc")
    args+=(--tsgo-mapper-version "$TSGO_MAPPER" --mapper-modules "$RUNNER_TEMP/mapper/node_modules")
    while read -r name version; do args+=(--meta "$name=$version"); done < "$RUNNER_TEMP/mapper/versions.txt"
  fi
  for assignment in $VIZE_ENV; do
    args+=(--vize-env "head:$assignment" --meta "env=$assignment")
    args+=(--vize-env "head-tsrs-fast:$assignment")
    if [ -n "$COMPARE_REF" ]; then
      args+=(--vize-env "compare:$assignment" --vize-env "compare-tsrs-fast:$assignment")
    fi
  done
  if [ "$TSSERVER_PLUGIN" = true ]; then
    args+=(--tsserver-plugin "head=$RUNNER_TEMP/tsserver-plugin")
    if [ -n "$COMPARE_REF" ]; then
      args+=(--tsserver-plugin "compare=$RUNNER_TEMP/tsserver-plugin-compare")
    fi
  fi
  while read -r name version; do args+=(--meta "$name=$version"); done < "$RUNNER_TEMP/tools/versions.txt"
  # Below 16 GiB available the session is killed and reported, so no server takes the runner down.
  args+=(--memory-reserve-gib 16 --meta "memory-reserve=16GiB")
  free -g; df -h /tmp "$RUNNER_TEMP"
  taskset -c "0-$((CPUS - 1))" node tools/benchmarks/scripts/lsp-vs-volar.ts "${args[@]}" \
    --tsgo "$tools/@typescript/typescript-linux-x64/lib/tsc" --volar-root "$RUNNER_TEMP/tools" \
    --fixtures-dir "$RUNNER_TEMP/projects" --rounds "$rounds" --cycles "$cycles" \
    --meta "head=$(git rev-parse HEAD)" --meta "cpus=$CPUS" \
    --meta "rounds=$rounds" --meta "cycles=$cycles" \
    --out "lsp-vs-volar-$JOB.md" --json "lsp-vs-volar-$JOB.json" --logs "lsp-vs-volar-logs-$JOB"
  cat "lsp-vs-volar-$JOB.md" >> "$GITHUB_STEP_SUMMARY"
  if [[ " $FIXTURE_IDS " == *" scale-5k "* ]]; then
    node tools/benchmarks/scripts/lsp-vs-volar-convergence.ts \
      --json "lsp-vs-volar-$JOB.json" --fixture scale-5k
  fi
  """#
}
