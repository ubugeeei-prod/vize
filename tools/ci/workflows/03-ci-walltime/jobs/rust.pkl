import "../../../lib/Actions.pkl" as ci

`if` = "${{ (github.event_name == 'pull_request' && (github.event.label.name == 'ci-walltime-benchmark' || (github.event.action != 'labeled' && startsWith(github.head_ref, 'ci/optimize-')))) || (github.event_name == 'workflow_dispatch' && (inputs.component == 'all' || inputs.component == 'rust')) }}"
`runs-on` = ci.linux
`timeout-minutes` = 90
env {
  VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/03-ci-walltime/scripts"
  CARGO_BUILD_JOBS = "12"
  VIZE_NUXT_CONFIG_ITERATIONS = "100"
  VIZE_TEST_REQUIRE_TSGO = "1"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { ref = "${{ github.sha }}" }
  }
  ci.rust("stable")
  ci.wild()
  new Dynamic {
    uses = ci.setupVp
    with {
      version = ci.vpVersion
      `node-version-file` = "package.json"
      cache = true
      `run-install` = true
    }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "clippy-test"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.use("./.github/actions/setup-rust-script")
  new Dynamic {
    uses = "taiki-e/install-action@184183c2401be73c3bf42c2e61268aa5855379c1"  // v2
    with { tool = "cargo-nextest@0.9.146" }
  }
  ci.command("Install the existing Pkl fixture runtime", "npm install --global @pkl-community/pkl@0.27.2")
  new Dynamic {
    name = "Compile identical full-workspace test binaries once"
    run = #". "${{ env.VIZE_CI_FILES }}/compile-identical-full-workspace-test-binaries-once.sh""#
  }
  new Dynamic {
    name = "Serial full workspace including doctests"
    run = "node tools/support/compat/github/run-rust-workspace-tests.ts --runner cargo --output target/ci-walltime/rust-cargo.json"
  }
  new Dynamic {
    name = "Concurrent full workspace including doctests"
    `if` = "${{ !cancelled() }}"
    run = "node tools/support/compat/github/run-rust-workspace-tests.ts --runner nextest --output target/ci-walltime/rust-nextest.json"
  }
  new Dynamic {
    name = "Preserve both workspace timings and complete nextest results"
    `if` = "${{ always() }}"
    uses = ci.uploadArtifact
    with {
      name = "ci-walltime-rust-${{ github.sha }}"
      path = """
      target/ci-walltime/
      target/nextest/full/

      """
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
}
