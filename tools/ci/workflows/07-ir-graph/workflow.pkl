import "../../lib/Actions.pkl" as ci

name = "Davinci IR graph queries"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/07-ir-graph.yml"
      "tests/formal/ir-graph/**"
      "tests/formal/position-index/**"
      "tools/ci/workflows/07-ir-graph/scripts/**"
      "crates/vize_maestro/src/document/store.rs"
      "crates/vize_maestro/src/source_project/query.rs"
      "crates/vize_maestro/src/source_project/scoped_component.rs"
      "crates/vize_maestro/src/source_project/snapshot.rs"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "ir-graph-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  models {
    name = "Reachability theory and snapshot publication"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ...ci.stageWorkflow("07-ir-graph")
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        name = "Install pinned standalone model checkers"
        `working-directory` = "${{ runner.temp }}"
        run = ci.workflowProgram("install-pinned-standalone-model-checkers")
      }
      new Dynamic {
        name = "Check resident template decisions across source edits"
        `working-directory` = "tests/formal/ir-graph"
        run = ci.workflowProgram("check-resident-template-decisions-across-source-edits")
      }
      new Dynamic {
        name = "Check the unbounded theorem and bounded models"
        `working-directory` = "tests/formal/ir-graph"
        run = ci.workflowProgram("check-the-unbounded-theorem-and-bounded-models")
      }
    }
  }
}
