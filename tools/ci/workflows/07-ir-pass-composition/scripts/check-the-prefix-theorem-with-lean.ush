# Install the pinned Lean release and check the template-lint prefix theorems with the axioms each may use.
use $bin::{curl, grep, sha256sum, tar, tee}
use std::process::exec

let theorem = $"$env::GITHUB_WORKSPACE/tests/formal/template-lint/Selection.lean"

curl -fsSL --retry 3 -o lean.tar.zst https://github.com/leanprover/lean4/releases/download/v4.33.1/lean-4.33.1-linux.tar.zst
"890afd185370f85666025b883914ab4f4b339136f8c96167b69cfb62aecaf235  lean.tar.zst\n" | sha256sum --check
tar --zstd -xf lean.tar.zst
exec lean-4.33.1-linux/bin/lean ["-DwarningAsError=true", theorem] | tee theorem.log
grep -Fx "'Davinci.TemplateLint.fold_prefix' depends on axioms: [propext]" theorem.log
grep -Fx "'Davinci.TemplateLint.labels_exact' depends on axioms: [propext, Classical.choice, Quot.sound]" theorem.log
