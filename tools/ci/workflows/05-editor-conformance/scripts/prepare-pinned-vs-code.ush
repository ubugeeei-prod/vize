# Download the pinned VS Code build, installing a virtual display first if the runner lacks one.
use $bin::{command, sudo, timeout, vp, "vize-ci-apt-retry" as apt_retry}
use std::io::to_file

if ! command -v xvfb-run |& to_file "/dev/null" {
  apt_retry sudo apt-get update
  apt_retry sudo apt-get install -y xvfb
}
# Quoted, because a bare 300s is a ush quantity literal.
timeout --signal=TERM --kill-after=10s "300s" vp run --workspace-root test:vscode-extension:download
