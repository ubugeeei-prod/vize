# Verify the downloaded server's digest, producer and manifest for this commit, and hand its path to later steps.
mod "../../../lib/github.ush" as github
use $bin::{chmod, grep, node, sha256sum}

let server = $"$env::RUNNER_TEMP/vize-server"

cd $server {
  sha256sum --check vize.sha256
}
grep -Fx $"producer=$env::GITHUB_SHA" $"$server/vize-producer.txt"
node tests/editor-conformance/server-artifact.ts verify $"$server/vize" $"$server/server.json" $env::GITHUB_SHA
chmod +x $"$server/vize"
github::export_env VIZE_SERVER_PATH $"$server/vize"
