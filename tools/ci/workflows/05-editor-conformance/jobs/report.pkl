import "../../../lib/Actions.pkl" as ci

name = "TS-45 results"
needs = "conformance"
`if` = "always()"
`runs-on` = ci.linux
`timeout-minutes` = 10
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { `persist-credentials` = false }
  }
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      cache = false
      `run-install` = false
    }
  }
  new Dynamic {
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      pattern = "ts45-*"
      `merge-multiple` = true
      path = "${{ runner.temp }}/ts45"
    }
  }
  new Dynamic {
    name = "Render the multi-client table"
    run = #"node tests/editor-conformance/report.ts "${RUNNER_TEMP}/ts45" --require helix,neovim,vscode,zed"#
  }
}
