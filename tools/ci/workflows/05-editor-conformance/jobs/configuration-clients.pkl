import "../../../lib/Actions.pkl" as ci

name = "Project configuration ${{ matrix.client }}"
needs = "server"
`runs-on` = ci.linux
`timeout-minutes` = 15
strategy {
  `fail-fast` = false
  matrix {
    client = List("vim", "emacs")
  }
}
env {
  VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/05-editor-conformance/scripts"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { `persist-credentials` = false }
  }
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      cache = false
      `run-install` = false
    }
  }
  new Dynamic {
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "vize-server"
      path = "${{ runner.temp }}/vize-server"
    }
  }
  new Dynamic {
    name = "Verify the source-built server"
    run = ci.workflowProgram("verify-the-source-built-server-2")
  }
  ci.use("./.github/actions/setup-ubuntu-archive")
  new Dynamic {
    name = "Install the actual client"
    env { CLIENT = "${{ matrix.client }}" }
    run = ci.workflowProgram("install-the-actual-client")
  }
  new Dynamic {
    name = "Install pinned vim-lsp"
    `if` = "matrix.client == 'vim'"
    env { VIM_LSP_COMMIT = "474c656659b5fb51eec6770309e0211c8aa49b5b" }
    run = ci.workflowProgram("install-pinned-vim-lsp")
  }
  new Dynamic {
    name = "Qualify serialized profiles against the verified server"
    run = #"node tests/editor-conformance/named-profiles.ts "${{ matrix.client }}" "${RUNNER_TEMP}/configuration-client/named-profiles""#
  }
  new Dynamic {
    name = "Exercise project configuration through the actual client"
    env {
      CLIENT = "${{ matrix.client }}"
      VIZE_TEST_VIM_LSP_PATH = "${{ runner.temp }}/vim-lsp"
      VIZE_VIM_ARTIFACT_DIR = "${{ runner.temp }}/configuration-client"
      VIZE_EMACS_ARTIFACT_DIR = "${{ runner.temp }}/configuration-client"
    }
    run = ci.workflowProgram("exercise-project-configuration-through-the-actual-client")
  }
  new Dynamic {
    uses = ci.uploadArtifact
    `if` = "always()"
    with {
      name = "configuration-${{ matrix.client }}"
      overwrite = true
      `if-no-files-found` = "error"
      path = "${{ runner.temp }}/configuration-client"
      `retention-days` = 14
    }
  }
}
