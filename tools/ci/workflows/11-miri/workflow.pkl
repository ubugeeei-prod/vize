import "../../lib/Actions.pkl" as ci

name = "Miri"
`run-name` = "${{ github.event_name == 'workflow_dispatch' && format('Miri @ {0}', github.sha) || format('Miri scheduled @ {0}', github.sha) }}"

on {
  workflow_dispatch = null
  schedule = new Listing {
    new Dynamic { cron = "41 3 * * *" }
  }
}
concurrency {
  group = "miri-${{ github.workflow }}-${{ github.event_name }}-${{ github.ref }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  MIRIFLAGS = "-Zmiri-ignore-leaks"
}

jobs {
  miri {
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "nightly"
          components = "miri,rust-src"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "miri"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
          `target-path` = "target/miri"
        }
      }
      ci.command("Setup Miri", "cargo +nightly miri setup")
      ci.command("Test VDOM transform with Miri", "cargo +nightly miri test -p vize_atelier_core --test scoped_slot_shadowing")
      new Dynamic {
        name = "Test DOM transform with Miri"
        run = #"cargo +nightly miri test -p vize_atelier_dom --test integration "setup_component_unref::""#
      }
      new Dynamic {
        name = "Test SFC transform with Miri"
        run = "cargo +nightly miri test -p vize_atelier_sfc --test setup_component_unref --no-default-features"
      }
      // Davinci P1-11: the batch pool hands one arena to file after file, so a
      // value that outlived its compile would read recycled bytes. Miri is the
      // lane that reports that for real — it caught a Stacked Borrows violation
      // in the first draft of `Allocator::alloc_owned`.
      ci.command("Test the batch arena pool with Miri", "cargo +nightly miri test -p vize_carton --lib -- allocator pool")
      new Dynamic {
        name = "Test pooled SFC compiles with Miri"
        run = "cargo +nightly miri test -p vize_atelier_sfc --test davinci_arena_pool --no-default-features"
      }
    }
  }
  // The lent walk restores oxc's callback borrows to the walked root's
  // lifetime (`vize_patina/src/lent_walk.rs`). Its tests keep every lent node
  // past the walk, so Miri checks each widened reference under the aliasing
  // model. Only the `lent_walk::tests` module runs.
  `patina-lent-walk` {
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "nightly"
          components = "miri,rust-src"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "miri-patina"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
          `target-path` = "target/miri"
        }
      }
      ci.command("Setup Miri", "cargo +nightly miri setup")
      ci.command("Test the lent walk with Miri", "cargo +nightly miri test -p vize_patina --lib -- lent_walk::tests")
    }
  }
  // A shared script parse stores its oxc tree with the lifetime erased next
  // to the boxed text and arena it borrows (`vize_croquis/src/script_parser/
  // shared.rs`). Its tests keep parses past nested reads, list growth and the
  // scope's drop, so Miri checks the erased borrow, the owned source pointer
  // and the drop order. Only the `script_parser::shared::tests` module runs.
  `croquis-shared-parse` {
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "nightly"
          components = "miri,rust-src"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "miri-croquis"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
          `target-path` = "target/miri"
        }
      }
      ci.command("Setup Miri", "cargo +nightly miri setup")
      ci.command("Test shared script parses with Miri", "cargo +nightly miri test -p vize_croquis --lib -- script_parser::shared::tests")
    }
  }
}
