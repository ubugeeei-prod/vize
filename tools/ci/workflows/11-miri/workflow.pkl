// Temporary source-bound verifier driver; production Miri configuration is unchanged.
`name` = "Unsafe source Miri evidence"
`on` = new Dynamic {
  `workflow_dispatch` = new Dynamic {
    `inputs` = new Dynamic {
      `source_sha` = new Dynamic {
        `required` = true
        `type` = "string"
      }
      `package` = new Dynamic {
        `required` = true
        `type` = "choice"
        `options` = new Listing {
          "vize_patina"
          "vize_fresco"
        }
      }
    }
  }
}
`permissions` = new Dynamic { `contents` = "read" }
`env` = new Dynamic {
  `CARGO_TERM_COLOR` = "always"
  `FORCE_JAVASCRIPT_ACTIONS_TO_NODE24` = true
  `MIRIFLAGS` = "-Zmiri-ignore-leaks"
  `CARGO_TARGET_DIR` = "${{ github.workspace }}/source/target/miri"
  `PRODUCT_SOURCE_SHA` = "${{ inputs.source_sha }}"
  `PRODUCT_PACKAGE` = "${{ inputs.package }}"
}
`jobs` = new Dynamic {
  `verify` = new Dynamic {
    `name` = "Actual ${{ inputs.package }} kernel and tests"
    `runs-on` = "blacksmith-16vcpu-ubuntu-2404"
    `timeout-minutes` = 20
    `steps` = new Listing {
      new Dynamic {
        `uses` = "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
        `with` = new Dynamic {
          `ref` = "${{ github.workflow_sha }}"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        `uses` = "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
        `with` = new Dynamic {
          `ref` = "${{ inputs.source_sha }}"
          `path` = "source"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        `uses` = "actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38"
        `with` = new Dynamic { `node-version` = "24" }
      }
      new Dynamic {
        `uses` = "dtolnay/rust-toolchain@d1031067263f94b142dd6c0ce24c5eb9d02d52a0"
        `with` = new Dynamic {
          `toolchain` = "nightly"
          `components` = "miri,rust-src"
        }
      }
      new Dynamic {
        `uses` = "./source/.github/actions/setup-rust-sticky-cache"
        `with` = new Dynamic {
          `key` = "miri"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
          `target-path` = "source/target/miri"
        }
      }
      new Dynamic {
        `name` = "Setup Miri"
        `working-directory` = "source"
        `run` = "cargo miri setup"
      }
      new Dynamic {
        `name` = "Bind immutable source and verifier before execution"
        `run` = "node tools/ci/commands/unsafe-miri-source.ts before"
      }
      new Dynamic {
        `name` = "Run the original Miri command on the actual selected tests"
        `run` = "node tools/ci/commands/unsafe-miri-source.ts run"
      }
      new Dynamic {
        `name` = "Verify unchanged source and verifier after execution"
        `if` = "always()"
        `run` = "node tools/ci/commands/unsafe-miri-source.ts after"
      }
      new Dynamic {
        `name` = "Retain source and verifier receipts"
        `if` = "always()"
        `uses` = "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a"
        `with` = new Dynamic {
          `name` = "miri-${{ inputs.package }}-${{ inputs.source_sha }}"
          `path` = "miri-evidence/**"
          `if-no-files-found` = "error"
        }
      }
    }
  }
}
`run-name` = "Miri ${{ inputs.package }} source ${{ inputs.source_sha }}"
