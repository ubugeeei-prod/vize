import "../../lib/Actions.pkl" as ci

name = "Typecheck vs vue-tsc"

// One fixed comparative diagnostic/timing packet; ordinary PRs validate pure contracts only.
on {
  workflow_dispatch {}
  pull_request {
    paths = new Listing {
      ".github/workflows/03-typecheck-vs-vue-tsc.yml"
      "tools/ci/workflows/03-typecheck-vs-vue-tsc/scripts/**"
      "tools/benchmarks/scripts/typecheck-vs-vue-tsc*.ts"
      "tests/tooling/typecheck-vs-vue-tsc*.test.ts"
      "tests/_fixtures/tooling/typecheck-vs-vue-tsc-provider/**"
    }
  }
}

concurrency {
  group = "typecheck-vs-vue-tsc-${{ github.event.pull_request.number || github.run_id }}"
  `cancel-in-progress` = "${{ github.event_name == 'pull_request' }}"
}
permissions { contents = "read" }
env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  NODE_DISABLE_COMPILE_CACHE = "1"
}
jobs {
  contracts {
    name = "comparative-source-contracts"
    `runs-on` = ci.linux
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.14.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Fetch immutable product source oracle"
        run = "git fetch --no-tags --depth=1 origin ea22f2cd2aa661b9bdab940e25464eff692b935f"
      }
      new Dynamic {
        name = "Validate complete evidence and refusal controls"
        run = "node --test tests/tooling/typecheck-vs-vue-tsc-evidence.test.ts tests/tooling/typecheck-vs-vue-tsc-frozen.test.ts"
      }
    }
  }
  bench {
    `if` = "${{ github.event_name == 'workflow_dispatch' }}"
    needs = "contracts"
    name = "fixed-2500-and-misskey"
    `runs-on` = ci.linux
    `timeout-minutes` = 240
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/03-typecheck-vs-vue-tsc/scripts"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with {
          `persist-credentials` = false
          `fetch-depth` = 2
        }
      }
      ci.rust("1.99.1")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.14.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Prepare exact product and frozen provider"
        run = ci.workflowScript("prepare-exact-product-and-frozen-provider.sh")
      }
      new Dynamic {
        name = "Build fixed normal product"
        run = ci.workflowScript("build-fixed-normal-product.sh")
      }
      new Dynamic {
        name = "Measure"
        run = ci.workflowScript("measure.sh")
      }
      new Dynamic {
        name = "Preserve all raw before any verdict"
        `if` = "always()"
        run = ci.workflowScript("preserve-all-raw-before-any-verdict.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "typecheck-vs-vue-tsc-raw-${{ github.run_id }}"
          path = "${{ runner.temp }}/typecheck-vs-vue-tsc-raw.tgz"
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
}
