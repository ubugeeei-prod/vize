import "../../lib/Actions.pkl" as ci

name = "Canonical Davinci corpus"
on {
  workflow_call {
    inputs {
      davinci_dom_corpus_mode {
        type = "string"
        required = false
        ["default"] = "enforce"
      }
    }
  }
}
permissions { contents = "read" }
env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}
jobs {
  `canonical-observers` {
    name = "canonical observer (${{ matrix.observer }})"
    `runs-on` = ci.linux
    `timeout-minutes` = 120
    strategy {
      `fail-fast` = false
      `max-parallel` = 3
      matrix {
        observer = List("dom", "ssr-pug", "reach")
      }
    }
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/tools/ci/workflows/07-canonical-corpus/scripts"
      VIZE_DAVINCI_DOM_CORPUS_MODE = "${{ inputs.davinci_dom_corpus_mode || 'enforce' }}"
    }
    steps = new Listing {
      new Dynamic {
        name = "Checkout matrix commit"
        uses = ci.checkout
        with {
          `persist-credentials` = false
          ref = "${{ github.sha }}"
        }
      }
      new Dynamic {
        name = "Setup Rust"
        uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // stable
        with { toolchain = "stable" }
      }
      new Dynamic {
        name = "Setup Wild linker recovery"
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "davinci-dom-corpus"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Setup Node"
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      // The test binaries do not read the fixtures; compile them while the
      // corpus hydrates. The observer command's own cargo invocation waits on
      // the build lock and then finds them fresh.
      new Dynamic {
        name = "Start observer test build"
        env { OBSERVER = "${{ matrix.observer }}" }
        run = ci.workflowScript("start-observer-test-build.sh")
      }
      new Dynamic {
        name = "Plan canonical corpus identity"
        id = "corpus-plan"
        run = "node tools/support/compat/github/canonical-corpus-observer.mjs plan"
      }
      new Dynamic {
        name = "Restore immutable fixture objects"
        `if` = "${{ steps.corpus-plan.outputs.cache-trusted != 'true' }}"
        uses = "actions/cache/restore@27d5ce7f107fe9357f9df03efb73ab90386fccae"  // v5
        with {
          path = ".git/modules/tests/_fixtures/_git"
          key = "${{ steps.corpus-plan.outputs.cache-key }}"
          `restore-keys` = "${{ steps.corpus-plan.outputs.cache-restore-key }}"
        }
      }
      new Dynamic {
        name = "Cache immutable trusted fixture objects"
        `if` = "${{ steps.corpus-plan.outputs.cache-trusted == 'true' }}"
        uses = ci.cache
        with {
          path = ".git/modules/tests/_fixtures/_git"
          key = "${{ steps.corpus-plan.outputs.cache-key }}"
          `restore-keys` = "${{ steps.corpus-plan.outputs.cache-restore-key }}"
        }
      }
      new Dynamic {
        name = "Select and hydrate full fixture corpus"
        run = ci.workflowProgram("select-and-hydrate-full-fixture-corpus")
      }
      new Dynamic {
        name = "Capture canonical corpus identity"
        id = "corpus_snapshot"
        run = "node tools/support/compat/github/canonical-corpus-observer.mjs snapshot"
      }
      new Dynamic {
        name = "Run L2 DOM differential corpus"
        `if` = "${{ matrix.observer == 'dom' }}"
        id = "davinci_dom_corpus"
        `continue-on-error` = true
        run = "node tools/support/compat/fixtures/davinci-dom-corpus-workflow.ts run"
      }
      // One build, then concurrent processes of the same binaries: a base
      // process for the non-sweep tests, process shards of the canonical SSR
      // sweep and the complete pug sweep. The recorder proves the shard
      // vectors exactly cover files.json and sums their counters.
      new Dynamic {
        name = "Run L4 SSR and pug L1 differential corpora"
        id = "ssr_pug"
        `if` = "${{ matrix.observer == 'ssr-pug' }}"
        run = "node tools/support/compat/github/canonical-corpus-shards.ts run ssr-pug ssr-pug.log"
      }
      new Dynamic {
        name = "Diagnose complete original corpus source IO"
        id = "corpus_io"
        `if` = "${{ always() && matrix.observer == 'ssr-pug' && steps.corpus_snapshot.outcome == 'success' }}"
        `continue-on-error` = true
        run = "node tools/support/compat/github/canonical-corpus-io-probe.mjs"
      }
      new Dynamic {
        name = "Measure Davinci production reach on the hydrated corpus"
        id = "production_reach"
        `if` = "${{ matrix.observer == 'reach' }}"
        run = "node tools/support/compat/github/canonical-corpus-shards.ts run reach reach.log"
      }
      new Dynamic {
        name = "Require complete source IO diagnostic success"
        `if` = "${{ always() && matrix.observer == 'ssr-pug' && steps.corpus_io.outcome != 'success' }}"
        run = ci.workflowProgram("require-complete-source-io-diagnostic-success")
      }
      new Dynamic {
        name = "Record required observer evidence"
        `if` = "${{ always() }}"
        env {
          OBSERVER = "${{ matrix.observer }}"
          OBSERVER_OUTCOME = "${{ matrix.observer == 'dom' && steps.davinci_dom_corpus.outcome || matrix.observer == 'ssr-pug' && steps.ssr_pug.outcome || steps.production_reach.outcome }}"
        }
        run = #"node tools/support/compat/github/canonical-corpus-observer.mjs record "$OBSERVER""#
      }
      new Dynamic {
        name = "Upload required observer evidence"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "canonical-corpus-${{ matrix.observer }}-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.sha }}"
          path = "real-project-davinci-dom-corpus"
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
  `davinci-dom-corpus` {
    name = "s2 dom corpus"
    `if` = "${{ always() }}"
    needs = "canonical-observers"
    permissions {
      contents = "read"
      actions = "read"
      checks = "read"
    }
    `runs-on` = ci.linux
    `timeout-minutes` = 120
    env { VIZE_DAVINCI_DOM_CORPUS_MODE = "${{ inputs.davinci_dom_corpus_mode || 'enforce' }}" }
    steps = new Listing {
      new Dynamic {
        name = "Checkout matrix commit"
        uses = ci.checkout
        with {
          `persist-credentials` = false
          ref = "${{ github.sha }}"
        }
      }
      new Dynamic {
        name = "Setup Rust"
        uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // stable
        with { toolchain = "stable" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "davinci-dom-corpus"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Setup Node"
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Select complete canonical workers"
        id = "canonical_workers"
        env {
          GH_TOKEN = "${{ github.token }}"
          NEEDS_JSON = "${{ toJSON(needs) }}"
        }
        run = "node tools/support/compat/github/canonical-corpus-workers.mjs select real-project-davinci-dom-corpus/selection.json"
      }
      new Dynamic {
        name = "Download current canonical worker artifacts"
        uses = ci.downloadArtifact
        with {
          `artifact-ids` = "${{ steps.canonical_workers.outputs.artifact-ids }}"
          `github-token` = "${{ github.token }}"
          `run-id` = "${{ github.run_id }}"
          repository = "${{ github.repository }}"
          `merge-multiple` = false
          `digest-mismatch` = "error"
          path = ".artifacts/canonical-workers"
        }
      }
      new Dynamic {
        name = "Verify complete canonical worker artifacts"
        id = "canonical_verification"
        env { GH_TOKEN = "${{ github.token }}" }
        run = "node tools/support/compat/github/canonical-corpus-workers.mjs verify real-project-davinci-dom-corpus/selection.json .artifacts/canonical-workers"
      }
      new Dynamic {
        name = "Finalize L2 DOM corpus evidence"
        `if` = "${{ always() }}"
        env { VIZE_DAVINCI_DOM_CORPUS_OUTCOME = "${{ steps.canonical_verification.outcome }}" }
        run = "node tools/support/compat/fixtures/davinci-dom-corpus-workflow.ts finalize-and-dehydrate"
      }
      new Dynamic {
        name = "Upload L2 DOM corpus evidence"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "real-project-davinci-dom-corpus"
          overwrite = true
          path = "real-project-davinci-dom-corpus"
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
}
