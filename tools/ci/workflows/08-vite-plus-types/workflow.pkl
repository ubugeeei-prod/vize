import "../../lib/Actions.pkl" as ci

name = "Vite+ Type Compatibility"

on {
  workflow_call = null
  push {
    branches = List("main", "davinci")
    paths = new Listing {
      "npm/builder/vite/src/vite-plus.ts"
      "npm/builder/vite/src/vite-plus/**"
      "npm/builder/vite/client.d.ts"
      "npm/builder/vite/type-tests/markdown/**"
      "npm/builder/vite/type-tests/plugin-vue/**"
      "npm/builder/vite/package.json"
      "pnpm-lock.yaml"
      ".github/workflows/08-vite-plus-types.yml"
    }
  }
  pull_request {
    branches = List("main", "davinci")
    paths = new Listing {
      "npm/builder/vite/src/vite-plus.ts"
      "npm/builder/vite/src/vite-plus/**"
      "npm/builder/vite/client.d.ts"
      "npm/builder/vite/type-tests/markdown/**"
      "npm/builder/vite/type-tests/plugin-vue/**"
      "npm/builder/vite/package.json"
      "pnpm-lock.yaml"
      ".github/workflows/08-vite-plus-types.yml"
    }
  }
}

concurrency {
  group = "vite-plus-type-compat-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

jobs {
  `real-vite-plugin-types` {
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    steps = new Listing {
      ci.use(ci.checkout)
      ci.workspaceVp()
      new Dynamic {
        name = "Install Vite plugin dependencies"
        run = "vp install --frozen-lockfile --prefer-offline --filter './npm/builder/vite...' --ignore-scripts"
      }
      ci.command("Type-check plugin-vue against real Vite 8", "vp run --filter './npm/builder/vite' test:types:real-vite")
      ci.command("Type-check Ox Content Markdown modules", "vp run --filter './npm/builder/vite' test:types:markdown")
    }
  }
}
