import "../../lib/Actions.pkl" as ci

name = "Declaration source products"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/07-declaration-products.yml"
      "tools/ci/workflows/07-declaration-products/scripts/**"
      "davinci/vize_l2/src/query/script/assignments.rs"
      "davinci/vize_l2/src/query/script/assignments/**"
      "crates/vize_canon/src/corsa_bridge/vue_document.rs"
      "crates/vize_canon/src/corsa_bridge/vue_document/ambient_diagnostics.rs"
      "crates/vize_canon/src/corsa_bridge/bridge/initial_diagnostics.rs"
      "crates/vize_canon/src/lsp_client/diagnostics.rs"
      "crates/vize_canon/src/lsp_client/diagnostics/ambient.rs"
      "crates/vize_canon/src/lsp_client/initial_diagnostics.rs"
      "crates/vize_canon/src/lsp_client/initial_diagnostics/ambient_world.rs"
      "crates/vize_canon/src/lsp_client/tracked_documents.rs"
      "crates/vize_canon/src/lsp_client/tracked_documents/**"
      "crates/vize_maestro/src/ide/diagnostics/corsa/ambient_project*"
      "crates/vize_maestro/src/ide/diagnostics/corsa/ambient_project/**"
      "crates/vize_maestro/src/server/state/global_components/editor_options/ambient.rs"
      "tests/_fixtures/differential/typechecker/ambient-global-slot-host-3011/**"
      "tests/formal/ambient-diagnostics/**"
      "tools/benchmarks/scripts/compare-ambient-diagnostics.ts"
      "tests/formal/primitive-assignments/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "declaration-source-products-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `primitive-assignability-proof` {
    name = "Check immutable binding traces"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ...ci.stageWorkflow("07-declaration-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        name = "Check immutable binding traces and witness unsafe scopes"
        env { ALLOY_SHA256 = "6037cbeee0e8423c1c468447ed10f5fcf2f2743a2ffc39cb1c81f2905c0fdb9d" }
        run = ci.workflowProgram("check-immutable-binding-traces-and-witness-unsafe-scopes")
      }
    }
  }

  `ambient-component-project` {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUSTUP_TOOLCHAIN = "1.100.0"
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_TSGO_PATH = "${{ github.workspace }}/node_modules/@typescript/typescript-linux-x64/lib/tsc"
    }
    steps = new Listing {
      ...ci.stageWorkflow("07-declaration-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      ci.use("./.github/actions/cache-vp-bootstrap")
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version-file` = "package.json"
          cache = true
          `cache-save` = false
          `run-install` = true
        }
      }
      new Dynamic {
        name = "Model native acknowledgement and publication across edits"
        `working-directory` = "tests/formal/ambient-diagnostics"
        run = ci.workflowProgram("model-native-diagnostic-publication")
      }
      new Dynamic {
        name = "Compare cold and repeated diagnostics on both revisions"
        env {
          BASE_SHA = "${{ github.event.pull_request.base.sha }}"
          HEAD_SHA = "${{ github.event.pull_request.head.sha }}"
        }
        run = ci.workflowProgram("compare-ambient-diagnostic-revisions")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "ambient-diagnostic-costs"
          path = "${{ runner.temp }}/ambient-diagnostics.json"
          `if-no-files-found` = "ignore"
          `retention-days` = 7
        }
      }
    }
  }
}
