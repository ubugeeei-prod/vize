import "../../lib/Actions.pkl" as ci

name = "Shipped CLI Nuxt consumer"

on {
  workflow_dispatch {
    inputs {
      mode {
        description = "Verify retained records or measure the reviewed source receipt"
        required = true
        ["default"] = "replay"
        type = "choice"
        options = List("replay", "measure")
      }
    }
  }
  pull_request {
    paths = new Listing {
      ".github/workflows/03-shipped-cli-nuxt.yml"
      "tools/ci/workflows/03-shipped-cli-nuxt/**"
      "tools/benchmarks/scripts/shipped-cli-nuxt*"
      "tests/_fixtures/tooling/shipped-cli-nuxt/**"
    }
  }
}
permissions {
  contents = "read"
  actions = "read"
}
concurrency {
  group = "shipped-cli-nuxt-${{ github.event.pull_request.number || github.run_id }}"
  `cancel-in-progress` = false
}
env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }
jobs {
  qualify {
    name = "Exact release images and frozen Nuxt consumer"
    `runs-on` = "${{ github.event_name == 'workflow_dispatch' && inputs.mode == 'measure' && 'blacksmith-32vcpu-ubuntu-2404' || 'blacksmith-4vcpu-ubuntu-2404' }}"
    `timeout-minutes` = 30
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "26.13.1"
          `package-manager-cache` = false
        }
      }
      ci.command("Check provenance and refusal contracts", "node --test tools/benchmarks/scripts/shipped-cli-nuxt.test.ts")
      new Dynamic {
        name = "Download the exact retained release producer"
        `if` = "github.event_name == 'workflow_dispatch' && inputs.mode == 'measure'"
        env { GH_TOKEN = "${{ github.token }}" }
        run = "node tools/benchmarks/scripts/shipped-cli-nuxt.ts --download"
      }
      new Dynamic {
        name = "Restore frozen external-context inputs"
        `if` = "github.event_name == 'workflow_dispatch' && inputs.mode == 'measure'"
        run = "node tools/benchmarks/scripts/shipped-cli-nuxt.ts --prepare"
      }
      new Dynamic {
        name = "Measure balanced independent images and compare complete output"
        `if` = "github.event_name == 'workflow_dispatch' && inputs.mode == 'measure'"
        run = "node tools/benchmarks/scripts/shipped-cli-nuxt.ts --measure"
      }
      new Dynamic {
        name = "Verify and publish the original retained campaign without execution"
        `if` = "github.event_name != 'workflow_dispatch' || inputs.mode != 'measure'"
        run = "node tools/benchmarks/scripts/shipped-cli-nuxt.ts --replay"
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "shipped-cli-nuxt-${{ github.run_id }}"
          path = """
          ${{ runner.temp }}/shipped-cli-nuxt/*.json
          ${{ runner.temp }}/shipped-cli-nuxt/*.stderr
          ${{ runner.temp }}/shipped-cli-nuxt/*.log
          ${{ runner.temp }}/shipped-cli-nuxt/summary.md
          ${{ runner.temp }}/shipped-cli-nuxt/images/*/identity.json
          ${{ runner.temp }}/shipped-cli-nuxt/images/*/side.json
          ${{ runner.temp }}/shipped-cli-nuxt/images/*/elf-versions.txt
          """
          `if-no-files-found` = "warn"
          `retention-days` = 30
        }
      }
    }
  }
}
