module vize.ci.BootstrapAssets

class ReleaseAsset {
  repository: String
  version: String
  filename: String
  assetId: Int
  sha256: String(matches(Regex("[0-9a-f]{64}")))

  downloadUrl = "https://github.com/\(repository)/releases/download/\(version)/\(filename)"
  apiUrl = "https://api.github.com/repos/\(repository)/releases/assets/\(assetId)"
}

wild: ReleaseAsset = new {
  repository = "wild-linker/wild"
  version = "0.9.0"
  filename = "wild-linker-\(version)-x86_64-unknown-linux-gnu.tar.gz"
  assetId = 428152085
  sha256 = "deb6ee0e5caec798053ec4aafaba042e20a8edf91f08cb4d36268571cc628d3b"
}

rustScript: ReleaseAsset = new {
  repository = "fornwall/rust-script"
  version = "0.34.0"
  filename = "rust-script-x86_64-unknown-linux-gnu.tar.gz"
  assetId = 127872817
  sha256 = "0700ecfe6c768c007f3e5a7919f4fedbf0a6727d275a196791f134a1742d4d13"
}
