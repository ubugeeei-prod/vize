module vize.ci.Actions

import "BootstrapAssets.pkl" as assets

typealias ActionPin = String(matches(Regex("[A-Za-z0-9_./-]+@[a-f0-9]{40}")))
typealias ScriptName = String(matches(Regex("[A-Za-z0-9_][A-Za-z0-9_.-]*")))

checkout: ActionPin = "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
uploadArtifact: ActionPin = "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a"
downloadArtifact: ActionPin = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
setupRust: ActionPin = "dtolnay/rust-toolchain@d1031067263f94b142dd6c0ce24c5eb9d02d52a0"
setupNode: ActionPin = "actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38"
setupVp: ActionPin = "voidzero-dev/setup-vp@ca1c46663915d6c1042ae23bd39ab85718bfb0fa"
setupVp121: ActionPin = "voidzero-dev/setup-vp@68f39c78aaf39be468cabd2afb09c162574c84af"
/// The Vite+ CLI release every setup-vp step installs. Without an explicit
/// version the action installs whatever is newest when the job starts, so two
/// jobs of one run could use different CLIs. Raise it in its own change.
vpVersion = "1.8.0"
setupWild: ActionPin = "wild-linker/action@0bbbfa5df4380cab8e63cb8505a1ce65e1d10203"
setupBun: ActionPin = "oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6"
cache: ActionPin = "actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae"
linux = "blacksmith-32vcpu-ubuntu-2404"
linux2204 = "blacksmith-32vcpu-ubuntu-2204"
windows = "blacksmith-32vcpu-windows-2025"
macos = "blacksmith-12vcpu-macos-15"
// The smallest class we use, for build-free jobs (planners and short policy
// checks with no Rust toolchain or sticky disk). They finish in seconds, and
// a 32-vCPU slot spent on them delays a build job at the pool's cap.
linuxSmall = "blacksmith-4vcpu-ubuntu-2404"
// Source checks keep their complete commands on the available mid-size pool.
linuxValidation = "blacksmith-16vcpu-ubuntu-2404"

function use(action: String): Dynamic = new { uses = action }

function command(label: String, commandLine: String): Dynamic = new {
  name = label
  run = commandLine
}

function workflowScript(file: ScriptName): String = #". "${{ env.VIZE_CI_FILES }}/\#(file)""#

function actionScript(file: ScriptName): String = #". "$GITHUB_ACTION_PATH/scripts/\#(file)""#

// WSL translates the staged Windows path before its Bash shell expands the variable.
function wslScript(file: ScriptName): String = #". "$VIZE_CI_FILES/\#(file)""#

// An ush program `scripts/<name>.ush` runs from its committed build, `scripts/compiled/<name>.sh`.
function workflowProgram(name: ScriptName): String = #"sh "${{ env.VIZE_CI_FILES }}/compiled/\#(name).sh""#

function actionProgram(name: ScriptName): String = #"sh "$GITHUB_ACTION_PATH/scripts/compiled/\#(name).sh""#

function wslProgram(name: ScriptName): String = #"sh "$VIZE_CI_FILES/compiled/\#(name).sh""#

function onFailureOf(step: String): String = "failure() && steps.\(step).outcome == 'failure'"

function checkoutAt(revision: String): Dynamic = new {
  uses = checkout
  with {
    ref = revision
    `persist-credentials` = false
  }
}

function rust(version: String): Dynamic = new {
  uses = setupRust
  with { toolchain = version }
}

function wild(): Dynamic = new {
  uses = setupWild
  with { `wild-version` = assets.wild.version }
}

function workspaceVp(): Dynamic = new {
  uses = setupVp
  with {
    version = vpVersion
    `node-version-file` = "package.json"
    cache = true
    `run-install` = false
  }
}

function stageWorkflowScripts(workflow: String): Listing<Dynamic> =
  stagePrograms("/.github/scripts/workflows/\(workflow)/")

/// The programs of a workflow that lives in tools/ci/workflows/<workflow>/.
function stageWorkflow(workflow: String): Listing<Dynamic> =
  stagePrograms("/tools/ci/workflows/\(workflow)/scripts/")

local function stagePrograms(programs: String): Listing<Dynamic> = new {
  new Dynamic {
    name = "Check out the workflow's scripts"
    uses = checkout
    with {
      ref = "${{ github.workflow_sha }}"
      path = ".vize-workflow-tools"
      `persist-credentials` = false
      `sparse-checkout-cone-mode` = false
      `sparse-checkout` = "/.github/actions/stage-workflow-scripts/\n/tools/ci/lib/scripts/\n\(programs)"
    }
  }
  new Dynamic {
    name = "Stage scripts outside the source checkout"
    uses = "./.vize-workflow-tools/.github/actions/stage-workflow-scripts"
  }
}
