steps = new Listing {
  new Dynamic {
    name = "Test config recovery guidance and no-config with the actual CLI"
    shell = "bash"
    env { VIZE_TEST_REQUIRE_TSGO = "1" }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-config-recovery-guidance-and-no-config-with-the-actual-cli.sh""#
  }
  new Dynamic {
    name = "Test nested sibling narrowing with the actual CLI"
    shell = "bash"
    env { VIZE_TEST_REQUIRE_TSGO = "1" }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-nested-sibling-narrowing-with-the-actual-cli.sh""#
  }
  new Dynamic {
    name = "Test mixed Vue and private imports with the actual CLI"
    shell = "bash"
    env { VIZE_TEST_REQUIRE_TSGO = "1" }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-mixed-vue-and-private-imports-with-the-actual-cli.sh""#
  }
  new Dynamic {
    name = "Test original imported Options API members with the actual CLI"
    `if` = "${{ !cancelled() }}"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-original-imported-options-api-members-with-the-actual-cli.sh""#
  }
  new Dynamic {
    name = "Test redirected package diagnostics with the actual CLI"
    shell = "bash"
    env { VIZE_TEST_REQUIRE_TSGO = "1" }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-redirected-package-diagnostics-with-the-actual-cli.sh""#
  }
  new Dynamic {
    name = "Test original static template refs and authored unused bindings with the actual CLI"
    shell = "bash"
    env { VIZE_TEST_REQUIRE_TSGO = "1" }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-original-static-template-refs-and-authored-unused-bindings-with-the.sh""#
  }
  new Dynamic {
    name = "Test later implicit referenced-project inputs and Vue repair"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TSCONFIG_REFERENCE_CAPTURE = "${{ runner.temp }}/native-syntax-semantics/tsconfig-reference-defaults-3984"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-later-implicit-referenced-project-inputs-and-vue-repair.sh""#
  }
  new Dynamic {
    name = "Test complete native diagnostic profiling and source repair"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_MESSAGE_PROFILE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/message-profile"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-complete-native-diagnostic-profiling-and-source-repair.sh""#
  }
  new Dynamic {
    name = "Test complete malformed project membership with the actual CLI"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_NATIVE_SYNTAX_CAPTURE_DIR = "${{ runner.temp }}/native-syntax-semantics"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-complete-malformed-project-membership-with-the-actual-cli.sh""#
  }
  new Dynamic {
    name = "Test native syntax, semantic completion and transport refusals"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_REQUIRE_PIN_INPUT_FIXTURE = "1"
      VIZE_NATIVE_SYNTAX_CAPTURE_DIR = "${{ runner.temp }}/native-syntax-semantics"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-native-syntax-semantic-completion-and-transport-refusals.sh""#
  }
}
