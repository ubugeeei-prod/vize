amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  model_rust_status=0
  cargo test --locked --profile ci -p vize_atelier_sfc native_selected_setup::tests::original_input_model::fourteen_whole_original_input_model_components_and_raw_maps_are_captured -- --exact --nocapture || model_rust_status=$?
  model_development_status=0
  NODE_ENV=development vp node --test tests/tooling/native-original-input-model-sfc-dom-reference.test.ts || model_development_status=$?
  model_production_status=0
  NODE_ENV=production vp node --test tests/tooling/native-original-input-model-sfc-dom-reference.test.ts || model_production_status=$?
  printf '{"rust":%s,"development":%s,"production":%s}\n' "$model_rust_status" "$model_development_status" "$model_production_status" > "${VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_CAPTURE}.statuses.json"
  test "$model_rust_status" -eq 0
  test "$model_development_status" -eq 0
  test "$model_production_status" -eq 0
  test -s "$VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_CAPTURE"
  test -s "${VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_PRIMARY_CAPTURE}.development.json"
  test -s "${VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_PRIMARY_CAPTURE}.production.json"
  test -s "${VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_RUNTIME_CAPTURE}.development.json"
  test -s "${VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_RUNTIME_CAPTURE}.production.json"
  """#
}
