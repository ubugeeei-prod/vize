amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  root_if_rust_status=0
  cargo test --locked --profile ci -p vize_atelier_sfc native_selected_setup::tests::original_root_if::eighteen_whole_original_root_if_components_and_maps_are_captured -- --exact --nocapture || root_if_rust_status=$?
  root_if_development_status=0
  NODE_ENV=development vp node --test tests/tooling/native-original-root-if-sfc-dom-reference.test.ts || root_if_development_status=$?
  root_if_production_status=0
  NODE_ENV=production vp node --test tests/tooling/native-original-root-if-sfc-dom-reference.test.ts || root_if_production_status=$?
  printf '{"rust":%s,"development":%s,"production":%s}\n' "$root_if_rust_status" "$root_if_development_status" "$root_if_production_status" > "${VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_CAPTURE}.statuses.json"
  test "$root_if_rust_status" -eq 0
  test "$root_if_development_status" -eq 0
  test "$root_if_production_status" -eq 0
  test -s "$VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_CAPTURE"
  test -s "${VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_PRIMARY_CAPTURE}.development.json"
  test -s "${VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_PRIMARY_CAPTURE}.production.json"
  test -s "${VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_RUNTIME_CAPTURE}.development.json"
  test -s "${VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_RUNTIME_CAPTURE}.production.json"
  """#
}
