amends "../../../../../../ci/lib/ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  module.unsetVariable("VIZE_TEST_DISABLE_TSGO")
  "export VIZE_TEST_REQUIRE_TSGO=1"
  module.captureDirectory("VIZE_INLAY_HINT_CAPTURE", "outside-import-types/component-tag-types")
  #"export VIZE_COMPONENT_TYPE_CAPTURE="$VIZE_INLAY_HINT_CAPTURE/type-query-custody""#
  module.inSourceRoot()
  module.cargoTest("ci-opt", "vize", List("--test", "integration"), List("--", "lsp_component_tag_types_cli::", "--nocapture"))
  module.cargoTest("ci-opt", "vize", List("--test", "integration"), List("--", "lsp_tag_completion_cli::", "--nocapture"))
  module.cargoTest("ci-opt", "vize_maestro", List("--lib"), List("tag_name_tests::", "--", "--nocapture"))
}
