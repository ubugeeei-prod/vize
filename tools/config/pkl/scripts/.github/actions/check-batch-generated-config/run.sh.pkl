amends "../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  module.cargoTest("ci-opt", "vize_canon", List("--lib"), List("nested_generated_config::", "--", "--nocapture"))
  module.cargoTest("ci-opt", "vize_canon", List("--test", "tier_l_incremental"), List("failure::tests::", "--", "--nocapture"))
  #"export VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR="${VIZE_NESTED_BATCH_CAPTURE_DIR:-target/vize-tests/metrics}/snapshot-source""#
  module.makeDirectory("VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR")
  #"""
  cargo test --locked --profile ci-opt -p vize_canon --doc SnapshotSourceText -- --nocapture | tee "$VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR/doctests.log"
  rg -F 'test result: ok. 3 passed; 0 failed;' "$VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR/doctests.log"
  """#
  module.cargoTest("ci-opt", "vize_canon", List("--lib"), List("lsp_client::editor_lsp::snapshot_source::", "--", "--include-ignored", "--nocapture"))
  module.command("cargo", List("test", "--locked", "-p", "vize_l1_to_l2", "--features", "legacy-differential", "--test", "davinci_lowering_corpus", "--", "--nocapture"))
  module.command("cargo", List("test", "--locked", "-p", "vize_l1_to_l2", "--features", "legacy-differential", "--test", "davinci_dom_corpus", "--", "--nocapture"))
  module.command("cargo", List("test", "--locked", "-p", "vize_l1_to_l2", "--features", "legacy-differential", "--test", "davinci_remarks_corpus", "--", "--nocapture"))
  module.command("cargo", List("test", "--locked", "-p", "vize_canon", "--features", "legacy-differential", "--test", "davinci_projection_differential", "--", "--nocapture"))
}
