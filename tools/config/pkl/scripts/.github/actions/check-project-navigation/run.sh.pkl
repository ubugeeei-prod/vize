amends "../../../../../../ci/lib/ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  module.inSourceRoot()
  module.captureDirectory("VIZE_EDITOR_CONFIG_CAPTURE", "outside-import-types/project-navigation-8013")
  module.captureDirectory("VIZE_PROJECT_NAVIGATION_VUE_ROOT", "editor-jsconfig-provider/node_modules/vue")
  module.cargoTest("ci-opt", "vize_maestro", List("--lib"), List("workspace_project_files::", "--", "--nocapture"))
  module.cargoTest("ci-opt", "vize_maestro", List("--lib"), List("project::scope::", "--", "--nocapture"))
  module.cargoTest("ci-opt", "vize_maestro", List("--lib"), List("workspace_symbols::script::tests::", "--", "--nocapture"))
  module.cargoTest("ci-opt", "vize_maestro", List("--lib"), List("references::canonical::local_binding::tests::", "--", "--nocapture"))
  #"""
  set +e
  VIZE_LSP_BIN="$NATIVE_PHASE_SOURCE_ROOT/target/ci/vize" VIZE_LSP_REQUIRE_SOURCE_BUILD=1 VIZE_TEST_REQUIRE_TSGO=1 VIZE_PROJECT_NAVIGATION_REQUIRED=1 vp node --test --test-concurrency=1 tests/tooling/lsp-project-navigation-8013.test.ts tests/tooling/lsp-workspace-semantic.test.ts tests/tooling/lsp-file-rename-workspace.test.ts
  navigation_status=$?
  set -e
  if [[ -d "$NATIVE_PHASE_SOURCE_ROOT/target/differential/lsp-sessions" ]]; then
    cp -R "$NATIVE_PHASE_SOURCE_ROOT/target/differential/lsp-sessions" "$VIZE_EDITOR_CONFIG_CAPTURE/original-symbol-consumers"
  fi
  exit "$navigation_status"
  """#
}
