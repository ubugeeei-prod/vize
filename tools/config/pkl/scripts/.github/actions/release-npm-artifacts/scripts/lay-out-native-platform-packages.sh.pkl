amends "../../../../../../../ci/lib/ShellScript.pkl"

interpreter = "bash"

commands {
  module.command("vp", List("exec", "napi", "create-npm-dirs"))
  module.command("vp", List("exec", "napi", "artifacts", "--output-dir", "artifacts"))
  module.command("vp", List("exec", "napi", "pre-publish", "-t", "npm", "--no-gh-release", "--skip-optional-publish"))
}
