amends "../../../../ShellScript.pkl"

commands {
  module.strictMode
  #"""

  capture="$RUNNER_TEMP/component-input-parity"
  """#
  module.captureDirectory("CARGO_TARGET_DIR", "component-input-head-target")
  #"""
  export VIZE_INPUT_OWNERSHIP_PROFILE_CAPTURE="$capture/generation-profile.json"
  cargo test --locked --profile ci -p vize_benchmarks --test component_input_ownership_profile \
    actual_mapper_generation_reports_gated_parse_and_allocation_costs -- --exact --nocapture \
    > "$capture/generation-profile.log" 2>&1
  export VIZE_ROOT_CALLBACK_PROFILE_CAPTURE="$capture/root-callback-generation-profile.json"
  cargo test --locked --profile ci -p vize_benchmarks --test component_input_ownership_profile \
    actual_root_callback_generation_reports_roles_and_buffer_costs -- --exact --nocapture \
    > "$capture/root-callback-generation-profile.log" 2>&1
  """#
}
