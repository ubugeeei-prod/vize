amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  flags=(--locked --profile ci-opt)
  checker=(-p vize_canon --features authored-script-diagnostics --lib)
  editor=(-p vize_maestro --features experimental-checker-script-queries,micro-profiling --lib)
  export VIZE_SCRIPT_QUERY_INPUTS="$RUNNER_TEMP/editor-scripts"
  cargo clippy "${flags[@]}" "${checker[@]}" --no-deps -- -D warnings
  cargo clippy "${flags[@]}" "${editor[@]}" --no-deps -- -D warnings
  cargo test "${flags[@]}" "${checker[@]}" script_parse:: -- --include-ignored --nocapture --test-threads=1
  cargo test "${flags[@]}" "${editor[@]}" source_project::script_queries:: -- --include-ignored --nocapture --test-threads=1
  """#
}
