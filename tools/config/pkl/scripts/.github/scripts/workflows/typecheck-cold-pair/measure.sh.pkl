amends "../../../../../../../ci/lib/ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  [[ "$PROJECTS" =~ ^(vue|monorepo):[0-9]+(,(vue|monorepo):[0-9]+)*$ ]] && [[ "$RUNS" =~ ^[1-9][0-9]?$ ]]
  [[ "$RUNTIME" =~ ^(tsgo|tsrs)$ ]] && [[ "$CHECKERS" =~ ^(1|8)$ ]]
  sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends time strace
  chmod +x pair-bin/*/vize
  node tools/benchmarks/scripts/typecheck-cold-pair.ts \
    --bin base=pair-bin/base/vize --bin head=pair-bin/head/vize \
    --root "$RUNNER_TEMP/pair" --projects "$PROJECTS" --runs "$RUNS" \
    --runtime "$RUNTIME" --checkers "$CHECKERS" $ALLOW $STRACE \
    --label "linux-ext4-$RUNTIME-c$CHECKERS" --out "$RUNNER_TEMP/pair-out" > /dev/null
  cat "$RUNNER_TEMP/pair-out/cold-pair-linux-ext4-$RUNTIME-c$CHECKERS.md" >> "$GITHUB_STEP_SUMMARY"
  """#
}
