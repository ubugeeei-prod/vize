amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  [[ "$BASE_SHA" =~ ^[0-9a-f]{40}$ && "$HEAD_SHA" =~ ^[0-9a-f]{40}$ ]]
  [[ "$(git rev-parse HEAD)" == "$HEAD_SHA" ]]
  capture="$RUNNER_TEMP/native-image-alt"
  baseline="$RUNNER_TEMP/native-image-alt-base"
  mkdir -p "$capture"
  git worktree add --detach "$baseline" "$BASE_SHA"
  observer=crates/vize_patina/examples/native_image_alt_original.rs
  support=crates/vize_patina/examples/image_alt_measurement/mod.rs
  # The base builds its own observer against its own Patina, so a head
  # that renames an API the observer uses cannot break the base build.
  # Only a base that predates the observer borrows the head's copy.
  if [[ -f "$baseline/$observer" && -f "$baseline/$support" ]]; then
    echo base > "$capture/base-observer-origin.txt"
  else
    mkdir -p "$baseline/$(dirname "$support")"
    cp "$observer" "$baseline/$observer"
    cp "$support" "$baseline/$support"
    echo head > "$capture/base-observer-origin.txt"
  fi
  git -C "$baseline" diff --exit-code -- crates/vize_patina/src Cargo.lock
  git diff --exit-code "$BASE_SHA" "$HEAD_SHA" -- Cargo.lock
  (cd "$baseline" && rustc -Vv) > "$capture/base-rustc.txt"
  rustc -Vv > "$capture/head-rustc.txt"
  uname -a > "$capture/platform.txt"
  sha256sum "$observer" "$support" Cargo.lock > "$capture/observer-and-lock.sha256"
  base_target="$RUNNER_TEMP/native-image-alt-targets/$BASE_SHA"
  head_target="$RUNNER_TEMP/native-image-alt-targets/$HEAD_SHA"
  [[ "$base_target" != "$head_target" && ! -e "$base_target" && ! -e "$head_target" ]]
  printf '%s\n' "$base_target" "$head_target" > "$capture/isolated-targets.txt"
  (cd "$baseline" && git ls-files crates/vize_patina/src | sort | xargs sha256sum) > "$capture/base-production.sha256"
  git ls-files crates/vize_patina/src | sort | xargs sha256sum > "$capture/head-production.sha256"
  flags=(--locked --profile ci-opt -p vize_patina --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16')
  (cd "$baseline" && CARGO_TARGET_DIR="$base_target" cargo build "${flags[@]}" --verbose --message-format=json --example native_image_alt_original) > "$capture/base-build.jsonl" 2> "$capture/base-build.stderr"
  cp "$base_target/ci-opt/examples/native_image_alt_original" "$capture/base-observer"
  CARGO_TARGET_DIR="$head_target" cargo build "${flags[@]}" --verbose --message-format=json --example native_image_alt_original --example native_image_alt_canonical > "$capture/head-build.jsonl" 2> "$capture/head-build.stderr"
  CARGO_TARGET_DIR="$head_target" cargo clippy "${flags[@]}" --lib --example native_image_alt_original --example native_image_alt_canonical -- -D warnings > "$capture/head-clippy.log" 2>&1
  cp "$head_target/ci-opt/examples/native_image_alt_original" "$capture/head-observer"
  cp "$head_target/ci-opt/examples/native_image_alt_canonical" "$capture/canonical-observer"
  sha256sum "$capture/"*-observer > "$capture/executables.sha256"
  """#
}
