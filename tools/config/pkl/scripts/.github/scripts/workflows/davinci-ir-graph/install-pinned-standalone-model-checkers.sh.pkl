amends "../../../../../../../ci/lib/ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  set -euo pipefail
  curl -fsSL --retry 3 -o alloy.jar https://repo.maven.apache.org/maven2/org/alloytools/org.alloytools.alloy.dist/6.2.0/org.alloytools.alloy.dist-6.2.0.jar
  curl -fsSL --retry 3 -o tlc.jar https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
  curl -fsSL --retry 3 -o lean.tar.zst https://github.com/leanprover/lean4/releases/download/v4.33.1/lean-4.33.1-linux.tar.zst
  sha256sum -c <<'SUMS'
  6037cbeee0e8423c1c468447ed10f5fcf2f2743a2ffc39cb1c81f2905c0fdb9d  alloy.jar
  936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88  tlc.jar
  890afd185370f85666025b883914ab4f4b339136f8c96167b69cfb62aecaf235  lean.tar.zst
  SUMS
  tar --zstd -xf lean.tar.zst
  """#
}
