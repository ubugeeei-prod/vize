amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  cd "$SOURCE_ROOT"
  status=0
  /usr/bin/time -v cargo test --locked --profile ci -p vize --test integration doctor_barrel_props_cli::direct_and_reexported_components_have_identical_complete_healthy_reports -- --nocapture > "$VIZE_BARREL_PROPS_ARTIFACTS/test.stdout" 2> "$VIZE_BARREL_PROPS_ARTIFACTS/test.stderr" || status=$?
  cat "$VIZE_BARREL_PROPS_ARTIFACTS/test.stdout"
  test "$status" -ne 0
  node "$VIZE_CI_FILES/verify-diagnostic-packet.ts"
  """#
}
