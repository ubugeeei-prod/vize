amends "../../../../../ShellScript.pkl"

local leanVersion = "4.33.1"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  cd "$RUNNER_TEMP"
  curl -fsSL --retry 3 -o lean.tar.zst https://github.com/leanprover/lean4/releases/download/v\#(leanVersion)/lean-\#(leanVersion)-linux.tar.zst
  echo '890afd185370f85666025b883914ab4f4b339136f8c96167b69cfb62aecaf235  lean.tar.zst' | sha256sum -c
  tar --zstd -xf lean.tar.zst
  lean-\#(leanVersion)-linux/bin/lean -DwarningAsError=true "$GITHUB_WORKSPACE/tests/formal/source-map/LineBreaks.lean" | tee line-breaks.log
  grep -Fx "'Davinci.SourceMap.LineBreaks.first_exact' does not depend on any axioms" line-breaks.log
  grep -Fx "'Davinci.SourceMap.LineBreaks.last_exact' depends on axioms: [propext]" line-breaks.log
  lean-\#(leanVersion)-linux/bin/lean -DwarningAsError=true "$GITHUB_WORKSPACE/tests/formal/source-map/Coordinates.lean" | tee theorem.log
  grep -Fx "'Davinci.SourceMap.column_exact' depends on axioms: [propext, Quot.sound]" theorem.log
  lean-\#(leanVersion)-linux/bin/lean -DwarningAsError=true "$GITHUB_WORKSPACE/tests/formal/style-format/Header.lean" | tee header.log
  grep -Fx "'Davinci.StyleFormat.accepted_iff' depends on axioms: [propext, Classical.choice, Quot.sound]" header.log
  """#
}
