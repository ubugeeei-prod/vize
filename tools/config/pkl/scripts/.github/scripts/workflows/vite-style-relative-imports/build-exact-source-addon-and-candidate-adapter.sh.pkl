amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.requireCheckout("SOURCE_SHA")
  #"""
  custody="$RUNNER_TEMP/vite-style-source-custody"
  mkdir -p "$custody"
  record_source() {
    source_stage="$1"
    git rev-parse HEAD > "$custody/$source_stage.head"
    git status --porcelain=v1 --untracked-files=all > "$custody/$source_stage.status"
    git diff --binary HEAD > "$custody/$source_stage.diff"
  }
  record_source before-native
  vp run --workspace-root build:native:test
  record_source after-native
  vp run --workspace-root build:vite-plugin
  record_source after-adapter-build
  node npm/builder/vite/scripts/run-tests.ts --require-prepared
  """#
}
