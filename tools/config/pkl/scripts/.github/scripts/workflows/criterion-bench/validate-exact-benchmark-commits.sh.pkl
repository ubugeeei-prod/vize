amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  module.requireCommitShas(List("BASE_SHA"))
  module.requireCommitShas(List("HEAD_SHA"))
  #"""
  [[ "$BASE_SHA" != "$HEAD_SHA" ]]
  [[ "$HEAD_SHA" == "$DISPATCH_SHA" ]]
  [[ "$(git -C base rev-parse HEAD)" == "$BASE_SHA" ]]
  [[ "$(git -C head rev-parse HEAD)" == "$HEAD_SHA" ]]
  git -C head merge-base --is-ancestor "$BASE_SHA" "$HEAD_SHA"
  """#
}
