amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  export VIZE_TOOLCHAIN_HISTORY="$RUNNER_TEMP/shared-documents"
  export VIZE_STYLED_SESSION_OUTPUT="$RUNNER_TEMP/styled-session.json"
  export VIZE_SCOPED_SESSION_OUTPUT="$RUNNER_TEMP/scoped-session.json"
  export NODE_PATH="$RUNNER_TEMP/session-oracle/node_modules"
  version=$(node "$VIZE_CI_FILES/read-pinned-sass-version.ts")
  npm install --prefix "$RUNNER_TEMP/session-oracle" --no-audit --no-fund --ignore-scripts --save-exact "sass@$version" @vue/compiler-sfc@3.5.35 @jridgewell/sourcemap-codec@1.6.0 postcss-selector-parser@7.1.6 vue@3.5.35
  flags=(--locked --profile ci-opt -p vize_maestro --features experimental-lexical-arrow-queries,experimental-recovered-literal-prefix,experimental-scoped-component-session,experimental-style-lint-products,micro-profiling --lib)
  cargo clippy "${flags[@]}" --no-deps -- -D warnings
  cargo test "${flags[@]}" toolchain_session_from_one_open_buffer -- --nocapture
  cargo test "${flags[@]}" toolchain_session_rejects_a_foreign_language -- --nocapture
  cargo test "${flags[@]}" current_scoped_compiler_and_lint_publication -- --ignored --nocapture --test-threads=1
  node crates/vize_atelier_sfc/tests/component_scss/oracle.ts < "$VIZE_STYLED_SESSION_OUTPUT"
  node crates/vize_atelier_sfc/tests/component_scss/oracle.ts < "$VIZE_SCOPED_SESSION_OUTPUT"
  node "$VIZE_CI_FILES/check-style-revisions.cjs"
  cargo test --locked --profile ci-opt -p vize_atelier_sfc --features native-sfc-scss --test native_sfc_scss component_scss::prepared:: -- --include-ignored --nocapture --test-threads=1
  export VIZE_COMPOSED_STYLE_INPUTS="$RUNNER_TEMP/vue-paths"
  git ls-files -z -- '*.vue' '*.vue.txt' > "$VIZE_COMPOSED_STYLE_INPUTS"
  cargo test "${flags[@]}" shared_style_queries_on_repository_documents -- --ignored --nocapture
  cargo test "${flags[@]}" source_project::style_format::composition:: -- --include-ignored --nocapture --test-threads=1
  test -s "$VIZE_TOOLCHAIN_HISTORY"
  cargo test --locked --profile ci-opt -p vize_atelier_sfc --features bundler-block-products --test bundler_toolchain_session -- --ignored --nocapture
  cargo test --locked --profile ci-opt --manifest-path crates/vize_incremental/providers/graph/Cargo.toml --test incremental original_template_graphs_follow_the_same_toolchain_session -- --ignored --nocapture
  """#
}
