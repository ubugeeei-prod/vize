amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  flags=(--locked --profile ci-opt)
  rust=(-p vize_atelier_sfc --features bundler-block-products)
  cargo clippy "${flags[@]}" "${rust[@]}" --lib --no-deps -- -D warnings
  cargo test "${flags[@]}" "${rust[@]}" --lib bundler::tests
  cargo test "${flags[@]}" "${rust[@]}" --test bundler_block_products -- --include-ignored --nocapture --test-threads=1
  cargo build "${flags[@]}" -p vize_vitrine --features experimental-bundler-block-products,legacy --lib
  cp target/ci-opt/libvize_vitrine.so "$RUNNER_TEMP/bundler-blocks.node"
  node tools/support/compat/npm/bundler-block-products.ts "$RUNNER_TEMP/bundler-blocks.node"
  """#
}
