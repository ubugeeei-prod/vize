amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_maestro", "--lib", "server::initial_diagnostics::"))
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_maestro", "--lib", "ide::diagnostics::native::timeout::"))
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_maestro", "--lib", "server::diagnostic_publishing::"))
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_maestro", "--lib", "ide::diagnostics::assembly_parity_tests::"))
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_maestro", "--lib", "server::state::config_tests::"))
  module.command("cargo", List("clippy", "--locked", "--profile", "ci", "-p", "vize_maestro", "--all-targets", "--", "-D", "warnings"))
  module.command("node", List("--test", "--test-concurrency=1", "tests/tooling/lsp-initial-diagnostics-version.test.ts", "tests/tooling/lsp-responsive-lint-diagnostics.test.ts", "tests/tooling/vscode-extension-core-behavior.test.ts", "tests/tooling/vscode-extension-manifest.test.ts", "tests/tooling/lsp-startup-local-interactive.test.ts"))
}
