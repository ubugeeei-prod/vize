amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  set -euo pipefail
  git -C .typescript-fixtures ls-files -z -- tests/cases/compiler tests/cases/conformance > "$RUNNER_TEMP/upstream-ts-paths"
  node tools/support/compat/davinci/select-broken-scripts.ts .typescript-fixtures "$RUNNER_TEMP/upstream-ts-paths" "$VIZE_FIRST_OPEN_INPUT"
  flags=(--locked --profile ci-opt --lib)
  cargo clippy "${flags[@]}" -p vize_l2 --features recovered-literal-prefix --no-deps -- -D warnings
  cargo clippy "${flags[@]}" -p vize_maestro --features experimental-recovered-literal-prefix --no-deps -- -D warnings
  cargo test "${flags[@]}" -p vize_l2 --features recovered-literal-prefix query::script::assignments::prefix::
  cargo test "${flags[@]}" -p vize_maestro --features experimental-recovered-literal-prefix,micro-profiling source_project::recovered_script:: -- --include-ignored --nocapture --test-threads=1
  node tools/support/compat/davinci/primitive-assignments-oracle.ts "$VIZE_PREFIX_OUTPUT" --recovered
  node tools/support/compat/davinci/literal-hover-oracle.ts target/ci-opt/vize "$VIZE_RECOVERED_HOVERS"
  """#
}
