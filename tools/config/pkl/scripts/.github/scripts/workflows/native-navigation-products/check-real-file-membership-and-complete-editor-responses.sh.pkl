amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  flags=(--locked --profile ci-opt)
  file=(-p vize_l1_to_l2 --features native-navigation-products --lib)
  editor=(-p vize_maestro --features experimental-navigation-products,micro-profiling --lib)
  cargo clippy "${flags[@]}" "${file[@]}" --no-deps -- -D warnings
  cargo clippy "${flags[@]}" "${editor[@]}" --no-deps -- -D warnings
  cargo test "${flags[@]}" "${file[@]}" native_file::query::
  cargo test "${flags[@]}" "${editor[@]}" source_project::navigation::
  export VIZE_NATIVE_NAVIGATION_INPUTS="$RUNNER_TEMP/navigation-sources"
  cargo test "${flags[@]}" "${editor[@]}" original_file_membership_and_public_navigation_packets_match -- --ignored --nocapture --test-threads=1
  """#
}
