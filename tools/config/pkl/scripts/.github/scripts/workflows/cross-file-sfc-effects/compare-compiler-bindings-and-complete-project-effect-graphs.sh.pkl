amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  flags=(--locked --profile ci-opt --lib)
  cargo clippy "${flags[@]}" -p vize_l2 -p vize_croquis -p vize_atelier_sfc --features vize_atelier_sfc/script-binding-products --no-deps -- -D warnings
  cargo test "${flags[@]}" -p vize_l2 --features script-declaration-queries query::script::
  export VIZE_SCRIPT_QUERY_INPUTS="$RUNNER_TEMP/script-effect-inputs"
  git ls-files -z -- '*.vue' '*.vue.txt' > "$VIZE_SCRIPT_QUERY_INPUTS"
  cargo test "${flags[@]}" -p vize_atelier_sfc --features script-binding-products compile_script::binding_products:: -- --include-ignored --nocapture --test-threads=1
  """#
}
