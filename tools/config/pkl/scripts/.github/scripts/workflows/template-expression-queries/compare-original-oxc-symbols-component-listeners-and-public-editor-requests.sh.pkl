amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  set -euo pipefail
  export VIZE_EXPRESSION_QUERY_MANIFEST="$RUNNER_TEMP/vue-files"
  export VIZE_LEXICAL_MODULE_MANIFEST="$RUNNER_TEMP/standalone-modules"
  export VIZE_REQUIRE_REPOSITORY_ARROWS=1
  git ls-files -z -- '*.vue' '*.vue.txt' > "$VIZE_EXPRESSION_QUERY_MANIFEST"
  git ls-files -z -- '*.js' '*.mjs' '*.ts' '*.mts' ':!*.d.ts' ':!*.d.mts' > "$VIZE_LEXICAL_MODULE_MANIFEST"
  # Keep exercising both original closures after their operational scripts have moved.
  find "$VIZE_LEXICAL_REFERENCE/tools" -type f -name '*.ts' -print0 | LC_ALL=C sort -z >> "$VIZE_LEXICAL_MODULE_MANIFEST"
  flags=(--locked --profile ci-opt)
  native=(-p vize_l1_to_l2 --features lexical-arrow-initializers,template-operand-queries,vize_l2/position-index)
  editor=(-p vize_maestro --features experimental-lexical-arrow-queries,micro-profiling --lib)
  cargo test "${flags[@]}" -p vize_oxc_parser --features terminal-embedding --lib embedding::terminal::tests::
  cargo test "${flags[@]}" -p vize_l1 --features retained-expressions --lib handoff::sequence::
  cargo clippy "${flags[@]}" -p vize_l1 --features retained-expressions --lib --no-deps -- -D warnings
  cargo clippy "${flags[@]}" -p vize_l2 --features lexical-arrow-initializers --lib --no-deps -- -D warnings
  cargo clippy "${flags[@]}" "${native[@]}" --lib --no-deps -- -D warnings
  cargo clippy "${flags[@]}" "${editor[@]}" --no-deps -- -D warnings
  cargo test "${flags[@]}" "${native[@]}" --test expression_queries lexical_arrows:: -- --include-ignored --nocapture --test-threads=1
  cargo test "${flags[@]}" "${native[@]}" --test expression_query_alloc
  cargo test "${flags[@]}" "${editor[@]}" tests::lexical:: -- --include-ignored --nocapture --test-threads=1
  """#
}
