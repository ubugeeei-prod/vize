amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  module.requireCommitShas(List("BASE_SHA"))
  module.requireCommitShas(List("HEAD_SHA"))
  #"""
  started="$(date +%s%3N)"
  echo "TEMPLATE_ALIAS_STARTED_MS=$started" >> "$GITHUB_ENV"
  echo "TEMPLATE_ALIAS_DEADLINE_MS=$((started + 53 * 60000))" >> "$GITHUB_ENV"
  mkdir -p "$RUNNER_TEMP/mapper-public-stages"
  """#
}
