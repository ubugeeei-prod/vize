amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  directory="$RUNNER_TEMP/jsx-authored-native/vdom-review"
  mkdir -p "$directory"
  """#
  module.requireCheckout("QUALIFICATION_HEAD_SHA")
  #"""
  git rev-parse HEAD HEAD^{tree} > "$directory/head-source.txt"
  baseline="$RUNNER_TEMP/jsx-vdom-review-base"
  observer=crates/vize_atelier_jsx/tests/vdom_child_review.rs
  git fetch --no-tags origin 18ebd0556f55fc1fff4b7a993efa752bdabc7232
  git worktree add --detach "$baseline" 18ebd0556f55fc1fff4b7a993efa752bdabc7232
  cp "$observer" "$baseline/$observer"
  cmp "$observer" "$baseline/$observer"
  ir_observer=davinci/vize_l4/tests/jsx_child_values.rs
  # The baseline predates the neutral `Op::ChildValue` name (`ui.jsx-child`);
  # its copy of the observer spells the variant as the baseline does, and
  # nothing else may differ.
  sed -f "$VIZE_CI_FILES/original-child-value.sed" "$ir_observer" > "$baseline/$ir_observer"
  diff <(sed -f "$VIZE_CI_FILES/current-child-value.sed" "$baseline/$ir_observer") "$ir_observer"
  git -C "$baseline" diff --exit-code -- crates/*/src davinci/*/src
  git -C "$baseline" rev-parse HEAD HEAD^{tree} > "$directory/base-source.txt"
  sha256sum "$observer" "$baseline/$observer" "$ir_observer" "$baseline/$ir_observer" tests/tooling/jsx-vapor-oracle/{vdom-child-review.ts,vdom-child-review-browser.ts,vdom-child-ir.ts,runtime.ts} tests/_fixtures/differential/compiler/jsx-child-values-6890/original.json > "$directory/observer.sha256"
  status=0
  VIZE_JSX_VDOM_REVIEW_CAPTURE="$directory/head.json" cargo test --locked --profile ci -p vize_atelier_jsx --test vdom_child_review > "$directory/head.stdout" 2> "$directory/head.stderr" || status=1
  (cd "$baseline" && CARGO_TARGET_DIR="$RUNNER_TEMP/jsx-vdom-review-base-target" VIZE_JSX_VDOM_REVIEW_CAPTURE="$directory/base.json" cargo test --locked --profile ci -p vize_atelier_jsx --test vdom_child_review) > "$directory/base.stdout" 2> "$directory/base.stderr" || status=1
  node tests/tooling/jsx-vapor-oracle/vdom-child-review.ts "$directory/base.json" "$directory/head.json" "$directory/node.json" > "$directory/node.stdout" 2> "$directory/node.stderr" || status=1
  VIZE_JSX_RAW_IR_CAPTURE="$directory/head-ir.json" cargo test --locked --profile ci -p vize_l4 --test jsx_child_values > "$directory/head-ir.stdout" 2> "$directory/head-ir.stderr" || status=1
  (cd "$baseline" && CARGO_TARGET_DIR="$RUNNER_TEMP/jsx-vdom-review-base-target" VIZE_JSX_RAW_IR_CAPTURE="$directory/base-ir.json" cargo test --locked --profile ci -p vize_l4 --test jsx_child_values) > "$directory/base-ir.stdout" 2> "$directory/base-ir.stderr" || status=1
  node tests/tooling/jsx-vapor-oracle/vdom-child-ir.ts "$directory/base-ir.json" "$directory/head-ir.json" "$directory/ir-ast.json" > "$directory/ir-ast.stdout" 2> "$directory/ir-ast.stderr" || status=1
  exit "$status"
  """#
}
