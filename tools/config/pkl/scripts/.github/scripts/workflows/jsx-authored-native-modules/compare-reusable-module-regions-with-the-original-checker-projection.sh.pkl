amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  # Both the projected modules and the published ambient file import Vue.
  test -f npm/cli/node_modules/vue/package.json
  cargo test --locked --profile ci -p vize_l4 --features module-ir --test jsx_module_projection
  export VIZE_MODULE_IR_MANIFEST="$RUNNER_TEMP/module-ir-paths"
  git ls-files -z '*.jsx' '*.tsx' '*.jsx.txt' '*.tsx.txt' > "$VIZE_MODULE_IR_MANIFEST"
  cargo test --locked --profile ci -p vize_l4 --features module-ir --test jsx_module_projection -- neutral_corpus::compare_modules_at_every_outcome --exact --ignored --nocapture
  """#
}
