amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  [[ "$SHA" =~ ^[0-9a-f]{40}$ ]]
  [[ "$SIZES" =~ ^([0-9]+(,[0-9]+)*)?$ ]]
  [[ "$RUNS" =~ ^[1-9][0-9]?$ ]]
  [[ "$SCALING_TOOLS" =~ ^([a-z0-9-]+(,[a-z0-9-]+)*)?$ ]]
  [[ "$MONOREPO_SFCS" =~ ^[0-9]+$ ]]
  [[ "$GIANT_BLOCKS" =~ ^[0-9]+$ ]]
  [[ "$NUXT_SIZES" =~ ^([0-9]+(,[0-9]+)*)?$ ]]
  """#
}
