amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  flags=(--locked --profile ci-opt)
  suite=(-p vize --features plugin-project-facts --test plugin_template_products)
  export VIZE_PLUGIN_TEMPLATE_INPUTS="$RUNNER_TEMP/plugin-templates"
  cargo clippy "${flags[@]}" -p vize_patina --features plugin-template-facts --lib --no-deps -- -D warnings
  cargo clippy "${flags[@]}" -p vize --features plugin-project-facts --lib --no-deps -- -D warnings
  cargo test "${flags[@]}" -p vize_patina --features plugin-template-facts --lib plugin_batch::
  cargo test "${flags[@]}" -p vize_doctor --features application-analysis --test application_complexity
  cargo test "${flags[@]}" "${suite[@]}" -- --test-threads=1
  cargo test "${flags[@]}" "${suite[@]}" original_packets_and_component_records_match -- --ignored --nocapture --test-threads=1
  """#
}
