  mkdir -p "$RUNNER_TEMP/nuxt5-runtime-proof"
  node "$VIZE_CI_FILES/install-the-frozen-nuxt-5-production-reproduction.cjs" > "$RUNNER_TEMP/nuxt5-runtime-proof/runtime.json"
