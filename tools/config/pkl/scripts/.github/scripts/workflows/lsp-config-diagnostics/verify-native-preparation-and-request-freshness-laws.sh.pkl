amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_maestro", "--features", "legacy", "--lib", "server::initial_diagnostics::"))
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_maestro", "--features", "legacy", "--lib", "server::native_requests::"))
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_maestro", "--features", "legacy", "--lib", "server::state::project_contexts::", "--", "--nocapture"))
  module.command("cargo", List("clippy", "--locked", "--profile", "ci", "-p", "vize_maestro", "--features", "legacy", "--all-targets", "--", "-D", "warnings"))
}
