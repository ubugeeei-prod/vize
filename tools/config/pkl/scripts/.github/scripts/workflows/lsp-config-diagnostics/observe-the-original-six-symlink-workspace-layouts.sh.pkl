amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  set +e
  cargo test --locked --profile ci -p vize --features legacy --message-format=json --test integration -- lsp_symlink_workspace_staging_cli::original_include_and_open_order_controls_keep_all_authored_bytes --nocapture > target/vize-tests/lsp-config-diagnostics/symlink.stdout 2> target/vize-tests/lsp-config-diagnostics/symlink.stderr
  status=$?
  set -e
  printf '%s\n' "$status" > target/vize-tests/lsp-config-diagnostics/symlink.status
  node tools/support/compat/github/run-lsp-config-diagnostics.ts --retain-symlink-producer
  cat target/vize-tests/lsp-config-diagnostics/symlink.stdout
  cat target/vize-tests/lsp-config-diagnostics/symlink.stderr >&2
  exit "$status"
  """#
}
