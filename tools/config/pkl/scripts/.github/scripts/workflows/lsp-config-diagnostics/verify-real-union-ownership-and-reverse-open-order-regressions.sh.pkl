amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_canon", "--features", "legacy", "--lib", "corsa_bridge::vue_document_package_tests::symlink_workspace::"))
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_canon", "--features", "legacy", "--lib", "batch::virtual_project::materialize::alias_transition_tests::"))
  module.command("cargo", List("test", "--locked", "--profile", "ci", "-p", "vize_canon", "--features", "legacy", "--lib", "corsa_bridge::vue_dependencies_alias::context::cache::tests::"))
  module.command("cargo", List("clippy", "--locked", "--profile", "ci", "-p", "vize_canon", "--features", "legacy", "--lib", "--", "-D", "warnings"))
