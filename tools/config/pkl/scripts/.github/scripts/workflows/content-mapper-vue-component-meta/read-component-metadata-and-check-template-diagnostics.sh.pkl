amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  #"""
  cp -R tools/support/compat/content-mapper/fixtures/vue-component-meta "$RUNNER_TEMP/component-meta"
  for input in tests/_fixtures/differential/typechecker/component-meta-13430/*.txt; do
    cp "$input" "$RUNNER_TEMP/component-meta/$(basename "$input" .txt)"
  done
  cd "$RUNNER_TEMP/component-meta"
  npm install --no-audit --no-fund --legacy-peer-deps tsrs@7.1.0-beta.tsrs4 vue@3.5.46 vue-component-meta@4.0.0-alpha.3
  mkdir -p node_modules/vize
  cp -R "$GITHUB_WORKSPACE/npm/cli/"{*.d.*,generated} node_modules/vize/
  jq --arg cli "$GITHUB_WORKSPACE/target/ci/vize" '.typescript.contentMapper.exec = [$cli, "content-mapper"]' \
    "$GITHUB_WORKSPACE/npm/cli/package.json" > node_modules/vize/package.json
  node check.ts
  """#
}
