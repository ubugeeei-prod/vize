amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.strictMode
  #"""
  mkdir -p functional-evidence
  git rev-parse HEAD > functional-evidence/source.sha
  rustc +1.100.0 -vV > functional-evidence/rustc.txt
  lscpu > functional-evidence/cpu.txt
  node "$VIZE_CI_FILES/../shared/runner-resources.ts" report 'untimed parser packets and counter laws; no throughput comparison' RUNNER_NAME RUNNER_OS RUNNER_ARCH RUNNER_ENVIRONMENT CARGO_BUILD_JOBS > functional-evidence/resources.json
  node tools/benchmarks/scripts/recovery_cost_contract.ts | tee functional-evidence/recovery-class-controls.log
  node tools/benchmarks/scripts/compare_recovery_clone.ts --self-test | tee functional-evidence/clone-class-controls.log
  cargo +1.100.0 test --locked --profile ci -p vize_croquis script_parser::recovery --message-format json -- --nocapture 2>&1 | tee functional-evidence/parser-packets.log
  cargo +1.100.0 test --locked --profile ci -p vize_l0 --test source_operations_profile --features micro-profiling --message-format json 2>&1 | tee functional-evidence/source-counter-laws.log
  """#
}
