amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.command("cargo", List("test", "--locked", "-p", "vize_canon", "--lib", "precedence_tests"))
  module.command("cargo", List("test", "--locked", "-p", "vize_canon", "--lib", "dependency_scan::resolution::alias_tests"))
  module.command("cargo", List("test", "--locked", "-p", "vize_canon", "--lib", "batch::virtual_project::tests::alias_rewrite"))
  module.command("cargo", List("test", "--locked", "-p", "vize_canon", "--lib", "app_only_suffix_alias_reports_and_repairs_the_authored_child"))
  module.command("cargo", List("test", "--locked", "-p", "vize", "--lib", "commands::check::imports_aliases::tests::selection", "--", "--nocapture"))
  module.command("node", List("--test", "tools/benchmarks/scripts/canon-alias-collector.test.mjs"))
}
