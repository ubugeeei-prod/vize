amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  module.command("cargo", List("test", "--locked", "-p", "vize_canon", "--lib", "batch::virtual_project::tests::type_source_snapshot"))
  module.command("cargo", List("test", "--locked", "-p", "vize_atelier_sfc", "--lib", "croquis::tests"))
  module.command("cargo", List("clippy", "--locked", "-p", "vize_canon", "--lib", "--", "-D", "warnings"))
}
