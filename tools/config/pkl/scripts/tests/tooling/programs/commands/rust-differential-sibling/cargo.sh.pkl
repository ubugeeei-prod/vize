amends "../../../../../../ShellScript.pkl"

interpreter = "sh"

commands {
  #"""
  exec "$NODE" -e 'const fs=require("node:fs"),assert=require("node:assert/strict"),args=process.argv.slice(1);if(process.env.REQUIRE_HYDRATION==="1")assert.equal(fs.readFileSync(@@FIXTURE_PATH_FIXTURE_PIN@@,"utf8"),process.env.FIXTURE_PIN);fs.appendFileSync(process.env.LOG,JSON.stringify({args,tsgo:process.env.VIZE_TEST_REQUIRE_TSGO,disable:process.env.VIZE_TEST_DISABLE_TSGO,iterations:process.env.VIZE_NUXT_CONFIG_ITERATIONS,production:process.env.VIZE_VUE_RUNTIME_PRODUCTION,corpus:process.env.VIZE_DAVINCI_DIFFERENTIAL_CORPUS})+"\n");if(process.env.VIZE_TEST_REQUIRE_TSGO!=="1"||Object.hasOwn(process.env,"VIZE_TEST_DISABLE_TSGO")||process.env.VIZE_NUXT_CONFIG_ITERATIONS!=="100")process.exit(92);if(args.includes(process.env.FAIL))process.exit(42);' -- "$@"
  """#
}
