amends "../../../../../../../../ci/lib/ShellScript.pkl"

interpreter = null

commands {
  #"""
  #!/bin/bash
  set -euo pipefail
  printf "%s\n" "$@" > "$HELPER_LOG"
  [ "$1" = "$EXTRACTOR" ] && [ "$4" = "$PRODUCTION_PIN" ]
  if [ "$FIXTURE_DIGEST" = true ]; then
    exec /bin/bash "$1" "$2" "$3" "$FIXTURE_SHA"
  fi
  exec /bin/bash "$@"
  """#
}
