amends "../../../../../ShellScript.pkl"

interpreter = "bash"

commands {
  "# Existing native phase build and recursive packet retention own this control."
  module.strictMode
  module.onlyPullRequestsAndSchedules
  module.unsetVariable("VIZE_TEST_DISABLE_TSGO")
  "export VIZE_TEST_REQUIRE_TSGO=1"
  module.captureDirectory("VIZE_NATIVE_SYNTAX_CAPTURE_DIR", "native-source-recipe-transport-refusal")
  module.inSourceRoot()
  module.command("git", List("submodule", "update", "--init", "--depth", "1", "--", "tests/_fixtures/_git/element-plus"))
  #"""
  cargo test --locked --profile ci-opt -p vize_canon --test native_syntax_semantics \
    --config 'profile.ci-opt.inherits="release"' \
    --config 'profile.ci-opt.lto="thin"' \
    --config 'profile.ci-opt.codegen-units=16' -- --nocapture --test-threads=1
  """#
}
