module vize.ci.Actions

import "BootstrapAssets.pkl" as assets

checkout = "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
uploadArtifact = "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a"
downloadArtifact = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8b5a5461e7c"
setupRust = "dtolnay/rust-toolchain@d1031067263f94b142dd6c0ce24c5eb9d02d52a0"
setupNode = "actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38"
setupVp = "voidzero-dev/setup-vp@ca1c46663915d6c1042ae23bd39ab85718bfb0fa"
setupVp121 = "voidzero-dev/setup-vp@68f39c78aaf39be468cabd2afb09c162574c84af"
setupWild = "wild-linker/action@0bbbfa5df4380cab8e63cb8505a1ce65e1d10203"
setupBun = "oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6"
cache = "actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae"
linux = "blacksmith-32vcpu-ubuntu-2404"
linux2204 = "blacksmith-32vcpu-ubuntu-2204"
windows = "blacksmith-32vcpu-windows-2025"
macos = "blacksmith-12vcpu-macos-15"

function use(action: String): Dynamic = new { uses = action }

function command(label: String, commandLine: String): Dynamic = new {
  name = label
  run = commandLine
}

function checkoutAt(revision: String): Dynamic = new {
  uses = checkout
  with {
    ref = revision
    `persist-credentials` = false
  }
}

function rust(version: String): Dynamic = new {
  uses = setupRust
  with { toolchain = version }
}

function wild(): Dynamic = new {
  uses = setupWild
  with { `wild-version` = assets.wild.version }
}

function workspaceVp(): Dynamic = new {
  uses = setupVp
  with {
    `node-version-file` = "package.json"
    cache = true
    `run-install` = false
  }
}

function stageWorkflowScripts(workflow: String): Listing<Dynamic> = new {
  new Dynamic {
    name = "Check out the workflow's scripts"
    uses = checkout
    with {
      ref = "${{ github.workflow_sha }}"
      path = ".vize-workflow-tools"
      `persist-credentials` = false
      `sparse-checkout-cone-mode` = false
      `sparse-checkout` = "/.github/actions/stage-workflow-scripts/\n/.github/scripts/workflows/shared/\n/.github/scripts/workflows/\(workflow)/"
    }
  }
  new Dynamic {
    name = "Stage scripts outside the source checkout"
    uses = "./.vize-workflow-tools/.github/actions/stage-workflow-scripts"
  }
}
