amends "../../../PackageTasks.pkl"

tasks {
  ["build"] {
    module.run("pnpm", List("check"))
    module.run("vp", List("build", "--config", "vite.app.config.ts"))
  }
  ["gallery:ui"] {
    module.run("node", List("../../npm/ui/scripts/generate-gallery.ts"))
    module.run("vp", List("dev", "--config", "vite.ui-gallery.config.ts"))
  }
  ["gallery:ui:build"] {
    module.run("node", List("../../npm/ui/scripts/generate-gallery.ts"))
    module.run("vp", List("build", "--config", "vite.ui-gallery.config.ts"))
  }
  ["check"] {
    module.run("cargo", List(
      "run",
      "--quiet",
      "--target-dir",
      "../../.docs-example-target",
      "--manifest-path",
      "../../Cargo.toml",
      "-p",
      "vize",
      "--",
      "check",
    ))
    module.run("vp", List(
      "check",
      "src",
      "vite.config.ts",
      "vite.app.config.ts",
      "vite.ui-gallery.config.ts",
      "vite.globals.config.ts",
      "musea.preview.ts",
      "playwright.config.ts",
    ))
  }
}
