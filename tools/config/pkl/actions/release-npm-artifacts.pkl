import "../../../ci/lib/Actions.pkl" as ci

name = "Restore release npm packages"
description = "Download the built npm packages and native bindings into npm/ and lay out the native platform packages"
inputs {
  `run-id` {
    description = "Prior Release run whose artifacts should be restored"
    required = false
    ["default"] = ""
  }
  `github-token` {
    description = "Token used to restore artifacts from a prior run"
    required = false
    ["default"] = ""
  }
  `release-tag` {
    description = "Immutable release tag whose native package metadata should be restored"
    required = false
    ["default"] = ""
  }
}
runs {
  using = "composite"
  steps = new Listing {
    new Dynamic {
      name = "Install native package tooling"
      shell = "bash"
      run = "vp install --frozen-lockfile --prefer-offline --filter './npm/native...' --filter './npm/fresco-native...' --filter '@vize/tools'"
    }
    new Dynamic {
      `if` = "inputs.run-id == ''"
      uses = ci.downloadArtifact
      with {
        name = "npm-packages"
        path = "npm"
      }
    }
    new Dynamic {
      `if` = "inputs.run-id != ''"
      uses = ci.downloadArtifact
      with {
        name = "npm-packages"
        path = "npm"
        `run-id` = "${{ inputs.run-id }}"
        `github-token` = "${{ inputs.github-token }}"
        repository = "${{ github.repository }}"
      }
    }
    new Dynamic {
      `if` = "inputs.run-id == ''"
      uses = ci.downloadArtifact
      with {
        pattern = "bindings-*"
        path = "npm/native/artifacts"
      }
    }
    new Dynamic {
      `if` = "inputs.run-id != ''"
      uses = ci.downloadArtifact
      with {
        pattern = "bindings-*"
        path = "npm/native/artifacts"
        `run-id` = "${{ inputs.run-id }}"
        `github-token` = "${{ inputs.github-token }}"
        repository = "${{ github.repository }}"
      }
    }
    new Dynamic {
      `if` = "inputs.run-id == ''"
      uses = ci.downloadArtifact
      with {
        pattern = "fresco-bindings-*"
        path = "npm/fresco-native/artifacts"
      }
    }
    new Dynamic {
      `if` = "inputs.run-id != ''"
      uses = ci.downloadArtifact
      with {
        pattern = "fresco-bindings-*"
        path = "npm/fresco-native/artifacts"
        `run-id` = "${{ inputs.run-id }}"
        `github-token` = "${{ inputs.github-token }}"
        repository = "${{ github.repository }}"
      }
    }
    new Dynamic {
      name = "Restore immutable native package metadata"
      `if` = "inputs.release-tag != ''"
      shell = "bash"
      env { RELEASE_TAG = "${{ inputs.release-tag }}" }
      run = ci.actionScript("restore-immutable-native-package-metadata.sh")
    }
    new Dynamic {
      name = "Lay out native platform packages"
      shell = "bash"
      `working-directory` = "npm/native"
      run = ci.actionScript("lay-out-native-platform-packages.sh")
    }
    new Dynamic {
      name = "Stage Fresco native binaries"
      shell = "bash"
      run = ci.actionScript("stage-fresco-native-binaries.sh")
    }
  }
}
