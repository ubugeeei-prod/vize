import "../Actions.pkl" as ci

name = "Native selected SFC DOM runtime"
description = "Capture whole original SFC components and compare pinned Vue click effects"
runs {
  using = "composite"
  steps = new Listing {
    new Dynamic {
      name = "Qualify fresh completed lower File static class modules in both runtime modes"
      `if` = "${{ !cancelled() }}"
      shell = "bash"
      env {
        VIZE_L4_DOM_STATIC_CLASS_CAPTURE = "${{ runner.temp }}/native-dom-static-class.json"
        VIZE_L4_DOM_STATIC_CLASS_RUNTIME_CAPTURE = "${{ runner.temp }}/native-dom-static-class-runtime"
        VIZE_L4_DOM_STATIC_CLASS_REQUIRE_CAPTURE = "1"
      }
      run = ci.actionScript("qualify-fresh-completed-lower-file-static-class-modules-in-both-runtime.sh")
    }
    new Dynamic {
      name = "Qualify whole public selected static class components in both runtime modes"
      `if` = "${{ !cancelled() }}"
      shell = "bash"
      env {
        VIZE_NATIVE_SELECTED_STATIC_CLASS_CAPTURE = "${{ runner.temp }}/native-selected-static-class.json"
        VIZE_NATIVE_SELECTED_STATIC_CLASS_RUNTIME_CAPTURE = "${{ runner.temp }}/native-selected-static-class-runtime"
        VIZE_NATIVE_SELECTED_STATIC_CLASS_REQUIRE_CAPTURE = "1"
      }
      run = ci.actionScript("qualify-whole-public-selected-static-class-components-in-both-runtime-mo.sh")
    }
    new Dynamic {
      name = "Capture and execute source-built selected SFC components"
      shell = "bash"
      env {
        VIZE_NATIVE_SELECTED_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-selected-sfc-dom-capture.json"
        VIZE_NATIVE_SELECTED_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_SELECTED_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-selected-sfc-dom-runtime.json"
      }
      run = ci.actionScript("capture-and-execute-source-built-selected-sfc-components.sh")
    }
    new Dynamic {
      name = "Capture and execute whole original selected setup components"
      shell = "bash"
      env {
        VIZE_NATIVE_SELECTED_SETUP_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-selected-setup-sfc-dom-capture.json"
        VIZE_NATIVE_SELECTED_SETUP_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_SELECTED_SETUP_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-selected-setup-sfc-dom-runtime.json"
      }
      run = ci.actionScript("capture-and-execute-whole-original-selected-setup-components.sh")
    }
    new Dynamic {
      name = "Capture and execute whole original mutable For components"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_FOR_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-for-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_FOR_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_FOR_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-for-sfc-dom-runtime.json"
      }
      run = ci.actionScript("capture-and-execute-whole-original-mutable-for-components.sh")
    }
    new Dynamic {
      name = "Capture and execute whole original For value components"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_FOR_VALUE_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-for-value-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_FOR_VALUE_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_FOR_VALUE_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-for-value-sfc-dom-runtime.json"
      }
      run = ci.actionScript("capture-and-execute-whole-original-for-value-components.sh")
    }
    new Dynamic {
      name = "Capture new original For key components and execute both primary runtime modes"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_FOR_KEY_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-for-key-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_FOR_KEY_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_FOR_KEY_SFC_DOM_PRIMARY_CAPTURE = "${{ runner.temp }}/native-original-for-key-sfc-dom-primary"
        VIZE_NATIVE_ORIGINAL_FOR_KEY_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-for-key-sfc-dom-runtime"
      }
      run = ci.actionScript("capture-new-original-for-key-components-and-execute-both-primary-runtime.sh")
    }
    new Dynamic {
      name = "Capture and qualify original constant For components in both runtime modes"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_FOR_CONSTANT_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-for-constant-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_FOR_CONSTANT_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_FOR_CONSTANT_SFC_DOM_RAW_CAPTURE = "${{ runner.temp }}/native-original-for-constant-sfc-dom-unqualified-attempts.json"
      }
      run = ci.actionScript("capture-and-qualify-original-constant-for-components-in-both-runtime-mod.sh")
    }
    new Dynamic {
      name = "Capture genuine original root If components in both explicit modes"
      `if` = "${{ !cancelled() }}"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-root-if-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_PRIMARY_CAPTURE = "${{ runner.temp }}/native-original-root-if-sfc-dom-primary"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-root-if-sfc-dom-runtime"
      }
      run = ci.actionScript("capture-genuine-original-root-if-components-in-both-explicit-modes.sh")
    }
    new Dynamic {
      name = "Capture genuine root If setup-binding text in both explicit modes"
      `if` = "${{ !cancelled() }}"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_ROOT_IF_TEXT_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-root-if-text-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_TEXT_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_TEXT_SFC_DOM_PRIMARY_CAPTURE = "${{ runner.temp }}/native-original-root-if-text-sfc-dom-primary"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_TEXT_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-root-if-text-sfc-dom-runtime"
      }
      run = ci.actionScript("capture-genuine-root-if-setup-binding-text-in-both-explicit-modes.sh")
    }
    new Dynamic {
      name = "Capture genuine adjacent root If Else components in both explicit modes"
      `if` = "${{ !cancelled() }}"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_SFC_DOM_PRIMARY_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-sfc-dom-primary"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-sfc-dom-runtime"
      }
      run = ci.actionScript("capture-genuine-adjacent-root-if-else-components-in-both-explicit-modes.sh")
    }
    new Dynamic {
      name = "Capture genuine adjacent root If Else setup text in both explicit modes"
      `if` = "${{ !cancelled() }}"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_TEXT_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-text-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_TEXT_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_TEXT_SFC_DOM_PRIMARY_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-text-sfc-dom-primary"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_TEXT_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-text-sfc-dom-runtime"
      }
      run = ci.actionScript("capture-genuine-adjacent-root-if-else-setup-text-in-both-explicit-modes.sh")
    }
    new Dynamic {
      name = "Capture genuine paired original literal and setup text in both explicit modes"
      `if` = "${{ !cancelled() }}"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_COMPOSITE_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-composite-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_COMPOSITE_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_COMPOSITE_SFC_DOM_PRIMARY_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-composite-sfc-dom-primary"
        VIZE_NATIVE_ORIGINAL_ROOT_IF_ELSE_COMPOSITE_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-root-if-else-composite-sfc-dom-runtime"
      }
      run = ci.actionScript("capture-genuine-paired-original-literal-and-setup-text-in-both-explicit.sh")
    }
    new Dynamic {
      name = "Capture genuine original input Models with actual DOM events and IME"
      `if` = "${{ !cancelled() }}"
      shell = "bash"
      env {
        VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_CAPTURE = "${{ runner.temp }}/native-original-input-model-sfc-dom-capture.json"
        VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_REQUIRE_CAPTURE = "1"
        VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_PRIMARY_CAPTURE = "${{ runner.temp }}/native-original-input-model-sfc-dom-primary"
        VIZE_NATIVE_ORIGINAL_INPUT_MODEL_SFC_DOM_RUNTIME_CAPTURE = "${{ runner.temp }}/native-original-input-model-sfc-dom-runtime"
      }
      run = ci.actionScript("capture-genuine-original-input-models-with-actual-dom-events-and-ime.sh")
    }
    new Dynamic {
      name = "Upload complete selected SFC component and runtime captures"
      `if` = "${{ always() }}"
      uses = ci.uploadArtifact
      with {
        name = "native-selected-sfc-dom-${{ github.sha }}-${{ github.run_attempt }}"
        path = """
        ${{ runner.temp }}/native-dom-static-class.json
        ${{ runner.temp }}/native-dom-static-class-runtime.development.json
        ${{ runner.temp }}/native-dom-static-class-runtime.production.json
        ${{ runner.temp }}/native-selected-static-class.json
        ${{ runner.temp }}/native-selected-static-class.json.late-header.json
        ${{ runner.temp }}/native-selected-static-class.json.for-refusal.json
        ${{ runner.temp }}/native-selected-static-class-runtime.late-header.development.json
        ${{ runner.temp }}/native-selected-static-class-runtime.late-header.production.json
        ${{ runner.temp }}/native-selected-static-class-runtime.development.json
        ${{ runner.temp }}/native-selected-static-class-runtime.production.json
        ${{ runner.temp }}/native-selected-static-class-runtime.statuses.json
        ${{ runner.temp }}/native-selected-sfc-dom-capture.json
        ${{ runner.temp }}/native-selected-sfc-dom-runtime.json
        ${{ runner.temp }}/native-selected-setup-sfc-dom-capture.json
        ${{ runner.temp }}/native-selected-setup-sfc-dom-runtime.json
        ${{ runner.temp }}/native-original-for-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-for-sfc-dom-runtime.json
        ${{ runner.temp }}/native-original-for-value-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-for-value-sfc-dom-runtime.json
        ${{ runner.temp }}/native-original-for-key-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-for-key-sfc-dom-capture.json.statuses.json
        ${{ runner.temp }}/native-original-for-key-sfc-dom-primary.*.json
        ${{ runner.temp }}/native-original-for-key-sfc-dom-runtime.*.json
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-unqualified-attempts.json
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-unqualified-attempts.json.statuses.json
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-*-unqualified-runtime.json
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-development-runtime.json
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-production-runtime.json
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-*.stdout
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-*.stderr
        ${{ runner.temp }}/native-original-for-constant-sfc-dom-*.process.json
        ${{ runner.temp }}/native-original-root-if-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-root-if-sfc-dom-capture.json.statuses.json
        ${{ runner.temp }}/native-original-root-if-sfc-dom-primary.*.json
        ${{ runner.temp }}/native-original-root-if-sfc-dom-runtime.*.json
        ${{ runner.temp }}/native-original-root-if-text-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-root-if-text-sfc-dom-capture.json.statuses.json
        ${{ runner.temp }}/native-original-root-if-text-sfc-dom-primary.*.json
        ${{ runner.temp }}/native-original-root-if-text-sfc-dom-runtime.*.json
        ${{ runner.temp }}/native-original-root-if-else-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-root-if-else-sfc-dom-capture.json.statuses.json
        ${{ runner.temp }}/native-original-root-if-else-sfc-dom-primary.*.json
        ${{ runner.temp }}/native-original-root-if-else-sfc-dom-runtime.*.json
        ${{ runner.temp }}/native-original-root-if-else-text-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-root-if-else-text-sfc-dom-capture.json.statuses.json
        ${{ runner.temp }}/native-original-root-if-else-text-sfc-dom-primary.*.json
        ${{ runner.temp }}/native-original-root-if-else-text-sfc-dom-runtime.*.json
        ${{ runner.temp }}/native-original-root-if-else-composite-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-root-if-else-composite-sfc-dom-capture.json.statuses.json
        ${{ runner.temp }}/native-original-root-if-else-composite-sfc-dom-primary.*.json
        ${{ runner.temp }}/native-original-root-if-else-composite-sfc-dom-runtime.*.json
        ${{ runner.temp }}/native-original-input-model-sfc-dom-capture.json
        ${{ runner.temp }}/native-original-input-model-sfc-dom-capture.json.statuses.json
        ${{ runner.temp }}/native-original-input-model-sfc-dom-primary.*.json
        ${{ runner.temp }}/native-original-input-model-sfc-dom-runtime.*.json

        """
        `if-no-files-found` = "error"
        `retention-days` = 7
      }
    }
  }
}
