import "../Actions.pkl" as ci

name = "Setup full JS package tests"
description = "Retain the physical package test runtime, cache, and dependency installation."
runs {
  using = "composite"
  steps = new Listing {
    ci.workspaceVp()
    new Dynamic {
      uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // stable
      with { toolchain = "stable" }
    }
    new Dynamic {
      uses = "./.github/actions/setup-wild-http-recovery"
      with { `wild-version` = "0.9.0" }
    }
    new Dynamic {
      uses = "./.github/actions/setup-rust-sticky-cache"
      with {
        key = "test-js-packages"
        `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
      }
    }
    new Dynamic {
      name = "Install JS dependencies"
      shell = "bash"
      run = "vp install --frozen-lockfile --prefer-offline"
    }
  }
}
