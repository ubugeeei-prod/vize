import "../Actions.pkl" as ci

name = "Validate workflow syntax and contexts"
description = "Run the checksum-pinned workflow checker on the complete workflow inventory"
inputs {
  controls {
    description = "Also exercise the checker's refusal controls during scheduled qualification"
    required = false
    ["default"] = "false"
  }
}
runs {
  using = "composite"
  steps = new Listing {
    new Dynamic {
      name = "Install the pinned workflow checker"
      id = "install"
      shell = "bash"
      run = #"""
      set -euo pipefail
      directory="$(mktemp -d "${RUNNER_TEMP}/vize-actionlint-1.7.12.XXXXXX")"
      archive="$directory/actionlint.tar.gz"
      install_archive=true
      primary_status=0
      primary_http=$(
        set +e
        curl --fail --silent --show-error --location \
          --connect-timeout 10 --max-time 30 --speed-limit 1 --speed-time 5 \
          --retry 2 --retry-all-errors --retry-delay 1 --retry-max-time 30 \
          --output "$archive" --write-out '%{http_code}' \
          https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz
        curl_status=$?
        printf '|'
        exit "$curl_status"
      ) || primary_status=$?
      primary_http="${primary_http%|}"
      case "$primary_status:$primary_http" in
        0:200) ;;
        7:000|18:200|28:000|28:200|28:302|52:000|55:000|55:200|56:000|56:200|\
        22:500|22:502|22:503|22:504)
          api_status=0
          curl --fail --silent --show-error --location \
            --connect-timeout 10 --max-time 30 \
            --retry 5 --retry-all-errors --retry-delay 1 --retry-max-time 30 \
            --header 'Accept: application/octet-stream' \
            --header 'X-GitHub-Api-Version: 2022-11-28' \
            --output "$archive" \
            https://api.github.com/repos/rhysd/actionlint/releases/assets/384924896 || api_status=$?
          if [ "$api_status" -ne 0 ]; then
            install_archive=false
          fi
          ;;
        0:*) echo 'Pinned actionlint download returned an unsupported HTTP status' >&2; exit 1 ;;
        *) exit "$primary_status" ;;
      esac
      binary="$directory/actionlint"
      if [ "$install_archive" = true ]; then
        printf '%s  %s\n' \
          8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8 \
          "$archive" | sha256sum --check --strict
        tar -xzf "$archive" -C "$directory" actionlint
      else
        echo 'Pinned actionlint release transfers failed; building the exact Go module' >&2
        GOBIN="$directory" go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.12
      fi
      "$binary" --version
      printf 'binary=%s\n' "$binary" >> "$GITHUB_OUTPUT"

      """#
    }
    new Dynamic {
      name = "Check complete workflow syntax"
      uses = "./.github/actions/check-workflow-syntax/validate"
      env {
        ACTIONLINT_BINARY = "${{ steps.install.outputs.binary }}"

        WORKFLOW_VALIDATOR_CONTROLS = "${{ inputs.controls }}"
      }
    }
    new Dynamic {
      name = "Preserve workflow diagnostics on failure"
      `if` = "${{ failure() }}"
      uses = ci.uploadArtifact
      with {
        name = "workflow-syntax-${{ github.sha }}-${{ github.run_attempt }}"
        path = "target/workflow-syntax"
        `retention-days` = 14
        `if-no-files-found` = "error"
      }
    }
  }
}
