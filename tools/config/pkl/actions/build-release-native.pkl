import "../../../ci/lib/Actions.pkl" as ci

name = "Build release native bindings"
description = "Shared exact-checkout native bindings recipe for release and trusted cache warming"
inputs {
  target {
    required = true
    description = "Rust target triple"
  }
  `release-version` {
    required = true
    description = "Exact version embedded in release binaries"
  }
  `cross-compile` {
    required = false
    ["default"] = "false"
    description = "Use cargo-zigbuild (Linux GNU targets link against the documented glibc floor)"
  }
  `authorized-release` {
    required = false
    ["default"] = "false"
    description = "Candidate authorization already passed in the caller"
  }
  `upload-artifacts` {
    required = false
    ["default"] = "true"
    description = "Upload artifacts from this checkout"
  }
}
runs {
  using = "composite"
  steps = new Listing {
    new Dynamic {
      name = "Enable long paths (Windows)"
      `if` = "runner.os == 'Windows'"
      shell = "bash"
      run = "git config --system core.longpaths true"
    }
    ci.workspaceVp()
    new Dynamic {
      name = "Install dependencies"
      shell = "bash"
      run = "vp install --frozen-lockfile --prefer-offline --filter './npm/native...' --filter './npm/fresco-native...'"
    }
    new Dynamic {
      name = "Select the Windows target SDK"
      `if` = "runner.os == 'Windows'"
      uses = "ilammy/msvc-dev-cmd@0b201ec74fa43914dc39ae48a89fd1d8cb592756"  // v1
      with { arch = "${{ startsWith(inputs.target, 'aarch64-') && 'amd64_arm64' || 'amd64' }}" }
    }
    new Dynamic {
      name = "Read the repository Rust toolchain"
      id = "rust-toolchain"
      shell = "bash"
      run = ci.actionScript("read-the-repository-rust-toolchain.sh")
    }
    new Dynamic {
      name = "Setup Rust"
      uses = ci.setupRust
      with {
        toolchain = "${{ steps.rust-toolchain.outputs.channel }}"
        targets = "${{ inputs.target }}"
      }
    }
    new Dynamic {
      name = "Setup Wild linker (Linux)"
      `if` = "runner.os == 'Linux'"
      uses = "./.github/actions/setup-wild-http-recovery"
      with { `wild-version` = "0.9.0" }
    }
    new Dynamic {
      name = "Mount Rust sticky disks (Linux)"
      `if` = "runner.os == 'Linux'"
      uses = "./.github/actions/setup-rust-sticky-cache"
      // Reuse only Cargo outputs whose recorded source blobs still match.
      with {
        `reuse-target` = "true"
        `restore-trusted` = "${{ inputs.authorized-release }}"
        key = "release-native-${{ inputs.target }}"
        `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
      }
    }
    new Dynamic {
      name = "Cache Rust (non-Linux)"
      `if` = "runner.os != 'Linux'"
      uses = "Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32"  // v2
      with {
        `shared-key` = "release-native-${{ inputs.target }}"
        `cache-workspace-crates` = "true"
        `save-if` = "${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) || inputs.authorized-release == 'true' }}"
      }
    }
    new Dynamic {
      name = "Tune Windows release profile"
      `if` = "runner.os == 'Windows'"
      shell = "bash"
      run = ci.actionScript("tune-windows-release-profile.sh")
    }
    new Dynamic {
      name = "Setup Zig"
      `if` = "inputs.cross-compile == 'true'"
      uses = "goto-bus-stop/setup-zig@abea47f85e598557f500fa1fd2ab7464fcb39406"  // v2
      // A pinned release: the default nightly master re-downloads (and can time out) every run.
      with { version = "0.15.1" }
    }
    new Dynamic {
      name = "Setup cargo-zigbuild"
      `if` = "inputs.cross-compile == 'true' && runner.os == 'Linux'"
      uses = "./.github/actions/setup-cargo-zigbuild"
    }
    new Dynamic {
      name = "Clean native build outputs"
      shell = "bash"
      run = "node tools/support/github/clean-node-binaries.ts npm/native npm/fresco-native"
    }
    new Dynamic {
      name = "Build vize-native"
      shell = "bash"
      env {
        RELEASE_TARGET = "${{ inputs.target }}"
        RELEASE_CROSS_COMPILE = "${{ inputs.cross-compile }}"
        VIZE_RELEASE_VERSION = "${{ inputs.release-version }}"
        VIZE_NATIVE_BUILD_RECEIPT = ".artifacts/vize-native/build-receipt.${{ inputs.target }}.json"
      }
      run = ci.actionScript("build-vize-native.sh")
    }
    new Dynamic {
      name = "Collect vize-native artifact"
      shell = "bash"
      run = "node tools/support/github/collect-native-artifacts.ts npm/native .artifacts/vize-native vize-native"
    }
    new Dynamic {
      name = "Upload vize-native artifact"
      `if` = "inputs.upload-artifacts == 'true'"
      uses = ci.uploadArtifact
      with {
        name = "bindings-${{ inputs.target }}"
        path = """
        .artifacts/vize-native/*.node
        .artifacts/vize-native/build-receipt.*.json

        """
        `if-no-files-found` = "error"
        `compression-level` = 0
      }
    }
    new Dynamic {
      name = "Build fresco-native"
      shell = "bash"
      env {
        RELEASE_TARGET = "${{ inputs.target }}"
        RELEASE_CROSS_COMPILE = "${{ inputs.cross-compile }}"
        VIZE_RELEASE_VERSION = "${{ inputs.release-version }}"
      }
      run = ci.actionScript("build-fresco-native.sh")
    }
    new Dynamic {
      name = "Collect fresco-native artifact"
      shell = "bash"
      run = "node tools/support/github/collect-native-artifacts.ts npm/fresco-native .artifacts/fresco-native fresco-native"
    }
    new Dynamic {
      name = "Upload fresco-native artifact"
      `if` = "inputs.upload-artifacts == 'true'"
      uses = ci.uploadArtifact
      with {
        name = "fresco-bindings-${{ inputs.target }}"
        path = ".artifacts/fresco-native/*.node"
        `if-no-files-found` = "error"
        `compression-level` = 0
      }
    }
  }
}
