import "../Actions.pkl" as ci

name = "Test native Program and Vue navigation"
description = "Query actual retained native owners through source and complete RPC laws"
runs {
  using = "composite"
  steps = new Listing {
    new Dynamic {
      name = "Test retained native navigation owners and responses"
      shell = "bash"
      run = ci.actionScript("test-retained-native-navigation-owners-and-responses.sh")
    }
  }
}
