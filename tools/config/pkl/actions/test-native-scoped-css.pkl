import "../Actions.pkl" as ci

name = "Native scoped CSS runtime"
description = "Check original SFC scoped CSS and fresh complete native modules in real Vue"
runs {
  using = "composite"
  steps = new Listing {
    new Dynamic {
      name = "Cache Chromium for original scoped empty selectors"
      id = "cache-scoped-chromium"
      uses = ci.cache
      with {
        path = "~/.cache/ms-playwright"
        key = "${{ runner.os }}-playwright-${{ hashFiles('**/pnpm-lock.yaml') }}"
      }
    }
    new Dynamic {
      name = "Install Chromium for scoped CSS behavior"
      uses = "./.github/actions/install-playwright-browsers"
      with { workspace = "./tests" }
    }
    new Dynamic {
      name = "Capture scoped modules from the current Rust source and mount real Vue"
      shell = "bash"
      env {
        VIZE_NATIVE_SCOPED_CSS_CAPTURE = "${{ runner.temp }}/native-scoped-css-capture.json"
        VIZE_NATIVE_SCOPED_CSS_RUNTIME_CAPTURE = "${{ runner.temp }}/native-scoped-css-runtime.json"
        VIZE_NATIVE_CLASS_LIST_CSS_CAPTURE = "${{ runner.temp }}/native-class-list-css-capture.json"
        VIZE_NATIVE_CLASS_LIST_CSS_RUNTIME_CAPTURE = "${{ runner.temp }}/native-class-list-css-runtime.json"
        VIZE_NATIVE_EMPTY_CSS_CAPTURE = "${{ runner.temp }}/native-empty-css-capture.json"
        VIZE_NATIVE_EMPTY_CSS_RUNTIME_CAPTURE = "${{ runner.temp }}/native-empty-css-runtime.json"
        VIZE_NATIVE_SCOPED_SSR_CAPTURE = "${{ runner.temp }}/native-scoped-ssr-capture.json"
        VIZE_NATIVE_SCOPED_SSR_RUNTIME_CAPTURE = "${{ runner.temp }}/native-scoped-ssr-runtime.json"
        VIZE_NATIVE_SCOPED_SSR_REQUIRE_NATIVE = "1"
        VIZE_SCOPE_BODY_CAPTURE = "${{ runner.temp }}/scope-body-source.json"
        VIZE_SCOPE_BODY_RUNTIME_CAPTURE = "${{ runner.temp }}/scope-body-browser.json"
      }
      run = ci.actionScript("capture-scoped-modules-from-the-current-rust-source-and-mount-real-vue.sh")
    }
    new Dynamic {
      name = "Verify original fragment CSS variables with exact production Vue"
      shell = "bash"
      env {
        NODE_ENV = "production"
        VIZE_FRAGMENT_CSS_CAPTURE = "${{ runner.temp }}/fragment-css-modules.json"
        VIZE_FRAGMENT_CSS_RUNTIME_CAPTURE = "${{ runner.temp }}/fragment-css-runtime.json"
        VIZE_NESTED_BRANCH_CAPTURE = "${{ runner.temp }}/nested-branch-modules.json"
        VIZE_NESTED_BRANCH_RUNTIME_CAPTURE = "${{ runner.temp }}/nested-branch-runtime.json"
        VIZE_SCOPE_ATTR_CAPTURE = "${{ runner.temp }}/scope-attr-modules.json"
        VIZE_SCOPE_ATTR_RUNTIME_CAPTURE = "${{ runner.temp }}/scope-attr-runtime.json"
      }
      run = ci.actionScript("verify-original-fragment-css-variables-with-exact-production-vue.sh")
    }
    new Dynamic {
      name = "Upload current-source scoped CSS modules and runtime captures"
      `if` = "always()"
      uses = ci.uploadArtifact
      with {
        name = "native-scoped-css-${{ github.sha }}-${{ github.run_attempt }}"
        path = """
        ${{ runner.temp }}/native-scoped-css-capture.json
        ${{ runner.temp }}/native-scoped-css-runtime.json
        ${{ runner.temp }}/native-class-list-css-capture.json
        ${{ runner.temp }}/native-class-list-css-runtime.json
        ${{ runner.temp }}/native-empty-css-capture.json
        ${{ runner.temp }}/native-empty-css-runtime.json
        ${{ runner.temp }}/native-scoped-ssr-capture.json
        ${{ runner.temp }}/native-scoped-ssr-runtime.json
        ${{ runner.temp }}/native-scoped-css-source.txt
        ${{ runner.temp }}/scope-body-source.json
        ${{ runner.temp }}/scope-body-browser.json
        ${{ runner.temp }}/fragment-css-modules.json
        ${{ runner.temp }}/fragment-css-runtime.json
        ${{ runner.temp }}/nested-branch-modules.json
        ${{ runner.temp }}/nested-branch-runtime.json
        ${{ runner.temp }}/scope-attr-modules.json
        ${{ runner.temp }}/scope-attr-runtime.json

        """
        `if-no-files-found` = "error"
        `retention-days` = 7
      }
    }
  }
}
