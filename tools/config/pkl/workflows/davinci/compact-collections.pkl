import "../../Actions.pkl" as ci

name = "Compact Collections"

on {
  workflow_dispatch {
    inputs {
      base_sha {
        description = "Exact baseline commit"
        type = "string"
        required = true
      }
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "compact-collections-${{ github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_INCREMENTAL = "0"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}

jobs {
  `compact-collections` {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    steps = new Listing {
      ...ci.stageWorkflowScripts("compact-collections")
      new Dynamic {
        uses = ci.checkout
        with {
          path = "head"
          `fetch-depth` = 0
          ref = "${{ github.event.pull_request.head.sha || github.sha }}"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        name = "Select and record exact comparison commits"
        env {
          REQUESTED_BASE = "${{ github.event.pull_request.base.sha || inputs.base_sha }}"
          REQUESTED_HEAD = "${{ github.event.pull_request.head.sha || github.sha }}"
        }
        run = ci.workflowScript("select-and-record-exact-comparison-commits.sh")
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "stable"
          components = "clippy"
          targets = "wasm32-unknown-unknown"
        }
      }
      ci.wild()
      // The cache action's nested local action resolves from the workspace root,
      // and this job checks the repository out under head/.
      new Dynamic {
        name = "Expose the nested target action at the workspace root"
        run = ci.workflowScript("expose-the-nested-target-action-at-the-workspace-root.sh")
      }
      new Dynamic {
        uses = "./head/.github/actions/setup-rust-sticky-cache"
        with {
          key = "compact-collections"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
          `target-path` = "head/target"
        }
      }
      new Dynamic {
        name = "Focused production regressions and lint"
        `working-directory` = "head"
        run = ci.workflowScript("focused-production-regressions-and-lint.sh")
      }
      new Dynamic {
        name = "Install identical measurement harness on baseline"
        run = ci.workflowScript("install-identical-measurement-harness-on-baseline.sh")
      }
      new Dynamic {
        name = "Build exact production base and head"
        run = ci.workflowScript("build-exact-production-base-and-head.sh")
      }
      new Dynamic {
        name = "Alternate measurements and check graph parity"
        run = ci.workflowScript("alternate-measurements-and-check-graph-parity.sh")
      }
      new Dynamic {
        name = "Upload raw samples"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "compact-collections-measurements"
          path = "measurements/"
          `if-no-files-found` = "warn"
          `retention-days` = 14
        }
      }
    }
  }
}
