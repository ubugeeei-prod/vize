import "../../Actions.pkl" as ci

local function graphExample(name: String): String =
  "cargo run --locked --manifest-path crates/vize_incremental/providers/graph/Cargo.toml --profile ci-opt --example \(name)"

name = "Davinci IR graph queries"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/davinci-ir-graph.yml"
      "davinci/vize_l1/**"
      "davinci/vize_l1_to_l2/**"
      "davinci/vize_l2/**"
      "davinci/vize_l2_to_l3/**"
      "davinci/vize_l3/**"
      "crates/vize_incremental/**"
      "crates/vize_maestro/src/document/store.rs"
      "crates/vize_maestro/src/source_project/query.rs"
      "crates/vize_maestro/src/source_project/scoped_component.rs"
      "crates/vize_maestro/src/source_project/snapshot.rs"
      "tests/formal/ir-graph/**"
      "tests/formal/position-index/**"
      ".github/scripts/workflows/davinci-ir-graph/**"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "ir-graph-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  graph {
    name = "Directed queries, resident edits and pass composition"
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("davinci-ir-graph")
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Qualify the real lowerer and exact resident snapshots"
        run = ci.workflowScript("qualify-the-real-lowerer-and-exact-resident-snapshots.sh")
      }
      ci.command("Measure authored graph source lookups independently", graphExample("source_sites"))
      ci.command("Measure retained recovery source lookups independently", graphExample("recovery_sites"))
    }
  }
  models {
    name = "Reachability theory and snapshot publication"
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    steps = new Listing {
      ...ci.stageWorkflowScripts("davinci-ir-graph")
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        name = "Install pinned standalone model checkers"
        `working-directory` = "${{ runner.temp }}"
        run = ci.workflowScript("install-pinned-standalone-model-checkers.sh")
      }
      new Dynamic {
        name = "Check resident template decisions across source edits"
        `working-directory` = "tests/formal/ir-graph"
        run = ci.workflowScript("check-resident-template-decisions-across-source-edits.sh")
      }
      new Dynamic {
        name = "Check the unbounded theorem and bounded models"
        `working-directory` = "tests/formal/ir-graph"
        run = ci.workflowScript("check-the-unbounded-theorem-and-bounded-models.sh")
      }
      new Dynamic {
        name = "Prove cursor windows against individual point containment"
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          command = "kani"
          args = "crates/vize_incremental/providers/graph/src/recovery/positions/kani.rs --output-format=terse"
        }
      }
    }
  }
}
