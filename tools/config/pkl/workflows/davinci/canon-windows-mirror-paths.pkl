import "../../Actions.pkl" as ci

name = "Windows project mirror and lint program paths"
// Windows-only filesystem facts that macOS/Linux lanes cannot observe:
// dangling directory junctions in the cached `vize check` project mirror
// (#13088) and `\\?\` verbatim spellings of type-aware lint program roots
// (#13077). Linux runs the same tests as the portable control.
on {
  pull_request {
    paths = new Listing {
      "crates/vize_canon/src/batch/materialize_fs.rs"
      "crates/vize_canon/src/batch/materialize_fs/**"
      "crates/vize_canon/src/batch/runtime_deps.rs"
      "crates/vize_patina/src/linter/corsa_session/paths.rs"
      "crates/vize_patina/src/linter/corsa_session/paths/**"
      "crates/vize/tests/check_removed_node_modules_package_cli.rs"
      "crates/vize/tests/lint_solution_tsconfig_cli.rs"
      ".github/workflows/canon-windows-mirror-paths.yml"
      ".github/scripts/workflows/canon-windows-mirror-paths/**"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }

concurrency {
  group = "canon-windows-mirror-paths-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_INCREMENTAL = "0"
  CARGO_TERM_COLOR = "never"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
  VIZE_TEST_REQUIRE_TSGO = "1"
}

jobs {
  `mirror-paths` {
    name = "Mirror links and lint program roots (${{ matrix.os }})"
    `runs-on` = "${{ matrix.runner }}"
    `timeout-minutes` = 60
    strategy {
      `fail-fast` = false
      matrix {
        include = new Listing {
          new Dynamic {
            os = "Windows"
            runner = ci.windows
          }
          new Dynamic {
            os = "Linux"
            runner = ci.linux
          }
        }
      }
    }
    defaults {
      run { shell = "bash" }
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("canon-windows-mirror-paths")
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      ci.workspaceVp()
      ci.command("Install frozen source dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.rust("1.100.0")
      new Dynamic {
        uses = ci.setupWild
        `if` = "runner.os == 'Linux'"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "canon-windows-mirror-paths"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Select the exact locked platform native provider"
        env { EXPECTED_SOURCE = "${{ github.event.pull_request.head.sha || github.sha }}" }
        run = #". "${{ env.VIZE_CI_FILES }}/select-the-exact-locked-platform-native-provider.sh""#
      }
      new Dynamic {
        name = "Detach dangling mirror links from facts about the link itself"
        run = """
        cargo test --locked --profile ci -p vize_canon --lib batch::materialize_fs:: -- --nocapture

        """
      }
      new Dynamic {
        name = "Spell lint program roots without verbatim prefixes"
        run = """
        cargo test --locked --profile ci -p vize_patina --lib linter::corsa_session::paths -- --nocapture

        """
      }
      new Dynamic {
        name = "Check after a package is removed and lint include-only declarations"
        run = #". "${{ env.VIZE_CI_FILES }}/check-after-a-package-is-removed-and-lint-include-only-declarations.sh""#
      }
    }
  }
}
