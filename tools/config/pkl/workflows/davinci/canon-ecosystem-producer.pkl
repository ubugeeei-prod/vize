import "../../Actions.pkl" as ci

name = "Canon ecosystem producer qualification"

// #6830: off the PR tier; main runs it nightly.
on {
  schedule = new Listing {
    new Dynamic { cron = "19 4 * * *" }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "canon-ecosystem-producer-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = "true"
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
}

jobs {
  qualification {
    name = "Qualify diagnostics and generated sources"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      ci.use("./.github/actions/cache-vp-bootstrap")
      new Dynamic {
        uses = ci.setupVp121
        with {
          `node-version-file` = "package.json"
          cache = true
          `cache-save` = false
          `run-install` = false
        }
      }
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "ecosystem-producer"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.command("Enable the pinned package manager shim", "corepack enable")
      ci.command("Install the frozen provider closure", "vp install --frozen-lockfile --prefer-offline")
      ci.command("Build the exact source CLI", "cargo build --locked --profile ci -p vize --features legacy")
      new Dynamic {
        name = "Qualify finite positive and negative controls"
        run = "node --test tests/tooling/ecosystem-producer-qualification.test.ts"
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "ecosystem-producer-qualification-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.sha }}"
          path = "target/differential/ecosystem-producer-qualification/receipt.json"
          `if-no-files-found` = "ignore"
          `retention-days` = 14
        }
      }
    }
  }
}
