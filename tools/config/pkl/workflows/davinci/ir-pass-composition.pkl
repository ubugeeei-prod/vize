import "../../Actions.pkl" as ci

name = "IR pass composition"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/ir-pass-composition.yml"
      ".github/scripts/workflows/ir-pass-composition/**"
      "crates/vize_patina/src/rules/facts/max_template_complexity.rs"
      "crates/vize_patina/src/rules/facts/max_template_complexity/**"
      "crates/vize_incremental/src/template.rs"
      "crates/vize_incremental/src/template/**"
      "davinci/vize_l0/src/pass.rs"
      "davinci/vize_l0/src/pass/**"
      "tests/formal/template-lint/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "ir-pass-composition-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `lint-ranking` {
    name = "Prove stable complexity label selection for unbounded inputs"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ...ci.stageWorkflowScripts("ir-pass-composition")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        name = "Check the prefix theorem with Lean"
        `working-directory` = "${{ runner.temp }}"
        run = ci.workflowScript("check-the-prefix-theorem-with-lean.sh")
      }
      new Dynamic {
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          command = "kani"
          args = "crates/vize_patina/src/rules/facts/max_template_complexity/original/kani.rs --output-format=terse"
        }
      }
      new Dynamic {
        name = "Check the editor's Rust projection on arbitrary UTF-8 ranges"
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          command = "kani"
          args = "crates/vize_incremental/src/template/kani.rs --output-format=terse"
        }
      }
    }
  }
  partition {
    name = "Prove the Rust group cursor partitions every bounded plan"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          command = "kani"
          args = "davinci/vize_l0/src/pass/fusion/grouped/kani.rs --output-format=terse"
        }
      }
    }
  }
}
