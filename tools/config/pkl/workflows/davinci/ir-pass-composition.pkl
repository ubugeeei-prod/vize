import "../../Actions.pkl" as ci

name = "IR pass composition"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/ir-pass-composition.yml"
      "tools/benchmarks/crates/davinci_harness/src/paired.rs"
      "davinci/vize_l0/Cargo.toml"
      "davinci/vize_l0/src/pass.rs"
      "davinci/vize_l0/src/pass/**"
      "davinci/vize_l0/tests/grouped_passes.rs"
      "davinci/vize_l1_to_l2/Cargo.toml"
      "davinci/vize_l1_to_l2/src/pass.rs"
      "davinci/vize_l1_to_l2/src/pass/**"
      "davinci/vize_l1_to_l2/tests/observed_template_passes.rs"
      "davinci/vize_l2/src/analysis.rs"
      "davinci/vize_l2/src/analysis/static_facts.rs"
      "davinci/vize_l2/src/analysis/static_facts/**"
      "davinci/vize_l2/src/analysis/template_complexity.rs"
      "davinci/vize_l2/src/analysis/template_complexity/**"
      "davinci/vize_l3/Cargo.toml"
      "davinci/vize_l3/src/optimize.rs"
      "davinci/vize_l3/tests/placement/extraction.rs"
      ".github/scripts/workflows/ir-pass-composition/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "ir-pass-composition-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  composition {
    name = "Source-order groups, optimizer equivalence and paired timings"
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {
      RUSTUP_TOOLCHAIN = "1.100.0"
      RUST_MIN_STACK = "16777216"
      CARGO_INCREMENTAL = "0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("ir-pass-composition")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Run the original catalogue, traces and allocation measurements"
        run = #". "${{ env.VIZE_CI_FILES }}/run-the-original-catalogue-traces-and-allocation-measurements.sh""#
      }
      new Dynamic {
        name = "Check original Vue templates against both passes and the independent CFG"
        run = #". "${{ env.VIZE_CI_FILES }}/check-original-vue-templates-against-both-passes-and-the-independent-cfg.sh""#
      }
    }
  }
  partition {
    name = "Prove the Rust group cursor partitions every bounded plan"
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          command = "kani"
          args = "davinci/vize_l0/src/pass/fusion/grouped/kani.rs --output-format=terse"
        }
      }
    }
  }
  stock {
    name = "Stock compiler and Node addon (${{ matrix.mode }})"
    strategy {
      `fail-fast` = false
      matrix {
        mode = List("default", "portable")
      }
    }
    `runs-on` = ci.linux
    `timeout-minutes` = 45
    env {
      RUSTUP_TOOLCHAIN = "1.100.0"
      RUST_MIN_STACK = "16777216"
      CARGO_INCREMENTAL = "0"
      MODE = "${{ matrix.mode }}"
      TARGET_SHA = "${{ github.event.pull_request.base.sha }}"
      HEAD_SHA = "${{ github.event.pull_request.head.sha }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("ir-pass-composition")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      ci.rust("1.100.0")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = ci.setupNode
        with { `node-version` = 24 }
      }
      new Dynamic {
        name = "Compare the shipping entry points against the common base"
        env { GH_TOKEN = "${{ github.token }}" }
        run = #". "${{ env.VIZE_CI_FILES }}/compare-the-shipping-entry-points-against-the-common-base.sh""#
      }
    }
  }
}
