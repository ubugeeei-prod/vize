import "../../Actions.pkl" as ci

name = "Level dependencies"
on {
  workflow_call = null
}
permissions { contents = "read" }

jobs {
  `level-dependencies` {
    name = "Level dependency direction"
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `fetch-depth` = 2 }
      }
      // This gate needs only Node built-ins. Avoid bootstrapping Vite+/pnpm
      // before its dependency checks within the existing five-minute deadline.
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.rust("stable")
      new Dynamic {
        name = "Fetch dependency policy comparison base"
        env {
          BASE_SHA = "${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }}"
        }
        run = """
        dependency_base="$BASE_SHA"
        if [[ -z "$dependency_base" ]]; then
          dependency_base="$(git rev-parse HEAD^)"
        fi
        if [[ ! "$dependency_base" =~ ^[0-9a-f]{40}$ || "$dependency_base" =~ ^0+$ ]]; then
          echo 'Missing dependency policy comparison base' >&2
          exit 1
        fi
        git fetch --no-tags --depth=1 origin "$dependency_base"
        echo "DEPENDENCY_BASE=$dependency_base" >> "$GITHUB_ENV"

        """
      }
      new Dynamic {
        name = "Test dependency policy mutations"
        run = "node --test tests/tooling/davinci-level-dependencies.test.mjs tests/tooling/davinci-directory-dependencies.test.ts"
      }
      new Dynamic {
        name = "Report and ratchet normal level dependencies"
        run = #"node tools/support/compat/davinci/level-dependencies.ts --base "$DEPENDENCY_BASE""#
      }
    }
  }
}
