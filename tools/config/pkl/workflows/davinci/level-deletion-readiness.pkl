import "../../../../ci/lib/Actions.pkl" as ci

name = "Level deletion readiness"

on {
  workflow_dispatch {
    inputs {
      evidence_run_id {
        description = "Successful exact-SHA Real Project Matrix run with davinci-deletion-evidence"
        required = false
        type = "string"
      }
    }
  }
}

permissions {
  contents = "read"
  actions = "read"
}

jobs {
  `deletion-readiness` {
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/level-deletion-readiness"
    }
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        uses = ci.setupVp
        with {
          `node-version-file` = "package.json"
          `run-install` = false
        }
      }
      new Dynamic {
        name = "Download exact-SHA differential evidence"
        `if` = "${{ inputs.evidence_run_id != '' }}"
        env {
          GH_TOKEN = "${{ github.token }}"
          GH_REPO = "${{ github.repository }}"
          EVIDENCE_RUN_ID = "${{ inputs.evidence_run_id }}"
        }
        run = ci.workflowScript("download-exact-sha-differential-evidence.sh")
      }
      new Dynamic {
        name = "Check deletion readiness"
        env { GH_TOKEN = "${{ github.token }}" }
        run = #"vp node tests/differential/check-deletion-readiness.mjs "$RUNNER_TEMP/davinci-deletion-evidence""#
      }
    }
  }
}
