import "../../Actions.pkl" as ci

name = "Cross-file SFC effect graphs"
`run-name` = "Cross-file SFC effects @ ${{ github.event.pull_request.head.sha || github.sha }}"

on {
  workflow_dispatch = null
  pull_request {
    types = List("opened", "synchronize", "reopened")
    paths = new Listing {
      ".github/workflows/cross-file-sfc-effects.yml"
      ".github/scripts/workflows/cross-file-sfc-effects/**"
      "crates/vize/src/commands/lint/cross_file.rs"
      "crates/vize/src/commands/lint/cross_file/**"
      "davinci/vize_l0/src/source_frame.rs"
      "davinci/vize_l1/src/embed.rs"
      "davinci/vize_l1/src/embed/authored_program.rs"
      "davinci/vize_l2/Cargo.toml"
      "davinci/vize_l2/src/query.rs"
      "davinci/vize_l2/src/query/script*"
      "davinci/vize_l2/src/query/script/**"
      "crates/vize_croquis/Cargo.toml"
      "crates/vize_croquis/src/effect_graph*"
      "crates/vize_croquis/src/effect_graph/**"
      "crates/vize_croquis/src/sfc/types.rs"
      "crates/vize_atelier_sfc/Cargo.toml"
      "crates/vize_atelier_sfc/src/compile_script.rs"
      "crates/vize_atelier_sfc/src/compile_script/binding_products*"
      "crates/vize_atelier_sfc/src/compile_script/binding_products/**"
      "crates/vize_atelier_sfc/src/compile_script/runtime_bindings.rs"
      "tests/tooling/support/cross-file-sfc-effects.ts"
      "tests/tooling/support/cross-file-sfc-effects/**"
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "cross-file-sfc-effects-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_INCREMENTAL = "0"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  EXPECTED_SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
}

jobs {
  `actual-cli-packets` {
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    steps = new Listing {
      ...ci.stageWorkflowScripts("cross-file-sfc-effects")
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      ci.workspaceVp()
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "cross-file-sfc-effects"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.command("Install frozen workspace tools", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Build and receipt the actual source CLI"
        run = ci.workflowScript("build-and-receipt-the-actual-source-cli.sh")
      }
      new Dynamic {
        name = "Verify descriptor and complete report regressions"
        run = ci.workflowScript("verify-descriptor-and-complete-report-regressions.sh")
      }
      new Dynamic {
        name = "Compare complete public and source CLI packets with the actual WASM reference"
        run = "node tests/tooling/support/cross-file-sfc-effects.ts"
      }
      new Dynamic {
        name = "Preserve complete packets, provider identities and phase profiles"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "cross-file-sfc-effects-${{ github.run_id }}-${{ github.run_attempt }}"
          path = """
          target/ci/vize.differential-build.json
          target/vize-tests/cross-file-sfc-effects

          """
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }

  `script-declaration-products` {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {

      CARGO_BUILD_JOBS = "24"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("cross-file-sfc-effects")
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Compare compiler bindings and complete project effect graphs"
        run = ci.workflowScript("compare-compiler-bindings-and-complete-project-effect-graphs.sh")
      }
    }
  }
}
