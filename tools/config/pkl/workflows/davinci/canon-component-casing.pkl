import "../../Actions.pkl" as ci

name = "Canon component casing accuracy"
on {
  pull_request {
    paths = new Listing {
      "crates/vize_canon/src/virtual_ts/scope/component_props.rs"
      "tools/benchmarks/scripts/canon-component-casing*.ts"
      "tests/tooling/canon-component-casing-source-sdk.test.ts"
      ".github/workflows/canon-component-casing.yml"
      ".github/scripts/workflows/canon-component-casing/**"
      ".github/scripts/workflows/shared/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "canon-component-casing-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  accuracy {
    `runs-on` = ci.linux
    `timeout-minutes` = 35
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/canon-component-casing"
      PR_HEAD_SHA = "${{ github.event.pull_request.head.sha }}"
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      GOMAXPROCS = "2"
      RAYON_NUM_THREADS = "2"
      NODE_DISABLE_COMPILE_CACHE = "1"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with {
          `fetch-depth` = 2
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.14.0"
          `package-manager-cache` = false
        }
      }
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        name = "Build one exact normal source CLI and preserve Cargo identity"
        run = #". "${{ env.VIZE_CI_FILES }}/build-one-exact-normal-source-cli-and-preserve-cargo-identity.sh""#
      }
      new Dynamic {
        name = "Install one pinned independent public framework provider"
        run = #". "${{ env.VIZE_CI_FILES }}/install-one-pinned-independent-public-framework-provider.sh""#
      }
      new Dynamic {
        name = "Check the pinned complete batch-diagnostic fixture with the same native compiler"
        run = #". "${{ env.VIZE_CI_FILES }}/check-the-pinned-complete-batch-diagnostic-fixture-with-the-same-native.sh""#
      }
      new Dynamic {
        name = "Preserve published false negatives and prove source invalid poison repair"
        run = #". "${{ env.VIZE_CI_FILES }}/preserve-published-false-negatives-and-prove-source-invalid-poison-repai.sh""#
      }
      new Dynamic {
        name = "Package raw provider input configurations whole packets and compiler receipts"
        `if` = "always()"
        run = #". "${{ env.VIZE_CI_FILES }}/package-raw-provider-input-configurations-whole-packets-and-compiler-rec.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "component-casing-summary-${{ github.sha }}"
          path = """
          ${{ runner.temp }}/component-casing/source-build.json
          ${{ runner.temp }}/component-casing/pinned-batch.json
          ${{ runner.temp }}/component-casing/proof/summary.json
          ${{ runner.temp }}/component-casing/proof/failures.json

          """
          `retention-days` = 14
        }
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "component-casing-raw-${{ github.sha }}"
          path = "${{ runner.temp }}/component-casing-raw.tgz"
          `retention-days` = 14
        }
      }
    }
  }
}
