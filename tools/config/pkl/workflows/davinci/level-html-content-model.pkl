import "../../Actions.pkl" as ci

name = "Level HTML content model"

// Browser oracles: generated output and checker verdicts must agree with
// Chromium.
// - chromium-oracle (P4-11a): the checker's committed parser-family verdicts
//   (crates/vize_patina/tests/html_content_model/checker-verdicts.tsv, kept
//   current by `cargo test -p vize_patina --test integration html_content_model_differential::`
//   in the Check workflow) must agree exactly with Chromium's HTML parser.
//   Charter #36: the checker's walk and verdict rule are sound for every context
//   a truncated chain describes. Creusot proves the shipped kernel for chains of
//   every length in the Davinci Creusot workflow
//   (crates/vize_patina/src/html_content_model/creusot.rs).
// - special-text: L1 document packets against Chromium, native and legacy Rust.
// - first-newline: leading newlines in pre/textarea at runtime.
// - scoped-cascade: scoped CSS nesting specificity, cascade and pixels.
// Pushes to main and davinci run the parser oracle; pull requests run the
// oracles whose inputs changed; a dispatch runs all four.
on {
  push {
    branches = List("main", "davinci")
    paths = new Listing {
      "crates/vize_patina/src/html_content_model/**"
      "crates/vize_patina/tests/html_content_model/**"
      "tools/support/compat/davinci/html-content-model-oracle.ts"
      ".github/workflows/level-html-content-model.yml"
      ".github/scripts/workflows/level-html-content-model/**"
      "tools/config/pkl/parts/level-html-content-model/**"
    }
  }
  pull_request {
    paths = new Listing {
      ".github/actions/install-playwright-browsers/**"
      ".github/scripts/workflows/level-html-content-model/**"
      ".github/workflows/level-html-content-model.yml"
      "Cargo.lock"
      "Cargo.toml"
      "crates/vize_armature/**"
      "crates/vize_armature/src/parser/**"
      "crates/vize_armature/tests/_fixtures/first_newline_parser_*"
      "crates/vize_armature/tests/_fixtures/tokenizer_parser_*.bin"
      "crates/vize_atelier_sfc/src/vite_plugin/css_scope.rs"
      "crates/vize_atelier_sfc/src/vite_plugin/css_scope/**"
      "crates/vize_atelier_sfc/tests/fixtures/scoped_nesting_specificity.json"
      "crates/vize_atelier_sfc/tests/scoped_nesting_specificity.rs"
      "crates/vize_atelier_vapor/src/lower/element/template.rs"
      "crates/vize_atelier_vapor/src/lower/element/template/**"
      "crates/vize_relief/**"
      "davinci/vize_l0/**"
      "davinci/vize_l1/**"
      "davinci/vize_l1_to_l2/src/lower/**"
      "davinci/vize_l1_to_l2/tests/pre_textarea_first_newline.rs"
      "davinci/vize_l1_to_l2/tests/text_pass.rs"
      "davinci/vize_l1_to_l2/tests/text_singleton.rs"
      "package.json"
      "pnpm-lock.yaml"
      "tests/_fixtures/differential/compiler/first-newline-runtime.manifest.json"
      "tests/_fixtures/differential/compiler/manifest.json"
      "tests/_fixtures/differential/compiler/pre-textarea-first-newline/**"
      "tests/_fixtures/differential/compiler/scoped-list-nesting-10606/**"
      "tests/package.json"
      "tests/tooling/davinci-document-body-elements.test.ts"
      "tests/tooling/davinci-document-disclosure-elements.test.ts"
      "tests/tooling/davinci-document-embedded-fallback.test.ts"
      "tests/tooling/davinci-document-foreign-content.test.ts"
      "tests/tooling/davinci-document-phrasing.test.ts"
      "tests/tooling/davinci-document-select.test.ts"
      "tests/tooling/davinci-document-special-text.test.ts"
      "tests/tooling/pre-textarea-first-newline.test.mjs"
      "tests/tooling/scoped-nesting-specificity.test.mjs"
      "tests/tooling/support/first-newline-vapor-oracle.mjs"
      "tools/config/pkl/parts/level-html-content-model/**"
    }
  }
  workflow_dispatch = null
}
concurrency {
  group = "level-html-content-model-${{ github.workflow }}-${{ github.event.pull_request.number || github.sha }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  HEAD_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
}

jobs {
  changes {
    `if` = "github.event_name == 'pull_request'"
    `runs-on` = "ubuntu-24.04"
    `timeout-minutes` = 5
    permissions {
      contents = "read"
      `pull-requests` = "read"
    }
    outputs {
      `special-text` = "${{ steps.filter.outputs.special-text }}"
      `first-newline` = "${{ steps.filter.outputs.first-newline }}"
      `scoped-cascade` = "${{ steps.filter.outputs.scoped-cascade }}"
    }
    steps = new Listing {
      new Dynamic {
        name = "Select the oracles whose inputs changed"
        id = "filter"
        uses = "dorny/paths-filter@7b450fff21473bca461d4b92ce414b9d0420d706"  // v4.0.2
        with {
          filters = """
          special-text:
            - '.github/actions/install-playwright-browsers/**'
            - 'Cargo.lock'
            - 'Cargo.toml'
            - 'davinci/vize_l0/**'
            - 'davinci/vize_l1/**'
            - 'crates/vize_armature/**'
            - 'crates/vize_relief/**'
            - 'package.json'
            - 'pnpm-lock.yaml'
            - 'tests/package.json'
            - 'tests/tooling/davinci-document-body-elements.test.ts'
            - 'tests/tooling/davinci-document-disclosure-elements.test.ts'
            - 'tests/tooling/davinci-document-embedded-fallback.test.ts'
            - 'tests/tooling/davinci-document-foreign-content.test.ts'
            - 'tests/tooling/davinci-document-phrasing.test.ts'
            - 'tests/tooling/davinci-document-select.test.ts'
            - 'tests/tooling/davinci-document-special-text.test.ts'
            - '.github/workflows/level-html-content-model.yml'
            - '.github/scripts/workflows/level-html-content-model/**'
            - 'tools/config/pkl/parts/level-html-content-model/**'
          first-newline:
            - 'crates/vize_armature/src/parser/**'
            - 'crates/vize_armature/tests/_fixtures/first_newline_parser_*'
            - 'crates/vize_armature/tests/_fixtures/tokenizer_parser_*.bin'
            - 'crates/vize_atelier_vapor/src/lower/element/template.rs'
            - 'crates/vize_atelier_vapor/src/lower/element/template/**'
            - 'davinci/vize_l1_to_l2/src/lower/**'
            - 'davinci/vize_l1_to_l2/tests/pre_textarea_first_newline.rs'
            - 'davinci/vize_l1_to_l2/tests/text_pass.rs'
            - 'davinci/vize_l1_to_l2/tests/text_singleton.rs'
            - 'tests/tooling/pre-textarea-first-newline.test.mjs'
            - 'tests/tooling/support/first-newline-vapor-oracle.mjs'
            - 'tests/_fixtures/differential/compiler/pre-textarea-first-newline/**'
            - 'tests/_fixtures/differential/compiler/first-newline-runtime.manifest.json'
            - 'tests/_fixtures/differential/compiler/manifest.json'
            - '.github/workflows/level-html-content-model.yml'
            - '.github/scripts/workflows/level-html-content-model/**'
            - 'tools/config/pkl/parts/level-html-content-model/**'
          scoped-cascade:
            - 'crates/vize_atelier_sfc/src/vite_plugin/css_scope.rs'
            - 'crates/vize_atelier_sfc/src/vite_plugin/css_scope/**'
            - 'crates/vize_atelier_sfc/tests/scoped_nesting_specificity.rs'
            - 'crates/vize_atelier_sfc/tests/fixtures/scoped_nesting_specificity.json'
            - 'tests/tooling/scoped-nesting-specificity.test.mjs'
            - 'tests/_fixtures/differential/compiler/scoped-list-nesting-10606/**'
            - '.github/workflows/level-html-content-model.yml'
            - '.github/scripts/workflows/level-html-content-model/**'
            - 'tools/config/pkl/parts/level-html-content-model/**'
          """
        }
      }
    }
  }
  `chromium-oracle` {
    name = "HTML content-model parser oracle (Chromium)"
    `if` = "github.event_name != 'pull_request'"
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupVp
        with {
          `node-version-file` = "package.json"
          `run-install` = false
        }
      }
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.use("./.github/actions/setup-ubuntu-archive")
      new Dynamic {
        name = "Install Chromium"
        `working-directory` = "tests"
        run = "vize-ci-apt-retry vp exec playwright install --with-deps chromium"
      }
      new Dynamic {
        name = "Compare checker verdicts with Chromium's parser"
        run = "node tools/support/compat/davinci/html-content-model-oracle.ts --engine chromium"
      }
    }
  }

  `special-text` = import("../../parts/level-html-content-model/special-text.pkl")
  `first-newline` = import("../../parts/level-html-content-model/first-newline.pkl")
  `scoped-cascade` = import("../../parts/level-html-content-model/scoped-cascade.pkl")
}
