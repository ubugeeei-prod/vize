import "../../../../ci/lib/Actions.pkl" as ci

name = "Davinci reference backends"

// The independent L3 reference (`davinci_test_support::l3_reference`) against
// its committed pages, then both mounted backends against the same pages. The
// reference laws are Kani harnesses in `davinci-kani.yml`.
//
on {
  schedule = new Listing {
    new Dynamic { cron = "11 5 * * *" }
  }
  workflow_dispatch = null
}
concurrency {
  group = "davinci-reference-${{ github.workflow }}-${{ github.event.pull_request.number || github.sha }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }

jobs {
  `reference-backends` {
    name = "L3 reference and mounted backends (TS-28)"
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.rust("stable")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "davinci-reference"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        uses = ci.setupVp
        with {
          `node-version-file` = "package.json"
          `run-install` = false
        }
      }
      ci.command("Install mounted runtime dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.command("Run P3-15 reactivity lattice differential", "cargo test -p vize_l3 --test lattice_reference_fixture")
      new Dynamic {
        name = "Run TS-28 reference, P3-15 schedule and C-23 checker differentials"
        run = "cargo test -p vize_l2_to_l3 --test l3_reference_fixture"
      }
      ci.command("Run TS-28 compiled backend trace", "cargo test -p vize_atelier_vapor --test davinci_l3_compiled_trace")
      ci.command("Run TS-30 mounted backend behavior", "cargo test -p vize_atelier_vapor --test davinci_mounted_behavior")
      new Dynamic {
        name = "Run TS-33 upstream Vapor behavioral parity"
        run = "cargo test -p vize_atelier_vapor --test davinci_vapor_upstream_parity --test davinci_keep_alive_parity --test davinci_suspense_parity --test davinci_structural_slots_parity --test davinci_transition_parity"
      }
      ci.use("./.github/actions/setup-ubuntu-archive")
      new Dynamic {
        name = "Install Chromium for the event contract"
        `working-directory` = "tests"
        run = "vize-ci-apt-retry vp exec playwright install --with-deps chromium"
      }
      new Dynamic {
        name = "Run TS-30 event scope and delivery in Chromium"
        run = "cargo test -p vize_atelier_vapor --test davinci_event_handlers -- --ignored --nocapture"
      }
    }
  }
}
