import "../../Actions.pkl" as ci

name = "Type admission scale axes"
on {
  pull_request {
    paths = new Listing {
      "tools/benchmarks/scripts/type-admission-scale*.ts"
      "tests/tooling/type-admission-scale.test.ts"
      ".github/workflows/type-admission-scale.yml"
      ".github/scripts/workflows/type-admission-scale/**"
    }
  }
  workflow_dispatch {
    inputs {
      axis {
        type = "choice"
        options = List("smoke", "files", "graph", "file-size", "types", "mixed")
        ["default"] = "smoke"
      }
      sfcs {
        description = "File-axis SFC count (2500, 10000, or 50000)"
        type = "choice"
        options = List("2500", "10000", "50000")
        ["default"] = "2500"
      }
      tool {
        type = "choice"
        options = List("all", "cli", "mapper", "vue-tsc")
        ["default"] = "all"
      }
      `vize-version` {
        description = "Exact published Vize/native version for this baseline"
        type = "string"
        ["default"] = "0.598.0"
      }
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "type-admission-scale-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  `original-public-projects` {
    `runs-on` = ci.linux
    `timeout-minutes` = 35
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/type-admission-scale"
      SCALE_AXIS = "${{ inputs.axis || 'smoke' }}"
      SCALE_SFCS = "${{ inputs.sfcs || '2500' }}"
      SCALE_TOOL = "${{ inputs.tool || 'all' }}"
      VIZE_VERSION = "${{ inputs.vize-version || '0.598.0' }}"
      GOMAXPROCS = "8"
      RAYON_NUM_THREADS = "8"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "26.6.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Install the exact public baseline providers"
        shell = "bash"
        run = ci.workflowScript("install-the-exact-public-baseline-providers.sh")
      }
      ci.command("Require the original corpus and diagnostic custody laws", "node --test tests/tooling/type-admission-scale.test.ts")
      new Dynamic {
        name = "Run each original axis and retain every raw diagnostic packet"
        shell = "bash"
        run = ci.workflowScript("run-each-original-axis-and-retain-every-raw-diagnostic-packet.sh")
      }
      new Dynamic {
        name = "Package evidence without following workspace dependency symlinks"
        `if` = "${{ always() }}"
        shell = "bash"
        run = ci.workflowScript("package-evidence-without-following-workspace-dependency-symlinks.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ always() }}"
        with {
          name = "type-admission-scale-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/admission-scale-evidence.tgz"
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }
}
