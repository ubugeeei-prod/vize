import "../../../../ci/lib/Actions.pkl" as ci

name = "Benchmark - VS Code startup"
`run-name` = "VS Code startup ${{ inputs.head }} vs ${{ inputs.base }}"
// Two extension builds open one SFC in a generated workspace, alternating per
// round: time to the started client and to the first Vize diagnostic on Linux,
// native Windows, and WSL2 (ext4 and the Windows mount). Every run uses a fresh
// profile whose release-server cache already holds the published server.
on {
  workflow_dispatch {
    inputs {
      base {
        description = #"Full 40-hex commit measured first (the "before")"#
        type = "string"
        required = true
      }
      head {
        description = "Full 40-hex commit compared against it"
        type = "string"
        required = true
      }
      server_version {
        description = "Published vize release both builds use as their cached server"
        type = "string"
        ["default"] = "0.717.0"
      }
      rounds {
        description = "Alternating recorded runs per build and layout"
        type = "string"
        ["default"] = "10"
      }
      layouts {
        description = "Space-separated workspace layouts (root keeps a root tsconfig; nested has only package configs)"
        type = "string"
        ["default"] = "root nested"
      }
      sfcs {
        description = "Generated SFCs"
        type = "string"
        ["default"] = "2000"
      }
      noise {
        description = "Generated ordinary files outside node_modules"
        type = "string"
        ["default"] = "30000"
      }
      windows {
        description = "Also measure native Windows"
        type = "boolean"
        ["default"] = true
      }
      wsl2 {
        description = "Also measure WSL2 (ext4 and the Windows mount)"
        type = "boolean"
        ["default"] = true
      }
    }
  }
  // Registers the dispatch-only workflow from its PR; only the smoke runs there.
  pull_request {
    paths = new Listing {
      ".github/workflows/vscode-startup-bench.yml"
      ".github/scripts/workflows/vscode-startup-bench/**"
      "editors/vscode/test/run-startup-latency.ts"
      "editors/vscode/test/suite/startup-latency.cjs"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "vscode-startup-bench-${{ github.event.pull_request.number || inputs.head }}-${{ inputs.base }}"
  `cancel-in-progress` = true
}
env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  VSCODE_VERSION = "1.107.1"
}
jobs {
  smoke {
    `if` = "github.event_name == 'pull_request'"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/vscode-startup-bench"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Generate both layouts"
        run = ci.workflowScript("generate-both-layouts.sh")
      }
    }
  }

  build {
    `if` = "github.event_name == 'workflow_dispatch'"
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    env {

      BASE = "${{ inputs.base }}"
      HEAD = "${{ inputs.head }}"
      SERVER_VERSION = "${{ inputs.server_version }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("vscode-startup-bench")
      new Dynamic {
        name = "Validate inputs"
        run = ci.workflowScript("validate-inputs.sh")
      }
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version-file` = "package.json"
          `run-install` = false
          cache = true
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      ci.command("Install locked dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.command("Install the extension's dependencies", "vp run --workspace-root test:vscode-extension:download")
      new Dynamic {
        name = "Build both extension commits"
        run = ci.workflowScript("build-both-extension-commits.sh")
      }
      new Dynamic {
        name = "Fetch the published servers"
        env { GH_TOKEN = "${{ github.token }}" }
        run = ci.workflowScript("fetch-the-published-servers.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        with {
          name = "ext-builds"
          path = "ext-builds/"
          `retention-days` = 7
        }
      }
    }
  }

  linux {
    needs = "build"
    `runs-on` = ci.linux
    `timeout-minutes` = 60
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/vscode-startup-bench"
      SERVER_VERSION = "${{ inputs.server_version }}"
      ROUNDS = "${{ inputs.rounds }}"
      LAYOUTS = "${{ inputs.layouts }}"
      SFCS = "${{ inputs.sfcs }}"
      NOISE = "${{ inputs.noise }}"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version-file` = "package.json"
          `run-install` = false
          cache = true
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      ci.command("Install locked dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        uses = ci.downloadArtifact
        with {
          name = "ext-builds"
          path = "ext-builds"
        }
      }
      new Dynamic {
        name = "Stage the published server and VS Code"
        run = ci.workflowScript("stage-the-published-server-and-vs-code.sh")
      }
      new Dynamic {
        name = "Measure"
        run = ci.workflowScript("measure.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "startup-linux"
          path = "${{ runner.temp }}/out/"
          `if-no-files-found` = "warn"
        }
      }
    }
  }

  windows {
    `if` = "inputs.windows"
    needs = "build"
    `runs-on` = ci.windows
    `timeout-minutes` = 60
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/vscode-startup-bench"
      SERVER_VERSION = "${{ inputs.server_version }}"
      ROUNDS = "${{ inputs.rounds }}"
      LAYOUTS = "${{ inputs.layouts }}"
      SFCS = "${{ inputs.sfcs }}"
      NOISE = "${{ inputs.noise }}"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version-file` = "package.json"
          `run-install` = false
          cache = true
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      ci.command("Install locked dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        uses = ci.downloadArtifact
        with {
          name = "ext-builds"
          path = "ext-builds"
        }
      }
      new Dynamic {
        name = "Measure"
        shell = "bash"
        run = ci.workflowScript("measure-2.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "startup-windows"
          path = "${{ runner.temp }}/out/"
          `if-no-files-found` = "warn"
        }
      }
    }
  }

  wsl2 {
    `if` = "inputs.wsl2"
    needs = "build"
    // WSL2 needs nested virtualization; Blacksmith Windows runners lack it.
    // Linux VS Code runs inside WSL2, so its extension host and file search see
    // the same filesystems a WSL remote session does.
    `runs-on` = "windows-2025-vs2026"
    `timeout-minutes` = 120
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/vscode-startup-bench"
      SERVER_VERSION = "${{ inputs.server_version }}"
      ROUNDS = "${{ inputs.rounds }}"
      LAYOUTS = "${{ inputs.layouts }}"
      SFCS = "${{ inputs.sfcs }}"
      NOISE = "${{ inputs.noise }}"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = "Vampire/setup-wsl@d1da7f2c0322a5ee4f24975344f67fc0f5baf364"  // v7.0.0
        with {
          distribution = "Ubuntu-24.04"
          `wsl-version` = "2"
          `wsl-shell-user` = "root"
          `additional-packages` = "ca-certificates curl xz-utils xvfb xauth libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libgtk-3-0t64 libgbm1 libasound2t64 libxkbfile1 libsecret-1-0 libxss1"
        }
      }
      new Dynamic {
        uses = ci.downloadArtifact
        with {
          name = "ext-builds"
          path = "ext-builds"
        }
      }
      new Dynamic {
        name = "Resolve the Windows mount"
        shell = "pwsh"
        run = ci.workflowScript("resolve-the-windows-mount.ps1")
      }
      new Dynamic {
        name = "Install Node, the published server and VS Code in WSL2"
        shell = "wsl-bash {0}"
        env {
          WSLENV = "VSCODE_VERSION/u:VIZE_CI_FILES/p"
        }
        run = ci.wslScript("install-node-the-published-server-and-vs-code-in-wsl2.sh")
      }
      new Dynamic {
        name = "Measure ext4 and the Windows mount"
        shell = "wsl-bash {0}"
        env {
          WSLENV = "ROUNDS/u:LAYOUTS/u:SFCS/u:NOISE/u:WSL_MOUNT_ROOT/u:GITHUB_STEP_SUMMARY/u:VIZE_CI_FILES/p"
        }
        run = ci.wslScript("measure-ext4-and-the-windows-mount.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "startup-wsl2"
          path = "${{ runner.temp }}/vize-startup/out/"
          `if-no-files-found` = "warn"
        }
      }
    }
  }
}
