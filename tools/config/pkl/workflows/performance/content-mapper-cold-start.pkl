import "../../Actions.pkl" as ci

name = "Content Mapper Cold Start"

on {
  pull_request {
    paths = new Listing {
      ".github/workflows/content-mapper-cold-start.yml"
      "crates/vize/Cargo.toml"
      "crates/vize/tests/content_mapper_tsgo_cli/memo_expression.rs"
      "tests/tooling/content-mapper-process-receipt.test.ts"
      "tools/support/compat/content-mapper/process-receipt.ts"
      "tools/support/release/type-admission-mapper-host.ts"
    }
  }
  // Still the full qualification of every main commit (no paths), but post-merge:
  // not a required check, so a queue run gated nothing while it competed with
  // every queue entry for runners. cancel-in-progress coalesces merge bursts.
  push {
    branches = List("main")
  }
  workflow_dispatch = null
}
concurrency {
  group = "content-mapper-cold-start-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}

jobs {
  `macos-arm64` {
    `runs-on` = ci.macos
    `timeout-minutes` = 20
    steps = new Listing {
      new Dynamic {
        name = "Checkout source"
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        name = "Setup Rust"
        uses = ci.setupRust
        with { toolchain = "stable" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "content-mapper-cold-start"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Setup Vite Plus"
        uses = ci.setupVp
        with {
          `node-version-file` = "package.json"
          cache = true
          `run-install` = true
        }
      }
      new Dynamic {
        name = "Prepare the exact macOS Content Mapper host"
        run = #"""
        set -euo pipefail
        provider="$RUNNER_TEMP/cold-content-mapper-host"
        proof="$RUNNER_TEMP/cold-content-mapper-host-proof"
        receipts="$RUNNER_TEMP/cold-content-mapper-receipts"
        mkdir -p "$receipts"
        printf '{"source":"%s","runId":"%s","attempt":"%s"}\n' \
          "$GITHUB_SHA" "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" > "$receipts/invocation.json"
        env -u GH_TOKEN -u GITHUB_TOKEN -u NODE_AUTH_TOKEN -u NPM_TOKEN -u NODE_OPTIONS -u NODE_PATH \
          node tools/support/release/type-admission-mapper-host.ts "$provider" "$proof"
        runtime="$provider/node_modules/@typescript/typescript-darwin-arm64/lib/tsc"
        test -x "$runtime"
        {
          printf 'VIZE_TEST_MEMO_CONTENT_MAPPER_TSGO=%s\n' "$runtime"
          printf 'VIZE_TEST_MEMO_PROCESS_RECEIPT_DIR=%s\n' "$receipts"
          printf 'VIZE_TEST_NODE=%s\n' "$(command -v node)"
          printf 'VIZE_TEST_REQUIRE_TSGO=1\n'
        } >> "$GITHUB_ENV"

        """#
      }
      new Dynamic {
        name = "Capture the first post-build mapper process"
        run = "cargo test --locked -p vize --test integration -- content_mapper_tsgo_cli::memo_expression::memo_dependencies_check_members_and_preserve_unused_controls --exact --nocapture --test-threads=1"
      }
      new Dynamic {
        name = "Upload mapper process and provider receipts"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "content-mapper-cold-start-${{ github.sha }}-${{ github.run_attempt }}"
          path = """
          ${{ runner.temp }}/cold-content-mapper-receipts/
          ${{ runner.temp }}/cold-content-mapper-host-proof/

          """
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
