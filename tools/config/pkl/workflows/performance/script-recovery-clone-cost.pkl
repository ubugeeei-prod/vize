import "../../Actions.pkl" as ci

name = "Script recovery clone cost"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/script-recovery-clone-cost.yml"
      ".github/scripts/workflows/script-recovery-clone-cost/**"
      ".github/scripts/workflows/shared/**"
      "crates/vize_croquis/src/script_parser/recovery.rs"
      "crates/vize_croquis/src/script_parser/recovery/**"
      "davinci/vize_l0/examples/source_recovery_clone_benchmark.rs"
      "davinci/vize_l0/tests/source_probes/mod.rs"
      "tools/benchmarks/scripts/compare_recovery_clone.ts"
      "tools/benchmarks/scripts/recovery_clone_contract.ts"
      "tools/benchmarks/scripts/profile-evidence-json.ts"
    }
  }
  workflow_dispatch {
    inputs {
      base_sha {
        description = "Immutable first-parent baseline commit"
        type = "string"
        required = true
      }
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "script-recovery-clone-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  functional {
    `runs-on` = ci.linux
    `timeout-minutes` = 40
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/script-recovery-clone-cost"
      CARGO_BUILD_JOBS = "4"
      CARGO_INCREMENTAL = "0"
      CARGO_TERM_COLOR = "never"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with { `node-version` = "26.6.0" }
      }
      new Dynamic { run = "rustup toolchain install 1.100.0 --profile minimal" }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "script-recovery-clone-functional-v1"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Check full parser packets and source laws without timing qualification"
        run = ci.workflowScript("check-full-parser-packets-and-source-laws-without-timing-qualification.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "script-recovery-clone-functional-${{ github.sha }}"
          path = "functional-evidence/"
          `if-no-files-found` = "error"
        }
      }
    }
  }
  `allocation-law` {
    needs = "functional"
    `runs-on` = ci.linux
    `timeout-minutes` = 40
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/script-recovery-clone-cost"
      DECLARED_BASE_SHA = "${{ github.event.pull_request.base.sha || inputs.base_sha }}"
      EVENT_KIND = "${{ github.event_name }}"
      CARGO_BUILD_JOBS = "4"
      CARGO_INCREMENTAL = "0"
      CARGO_TERM_COLOR = "never"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with { `node-version` = "26.6.0" }
      }
      new Dynamic { run = "rustup toolchain install 1.100.0 --profile minimal" }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "script-recovery-clone-allocation-law-v1"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Preserve the immutable profile-only pair and shared carrier"
        run = ci.workflowScript("preserve-the-immutable-profile-only-pair-and-shared-carrier.sh")
      }
      new Dynamic {
        name = "Build independent instrumented roles and admit the small allocation law"
        run = ci.workflowScript("build-independent-instrumented-roles-and-admit-the-small-allocation-law.sh")
      }
      new Dynamic {
        name = "Enforce allocation and parse-call laws on huge authored sources"
        run = ci.workflowScript("enforce-allocation-and-parse-call-laws-on-huge-authored-sources.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "success()"
        with {
          name = "script-recovery-clone-allocation-summary-${{ github.sha }}"
          path = """
          allocation-evidence/clone-allocation-*-summary.json
          allocation-evidence/identity.json

          """
          `if-no-files-found` = "error"
        }
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "script-recovery-clone-allocation-${{ github.sha }}"
          path = """
          allocation-evidence/*.json
          allocation-evidence/*.jsonl
          allocation-evidence/*.txt
          allocation-evidence/*.sha
          allocation-evidence/*.commit

          """
          `if-no-files-found` = "error"
        }
      }
    }
  }
  compare {
    needs = List("functional", "allocation-law")
    `runs-on` = ci.linux
    `timeout-minutes` = 40
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/script-recovery-clone-cost"
      DECLARED_BASE_SHA = "${{ github.event.pull_request.base.sha || inputs.base_sha }}"
      EVENT_KIND = "${{ github.event_name }}"
      CARGO_INCREMENTAL = "0"
      CARGO_TERM_COLOR = "never"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        name = "Reject invalid clone comparisons before building"
        run = "node tools/benchmarks/scripts/compare_recovery_clone.ts --self-test"
      }
      new Dynamic {
        uses = ci.setupNode
        with { `node-version` = "26.6.0" }
      }
      new Dynamic { run = "rustup toolchain install 1.100.0 --profile minimal" }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "script-recovery-clone-v1"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Preserve exact source identities and the shared benchmark carrier"
        run = ci.workflowScript("preserve-exact-source-identities-and-the-shared-benchmark-carrier.sh")
      }
      new Dynamic {
        name = "Compare complete parser packets and exact source counter controls"
        run = ci.workflowScript("compare-complete-parser-packets-and-exact-source-counter-controls.sh")
      }
      new Dynamic {
        name = "Build independent baseline and candidate targets with equal flags"
        run = ci.workflowScript("build-independent-baseline-and-candidate-targets-with-equal-flags.sh")
      }
      new Dynamic {
        name = "Admit the small carrier before the huge-file matrix"
        run = ci.workflowScript("admit-the-small-carrier-before-the-huge-file-matrix.sh")
      }
      new Dynamic {
        name = "Measure actual-code Unicode and CRLF sources on each size axis"
        run = ci.workflowScript("measure-actual-code-unicode-and-crlf-sources-on-each-size-axis.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "success()"
        with {
          name = "script-recovery-clone-summary-${{ github.sha }}"
          path = """
          evidence/clone-*-summary.json
          evidence/identity.json

          """
          `if-no-files-found` = "error"
        }
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "script-recovery-clone-${{ github.sha }}"
          path = """
          evidence/*.json
          evidence/*.jsonl
          evidence/*.log
          evidence/*.txt
          evidence/*.sha
          evidence/*.sha256
          evidence/*.commit

          """
          `if-no-files-found` = "error"
        }
      }
    }
  }
}
