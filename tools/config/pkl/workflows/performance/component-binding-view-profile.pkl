import "../../Actions.pkl" as ci

name = "Component binding view allocation profile"
on {
  pull_request {
    paths = new Listing {
      "crates/vize_canon/src/virtual_ts/component_reference.rs"
      "crates/vize_canon/src/virtual_ts/generator/unresolved_components.rs"
      "tools/benchmarks/crates/vize/tests/component_binding_profile.rs"
      "tools/benchmarks/scripts/component-binding-view-evidence.ts"
      "tools/benchmarks/scripts/component-binding-view-eligibility.ts"
      "tests/tooling/component-binding-view-eligibility.test.ts"
      ".github/workflows/component-binding-view-profile.yml"
      ".github/scripts/workflows/component-binding-view-profile/**"
      ".github/scripts/workflows/shared/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "component-binding-view-profile-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  compare {
    `runs-on` = ci.linux
    `timeout-minutes` = 45
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/component-binding-view-profile"
      EVENT_BASE_SHA = "${{ github.event.pull_request.base.sha }}"
      PR_HEAD_SHA = "${{ github.event.pull_request.head.sha }}"
      RUSTUP_TOOLCHAIN = "1.100.0"
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RAYON_NUM_THREADS = "8"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with {
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        name = "Authenticate actual merge parents and untouched normal products"
        run = #". "${{ env.VIZE_CI_FILES }}/authenticate-actual-merge-parents-and-untouched-normal-products.sh""#
      }
      new Dynamic {
        name = "Add identical explicit profiling-only source observers"
        run = #". "${{ env.VIZE_CI_FILES }}/add-identical-explicit-profiling-only-source-observers.sh""#
      }
      new Dynamic {
        name = "Compare full packets and fresh normal mapper processes"
        run = #". "${{ env.VIZE_CI_FILES }}/compare-full-packets-and-fresh-normal-mapper-processes.sh""#
      }
      new Dynamic {
        name = "Require immutable complete constructor packets"
        run = #". "${{ env.VIZE_CI_FILES }}/require-immutable-complete-constructor-packets.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "component-binding-view-${{ github.sha }}"
          path = "${{ runner.temp }}/component-binding-evidence"
          `retention-days` = 14
        }
      }
    }
  }
}
