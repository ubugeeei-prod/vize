import "../../../../ci/lib/Actions.pkl" as ci

name = "Formatter launch context diagnostic"
`run-name` = "Formatter launch-context diagnosis 8a1ea5556d8f — one copied build"
on {
  push { branches = List("diag/formatter-launch-context-20261126") }
}
permissions { contents = "read" }
concurrency {
  group = "formatter-launch-context-diagnostic-8a1ea5556d8f-${{ github.ref }}"
  `cancel-in-progress` = false
}
env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  CARGO_INCREMENTAL = "0"
  // This push launches a diagnosis OF this exact source, never of the driver ref.
  SOURCE_SHA = "8a1ea5556d8f00defad4ac5635bdf48e5ab1d302"
  SOURCE_DATE_EPOCH = "1795617213"
}
jobs {
  diagnose {
    `runs-on` = ci.linux
    `timeout-minutes` = 90
    steps = new Listing {
      new Dynamic { uses = ci.checkout; with { path = "driver"; `persist-credentials` = false } }
      new Dynamic { uses = ci.checkout; with { path = "source"; ref = "${{ env.SOURCE_SHA }}"; `persist-credentials` = false } }
      new Dynamic { uses = ci.setupVp; with { `node-version-file` = "driver/package.json"; `run-install` = false } }
      ci.rust("1.100.0")
      new Dynamic { uses = "./driver/.github/actions/setup-wild-http-recovery"; with { `wild-version` = "0.9.0" } }
      ci.command("Install pinned Callgrind", "bash driver/.github/scripts/workflows/shipped-profile-measure/install-callgrind.sh")
      ci.command("Test diagnostic controls", "node --test driver/tests/tooling/formatter-launch-context.test.mjs")
      ci.command("Build one formatter probe and diagnose launch contexts", "node driver/tools/benchmarks/scripts/formatter-launch-context.mjs source")
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "formatter-launch-context-diagnostic-${{ github.run_id }}"
          path = "${{ runner.temp }}/formatter-launch-diagnostic/\n!${{ runner.temp }}/formatter-launch-diagnostic/target/**"
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
}
