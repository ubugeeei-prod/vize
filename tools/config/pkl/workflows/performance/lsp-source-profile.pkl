import "../../Actions.pkl" as ci

name = "LSP source operations and allocations"

on {
  pull_request {
    paths = new Listing {
      ".github/workflows/lsp-source-profile.yml"
      ".github/scripts/workflows/lsp-source-profile/**"
      "crates/vize/src/commands/lsp.rs"
      "crates/vize/tests/lsp_profile_cli.rs"
      "crates/vize_maestro/src/server/state/project_contexts/root_discovery.rs"
      "tools/support/compat/davinci/lsp-resources.ts"
      "tools/support/compat/davinci/lib/lsp-profile-launch.ts"
      "tools/support/process-launcher.ts"
      "tools/support/launchers/profile-lsp.sh"
      "tools/support/compat/davinci/lib/lsp-resource-cancellation.ts"
      "tools/support/compat/davinci/lib/lsp-resource-cancellation-run.ts"
      "tools/support/compat/davinci/lib/lsp-resource-corsa-gate.ts"
      "tools/support/compat/davinci/lib/lsp-resource-corsa-mirror.cjs"
      "tools/support/compat/davinci/lib/lsp-resource-corsa-proxy.ts"
      "tools/support/compat/davinci/lib/lsp-resource-corsa-proxy.cjs"
      "tools/support/compat/davinci/lib/lsp-resource-corpus.ts"
      "tools/support/compat/davinci/lib/lsp-resource-finalize.ts"
      "tools/support/compat/davinci/lib/lsp-resource-sampler.ts"
      "tools/support/compat/davinci/lib/lsp-resource-witness.ts"
      "tools/support/compat/davinci/lib/lsp-resource-workspace.ts"
      "tools/support/json-value.ts"
      "tests/tooling/lsp-resource-cancellation.test.ts"
      "tests/tooling/lsp-resource-corsa-gate.test.ts"
      "tests/tooling/lsp-resource-finalize.test.ts"
      "tests/tooling/support/lsp/assertions.ts"
      "tests/tooling/support/lsp/protocol.ts"
      "tests/tooling/support/lsp/session.ts"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }

concurrency {
  group = "lsp-source-profile-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

jobs {
  source {
    name = "Fresh-process LSP source counts (100, 500, 2500 SFCs)"
    `runs-on` = ci.linux
    `timeout-minutes` = 45
    env {

      CARGO_TERM_COLOR = "always"
      NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
      SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("lsp-source-profile")
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      ci.command("Authenticate the exact source revision", ci.workflowScript("authenticate-the-exact-source-revision.sh"))
      ci.workspaceVp()
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Verify LSP resource evidence helpers"
        run = "vp exec node --test tests/tooling/lsp-resource-cancellation.test.ts tests/tooling/lsp-resource-corsa-gate.test.ts tests/tooling/lsp-resource-finalize.test.ts"
      }
      ci.command("Install the repository Rust toolchain", ci.workflowScript("install-the-repository-rust-toolchain.sh"))
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "lsp-source-profile"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Build the separately instrumented server"
        run = ci.workflowScript("build-the-separately-instrumented-server.sh")
      }
      new Dynamic {
        name = "Verify real stdio profiling with the instrumented allocator"
        run = "cargo test --profile ci-opt -p vize --features profiling --test integration lsp_profile_cli::lsp_exports_profile_after_graceful_stdio_shutdown -- --exact"
      }
      new Dynamic {
        name = "Record the instrumented binary identity"
        run = #"vp exec node tools/support/compat/davinci/lsp-build-identity.ts target/ci-opt/vize ci-opt "${RUNNER_TEMP}/source-build.jsonl" "${RUNNER_TEMP}/source-build-identity.json""#
      }
      new Dynamic {
        name = "Collect the complete residency oracle and source profiles"
        run = ci.workflowScript("collect-the-complete-residency-oracle-and-source-profiles.sh")
      }
      new Dynamic {
        name = "Summarize the scope of these observations"
        `if` = "${{ success() }}"
        run = ci.workflowScript("summarize-the-scope-of-these-observations.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ always() }}"
        with {
          name = "lsp-source-operations-linux-x64"
          path = """
          ${{ runner.temp }}/source-build-identity.json
          ${{ runner.temp }}/source-*.json
          ${{ runner.temp }}/source-*/run-*.json

          """
          `retention-days` = 30
        }
      }
    }
  }
}
