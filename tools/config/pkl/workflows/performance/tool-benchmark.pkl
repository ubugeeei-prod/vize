import "../../../../ci/lib/Actions.pkl" as ci

name = "Benchmark - Tool comparison"

on {
  workflow_dispatch {
    inputs {
      file_count {
        description = "Generated SFC files for compile/lint/fmt benchmarks"
        required = true
        ["default"] = "15000"
      }
      check_file_count {
        description = "Generated SFC files for vue-tsc/Vize check benchmarks"
        required = true
        ["default"] = "500"
      }
      vite_file_count {
        description = "Generated SFC files imported by the Vite benchmark entry"
        required = true
        ["default"] = "1000"
      }
      nuxt_file_count {
        description = "Generated SFC files imported by the Nuxt benchmark app"
        required = true
        ["default"] = "500"
      }
      musea_file_count {
        description = "Generated art files measured by the Musea plugin benchmark"
        required = true
        ["default"] = "240"
      }
      large_blocks {
        description = "Repeated template blocks in the large single-SFC benchmark"
        required = true
        ["default"] = "900"
      }
      runs {
        description = "Measured runs per variant"
        required = true
        ["default"] = "5"
      }
      warmups {
        description = "Warmup runs per variant"
        required = true
        ["default"] = "1"
      }
      tasks {
        description = "Comma-separated surfaces to measure (empty measures all; publication requires all)"
        required = false
        ["default"] = ""
      }
      commit_results {
        description = "Commit the generated docs benchmark snapshot back to the branch"
        required = true
        type = "boolean"
        ["default"] = false
      }
    }
  }
  // A full tool benchmark is far too heavy (75 min) to run on every push to
  // main, so a scheduled run publishes benchmark artifacts on a fixed cadence.
  // Committed baseline refreshes must go through a non-main branch because
  // main is protected by required status checks.
  schedule = new Listing {
    new Dynamic { cron = "41 5 * * 1" }
  }
}

concurrency {
  group = "tool-benchmark-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  VIZE_TOOL_BENCH_FILE_COUNT = "${{ github.event_name == 'workflow_dispatch' && inputs.file_count || '3000' }}"
  VIZE_TOOL_BENCH_CHECK_FILE_COUNT = "${{ github.event_name == 'workflow_dispatch' && inputs.check_file_count || '500' }}"
  VIZE_TOOL_BENCH_VITE_FILE_COUNT = "${{ github.event_name == 'workflow_dispatch' && inputs.vite_file_count || '1000' }}"
  VIZE_TOOL_BENCH_NUXT_FILE_COUNT = "${{ github.event_name == 'workflow_dispatch' && inputs.nuxt_file_count || '250' }}"
  VIZE_TOOL_BENCH_MUSEA_FILE_COUNT = "${{ github.event_name == 'workflow_dispatch' && inputs.musea_file_count || '240' }}"
  VIZE_TOOL_BENCH_LARGE_BLOCKS = "${{ github.event_name == 'workflow_dispatch' && inputs.large_blocks || '300' }}"
  VIZE_TOOL_BENCH_RUNS = "${{ github.event_name == 'workflow_dispatch' && inputs.runs || '3' }}"
  VIZE_TOOL_BENCH_WARMUPS = "${{ github.event_name == 'workflow_dispatch' && inputs.warmups || '1' }}"
  VIZE_TOOL_BENCH_TASKS = "${{ github.event_name == 'workflow_dispatch' && inputs.tasks || '' }}"
}

jobs {
  `tool-benchmark-impact` {
    name = "tool-benchmark-impact"
    `if` = "${{ github.event_name == 'pull_request' }}"
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    permissions {
      contents = "read"
      `pull-requests` = "read"
    }
    outputs { runtime = "${{ steps.changes.outputs.runtime }}" }
    // Unknown paths match `**` and run the benchmark. Negations remove only
    // areas known not to affect any measured CLI/native/Vite/Nuxt runtime.
    steps = new Listing {
      new Dynamic {
        name = "Detect measured runtime changes"
        id = "changes"
        uses = "dorny/paths-filter@7b450fff21473bca461d4b92ce414b9d0420d706"  // v4.0.2
        with {
          `predicate-quantifier` = "every"
          filters = """
          runtime:
            - '**'
            - '!**/*.md'
            - '!docs/**'
            - '!.changeset/**'
            - '!.github/ISSUE_TEMPLATE/**'
            - '!.github/PULL_REQUEST_TEMPLATE.md'
            - '!.github/actions/app-readiness/**'
            - '!.github/workflows/check-bench.yml'
            - '!.github/workflows/check.yml'
            - '!.github/workflows/criterion-bench.yml'
            - '!.github/workflows/build-docs.yml'
            - '!.github/workflows/deploy-docs.yml'
            - '!.github/workflows/e2e.yml'
            - '!.github/workflows/fuzz.yml'
            - '!.github/workflows/miri.yml'
            - '!.github/workflows/native-smoke.yml'
            - '!.github/workflows/pkg-pr-new.yml'
            - '!.github/workflows/release*.yml'
            - '!.github/workflows/title-policy.yml'
            - '!tools/benchmarks/scripts/check-gate.mjs'
            - '!tools/benchmarks/scripts/check-gate-env.mjs'
            - '!tools/benchmarks/scripts/check-gate-plants.mjs'
            - '!tools/benchmarks/scripts/check-gate-report.ts'
            - '!editors/**'
            - '!tests/**'
            - '!tools/ci/commands/github/**'
            - '!tools/support/github/**'
            - '!tools/support/release/publish_*/**'
            - '!tools/support/release/release/**'
            - '!tools/ci/commands/source-coverage.ts'
            - '!tools/ci/commands/source-file-lengths.ts'
            - '!tools/ci/commands/check-warning-budget.ts'
            - '!tools/commands/release/npm/tag.ts'
            - '!tools/support/release/inject_native_optional_deps/**'

          """
        }
      }
    }
  }

  `tool-benchmark` {
    name = "tool-benchmark"
    needs = "tool-benchmark-impact"
    `if` = "${{ always() && !cancelled() && (github.event_name != 'pull_request' || needs.tool-benchmark-impact.outputs.runtime == 'true') }}"
    `runs-on` = ci.linux
    `timeout-minutes` = 75
    permissions { contents = "read" }
    steps = new Listing {
      ...ci.stageWorkflowScripts("tool-benchmark")
      new Dynamic {
        name = "Checkout benchmark commit"
        uses = ci.checkout
        with {
          ref = "${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}"
        }
      }
      ci.rust("stable")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "tool-benchmark"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.workspaceVp()
      ci.use("./.github/actions/setup-rust-script")
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Install the pinned content-mapper hosts and Vue mapper"
        run = "npm ci --prefix tools/benchmarks/typecheck-hosts --ignore-scripts --no-audit --no-fund"
      }
      new Dynamic {
        name = "Install the pinned Nuxt benchmark app"
        run = "npm ci --prefix tools/benchmarks/nuxt-app --ignore-scripts --no-audit --no-fund"
      }
      ci.command("Build Vize CLI", "cargo build --release -p vize")
      new Dynamic {
        name = "Verify CSS recovery in the shipped release profile"
        run = "cargo run --release -p vize_atelier_sfc --example css_engine_recovery"
      }
      ci.command("Build native package", "vp run --workspace-root build:native")
      ci.command("Build Vite plugin package", "vp run --workspace-root build:vite-plugin")
      ci.command("Build Nuxt package stack", "vp run --workspace-root build:nuxt-stack")
      ci.command("Generate benchmark input", #"node tools/benchmarks/scripts/generate.mjs "$VIZE_TOOL_BENCH_FILE_COUNT""#)
      new Dynamic {
        name = "Compare Vize with existing tools"
        env {
          VIZE_BENCHMARK_REVISION = "${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}"
          VIZE_BENCH_REF = "${{ github.ref_name }}"
        }
        run = ci.workflowScript("compare-vize-with-existing-tools.sh")
      }
      ci.command("Write job summary", ci.workflowScript("write-job-summary.sh"))
      new Dynamic {
        name = "Upload tool benchmark results"
        uses = ci.uploadArtifact
        with {
          name = "tool-benchmark"
          path = """
          tool-benchmark-summary.md
          tool-benchmark-results.json
          performance-blacksmith.md

          """
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }

  `tool-benchmark-comment` {
    name = "tool-benchmark-comment"
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    `if` = "${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository }}"
    needs = List("tool-benchmark")
    permissions {
      actions = "read"
      contents = "read"
      issues = "write"
      `pull-requests` = "write"
    }
    steps = new Listing {
      new Dynamic {
        name = "Checkout trusted base"
        uses = ci.checkout
        with { ref = "${{ github.event.pull_request.base.sha }}" }
      }
      new Dynamic {
        name = "Download tool benchmark results"
        uses = ci.downloadArtifact
        with { name = "tool-benchmark" }
      }
      new Dynamic {
        name = "Comment on PR"
        `continue-on-error` = true
        env {
          GITHUB_TOKEN = "${{ github.token }}"
          PR_NUMBER = "${{ github.event.pull_request.number }}"
          BENCHMARK_COMMENT_KEY = "tool-${{ github.event.pull_request.head.sha }}"
        }
        run = #"node tools/benchmarks/scripts/comment-pr.mjs --body tool-benchmark-summary.md --comment-key "$BENCHMARK_COMMENT_KEY""#
      }
    }
  }

  `tool-benchmark-commit` {
    name = "tool-benchmark-commit"
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    // The implicit success() is false whenever an ancestor job was skipped, and
    // tool-benchmark-impact is skipped on every dispatch; gate on the measured job.
    `if` = "${{ !cancelled() && needs.tool-benchmark.result == 'success' && github.event_name == 'workflow_dispatch' && inputs.commit_results && startsWith(github.ref, 'refs/heads/') && github.ref_name != 'main' }}"
    needs = List("tool-benchmark")
    permissions {
      actions = "read"
      contents = "write"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("tool-benchmark")
      new Dynamic {
        name = "Checkout benchmark branch"
        uses = ci.checkout
        with { ref = "${{ github.ref_name }}" }
      }
      new Dynamic {
        name = "Run voidzero-dev/setup-vp@ca1c46663915d6c1042ae23bd39ab85718bfb0fa"
        uses = ci.setupVp
        with {
          `node-version-file` = "package.json"
          cache = true
          `run-install` = false
        }
      }
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Download tool benchmark results"
        uses = ci.downloadArtifact
        with {
          name = "tool-benchmark"
          path = "tool-benchmark-artifact"
        }
      }
      new Dynamic {
        name = "Commit benchmark snapshot"
        env { VIZE_BENCH_REF = "${{ github.ref_name }}" }
        run = ci.workflowScript("commit-benchmark-snapshot.sh")
      }
    }
  }
}
