import "../../Actions.pkl" as ci

name = "Benchmark - UTF-8 file reads"

on {
  workflow_dispatch = null
  schedule = new Listing {
    new Dynamic { cron = "23 4 * * 0" }
  }
}

permissions { contents = "read" }

concurrency {
  group = "text-boundary-${{ github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_TERM_COLOR = "always"
  CARGO_INCREMENTAL = "0"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}

jobs {
  `paired-read` {
    name = "UTF-8 correctness and paired file reads"
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      ci.rust("stable")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "text-boundary"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.command("Verify exact UTF-8 and filesystem contracts", "cargo test --locked -p vize_l0 -p vize_carton source_io")
      new Dynamic {
        name = "Check the source boundary and benchmark with Clippy"
        run = "cargo clippy --locked -p vize_carton --lib --tests --examples -- -D warnings"
      }
      new Dynamic {
        name = "Measure validation and actual file reads separately"
        env { HEAD_SHA = "${{ github.event.pull_request.head.sha || github.sha }}" }
        run = "cargo run --locked --profile ci-opt -p vize_carton --example source_io_bench -- source-io-bench.json"
      }
      new Dynamic {
        name = "Upload exact timings and input sizes"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "source-io-bench"
          path = "source-io-bench.json"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
