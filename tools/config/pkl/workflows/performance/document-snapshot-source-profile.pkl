import "../../Actions.pkl" as ci

name = "Document snapshot source profile"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/document-snapshot-source-profile.yml"
      ".github/scripts/workflows/document-snapshot-source-profile/**"
      ".github/scripts/workflows/shared/**"
      "crates/vize_maestro/src/document/store.rs"
      "crates/vize_maestro/src/document/store/**"
      "crates/vize_maestro/src/ide/diagnostics/corsa/**"
      "crates/vize_maestro/src/ide/workspace_symbols.rs"
      "crates/vize_maestro/src/ide/workspace_symbols/**"
      "crates/vize_maestro/src/server/state/corsa_overlays.rs"
      "crates/vize_maestro/src/server/state/workspace_project_files/**"
      "crates/vize_maestro/src/source_project/snapshot.rs"
      "crates/vize_maestro/Cargo.toml"
      "crates/vize_maestro/tests/source_snapshot_profile.rs"
      "crates/vize_maestro/tests/workspace_symbol_allocation/**"
    }
  }
  workflow_dispatch {}
}
permissions { contents = "read" }
concurrency {
  group = "document-snapshot-source-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  carrier {
    `runs-on` = ci.linux
    `timeout-minutes` = 40
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/document-snapshot-source-profile"
      CARGO_BUILD_JOBS = "4"
      CARGO_INCREMENTAL = "0"
      CARGO_TERM_COLOR = "never"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic { run = "rustup toolchain install 1.100.0 --profile minimal" }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "document-snapshot-source-v1"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Run the bounded normal and source-counter carriers"
        run = #". "${{ env.VIZE_CI_FILES }}/run-the-bounded-normal-and-source-counter-carriers.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "document-snapshot-source-${{ github.sha }}"
          path = "evidence/"
          `if-no-files-found` = "error"
        }
      }
    }
  }
}
