// Temporary driver for the actual L2 text rebuild function; not a product source change.
`name` = "L2 text rebuild comparison"
`on` = new Dynamic {
  `workflow_dispatch` = new Dynamic {
    `inputs` = new Dynamic {
      `base_sha` = new Dynamic {
        `required` = true
        `type` = "string"
      }
      `head_sha` = new Dynamic {
        `required` = true
        `type` = "string"
      }
    }
  }
}
`permissions` = new Dynamic {
  `contents` = "read"
}
`env` = new Dynamic {
  `FORCE_JAVASCRIPT_ACTIONS_TO_NODE24` = true
}
`jobs` = new Dynamic {
  `compare` = new Dynamic {
    `runs-on` = "blacksmith-32vcpu-ubuntu-2404"
    `timeout-minutes` = 60
    `steps` = new Listing {
      new Dynamic {
        `uses` = "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
        `with` = new Dynamic {
          `persist-credentials` = false
        }
      }
      new Dynamic {
        `uses` = "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
        `with` = new Dynamic {
          `ref` = "${{ inputs.base_sha }}"
          `path` = "rebuild-base"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        `uses` = "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
        `with` = new Dynamic {
          `ref` = "${{ inputs.head_sha }}"
          `path` = "rebuild-head"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        `uses` = "actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38"
        `with` = new Dynamic {
          `node-version` = "24"
        }
      }
      new Dynamic {
        `uses` = "dtolnay/rust-toolchain@d1031067263f94b142dd6c0ce24c5eb9d02d52a0"
        `with` = new Dynamic {
          `toolchain` = "1.100.0"
        }
      }
      new Dynamic {
        `name` = "Install existing Callgrind identity"
        `run` = ". \".github/scripts/workflows/shipped-profile-measure/install-callgrind.sh\""
      }
      new Dynamic {
        `name` = "Build, verify native behavior, and compare instructions"
        `env` = new Dynamic {
          `REBUILD_PROBE_ROOT` = "${{ github.workspace }}"
          `REBUILD_PROBE_BASE_SHA` = "${{ inputs.base_sha }}"
          `REBUILD_PROBE_HEAD_SHA` = "${{ inputs.head_sha }}"
        }
        `run` = "node tools/benchmarks/probes/text-rebuild/driver.ts"
      }
      new Dynamic {
        `name` = "Retain raw dumps, actual ELFs, source, dependency identity and receipt"
        `if` = "always()"
        `uses` = "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a"
        `with` = new Dynamic {
          `name` = "text-rebuild-${{ inputs.head_sha }}"
          `if-no-files-found` = "error"
          `path` = "rebuild-evidence/measurement.json\nrebuild-evidence/environment.json\nrebuild-evidence/authored/**\nrebuild-evidence/*/package/**\nrebuild-evidence/*/metadata.json\nrebuild-evidence/*/build.jsonl\nrebuild-evidence/*/symbols.txt\nrebuild-evidence/*/sections.txt\nrebuild-evidence/*/elf-symbols.txt\nrebuild-evidence/*/run-*/**\nrebuild-evidence/*/text_rebuild_probe\n"
        }
      }
    }
  }
}
`run-name` = "L2 text rebuild instruction comparison ${{ inputs.base_sha }} → ${{ inputs.head_sha }}"
