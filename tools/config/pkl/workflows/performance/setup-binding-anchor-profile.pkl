import "../../Actions.pkl" as ci

name = "Setup binding anchor allocation profile"
on {
  pull_request {
    paths = new Listing {
      "crates/vize_canon/src/virtual_ts/generator/anchors.rs"
      "crates/vize_canon/src/virtual_ts/generator/imports.rs"
      "crates/vize_canon/src/virtual_ts/generator/type_only_imports.rs"
      "crates/vize_canon/src/virtual_ts/generator/type_only_imports/**"
      "tests/_fixtures/differential/typechecker/prepared-type-only-import-facts/**"
      "crates/vize_canon/src/virtual_ts/props.rs"
      "crates/vize_canon/src/virtual_ts/props/template_bindings.rs"
      "tools/benchmarks/crates/vize/tests/setup_binding_anchor_profile.rs"
      "tools/benchmarks/scripts/setup-binding-anchor-evidence.ts"
      "tools/benchmarks/scripts/setup-binding-constructor-evidence.ts"
      "tools/support/compat/content-mapper/**"
      "tests/tooling/setup-binding-anchor-evidence.test.ts"
      ".github/workflows/setup-binding-anchor-profile.yml"
      ".github/scripts/workflows/setup-binding-anchor-profile/**"
      ".github/scripts/workflows/shared/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "setup-binding-anchor-profile-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  compare {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {

      BASE_SHA = "${{ github.event.pull_request.base.sha }}"
      HEAD_SHA = "${{ github.event.pull_request.head.sha }}"
      RUSTUP_TOOLCHAIN = "1.100.0"
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RAYON_NUM_THREADS = "8"
      VIZE_BINDING_PROFILE_INPUT = "${{ github.workspace }}/tests/_fixtures/differential/typechecker/prepared-type-only-import-facts/Imports.vue.txt"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("setup-binding-anchor-profile")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.event.pull_request.head.sha }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        name = "Build role-isolated exact source observers"
        run = ci.workflowScript("build-role-isolated-exact-source-observers.sh")
      }
      new Dynamic {
        name = "Compare fresh generation packets and allocation pressure"
        run = ci.workflowScript("compare-fresh-generation-packets-and-allocation-pressure.sh")
      }
      new Dynamic {
        name = "Require complete constructor projection byte parity"
        run = ci.workflowScript("require-complete-constructor-projection-byte-parity.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "setup-binding-anchor-profile-${{ github.sha }}"
          path = "${{ runner.temp }}/binding-evidence"
          `retention-days` = 14
        }
      }
    }
  }
}
