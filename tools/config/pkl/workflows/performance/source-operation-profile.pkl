import "../../Actions.pkl" as ci

name = "Source operation profile"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/source-operation-profile.yml"
      ".github/scripts/workflows/source-operation-profile/**"
      ".github/scripts/workflows/shared/**"
      "davinci/vize_l0/src/profiler/**"
      "davinci/vize_l0/src/profiler.rs"
      "davinci/vize_l0/tests/source_operations_profile.rs"
      "davinci/vize_l0/tests/source_probes/**"
      "crates/vize_croquis/src/script_parser/parse.rs"
      "crates/vize_croquis/src/script_parser/recovery.rs"
      "crates/vize_croquis/src/script_parser/recovery/**"
      "crates/vize_canon/src/corsa_bridge/vue_dependencies_alias/context/cache/fingerprint.rs"
      "crates/vize_canon/src/corsa_bridge/vue_dependencies_alias/context/namespace.rs"
      "davinci/vize_l0/examples/source_operation_overhead.rs"
      "davinci/vize_l0/Cargo.toml"
      "crates/vize_carton/src/profile_export/**"
      "crates/vize_carton/src/profile_export.rs"
      "crates/vize_carton/Cargo.toml"
    }
  }
  workflow_dispatch {}
}
permissions { contents = "read" }
concurrency {
  group = "source-operation-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  scopes {
    `runs-on` = ci.linux
    `timeout-minutes` = 35
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/source-operation-profile"
      CARGO_INCREMENTAL = "0"
      CARGO_TERM_COLOR = "never"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic { run = "rustup toolchain install 1.100.0 --profile minimal" }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "source-operation-v1"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Check disabled and instrumented collector laws"
        run = ci.workflowScript("check-disabled-and-instrumented-collector-laws.sh")
      }
      new Dynamic {
        name = "Measure instrumentation overhead separately from product speed"
        run = ci.workflowScript("measure-instrumentation-overhead-separately-from-product-speed.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "source-operation-${{ github.sha }}"
          path = "evidence/"
          `if-no-files-found` = "error"
        }
      }
    }
  }
}
