import "../../../../ci/lib/Actions.pkl" as ci

name = "Davinci resource budgets"

// TS-44 (Davinci P5-11a): the resident `vize lsp` measured against the
// `docs/davinci/plan/budgets.toml [resource]` ceilings on the reference
// runner. Every recorded number names this workflow's measure command; the
// ratchet step rejects a loosened or dropped ceiling against the PR base.
//
on {
  // Daily, offset from the other nightly lanes.
  schedule = new Listing {
    new Dynamic { cron = "53 5 * * *" }
  }
  workflow_dispatch {
    inputs {
      include_release {
        description = "Also measure the shipped fat-LTO Linux CLI at the same source revision"
        type = "boolean"
        ["default"] = false
      }
    }
  }
}

concurrency {
  group = "davinci-resource-${{ github.workflow }}-${{ github.event.pull_request.number || github.sha }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
  RESOURCE_PRESET = "linux-x64-ci"
}

jobs {
  resource {
    name = "TS-44 resource budgets (linux-x64-ci)"
    `runs-on` = ci.linux
    `timeout-minutes` = 45
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/davinci-resource-budgets"
    }
    steps = new Listing {
      ci.use(ci.checkout)
      ci.workspaceVp()
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      // The runner's rustup installs the toolchain pinned in rust-toolchain.toml.
      new Dynamic {
        name = "Install the repository Rust toolchain"
        run = ci.workflowScript("install-the-repository-rust-toolchain.sh")
      }
      // No Wild: the server links with rust-lld like the shipped x86_64 Linux
      // CLI, so crates/vize/build.rs folds identical code and packs relocations.
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "davinci-resource"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      // The optimized profile check-bench measures; shipped release binaries
      // use fat LTO and one codegen unit on top of it.
      new Dynamic {
        name = "Build the measured server"
        run = ci.workflowScript("build-the-measured-server.sh")
      }
      new Dynamic {
        name = "Record the measured binary and build identity"
        run = ci.workflowScript("record-the-measured-binary-and-build-identity.sh")
      }
      new Dynamic {
        name = "Measure the resident server"
        run = #"rust-script tools/commands/davinci/resource-budgets.rs --measure --preset "${RESOURCE_PRESET}" --runs 3 --keystrokes 20 --idle-seconds 60 --server target/ci-opt/vize --out "${RUNNER_TEMP}/resource.json""#
      }
      new Dynamic {
        name = "Every number carries its methodology"
        `if` = "${{ !cancelled() }}"
        run = "rust-script tools/commands/davinci/resource-budgets.rs --validate"
      }
      new Dynamic {
        name = "No ceiling is loosened against the base"
        `if` = "${{ !cancelled() && github.event_name == 'pull_request' }}"
        env { BASE_SHA = "${{ github.event.pull_request.base.sha }}" }
        run = ci.workflowScript("no-ceiling-is-loosened-against-the-base.sh")
      }
      new Dynamic {
        name = "The measurement holds every pinned ceiling"
        `if` = "${{ !cancelled() }}"
        run = #"rust-script tools/commands/davinci/resource-budgets.rs --check --measurement "${RUNNER_TEMP}/resource.json""#
      }
      new Dynamic {
        name = "Summarize"
        `if` = "${{ !cancelled() }}"
        run = ci.workflowScript("summarize.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ !cancelled() }}"
        with {
          name = "resource-${{ env.RESOURCE_PRESET }}"
          path = """
          ${{ runner.temp }}/resource.json
          ${{ runner.temp }}/resource-build-identity.json

          """
          `retention-days` = 30
        }
      }
    }
  }

  `resident-resource` {
    name = "Synthetic 10k-file resident resources (P5-4b)"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/davinci-resource-budgets"
    }
    steps = new Listing {
      ci.use(ci.checkout)
      ci.command("Install the repository Rust toolchain", ci.workflowScript("install-the-repository-rust-toolchain-2.sh"))
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "davinci-resident-resource"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Build the isolated resident session"
        run = #"cargo build --profile ci-opt -p vize_incremental --example resource_session --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16'"#
      }
      new Dynamic {
        name = "Measure and enforce the unchanged reference RSS ceilings"
        run = #"node tools/commands/davinci/resident-resources.ts --server target/ci-opt/examples/resource_session --files 10000 --edits 32 --runs 3 --out "${RUNNER_TEMP}/resident-resource.json""#
      }
      new Dynamic {
        name = "Summarize the isolated session"
        `if` = "${{ !cancelled() }}"
        run = ci.workflowScript("summarize-the-isolated-session.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ !cancelled() }}"
        with {
          name = "resident-resource-${{ env.RESOURCE_PRESET }}"
          path = "${{ runner.temp }}/resident-resource.json"
          `retention-days` = 30
        }
      }
    }
  }

  `production-lsp-resource` {
    name = "Production 10k open SFC process-tree RSS (record only)"
    `if` = "github.event_name == 'workflow_dispatch'"
    `runs-on` = ci.linux
    `timeout-minutes` = 60
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/davinci-resource-budgets"
    }
    steps = new Listing {
      ci.use(ci.checkout)
      ci.workspaceVp()
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.command("Install the repository Rust toolchain", ci.workflowScript("install-the-repository-rust-toolchain-2.sh"))
      // No Wild: the server links with rust-lld like the shipped x86_64 Linux
      // CLI, so crates/vize/build.rs folds identical code and packs relocations.
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "davinci-resource"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        name = "Verify assertion, module, and source length gates"
        run = "vp exec node --test tests/tooling/davinci-assertion-lint.test.ts tests/tooling/davinci-module-layout.test.ts tests/tooling/source-file-lengths.test.ts"
      }
      new Dynamic {
        name = "Build the production server"
        run = #"cargo build --profile ci-opt -p vize --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16'"#
      }
      new Dynamic {
        name = "Verify the protocol and controlled edit oracle"
        run = ci.workflowScript("verify-the-protocol-and-controlled-edit-oracle.sh")
      }
      new Dynamic {
        name = "Measure 10000 open buffers, 16 production providers, and Corsa"
        run = ci.workflowScript("measure-10000-open-buffers-16-production-providers-and.sh")
      }
      new Dynamic {
        name = "Summarize the actual scope and every process"
        `if` = "${{ !cancelled() }}"
        run = ci.workflowScript("summarize-the-actual-scope-and-every-process.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ always() }}"
        with {
          name = "production-lsp-resource-linux-x64-ci"
          path = "${{ runner.temp }}/lsp-resource*.json"
          `retention-days` = 30
        }
      }
    }
  }

  // Optional same-SHA supplement on the shipped fat-LTO profile. The scheduled
  // ci-opt gate and all its ceilings remain unchanged; a fat-LTO pass never
  // substitutes for a failing ci-opt result.
  `release-resource` {
    name = "Shipped Linux CLI resource comparison"
    `if` = "github.event_name == 'workflow_dispatch' && inputs.include_release"
    `runs-on` = ci.linux
    `timeout-minutes` = 60
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/davinci-resource-budgets"
      CARGO_TERM_COLOR = "always"
      NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
    }
    steps = new Listing {
      ci.use(ci.checkout)
      ci.workspaceVp()
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.command("Install the repository Rust toolchain", ci.workflowScript("install-the-repository-rust-toolchain-2.sh"))
      // Same default rust-lld, target, default features and fat release profile
      // as build-release-cli/action.yml. No CI profile or linker override.
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "lsp-release-resources"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        name = "Build the shipped Linux CLI recipe"
        run = ci.workflowScript("build-the-shipped-linux-cli-recipe.sh")
      }
      new Dynamic {
        name = "Record the measured binary and build identity"
        run = ci.workflowScript("record-the-measured-binary-and-build-identity-2.sh")
      }
      new Dynamic {
        name = "Measure the complete TS-44 campaign with the shipped profile"
        run = ci.workflowScript("measure-the-complete-ts-44-campaign-with-the-shipped.sh")
      }
      new Dynamic {
        name = "Apply every unchanged TS-44 ceiling to this additional build"
        run = #"rust-script tools/commands/davinci/resource-budgets.rs --check --measurement "${RUNNER_TEMP}/release-resource.json""#
      }
      new Dynamic {
        name = "Verify the protocol and controlled edit oracle"
        run = ci.workflowScript("verify-the-protocol-and-controlled-edit-oracle-2.sh")
      }
      new Dynamic {
        name = "Measure 10000 open buffers, 16 production providers, and Corsa"
        run = ci.workflowScript("measure-10000-open-buffers-16-production-providers-and-2.sh")
      }
      new Dynamic {
        name = "Summarize the separate release measurements"
        `if` = "${{ !cancelled() }}"
        run = ci.workflowScript("summarize-the-separate-release-measurements.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ always() }}"
        with {
          name = "release-lsp-resources-linux-x64"
          path = """
          ${{ runner.temp }}/release-build-identity.json
          ${{ runner.temp }}/release-resource.json
          ${{ runner.temp }}/release-lsp-resource*.json

          """
          `retention-days` = 30
        }
      }
    }
  }
}
