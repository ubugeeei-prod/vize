import "../../Actions.pkl" as ci

name = "Benchmark - Fresco dimensions"

on {
  schedule = new Listing {
    new Dynamic { cron = "37 6 * * *" }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }

concurrency {
  group = "fresco-dimensions-${{ github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_TERM_COLOR = "always"
  CARGO_INCREMENTAL = "0"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  HEAD_SHA = "${{ github.sha }}"
}

jobs {
  dimensions {
    name = "Fresco dimension parity and layout (measurement ${{ matrix.replica }})"
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    strategy {
      `fail-fast` = false
      matrix {
        replica = List(1, 2, 3)
      }
    }
    steps = new Listing {
      ci.checkoutAt("${{ github.sha }}")
      new Dynamic {
        name = "Record exact source of both parser implementations"
        run = """
        set -euo pipefail
        [[ "$HEAD_SHA" =~ ^[0-9a-f]{40}$ ]]
        [[ "$(git rev-parse HEAD)" == "$HEAD_SHA" ]]
        echo "BASE_SHA=$HEAD_SHA" >> "$GITHUB_ENV"

        """
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "stable"
          components = "clippy"
        }
      }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "fresco-dimensions-${{ matrix.replica }}"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Prove scalar bits, error categories and consumer behavior"
        run = "cargo test --locked -p vize_fresco layout::dimensions"
      }
      ci.command("Verify the actual NAPI call sites", "cargo clippy --locked -p vize_fresco --features napi --lib -- -D warnings")
      ci.command("Lint the parity corpus and benchmark", "cargo clippy --locked -p vize_fresco --lib --tests -- -D warnings")
      new Dynamic {
        name = "Compare actual parsing and 1k/10k node layout workloads"
        env {
          FRESCO_DIMENSION_BENCH_OUT = "${{ github.workspace }}/fresco-dimension-bench.json"
          REPLICA = "${{ matrix.replica }}"
        }
        run = "cargo test --locked --profile ci-opt -p vize_fresco --lib paired_parse_and_layout -- --ignored --test-threads=1"
      }
      new Dynamic {
        name = "Upload raw paired timings"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "fresco-dimension-bench-${{ matrix.replica }}"
          path = "fresco-dimension-bench.json"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
