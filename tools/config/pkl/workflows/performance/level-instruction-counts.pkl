import "../../../../ci/lib/Actions.pkl" as ci

name = "Level instruction counts"

// Check calls the measurement once per queue candidate and scheduled run.
// Avoid a second standalone PR run of the same instruction campaign.
on {
  workflow_dispatch = null
  workflow_call = null
}
permissions { contents = "read" }

concurrency {
  group = "instruction-counts-${{ github.workflow }}-${{ github.event.pull_request.number || github.sha }}"
  `cancel-in-progress` = true
}

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  RUSTUP_TOOLCHAIN = "1.100.0"
}

jobs {
  `instruction-counts` {
    name = "Per-stage instruction ceilings"
    `runs-on` = ci.linux
    `timeout-minutes` = 45
    // Reusable workflows retain the caller's workflow name.
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/level-instruction-counts"
      MEASURE = "${{ github.event_name == 'merge_group' || github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' || github.workflow == 'Level instruction counts' }}"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupVp
        with {
          `node-version-file` = "package.json"
          `run-install` = false
        }
      }
      new Dynamic {
        name = "Install pinned measurement Rust"
        `if` = "env.MEASURE == 'true'"
        run = "rustup toolchain install 1.100.0 --profile minimal"
      }
      new Dynamic {
        name = "Install Callgrind and matching client request headers"
        `if` = "env.MEASURE == 'true'"
        run = ci.workflowScript("install-callgrind-and-matching-client-request-headers.sh")
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        `if` = "env.MEASURE == 'true'"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        `if` = "env.MEASURE == 'true'"
        with {
          key = "instruction-counts-v1"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Test instruction parser and gates"
        run = "node --test tests/tooling/level-instruction-counts.test.mjs tests/tooling/formatter-instruction-counts.test.ts"
      }
      new Dynamic {
        name = "Test default harness and client request windows"
        `if` = "env.MEASURE == 'true'"
        run = ci.workflowScript("test-default-harness-and-client-request-windows.sh")
      }
      new Dynamic {
        name = "Measure original formatter routines three times without Criterion sampling"
        `if` = "env.MEASURE == 'true'"
        run = #"node tools/benchmarks/scripts/instruction-counts.mjs --formatter --collect --out "${RUNNER_TEMP}/formatter-instruction-counts""#
      }
      new Dynamic {
        name = "Measure each stage three times without Criterion sampling"
        `if` = "env.MEASURE == 'true'"
        run = #"node tools/benchmarks/scripts/instruction-counts.mjs --collect --out "${RUNNER_TEMP}/instruction-counts""#
      }
      new Dynamic {
        name = "Verify pinned registry and immutable base ratchet"
        env {
          BASE_SHA = "${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha }}"
        }
        run = ci.workflowScript("verify-pinned-registry-and-immutable-base-ratchet.sh")
      }
      new Dynamic {
        name = "Enforce pinned ceilings"
        `if` = "env.MEASURE == 'true'"
        run = ci.workflowScript("enforce-pinned-ceilings.sh")
      }
      new Dynamic {
        name = "Enforce original formatter ceilings"
        `if` = "env.MEASURE == 'true'"
        run = ci.workflowScript("enforce-original-formatter-ceilings.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ always() && env.MEASURE == 'true' }}"
        with {
          name = "instruction-counts-${{ github.sha }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/instruction-counts"
          `if-no-files-found` = "warn"
          `retention-days` = 30
        }
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ always() && env.MEASURE == 'true' }}"
        with {
          name = "formatter-instruction-counts-${{ github.sha }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/formatter-instruction-counts"
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }

  `sfc-parse` {
    name = "Template-only SFC instruction parity"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/level-instruction-counts"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Install measurement tools"
        run = ci.workflowScript("install-measurement-tools.sh")
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "sfc-instructions-v1"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Verify native descriptor compatibility"
        run = ci.workflowScript("verify-native-descriptor-compatibility.sh")
      }
      new Dynamic {
        name = "Measure both parsers three times and enforce parity"
        run = ci.workflowScript("measure-both-parsers-three-times-and-enforce-parity.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "sfc-instructions-${{ github.sha }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/sfc-instructions"
          `if-no-files-found` = "warn"
        }
      }
    }
  }
}
