import "../../Actions.pkl" as ci

name = "Content mapper span allocation"
on {
  pull_request {
    paths = new Listing {
      "crates/vize_canon/src/batch/virtual_project/content_mapper/publish.rs"
      "crates/vize_canon/src/batch/virtual_project/content_mapper/span_normalize.rs"
      "tools/benchmarks/crates/vize/tests/content_mapper_span_profile.rs"
      "tools/benchmarks/scripts/content-mapper-span-profile.ts"
      "tools/benchmarks/scripts/cold-typechecker-scale-affinity.ts"
      "tools/benchmarks/scripts/content-mapper-span-profile.test.ts"
      ".github/workflows/content-mapper-span-allocation.yml"
      ".github/scripts/workflows/content-mapper-span-allocation/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "content-mapper-span-allocation-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  compare {
    `runs-on` = ci.linux
    `timeout-minutes` = 60
    env {

      SPAN_EVENT_BASE = "${{ github.event.pull_request.base.sha }}"
      SPAN_HEAD = "${{ github.event.pull_request.head.sha }}"
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RAYON_NUM_THREADS = "8"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("content-mapper-span-allocation")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.event.pull_request.head.sha }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        name = "Test the evidence oracle and build isolated before and after sources"
        run = #". "${{ env.VIZE_CI_FILES }}/test-the-evidence-oracle-and-build-isolated-before-and-after-sources.sh""#
      }
      new Dynamic {
        name = "Compare complete packets and fresh process measurements"
        run = #"node tools/benchmarks/scripts/content-mapper-span-profile.ts measure "$RUNNER_TEMP/span-evidence""#
      }
      new Dynamic {
        name = "Write every family result"
        `if` = "always()"
        run = #". "${{ env.VIZE_CI_FILES }}/write-every-family-result.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "content-mapper-span-allocation-${{ github.event.pull_request.head.sha }}"
          path = "${{ runner.temp }}/span-evidence"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
