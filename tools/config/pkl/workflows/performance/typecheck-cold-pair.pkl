import "../../Actions.pkl" as ci

name = "Type-check cold pair"
`run-name` = "Type-check cold pair ${{ inputs.head }} vs ${{ inputs.base }} (${{ inputs.projects }})"
// Two commits check the same generated projects cold on Linux, WSL2 (ext4 and
// the Windows mount) and native Windows, alternating builds per run.
on {
  workflow_dispatch {
    inputs {
      base {
        description = #"Full 40-hex commit measured first (the "before")"#
        type = "string"
        required = true
      }
      head {
        description = "Full 40-hex commit compared against it"
        type = "string"
        required = true
      }
      projects {
        description = "Comma-separated generated projects (vue:<sfcs> or monorepo:<sfcs>)"
        type = "string"
        ["default"] = "vue:1000,vue:5000,monorepo:5000"
      }
      runs {
        description = "Alternating recorded cold runs per build"
        type = "string"
        ["default"] = "5"
      }
      runtime {
        description = "Native checker host used by both builds"
        type = "choice"
        options = List("tsgo", "tsrs")
        ["default"] = "tsgo"
      }
      checkers {
        description = "Explicit checker width used by both builds"
        type = "choice"
        options = List("1", "8")
        ["default"] = "8"
      }
      strace {
        description = "Attribute filesystem calls per process, syscall and path on Linux"
        type = "boolean"
        ["default"] = true
      }
      platforms {
        description = "Comma-separated measured cells (linux, wsl2, windows)"
        type = "string"
        ["default"] = "linux,wsl2,windows"
      }
      allow_output_change {
        description = "Publish timing even when the builds report different diagnostics"
        type = "boolean"
        ["default"] = false
      }
    }
  }
  // Registers the dispatch-only workflow from its PR; only the tests run there.
  pull_request {
    paths = new Listing {
      ".github/workflows/typecheck-cold-pair.yml"
      ".github/scripts/workflows/typecheck-cold-pair/**"
      "tools/benchmarks/scripts/typecheck-cold-pair*.ts"
      "tests/tooling/typecheck-cold-pair.test.ts"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "typecheck-cold-pair-${{ github.event.pull_request.number || inputs.head }}-${{ inputs.base }}-${{ inputs.projects }}-${{ inputs.platforms }}-${{ inputs.runtime }}-${{ inputs.checkers }}"
  `cancel-in-progress` = true
}
env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  CARGO_TERM_COLOR = "always"
  CARGO_INCREMENTAL = "0"
}
jobs {
  test {
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic { run = "node --test tests/tooling/typecheck-cold-pair.test.ts" }
    }
  }

  // Each platform builds on its own, so Linux results do not wait for Windows.
  `build-linux` {
    `if` = "github.event_name == 'workflow_dispatch' && (contains(format(',{0},', inputs.platforms), ',linux,') || contains(format(',{0},', inputs.platforms), ',wsl2,'))"
    needs = "test"
    `runs-on` = ci.linux
    `timeout-minutes` = 90
    env {

      BASE = "${{ inputs.base }}"
      HEAD = "${{ inputs.head }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("typecheck-cold-pair")
      new Dynamic {
        name = "Validate inputs"
        shell = "bash"
        run = ci.workflowScript("validate-inputs.sh")
      }
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.rust("1.100.0")
      // The faster linker is optional: a failed release download falls back
      // to the default linker instead of failing the pair.
      new Dynamic {
        uses = ci.setupWild
        id = "wild"
        `continue-on-error` = true
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Drop a partial wild configuration"
        `if` = "steps.wild.outcome == 'failure'"
        run = ci.workflowScript("drop-a-partial-wild-configuration.sh")
      }
      new Dynamic {
        name = "Build both commits"
        shell = "bash"
        run = ci.workflowScript("build-both-commits.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        with {
          name = "cold-pair-bin-linux"
          path = "pair-bin/"
          `retention-days` = 7
        }
      }
    }
  }

  // Each platform builds on its own, so Linux results do not wait for Windows.
  `build-windows` {
    `if` = "github.event_name == 'workflow_dispatch' && contains(format(',{0},', inputs.platforms), ',windows,')"
    needs = "test"
    `runs-on` = ci.windows
    `timeout-minutes` = 90
    env {

      BASE = "${{ inputs.base }}"
      HEAD = "${{ inputs.head }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("typecheck-cold-pair")
      new Dynamic {
        name = "Validate inputs"
        shell = "bash"
        run = ci.workflowScript("validate-inputs.sh")
      }
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        name = "Setup MSVC toolchain"
        uses = "ilammy/msvc-dev-cmd@0b201ec74fa43914dc39ae48a89fd1d8cb592756"  // v1
        with { arch = "amd64" }
      }
      ci.rust("1.100.0")
      new Dynamic {
        name = "Build both commits"
        shell = "bash"
        run = ci.workflowScript("build-both-commits-2.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        with {
          name = "cold-pair-bin-windows"
          path = "pair-bin/"
          `retention-days` = 7
        }
      }
    }
  }

  linux {
    needs = "build-linux"
    `if` = "contains(format(',{0},', inputs.platforms), ',linux,')"
    `runs-on` = ci.linux
    `timeout-minutes` = 120
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/typecheck-cold-pair"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = ci.downloadArtifact
        with {
          name = "cold-pair-bin-linux"
          path = "pair-bin"
        }
      }
      new Dynamic {
        name = "Measure"
        env {
          PROJECTS = "${{ inputs.projects }}"
          RUNS = "${{ inputs.runs }}"
          RUNTIME = "${{ inputs.runtime }}"
          CHECKERS = "${{ inputs.checkers }}"
          ALLOW = "${{ inputs.allow_output_change && '--allow-output-change' || '' }}"
          STRACE = "${{ inputs.strace && '--strace' || '' }}"
        }
        run = ci.workflowScript("measure.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "cold-pair-linux"
          path = "${{ runner.temp }}/pair-out/"
          `if-no-files-found` = "warn"
        }
      }
    }
  }

  wsl2 {
    needs = "build-linux"
    `if` = "contains(format(',{0},', inputs.platforms), ',wsl2,')"
    // WSL2 needs nested virtualization; Blacksmith Windows runners lack it.
    `runs-on` = "windows-2025"
    `timeout-minutes` = 300
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/typecheck-cold-pair"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = "Vampire/setup-wsl@d1da7f2c0322a5ee4f24975344f67fc0f5baf364"  // v7.0.0
        with {
          distribution = "Ubuntu-24.04"
          `wsl-version` = "2"
          `wsl-shell-user` = "root"
          `additional-packages` = "ca-certificates curl time xz-utils"
        }
      }
      new Dynamic {
        uses = ci.downloadArtifact
        with {
          name = "cold-pair-bin-linux"
          path = "pair-bin"
        }
      }
      new Dynamic {
        name = "Resolve the Windows mount"
        shell = "pwsh"
        run = ci.workflowScript("resolve-the-windows-mount.ps1")
      }
      new Dynamic {
        name = "Install Node 24 in WSL2"
        shell = "wsl-bash {0}"
        env {
          WSLENV = "VIZE_CI_FILES/p"
        }
        run = ci.wslScript("install-node-24-in-wsl2.sh")
      }
      new Dynamic {
        name = "Measure ext4 and the Windows mount"
        shell = "wsl-bash {0}"
        env {
          WSLENV = "PROJECTS/u:RUNS/u:RUNTIME/u:CHECKERS/u:ALLOW/u:WSL_MOUNT_ROOT/u:GITHUB_STEP_SUMMARY/u:VIZE_CI_FILES/p"
          PROJECTS = "${{ inputs.projects }}"
          RUNS = "${{ inputs.runs }}"
          RUNTIME = "${{ inputs.runtime }}"
          CHECKERS = "${{ inputs.checkers }}"
          ALLOW = "${{ inputs.allow_output_change && '--allow-output-change' || '' }}"
        }
        run = ci.wslScript("measure-ext4-and-the-windows-mount.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "cold-pair-wsl2"
          path = "${{ runner.temp }}/vize-cold-pair/out/"
          `if-no-files-found` = "warn"
        }
      }
    }
  }

  windows {
    needs = "build-windows"
    `if` = "contains(format(',{0},', inputs.platforms), ',windows,')"
    `runs-on` = ci.windows
    `timeout-minutes` = 120
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/typecheck-cold-pair"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = ci.downloadArtifact
        with {
          name = "cold-pair-bin-windows"
          path = "pair-bin"
        }
      }
      new Dynamic {
        name = "Measure"
        shell = "pwsh"
        env {
          PROJECTS = "${{ inputs.projects }}"
          RUNS = "${{ inputs.runs }}"
          RUNTIME = "${{ inputs.runtime }}"
          CHECKERS = "${{ inputs.checkers }}"
          ALLOW = "${{ inputs.allow_output_change && '--allow-output-change' || '' }}"
        }
        run = ci.workflowScript("measure.ps1")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "cold-pair-windows"
          path = "${{ runner.temp }}/pair-out/"
          `if-no-files-found` = "warn"
        }
      }
    }
  }
}
