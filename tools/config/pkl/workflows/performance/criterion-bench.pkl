import "../../Actions.pkl" as ci

name = "Benchmark - Criterion suites"
on {
  workflow_dispatch {
    inputs {
      base_sha {
        description = "Full base commit SHA"
        required = true
        type = "string"
      }
      head_sha {
        description = "Full head commit SHA"
        required = true
        type = "string"
      }
      vapor_only {
        description = "Measure only the Davinci Vapor native/retained pairs"
        required = false
        ["default"] = false
        type = "boolean"
      }
      level_memory_only {
        description = "Compare all105 normal-mode allocation and RSS reports"
        required = false
        ["default"] = false
        type = "boolean"
      }
      production_only {
        description = "Measure whole-SFC shipping shapes on three independent reference runners"
        required = false
        ["default"] = false
        type = "boolean"
      }
    }
  }
}
concurrency {
  group = "criterion-bench-${{ inputs.base_sha }}-${{ inputs.head_sha }}-${{ inputs.production_only || false }}-${{ inputs.level_memory_only || false }}"
  `cancel-in-progress` = true
}
env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  // Relative comparisons stay report-only; existing absolute and dialect gates remain strict.
  CRITERION_AB_THRESHOLD = ""
  DIALECT_GUARD_FILE_COUNT = 400
  DIALECT_GUARD_THRESHOLD_PERCENT = 2
}
jobs {
  `criterion-ab` = import("../../parts/criterion-bench/criterion-ab.pkl")
  `dialect-guard` = import("../../parts/criterion-bench/dialect-guard.pkl")
  `production-pairs` = import("../../parts/criterion-bench/production-pairs.pkl")
  `production-summary` = import("../../parts/criterion-bench/production-summary.pkl")
  `level-memory` = import("../../parts/criterion-bench/level-memory.pkl")
}
