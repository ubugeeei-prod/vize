import "../../Actions.pkl" as ci

name = "Shipped Linux LSP resource comparison"

// Optional same-SHA supplement to davinci-resource-budgets.yml. The scheduled
// ci-opt gate and all its ceilings remain unchanged. A fat-LTO pass never
// substitutes for a failing ci-opt result.
on {
  workflow_call = null
}
permissions { contents = "read" }

jobs {
  release {
    name = "Fat-LTO TS-44 and production 10k SFCs"
    `runs-on` = ci.linux
    `timeout-minutes` = 60
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/lsp-release-resources"
      CARGO_TERM_COLOR = "always"
      NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
    }
    steps = new Listing {
      ci.use(ci.checkout)
      ci.workspaceVp()
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.command("Install the repository Rust toolchain", #". "${{ env.VIZE_CI_FILES }}/install-the-repository-rust-toolchain.sh""#)
      // Same default rust-lld, target, default features and fat release profile
      // as build-release-cli/action.yml. No CI profile or linker override.
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "lsp-release-resources"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        name = "Build the shipped Linux CLI recipe"
        run = #". "${{ env.VIZE_CI_FILES }}/build-the-shipped-linux-cli-recipe.sh""#
      }
      new Dynamic {
        name = "Record the measured binary and build identity"
        run = #"vp exec node tools/support/compat/davinci/lsp-build-identity.ts target/x86_64-unknown-linux-gnu/release/vize release "${RUNNER_TEMP}/release-build.jsonl" "${RUNNER_TEMP}/release-build-identity.json""#
      }
      new Dynamic {
        name = "Measure the complete TS-44 campaign with the shipped profile"
        run = #"rust-script tools/commands/davinci/resource-budgets.rs --measure --preset linux-x64-ci --runs 3 --keystrokes 20 --idle-seconds 60 --server target/x86_64-unknown-linux-gnu/release/vize --out "${RUNNER_TEMP}/release-resource.json""#
      }
      new Dynamic {
        name = "Apply every unchanged TS-44 ceiling to this additional build"
        run = #"rust-script tools/commands/davinci/resource-budgets.rs --check --measurement "${RUNNER_TEMP}/release-resource.json""#
      }
      new Dynamic {
        name = "Verify the protocol and controlled edit oracle"
        run = #"vp exec node tools/support/compat/davinci/lsp-resources.ts --server target/x86_64-unknown-linux-gnu/release/vize --build "release: fat LTO, one codegen unit" --files 2 --runs 1 --idle-seconds 10 --out "${RUNNER_TEMP}/release-lsp-resource-smoke.json""#
      }
      new Dynamic {
        name = "Measure 10000 open buffers, 16 production providers, and Corsa"
        run = #"timeout --signal=TERM --kill-after=30s 45m vp exec node tools/support/compat/davinci/lsp-resources.ts --server target/x86_64-unknown-linux-gnu/release/vize --build "release: fat LTO, one codegen unit" --files 10000 --warm-providers 16 --runs 1 --idle-seconds 10 --out "${RUNNER_TEMP}/release-lsp-resource.json""#
      }
      new Dynamic {
        name = "Summarize the separate release measurements"
        `if` = "${{ !cancelled() }}"
        run = #". "${{ env.VIZE_CI_FILES }}/summarize-the-separate-release-measurements.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ always() }}"
        with {
          name = "release-lsp-resources-linux-x64"
          path = """
          ${{ runner.temp }}/release-build-identity.json
          ${{ runner.temp }}/release-resource.json
          ${{ runner.temp }}/release-lsp-resource*.json

          """
          `retention-days` = 30
        }
      }
    }
  }
}
