import "../../Actions.pkl" as ci

name = "Release build cache"
// Populate trusted default-branch caches ahead of a release. This never tags,
// promotes, or publishes; dispatch also validates these exact build recipes.
on {
  workflow_dispatch = null
  workflow_call = null
  push {
    branches = List("main")
    paths = new Listing {
      "Cargo.toml"
      "Cargo.lock"
      "rust-toolchain.toml"
      ".cargo/**"
      "crates/**"
      "davinci/**"
      "npm/native/**"
      "npm/fresco-native/**"
      ".github/actions/build-release-*/**"
      ".github/actions/setup-rust-sticky-cache/**"
      ".github/actions/reuse-rust-target/**"
      ".github/workflows/release-build-cache.yml"
      "tools/support/github/release-platforms.ts"
      "tools/support/github/build-napi-package.ts"
      "tools/support/github/clean-node-binaries.ts"
    }
  }
  schedule = new Listing {
    new Dynamic { cron = "41 18 * * *" }
  }
}
concurrency {
  group = "release-build-cache-${{ github.ref }}"
  // Active warmers must finish before their trusted cache snapshots can be committed.
  `cancel-in-progress` = false
}
permissions { contents = "read" }
env {
  CARGO_INCREMENTAL = 0
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  // Build exactly what the next release builds: vize_carton reads this with
  // option_env!, and the version stamp changes every workspace crate, so a
  // warm disk without either rebuilt the whole workspace in each release.
  VIZE_RELEASE_BUILD = "1"
}
jobs {
  plan {
    `runs-on` = "ubuntu-24.04"
    `timeout-minutes` = 5
    outputs {
      cli = "${{ steps.plan.outputs.cli_matrix }}"
      native = "${{ steps.plan.outputs.native_matrix }}"
      version = "${{ steps.next.outputs.version }}"
    }
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        id = "plan"
        // Platform coverage is independent of the current workspace version.
        run = "node tools/support/github/release-platforms.ts github-output v0.0.0"
      }
      new Dynamic {
        id = "next"
        name = "Read the version the next release stamps"
        shell = "bash"
        run = #"""
        set -euo pipefail
        version=$(node tools/support/release/release/main.ts next)
        printf 'version=%s\n' "$version" >> "$GITHUB_OUTPUT"

        """#
      }
    }
  }
  cli {
    name = "Cache CLI - ${{ matrix.settings.target }}"
    needs = "plan"
    `runs-on` = "${{ matrix.settings.host }}"
    `timeout-minutes` = 30
    strategy {
      `fail-fast` = false
      matrix { settings = "${{ fromJSON(needs.plan.outputs.cli) }}" }
    }
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Stamp the next release version like the release candidate"
        shell = "bash"
        env { NEXT_VERSION = "${{ needs.plan.outputs.version }}" }
        run = #"node tools/support/release/release/main.ts stamp "$NEXT_VERSION""#
      }
      new Dynamic {
        uses = "./.github/actions/build-release-cli"
        with {
          target = "${{ matrix.settings.target }}"
          archive = "${{ matrix.settings.archive }}"
          `release-version` = "${{ needs.plan.outputs.version }}"
          `upload-artifacts` = "false"
        }
      }
    }
  }
  native {
    name = "Cache native - ${{ matrix.settings.target }}"
    needs = "plan"
    `runs-on` = "${{ matrix.settings.host }}"
    `timeout-minutes` = 30
    strategy {
      `fail-fast` = false
      matrix { settings = "${{ fromJSON(needs.plan.outputs.native) }}" }
    }
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Stamp the next release version like the release candidate"
        shell = "bash"
        env { NEXT_VERSION = "${{ needs.plan.outputs.version }}" }
        run = #"node tools/support/release/release/main.ts stamp "$NEXT_VERSION""#
      }
      new Dynamic {
        uses = "./.github/actions/build-release-native"
        with {
          target = "${{ matrix.settings.target }}"
          `cross-compile` = "${{ matrix.settings.cross_compile }}"
          `release-version` = "${{ needs.plan.outputs.version }}"
          `upload-artifacts` = "false"
        }
      }
    }
  }
}
