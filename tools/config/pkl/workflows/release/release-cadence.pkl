import "../../../../ci/lib/Actions.pkl" as ci

name = "Release cadence"
// Starts a release on its own. After every completed Check or Release on main
// (and on a 15-minute fallback schedule, which GitHub often delays or drops)
// `main.ts cadence` picks the newest main commit whose push Check passed and
// dispatches release.yml for it when fix/feat/perf commits landed since the last
// release, at most once per 10 minutes, never retrying a commit whose release
// candidate already failed. Re-deciding when a Release completes picks up fixes
// that landed while it ran. It dispatches instead of
// releasing in place because crates.io trusted publishing refuses workflow_run
// and schedule triggers. It dispatches as the maintainer: JSR only accepts
// OIDC publishes whose actor is a scope member, never github-actions[bot].
on {
  workflow_run {
    workflows = List("Check", "Release")
    types = List("completed")
    branches = List("main")
  }
  schedule = new Listing {
    new Dynamic { cron = "8,23,38,53 * * * *" }
  }
}
permissions { contents = "read" }
concurrency {
  group = "release-cadence"
  `cancel-in-progress` = true
}
env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }
jobs {
  cadence {
    `if` = "github.repository == 'ubugeeei-prod/vize'"
    name = "Decide whether a release is due"
    `runs-on` = "ubuntu-24.04"
    `timeout-minutes` = 5
    permissions {
      contents = "read"
      actions = "read"
    }
    outputs {
      release = "${{ steps.cadence.outputs.release }}"
      sha = "${{ steps.cadence.outputs.sha }}"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Decide"
        id = "cadence"
        env { GITHUB_TOKEN = "${{ github.token }}" }
        run = "node tools/support/release/release/main.ts cadence"
      }
    }
  }
  dispatch {
    needs = "cadence"
    `if` = "needs.cadence.outputs.release == 'true'"
    name = "Dispatch release.yml"
    `runs-on` = "ubuntu-24.04"
    `timeout-minutes` = 5
    environment = "release-operator"
    steps = new Listing {
      new Dynamic {
        name = "Dispatch release.yml"
        env {
          GH_TOKEN = "${{ secrets.RELEASE_OPERATOR_TOKEN }}"
          RELEASE_SOURCE = "${{ needs.cadence.outputs.sha }}"
        }
        run = #"gh workflow run release.yml --repo "$GITHUB_REPOSITORY" --ref main -f source="$RELEASE_SOURCE""#
      }
    }
  }
}
