import "../../Actions.pkl" as ci

name = "Public typechecker consumer"
on {
  workflow_dispatch {
    inputs {
      consumer {
        type = "choice"
        ["default"] = "legacy-0.602"
        options = new Listing {
          "legacy-0.602"
          "package-import-redirects-11317"
          "options-inherited-members-11339"
          "q16-first-subset"
        }
        description = "Closed public consumer role"
      }
    }
  }
  pull_request {
    paths = new Listing {
      "tools/benchmarks/scripts/public-typechecker-q16/**"
      "tests/tooling/public-typechecker-q16*.test.ts"
      ".github/workflows/public-typechecker-consumer.yml"
      ".github/scripts/workflows/public-typechecker-consumer/**"
      "tools/benchmarks/scripts/public-typechecker-consumer.ts"
      "tests/_fixtures/differential/typechecker/dependency-probe-history-10936/**"
      "tools/benchmarks/scripts/public-typechecker-11317/**"
      "tests/tooling/public-typechecker-11317*.test.ts"
      "tools/benchmarks/scripts/public-typechecker-11339/**"
      "tests/tooling/public-typechecker-11339*.test.ts"
      "tests/_fixtures/differential/typechecker/package-import-redirects-11317/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "public-typechecker-consumer-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = false
}
jobs {
  public {
    `if` = "github.event_name != 'workflow_dispatch' || inputs.consumer == 'legacy-0.602'"
    `runs-on` = "blacksmith-8vcpu-ubuntu-2404"
    `timeout-minutes` = 20
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/public-typechecker-consumer"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Install a fresh public 0.602 consumer"
        shell = "bash"
        run = #". "${{ env.VIZE_CI_FILES }}/install-a-fresh-public-0-602-consumer.sh""#
      }
      new Dynamic {
        name = "Verify the published standalone archive"
        shell = "bash"
        run = #". "${{ env.VIZE_CI_FILES }}/verify-the-published-standalone-archive.sh""#
      }
      new Dynamic {
        name = "Run complete public mutation and repair packets"
        shell = "bash"
        run = #". "${{ env.VIZE_CI_FILES }}/run-complete-public-mutation-and-repair-packets.sh""#
      }
      new Dynamic {
        name = "Package only owned evidence"
        `if` = "always()"
        shell = "bash"
        run = #". "${{ env.VIZE_CI_FILES }}/package-only-owned-evidence.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "public-typechecker-0.602-${{ github.sha }}"
          path = "${{ runner.temp }}/public-acceptance.tgz"
          `retention-days` = 14
        }
      }
    }
  }
  `contracts-11317` {
    `runs-on` = "blacksmith-8vcpu-ubuntu-2404"
    `timeout-minutes` = 10
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.22.1"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Check the closed npm role without executing a public package"
        run = "node --test tests/tooling/public-typechecker-11317*.test.ts"
      }
    }
  }
  `public-11317` {
    permissions {
      contents = "read"
      actions = "read"
    }
    `if` = "github.event_name == 'workflow_dispatch' && inputs.consumer == 'package-import-redirects-11317' && github.repository == 'ubugeeei-prod/vize'"
    needs = "contracts-11317"
    `runs-on` = "blacksmith-8vcpu-ubuntu-2404"
    `timeout-minutes` = 30
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/public-typechecker-consumer"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.22.1"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Provision the reported npm version separately"
        shell = "bash"
        run = #". "${{ env.VIZE_CI_FILES }}/provision-the-reported-npm-version-separately.sh""#
      }
      new Dynamic {
        name = "Retain the original command and all nine JSON vectors for each public version"
        env { GITHUB_TOKEN = "${{ github.token }}" }
        run = #"node tools/benchmarks/scripts/public-typechecker-11317/run.ts --out "$RUNNER_TEMP/public-11317-evidence" --npm "$RUNNER_TEMP/11317-manager/node_modules/npm/bin/npm-cli.js" --npx "$RUNNER_TEMP/11317-manager/node_modules/npm/bin/npx-cli.js""#
      }
      new Dynamic {
        name = "Package only owned data"
        `if` = "always()"
        shell = "bash"
        run = #". "${{ env.VIZE_CI_FILES }}/package-only-owned-data.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "public-typechecker-11317-${{ github.sha }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/public-11317-evidence.tgz"
          `retention-days` = 14
        }
      }
    }
  }
  `contracts-11339` {
    `runs-on` = "blacksmith-8vcpu-ubuntu-2404"
    `timeout-minutes` = 10
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.22.1"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Validate immutable inputs and refusal contracts without public execution"
        run = "node --test tests/tooling/public-typechecker-11339*.test.ts"
      }
    }
  }
  `public-11339` {
    permissions {
      contents = "read"
      actions = "read"
    }
    `if` = "github.event_name == 'workflow_dispatch' && inputs.consumer == 'options-inherited-members-11339' && github.repository == 'ubugeeei-prod/vize' && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/test/published-options-inherited-members-11339-20261102')"
    needs = "contracts-11339"
    `runs-on` = "blacksmith-8vcpu-ubuntu-2404"
    `timeout-minutes` = 45
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/public-typechecker-consumer"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.22.1"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Provision the declared standalone manager control"
        run = #"npm install --prefix "$RUNNER_TEMP/11339-manager" npm@11.19.1 --ignore-scripts --no-audit --no-fund"#
      }
      new Dynamic {
        name = "Capture all default CLI and independent framework controls"
        env { GITHUB_TOKEN = "${{ github.token }}" }
        run = #"node tools/benchmarks/scripts/public-typechecker-11339/run.ts --out "$RUNNER_TEMP/public-11339-evidence" --npm "$RUNNER_TEMP/11339-manager/node_modules/npm/bin/npm-cli.js" --npx "$RUNNER_TEMP/11339-manager/node_modules/npm/bin/npx-cli.js""#
      }
      new Dynamic {
        name = "Package owned data after success or refusal"
        `if` = "always()"
        shell = "bash"
        run = #". "${{ env.VIZE_CI_FILES }}/package-owned-data-after-success-or-refusal.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "public-typechecker-11339-${{ github.sha }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/public-11339-evidence.tgz"
          `retention-days` = 14
        }
      }
    }
  }
  `contracts-q16` {
    `runs-on` = "${{ github.event_name == 'workflow_dispatch' && inputs.consumer == 'q16-first-subset' && (github.ref == 'refs/heads/test/published-generic-arrow-tsx-20261103' || github.ref == 'refs/heads/test/published-global-component-listener-11373-20261103') && 'ubuntu-24.04' || 'blacksmith-8vcpu-ubuntu-2404' }}"
    `timeout-minutes` = 10
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "26.13.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Validate the closed subset and raw-first refusal contracts without public execution"
        run = "node --test tests/tooling/public-typechecker-q16*.test.ts"
      }
    }
  }
  `public-q16` {
    permissions {
      contents = "read"
      actions = "read"
    }
    `if` = "github.event_name == 'workflow_dispatch' && inputs.consumer == 'q16-first-subset' && github.repository == 'ubugeeei-prod/vize' && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/test/published-q16-first-subset-20261102' || github.ref == 'refs/heads/test/published-commented-vif-11378-20261102' || github.ref == 'refs/heads/test/published-emits-11390-11391-20261102' || github.ref == 'refs/heads/test/published-static-template-ref-11377-20261102' || github.ref == 'refs/heads/test/published-generic-arrow-tsx-20261103' || github.ref == 'refs/heads/test/published-global-component-listener-11373-20261103')"
    needs = "contracts-q16"
    `runs-on` = "${{ github.event_name == 'workflow_dispatch' && inputs.consumer == 'q16-first-subset' && (github.ref == 'refs/heads/test/published-generic-arrow-tsx-20261103' || github.ref == 'refs/heads/test/published-global-component-listener-11373-20261103') && 'ubuntu-24.04' || 'blacksmith-8vcpu-ubuntu-2404' }}"
    `timeout-minutes` = 40
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/public-typechecker-consumer"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "${{ (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/test/published-global-component-listener-11373-20261103') && '26.12.1' || '26.13.0' }}"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Provision the explicit manager control separately from original npm i"
        run = #"npm install --prefix "$RUNNER_TEMP/q16-manager" npm@11.19.1 --ignore-scripts --no-audit --no-fund"#
      }
      new Dynamic {
        name = "Retain every selected original and wrong repair control before assessment"
        env { GITHUB_TOKEN = "${{ github.token }}" }
        run = #"node tools/benchmarks/scripts/public-typechecker-q16/run.ts --out "$RUNNER_TEMP/public-q16-evidence" --npm "$RUNNER_TEMP/q16-manager/node_modules/npm/bin/npm-cli.js" --npx "$RUNNER_TEMP/q16-manager/node_modules/npm/bin/npx-cli.js""#
      }
      new Dynamic {
        name = "Package only owned evidence after capture or refusal"
        `if` = "always()"
        shell = "bash"
        run = #". "${{ env.VIZE_CI_FILES }}/package-only-owned-evidence-after-capture-or-refusal.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "public-typechecker-q16-${{ github.sha }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/public-q16-evidence.tgz"
          `retention-days` = 14
        }
      }
    }
  }
}
