import "../../../../ci/lib/Actions.pkl" as ci

name = "Release smoke contracts"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/release-smoke-contracts.yml"
      ".github/scripts/workflows/release-smoke-contracts/**"
      ".github/workflows/release.yml"
      ".github/scripts/workflows/release/**"
      ".github/actions/release-npm-artifacts/**"
      ".github/actions/setup-runtime-package-managers/**"
      "tools/commands/release/npm/smoke-release-install.ts"
      "tools/support/release/smoke_release_install/**"
      "tools/support/command-invocation.ts"
      "tools/support/compat/npm/smoke-*"
      "tools/support/compat/github/legacy-fix-fixture-report.ts"
      "tools/support/compat/github/native-beta-dto-fixtures.ts"
      "tools/support/compat/github/report-legacy-fix-fixtures.ts"
      "npm/cli/**"
      "npm/native/**"
      "npm/builder/vite/**"
      "npm/linter/oxlint/**"
      "crates/vize_carton/src/config/loader/js/runtime_file.rs"
      "crates/vize_carton/src/config/loader/js/runtime_file/tests.rs"
      "tests/tooling/release/release-smoke-*"
      "tests/tooling/legacy-fix-fixture-report.test.ts"
      "tests/tooling/support/release-smoke-*"
      "tests/tooling/github-workflows-release-build.test.ts"
      "tests/tooling/release/release-workflow.test.ts"
      "tests/tooling/native-build-token.test.ts"
      "tests/tooling/native-binding-identity.test.ts"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "release-smoke-contracts-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }
jobs {
  `bun-planner` {
    `if` = "${{ github.event_name != 'workflow_dispatch' }}"
    name = "Shared source planner on Bun 1.3.14"
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/release-smoke-contracts"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.use("./.github/actions/setup-runtime-package-managers")
      new Dynamic {
        name = "Execute the shared planner contract through Bun"
        shell = "bash"
        run = ci.workflowScript("execute-the-shared-planner-contract-through-bun.sh")
      }
      new Dynamic {
        name = "Retain Bun planner timing and RSS"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "bun-planner-performance"
          path = "${{ runner.temp }}/bun-planner-*.txt"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }

  `node-planner-baseline` {
    `if` = "${{ github.event_name != 'workflow_dispatch' }}"
    name = "Shared source planner on Node 24.14.0"
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/release-smoke-contracts"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.use("./.github/actions/setup-runtime-package-managers")
      new Dynamic {
        name = "Execute the shared planner baseline through Node"
        shell = "bash"
        run = ci.workflowScript("execute-the-shared-planner-baseline-through-node.sh")
      }
      new Dynamic {
        name = "Retain Node planner timing and RSS"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "node-planner-performance"
          path = "${{ runner.temp }}/node-planner-*.txt"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }

  `bun-products` {
    `if` = "${{ github.event_name != 'workflow_dispatch' }}"
    name = "Packed products on Bun 1.3.14"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/release-smoke-contracts"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.use("./.github/actions/setup-runtime-package-managers")
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "bun-products"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        name = "Install product build dependencies"
        shell = "bash"
        run = ci.workflowScript("install-product-build-dependencies.sh")
      }
      new Dynamic {
        name = "Build native provider and Bun-facing packages"
        shell = "bash"
        run = ci.workflowScript("build-native-provider-and-bun-facing-packages.sh")
      }
      new Dynamic {
        name = "Compare packed Node and Bun product behavior"
        shell = "bash"
        run = ci.workflowScript("compare-packed-node-and-bun-product-behavior.sh")
      }
    }
  }

  contracts {
    `if` = "${{ github.event_name != 'workflow_dispatch' }}"
    name = "Release smoke contracts (${{ matrix.os }})"
    `runs-on` = "${{ matrix.os }}"
    `timeout-minutes` = 15
    strategy {
      `fail-fast` = false
      matrix {
        os = new Listing {
          ci.linux
          "${{ vars.VIZE_RELEASE_MACOS_RUNNER || 'blacksmith-12vcpu-macos-15' }}"
          ci.windows
        }
      }
    }
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/release-smoke-contracts"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.use("./.github/actions/setup-runtime-package-managers")
      ci.rust("stable")
      new Dynamic {
        uses = "Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32"  // v2
        with {
          `shared-key` = "config-runtime-storage-${{ runner.os }}-${{ runner.arch }}"
          `cache-workspace-crates` = "true"
        }
      }
      new Dynamic {
        name = "Verify owned config runtime storage and locking"
        shell = "bash"
        run = "cargo test --locked -p vize_carton --lib runtime_file::tests -- --nocapture"
      }
      new Dynamic {
        name = "Measure config runtime storage lifecycle"
        `if` = "runner.os == 'Linux'"
        shell = "bash"
        run = ci.workflowScript("measure-config-runtime-storage-lifecycle.sh")
      }
      new Dynamic {
        name = "Retain config runtime storage counts and timings"
        `if` = "${{ !cancelled() && runner.os == 'Linux' }}"
        uses = ci.uploadArtifact
        with {
          name = "config-runtime-storage-${{ github.sha }}-${{ github.run_attempt }}-${{ runner.os }}"
          path = """
          ${{ runner.temp }}/config-runtime-*.json
          ${{ runner.temp }}/config-runtime-*.time.txt

          """
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
      new Dynamic {
        name = "Install source contract dependencies"
        shell = "bash"
        run = "vp install --frozen-lockfile --prefer-offline --filter vize-workspace --filter '@vize/tests' --filter '@vize/tools' --ignore-scripts"
      }
      new Dynamic {
        name = "Require the stable Node release smoke contracts"
        shell = "bash"
        run = ci.workflowScript("require-the-stable-node-release-smoke-contracts.sh")
      }
      new Dynamic {
        name = "Require installed public native image and existing image-token laws"
        shell = "bash"
        run = ci.workflowScript("require-installed-public-native-image-and-existing-image.sh")
      }
      new Dynamic {
        name = "Require release caller and fresh-project workflow wiring"
        shell = "bash"
        run = ci.workflowScript("require-release-caller-and-fresh-project-workflow-wiring.sh")
      }
    }
  }

  `wasm-smoke-diagnostic` {
    name = "Actual WASM package smoke (private diagnostic)"
    `if` = "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/diag/wasm-smoke-13711-20261126' }}"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {
      CARGO_INCREMENTAL = "0"
      VIZE_RELEASE_BUILD = "1"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.sha }}"
          `fetch-depth` = 2
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "stable"
          targets = "wasm32-unknown-unknown"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          `reuse-target` = "true"
          `restore-trusted` = "true"
          key = "release-wasm"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        uses = "taiki-e/install-action@184183c2401be73c3bf42c2e61268aa5855379c1"
        with { tool = "wasm-bindgen-cli@0.2.129" }
      }
      ci.command("Build and smoke the unchanged source WASM package", "node tools/diagnostics/wasm-smoke-13711.ts")
      new Dynamic {
        name = "Retain source, binary and command receipts"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "wasm-smoke-13711-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/vize-wasm-smoke-13711/"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
