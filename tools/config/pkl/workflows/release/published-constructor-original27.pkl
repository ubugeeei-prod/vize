import "../../Actions.pkl" as ci

name = "Published original constructor 27"

on {
  pull_request {
    paths = new Listing {
      ".github/workflows/published-constructor-original27.yml"
      ".github/scripts/workflows/published-constructor-original27/**"
      "tools/support/release/constructor_original27_public/**"
      "tests/tooling/release/constructor-original27-public.test.ts"
      "tests/tooling/release/constructor-original27-stderr.test.ts"
      "tests/tooling/release/constructor-original27-zero-debt.test.ts"
    }
  }
  workflow_dispatch {
    inputs {
      version {
        description = "Exact containing public version (0.650.0)"
        type = "string"
        required = true
      }
      release_run {
        description = "Successful official Release producer run"
        type = "string"
        required = true
      }
      authority_blob {
        description = "Immutable authenticated producer receipt and npm SRI capsule Git blob"
        type = "string"
        required = true
      }
    }
  }
}

permissions { contents = "read" }
concurrency {
  group = "published-original27-${{ github.event.pull_request.number || github.ref }}-${{ inputs.version || 'contracts' }}"
  `cancel-in-progress` = false
}
env {
  SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  NODE_DISABLE_COMPILE_CACHE = "1"
}
defaults {
  run { shell = "bash" }
}

jobs {
  contracts {
    name = "Frozen original population and public authority controls"
    `runs-on` = "blacksmith-8vcpu-ubuntu-2404"
    `timeout-minutes` = 5
    steps = new Listing {
      ci.checkoutAt("${{ env.SOURCE_SHA }}")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.14.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Require whole zero-debt vectors, authored negatives, registry custody and repair isolation"
        run = "node --test tests/tooling/release/constructor-original27-public.test.ts tests/tooling/release/constructor-original27-stderr.test.ts tests/tooling/release/constructor-original27-zero-debt.test.ts tests/tooling/release/human-reports-11252-11253-native-prerequisite.test.ts"
      }
    }
  }

  `installed-public` {
    name = "Original Linux public 27 cases and separate repair copy"
    `if` = "github.event_name == 'workflow_dispatch' && github.repository == 'ubugeeei-prod/vize' && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/test/published-constructor-original27-zero-debt-20261103')"
    needs = "contracts"
    permissions {
      contents = "read"
      actions = "read"
    }
    `runs-on` = "blacksmith-8vcpu-ubuntu-2404"
    `timeout-minutes` = 25
    steps = new Listing {
      ...ci.stageWorkflowScripts("published-constructor-original27")
      ci.checkoutAt("${{ env.SOURCE_SHA }}")
      new Dynamic {
        name = "Obtain immutable historical fixtures separately from installed products"
        uses = ci.checkout
        with {
          ref = "a8ce1ec166a53b380e74dbf7189cc8578c80c676"
          path = ".original27-fixtures"
          `persist-credentials` = false
          `sparse-checkout-cone-mode` = false
          `sparse-checkout` = """
          /package.json
          /tools/support/compat/content-mapper/constructor-overload-original27.ts
          /tests/_fixtures/differential/typechecker/constructor-overload-11023-original27/

          """
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.14.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Isolate the unchanged fixture driver"
        run = #". "${{ env.VIZE_CI_FILES }}/isolate-the-unchanged-fixture-driver.sh""#
      }
      new Dynamic {
        name = "Fresh installed-public capture without source or package overlays"
        env {
          GITHUB_TOKEN = "${{ github.token }}"
          PUBLIC_VERSION = "${{ inputs.version }}"
          RELEASE_RUN = "${{ inputs.release_run }}"
          AUTHORITY_BLOB = "${{ inputs.authority_blob }}"
        }
        run = #"node tools/support/release/constructor_original27_public/run.ts "$PUBLIC_VERSION" "$RELEASE_RUN" "$AUTHORITY_BLOB" "$RUNNER_TEMP/original27-fixtures" "$RUNNER_TEMP/original27-public""#
      }
      new Dynamic {
        name = "Preserve complete raw failures, authored files and installed SDK custody"
        `if` = "always()"
        run = #". "${{ env.VIZE_CI_FILES }}/preserve-complete-raw-failures-authored-files-and-installed-sdk-custody.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "original27-installed-public-${{ inputs.version }}-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/original27-public-raw.tgz"
          `if-no-files-found` = "error"
          `retention-days` = 90
        }
      }
    }
  }
}
