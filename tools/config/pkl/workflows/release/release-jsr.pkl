import "../../../../ci/lib/Actions.pkl" as ci

name = "Release JSR"
// Publishes every npm release package to JSR at the same exact version, then
// installs the compatibility facade from JSR in fresh Node, Deno and Bun projects.
// release-verify.yml dispatches it as the maintainer once npm is verified.
// Every release runs the publish dry-run against the just-published npm
// packages. The real publication and the consumers wait for
// `jsr/vize/channel.json` to enable them.
on {
  workflow_dispatch {
    inputs {
      version {
        description = "Published npm release version or tag"
        required = true
        type = "string"
      }
      source_sha {
        description = "Release source commit (default the dispatched commit)"
        required = false
        ["default"] = ""
        type = "string"
      }
      backfill_existing_npm_release {
        description = "Publish facades for an older exact npm release after registry verification"
        required = false
        ["default"] = false
        type = "boolean"
      }
    }
  }
}
`run-name` = "Release JSR ${{ inputs.version }}"
permissions { contents = "read" }
concurrency {
  group = "release-jsr-${{ inputs.version }}"
  `cancel-in-progress` = false
}
jobs {
  channel {
    name = "Read the JSR channel"
    `runs-on` = "ubuntu-24.04"
    `timeout-minutes` = 5
    outputs {
      enabled = "${{ steps.channel.outputs.enabled }}"
      packages = "${{ steps.packages.outputs.packages }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("release-jsr")
      ci.checkoutAt("${{ inputs.source_sha || github.sha }}")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        id = "channel"
        run = ci.workflowScript("channel.sh")
      }
      new Dynamic {
        id = "packages"
        run = ci.workflowScript("packages.sh")
      }
    }
  }
  publish {
    name = "Publish the JSR package"
    needs = "channel"
    `runs-on` = "ubuntu-24.04"
    // 0.496.0-0.504.0 were accepted while `deno publish` kept polling until the
    // old 75-minute job limit. Bound the CLI below that, but long enough for the
    // provenance POST after an acceptance that takes about ten minutes. A killed
    // poll (124) still continues into the public wait; a provenance rejection
    // does not.
    `timeout-minutes` = 140
    permissions {
      contents = "read"
      `id-token` = "write"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("release-jsr")
      ci.checkoutAt("${{ inputs.source_sha || github.sha }}")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = "denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed"  // v2
        with { `deno-version` = "2.9.7" }
      }
      new Dynamic {
        name = "Generate the package for the published npm release"
        `if` = "inputs.backfill_existing_npm_release != true"
        env { JSR_VERSION = "${{ inputs.version }}" }
        run = #"node tools/support/release/jsr/package.ts prepare "$RUNNER_TEMP/jsr-package" "$JSR_VERSION""#
      }
      new Dynamic {
        name = "Generate a registry-verified npm release backfill"
        `if` = "inputs.backfill_existing_npm_release == true"
        env { JSR_VERSION = "${{ inputs.version }}" }
        run = #"node tools/support/release/jsr/package.ts prepare-backfill "$RUNNER_TEMP/jsr-package" "$JSR_VERSION""#
      }
      new Dynamic {
        name = "Check the publication graph and public types"
        `working-directory` = "${{ runner.temp }}/jsr-package"
        run = "deno publish --dry-run --config jsr.json"
      }
      new Dynamic {
        name = "Publish through the repository's JSR OIDC link"
        `if` = "needs.channel.outputs.enabled == 'true'"
        `working-directory` = "${{ runner.temp }}/jsr-package"
        env { JSR_VERSION = "${{ inputs.version }}" }
        run = ci.workflowScript("publish-through-the-repository-s-jsr-oidc-link.sh")
      }
      new Dynamic {
        name = "Wait for the immutable public JSR version"
        `if` = "needs.channel.outputs.enabled == 'true'"
        env { JSR_VERSION = "${{ inputs.version }}" }
        run = #"node tools/support/release/jsr/package.ts wait-public "${JSR_VERSION#v}""#
      }
    }
  }
  `publish-packages` {
    name = "Publish JSR package (${{ matrix.jsrName }})"
    needs = "channel"
    strategy {
      `fail-fast` = false
      matrix = "${{ fromJSON(needs.channel.outputs.packages) }}"
    }
    `runs-on` = "ubuntu-24.04"
    `timeout-minutes` = 140
    permissions {
      contents = "read"
      `id-token` = "write"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("release-jsr")
      ci.checkoutAt("${{ inputs.source_sha || github.sha }}")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = "denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed"  // v2
        with { `deno-version` = "2.9.7" }
      }
      new Dynamic {
        name = "Generate the package for the published npm release"
        `if` = "inputs.backfill_existing_npm_release != true"
        env {
          JSR_PACKAGE = "${{ matrix.jsrName }}"
          JSR_VERSION = "${{ inputs.version }}"
        }
        run = #"node tools/support/release/jsr/package.ts prepare-one "$RUNNER_TEMP/jsr-package" "$JSR_PACKAGE" "$JSR_VERSION""#
      }
      new Dynamic {
        name = "Generate a registry-verified npm release backfill"
        `if` = "inputs.backfill_existing_npm_release == true"
        env {
          JSR_PACKAGE = "${{ matrix.jsrName }}"
          JSR_VERSION = "${{ inputs.version }}"
        }
        run = #"node tools/support/release/jsr/package.ts prepare-backfill-one "$RUNNER_TEMP/jsr-package" "$JSR_PACKAGE" "$JSR_VERSION""#
      }
      new Dynamic {
        name = "Check the publication graph and public types"
        `working-directory` = "${{ runner.temp }}/jsr-package"
        run = "deno publish --dry-run --config jsr.json"
      }
      new Dynamic {
        name = "Publish through the package's repository OIDC link"
        `if` = "needs.channel.outputs.enabled == 'true'"
        `working-directory` = "${{ runner.temp }}/jsr-package"
        env {
          JSR_PACKAGE = "${{ matrix.jsrName }}"
          JSR_VERSION = "${{ inputs.version }}"
        }
        run = ci.workflowScript("publish-through-the-package-s-repository-oidc-link.sh")
      }
      new Dynamic {
        name = "Wait for the immutable public JSR version"
        `if` = "needs.channel.outputs.enabled == 'true'"
        env {
          JSR_PACKAGE = "${{ matrix.jsrName }}"
          JSR_VERSION = "${{ inputs.version }}"
        }
        run = #"node tools/support/release/jsr/package.ts wait-public "$JSR_PACKAGE" "${JSR_VERSION#v}""#
      }
    }
  }
  consumer {
    name = "JSR consumer (${{ matrix.runtime }}, ${{ matrix.os }})"
    needs = List("channel", "publish", "publish-packages")
    `if` = "needs.channel.outputs.enabled == 'true'"
    strategy {
      `fail-fast` = false
      matrix {
        include = new Listing {
          new Dynamic {
            os = "ubuntu-24.04"
            runtime = "node"
            node = "22"
          }
          new Dynamic {
            os = "ubuntu-24.04"
            runtime = "node"
            node = "24"
          }
          new Dynamic {
            os = ci.macos
            runtime = "node"
            node = "24"
          }
          new Dynamic {
            os = ci.windows
            runtime = "node"
            node = "24"
          }
          new Dynamic {
            os = "ubuntu-24.04"
            runtime = "deno"
            node = "24"
          }
          new Dynamic {
            os = "ubuntu-24.04"
            runtime = "bun"
            node = "24"
          }
        }
      }
    }
    `runs-on` = "${{ matrix.os }}"
    `timeout-minutes` = 20
    defaults {
      run { shell = "bash" }
    }
    env {

      JSR_VERSION = "${{ inputs.version }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("release-jsr")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ inputs.source_sha || github.sha }}"
          `persist-credentials` = false
          `sparse-checkout` = """
          tools/support/release/jsr/consumer.ts
          tools/support/release/jsr/consumer-deno.json

          """
          `sparse-checkout-cone-mode` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "${{ matrix.node }}"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        `if` = "matrix.runtime == 'deno'"
        uses = "denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed"  // v2
        with { `deno-version` = "2.9.7" }
      }
      new Dynamic {
        `if` = "matrix.runtime == 'bun'"
        uses = ci.setupBun
        with { `bun-version` = "1.3.14" }
      }
      new Dynamic {
        name = "Create a fresh consumer project"
        run = ci.workflowScript("create-a-fresh-consumer-project.sh")
      }
      new Dynamic {
        name = "Install from JSR and import every entry point (Node)"
        `if` = "matrix.runtime == 'node'"
        `working-directory` = "${{ runner.temp }}/consumer"
        run = ci.workflowScript("install-from-jsr-and-import-every-entry-point-node.sh")
      }
      new Dynamic {
        name = "Install from JSR and import every entry point (Bun)"
        `if` = "matrix.runtime == 'bun'"
        `working-directory` = "${{ runner.temp }}/consumer"
        run = ci.workflowScript("install-from-jsr-and-import-every-entry-point-bun.sh")
      }
      new Dynamic {
        name = "Import the published entry points (Deno)"
        `if` = "matrix.runtime == 'deno'"
        `working-directory` = "${{ runner.temp }}/consumer"
        run = ci.workflowScript("import-the-published-entry-points-deno.sh")
      }
    }
  }
}
