import "../../Actions.pkl" as ci

name = "SFC runtime option transport"

on {
  pull_request {
    paths = new Listing {
      ".github/workflows/native-sfc-runtime-options.yml"
      ".github/scripts/workflows/native-sfc-runtime-options/**"
      ".github/actions/setup-rust-script/**"
      ".github/actions/setup-wild-http-recovery/**"
      "crates/vize_vitrine/src/napi/sfc.rs"
      "crates/vize_vitrine/src/napi/sfc/**"
      "crates/vize_atelier_core/src/codegen/**"
      "crates/vize_atelier_sfc/src/**"
      "crates/vize_atelier_ssr/src/**"
      "crates/vize_atelier_vapor/src/**"
      "davinci/vize_l0/src/js_string.rs"
      "davinci/vize_l4/src/targets/dom/artifact/**"
      "tests/tooling/native-sfc-runtime-options.test.mjs"
      "tests/tooling/support/script-setup-default-expose.ts"
      "tests/tooling/support/setup-component-bracket-reference.ts"
      "tests/tooling/support/typescript-erasure-reference.ts"
      "tests/_fixtures/differential/compiler/sfc-runtime-options-native/**"
      "npm/native/**"
      "crates/vize_vitrine/src/napi/**"
      "Cargo.lock"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "sfc-runtime-options-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

jobs {
  `native-runtime-options-baseline` {
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    env {

      CARGO_BUILD_JOBS = "12"
      CARGO_TERM_COLOR = "always"
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
      RAYON_NUM_THREADS = "4"
      SOURCE_SHA = "7c62954a718a7137dc81c6723db696b674458360"
      VIZE_NATIVE_SFC_RUNTIME_OPTIONS_REQUIRED = "1"
      VIZE_NATIVE_SFC_RUNTIME_OPTIONS_PROOF = "target/vize-tests/sfc-runtime-options"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("native-sfc-runtime-options")
      ci.checkoutAt("7c62954a718a7137dc81c6723db696b674458360")
      new Dynamic {
        name = "Read the candidate qualification recipe without changing producer source"
        uses = ci.checkout
        with {
          ref = "${{ github.event.pull_request.head.sha || github.sha }}"
          path = "qualification"
          `persist-credentials` = false
          `sparse-checkout` = """
          .github/actions/setup-rust-script
          .github/actions/setup-wild-http-recovery
          tests/tooling/native-sfc-runtime-options.test.mjs
          tests/tooling/support/script-setup-default-expose.ts
          tests/tooling/support/setup-component-bracket-reference.ts
          tests/tooling/support/typescript-erasure-reference.ts

          """
          `sparse-checkout-cone-mode` = false
        }
      }
      new Dynamic {
        run = ci.workflowScript("native-runtime-options-baseline-cp-qualification-tests-tooling-native-sf.sh")
      }
      ci.workspaceVp()
      ci.rust("1.99.1")
      new Dynamic {
        uses = "./qualification/.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "sfc-runtime-options"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./qualification/.github/actions/setup-rust-script")
      new Dynamic { run = "vp install --frozen-lockfile --prefer-offline --filter './npm/native...'" }
      ci.command("Build the actual source-native package", "vp run --filter './npm/native' build:ci")
      new Dynamic {
        name = "Seal the selected image and exact source"
        run = ci.workflowScript("seal-the-selected-image-and-exact-source.sh")
      }
      new Dynamic {
        name = "Verify runtime option transport and complete code/maps"
        shell = "bash"
        run = ci.workflowScript("verify-runtime-option-transport-and-complete-code-maps.sh")
      }
      new Dynamic {
        name = "Preserve source identity and all observations"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "sfc-runtime-options-baseline-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "target/vize-tests/sfc-runtime-options/"
          `if-no-files-found` = "error"
          `include-hidden-files` = true
        }
      }
    }
  }

  `native-runtime-options` {
    needs = "native-runtime-options-baseline"
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    env {

      CARGO_BUILD_JOBS = "12"
      CARGO_TERM_COLOR = "always"
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
      RAYON_NUM_THREADS = "4"
      SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
      VIZE_NATIVE_SFC_RUNTIME_OPTIONS_BASELINE = "target/vize-tests/sfc-runtime-options-baseline/matrix.json"
      VIZE_NATIVE_SFC_RUNTIME_OPTIONS_REQUIRED = "1"
      VIZE_NATIVE_SFC_RUNTIME_OPTIONS_PROOF = "target/vize-tests/sfc-runtime-options"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("native-sfc-runtime-options")
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      ci.workspaceVp()
      ci.rust("1.100.0")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "sfc-runtime-options"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic { run = "vp install --frozen-lockfile --prefer-offline --filter './npm/native...'" }
      ci.command("Build the actual source-native package", "vp run --filter './npm/native' build:ci")
      new Dynamic {
        name = "Seal the selected image and exact source"
        run = ci.workflowScript("seal-the-selected-image-and-exact-source.sh")
      }
      new Dynamic {
        name = "Install the actual DOM runtime for standalone execution"
        run = ci.workflowScript("install-the-actual-dom-runtime-for-standalone-execution.sh")
      }
      new Dynamic {
        name = "Read the whole before-source packets"
        uses = ci.downloadArtifact
        with {
          name = "sfc-runtime-options-baseline-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "target/vize-tests/sfc-runtime-options-baseline"
        }
      }
      new Dynamic {
        name = "Verify runtime option transport and complete code/maps"
        shell = "bash"
        run = ci.workflowScript("verify-runtime-option-transport-and-complete-code-maps-2.sh")
      }
      new Dynamic {
        name = "Preserve source identity and all observations"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "sfc-runtime-options-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.event.pull_request.head.sha || github.sha }}"
          path = """
          target/vize-tests/sfc-runtime-options/
          npm/native/.artifacts/native/build-token-receipt.json

          """
          `if-no-files-found` = "error"
          `include-hidden-files` = true
        }
      }
    }
  }
}
