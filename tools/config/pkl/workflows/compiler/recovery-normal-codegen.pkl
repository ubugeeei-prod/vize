import "../../Actions.pkl" as ci

name = "Recovery normal codegen"
on {
  pull_request {
    paths = List(".github/workflows/recovery-normal-codegen.yml", ".github/scripts/workflows/recovery-normal-codegen/**", ".github/scripts/workflows/shared/**")
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "recovery-normal-codegen-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  codegen {
    `runs-on` = ci.linux
    `timeout-minutes` = 40
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/recovery-normal-codegen"
      CARGO_BUILD_JOBS = "4"
      CARGO_INCREMENTAL = "0"
      CARGO_TERM_COLOR = "never"
      PINNED_BASE = "21dbb3573d46655954de79ac90df14d24d657be9"
      PINNED_HEAD = "4f435a77902c570252e6c3ef322bf51ebdee5393"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic { run = "rustup toolchain install 1.99.1 --profile minimal" }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "script-recovery-clone-codegen-v1"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Pin the original normal source and carrier without changing compiler flags"
        run = #". "${{ env.VIZE_CI_FILES }}/pin-the-original-normal-source-and-carrier-without-changing-compiler-fla.sh""#
      }
      new Dynamic {
        name = "Build fresh normal images and retain exact artifact manifests"
        run = #". "${{ env.VIZE_CI_FILES }}/build-fresh-normal-images-and-retain-exact-artifact-manifests.sh""#
      }
      new Dynamic {
        name = "Correlate normal allocator shims and recovery code without executing a timing window"
        run = #". "${{ env.VIZE_CI_FILES }}/correlate-normal-allocator-shims-and-recovery-code-without-executing-a-t.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "recovery-normal-codegen-receipt-${{ github.run_id }}"
          path = """
          codegen/receipt.json
          codegen/assembly-*.txt
          codegen/dynamic-*.txt
          codegen/rustc.txt

          """
          `if-no-files-found` = "warn"
        }
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "recovery-normal-codegen-metadata-${{ github.run_id }}"
          path = """
          codegen/*.json
          codegen/*.jsonl
          codegen/*.txt
          codegen/*.sha
          codegen/*.commit

          """
          `if-no-files-found` = "error"
        }
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "success()"
        with {
          name = "recovery-normal-codegen-images-${{ github.run_id }}"
          path = "codegen/normal-*"
          `if-no-files-found` = "error"
        }
      }
    }
  }
}
