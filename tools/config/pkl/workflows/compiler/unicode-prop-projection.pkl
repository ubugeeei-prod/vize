import "../../Actions.pkl" as ci

name = "Unicode prop projection"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/unicode-prop-projection.yml"
      "tools/support/compat/github/unicode-prop-projection-custody.mjs"
      "tools/support/compat/content-mapper/constructor-projection-parity.ts"
      "tools/support/compat/content-mapper/constructor-helper-assets.ts"
      "tools/support/compat/content-mapper/constructor-projection-receipt.ts"
      "tools/support/compat/content-mapper/projection-byte-relocation.ts"
      "tools/support/compat/content-mapper/owned-emit-overload-transition.ts"
      "tools/support/compat/content-mapper/component-constructor-transition.ts"
      "tools/support/compat/content-mapper/component-export-transition.ts"
      "tools/support/compat/content-mapper/canonical-helper-transition.ts"
      "tools/support/compat/content-mapper/producer-unmapped-ignores.ts"
      "tests/tooling/runtime-prop-projection-certificate.test.ts"
      "tools/support/compat/content-mapper/constructor-jsx-witness-transition.ts"
      "tests/_fixtures/differential/typechecker/tsx-single-required-exact-keys/**"
      "tests/tooling/constructor-projection-parity.test.ts"
      "tests/tooling/constructor-projection-emit-overload.test.ts"
      "tests/tooling/emit-overload-transition-fixture.ts"
      "tests/tooling/fixtures/emit-overload-transition/**"
      "tests/tooling/unicode-prop-projection-custody.test.ts"
      "crates/vize_canon/src/virtual_ts/helpers/declarations/core-types.d.ts.txt"
      "crates/vize_canon/src/virtual_ts/helpers/declarations/emit-overloads.d.ts.txt"
      "crates/vize_canon/src/virtual_ts/helpers/declarations/emit-props.d.ts.txt"
      "crates/vize_canon/src/virtual_ts/helpers/preamble.rs"
      "crates/vize_canon/src/virtual_ts/generator/emits.rs"
      "crates/vize_canon/src/virtual_ts/generator/component_constructors/emission.rs"
      "crates/vize_canon/src/virtual_ts/generator/component_constructors/generic_function.rs"
      "crates/vize_canon/tests/constructor_emission_projection.rs"
      "crates/vize_canon/src/virtual_ts/helpers/declarations/vue3-types.d.ts.txt"
      "crates/vize_canon/src/virtual_ts/helpers/declarations/prop-keys.d.ts.txt"
      "crates/vize_canon/src/virtual_ts/component_prop_helpers.txt"
      "crates/vize_canon/src/virtual_ts/helpers/declarations/component-global-attributes.d.ts.txt"
      "crates/vize_canon/src/virtual_ts/helpers/declarations/content-mapper-type-imports.d.ts.txt"
      "crates/vize_canon/src/virtual_ts/props/mappings.rs"
      "crates/vize_canon/src/virtual_ts/props/mappings/**"
      "crates/vize_canon/src/virtual_ts/props/template_model.rs"
      "crates/vize/tests/content_mapper_tsgo_cli/unicode_prop_bindings.rs"
      "tests/_fixtures/differential/typechecker/unicode-prop-bindings-10573/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "unicode-props-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  CARGO_TERM_COLOR = "always"
  CONTENT_MAPPER_TYPESCRIPT_SHA = "d6c4afddb2c55f4a9dea7b59293a99a8fdea1799"
  BASE_SHA = "${{ github.event.pull_request.base.sha }}"
  HEAD_SHA = "${{ github.event.pull_request.head.sha }}"
}
jobs {
  `native-host` {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    steps = new Listing {
      ci.checkoutAt("${{ env.HEAD_SHA }}")
      new Dynamic {
        uses = ci.checkout
        with {
          repository = "microsoft/TypeScript"
          ref = "${{ env.CONTENT_MAPPER_TYPESCRIPT_SHA }}"
          path = "typescript-content-mapper"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = "actions/setup-go@4dc6199c7b1a012772edbd06daecab0f50c9053c"  // v6.1.0
        with {
          `go-version-file` = "typescript-content-mapper/tsc/go.mod"
          `cache-dependency-path` = "typescript-content-mapper/tsc/go.sum"
        }
      }
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "content-mapper-conformance"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version-file` = "package.json"
          `run-install` = false
          cache = true
          `cache-save` = false
        }
      }
      ci.command("Install pinned dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Build exact official mapper host"
        `working-directory` = "typescript-content-mapper/tsc"
        run = """
        test "$(git rev-parse HEAD)" = "$CONTENT_MAPPER_TYPESCRIPT_SHA"
        go build -tags=noembed -trimpath -o "$RUNNER_TEMP/tsgo" ./cmd/tsc
        cp internal/bundled/libs/*.d.ts "$RUNNER_TEMP/"

        """
      }
      new Dynamic {
        name = "Run all native and official-host valid invalid repair packets"
        env {
          VIZE_TEST_CONTENT_MAPPER_TSGO = "${{ runner.temp }}/tsgo"
          VIZE_TEST_REQUIRE_TSGO = "1"
          CORSA_PATH = "${{ github.workspace }}/node_modules/@typescript/typescript-linux-x64/lib/tsc"
          VIZE_UNICODE_PROP_CAPTURE = "${{ github.workspace }}/target/unicode-prop-packets"
        }
        run = """
        cargo test --locked --profile ci -p vize_canon --lib virtual_ts::props::mappings::tests:: -- --nocapture
        cargo test --locked --profile ci -p vize_canon --test fix_history_diagnostics unicode_prop_bindings_preserve_complete_authored_diagnostics -- --exact --nocapture
        cargo test --locked --profile ci -p vize --test integration -- content_mapper_tsgo_cli::unicode_prop_bindings:: --nocapture --test-threads=1

        """
      }
      new Dynamic {
        name = "Retain complete provider identities"
        `if` = "always()"
        run = #"""
        node --input-type=module <<'JS'
        import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
        import { createHash } from 'node:crypto';
        import { spawnSync } from 'node:child_process';
        const identify = path => {
          const bytes = readFileSync(path), version = spawnSync(path, ['--version']);
          return { path, sha256: createHash('sha256').update(bytes).digest('hex'), version: { status: version.status, stdout: version.stdout.toString('base64'), stderr: version.stderr.toString('base64') } };
        };
        mkdirSync('target/unicode-prop-packets', { recursive: true });
        const fixture = readFileSync('tests/_fixtures/differential/typechecker/unicode-prop-bindings-10573/cases.json');
        const receipt = { source: process.env.HEAD_SHA, mapperSource: process.env.CONTENT_MAPPER_TYPESCRIPT_SHA, mapper: identify(`${process.env.RUNNER_TEMP}/tsgo`), native: identify('node_modules/@typescript/typescript-linux-x64/lib/tsc'), cli: identify('target/ci/vize'), fixtureSha256: createHash('sha256').update(fixture).digest('hex') };
        writeFileSync('target/unicode-prop-packets/providers.json', JSON.stringify(receipt, null, 2) + '\n');
        JS

        """#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "unicode-prop-packets-${{ env.HEAD_SHA }}-${{ github.run_id }}"
          path = "target/unicode-prop-packets/"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
  `unaffected-projections` {
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ env.HEAD_SHA }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Validate the shared certificate and Unicode custody refusal controls"
        run = "node --test tests/tooling/constructor-projection-parity.test.ts tests/tooling/unicode-prop-projection-custody.test.ts tests/tooling/runtime-prop-projection-certificate.test.ts tests/tooling/constructor-projection-emit-overload.test.ts"
      }
      new Dynamic {
        name = "Compile and run both roles in initially absent isolated targets"
        run = "node tools/support/compat/github/unicode-prop-projection-custody.mjs"
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "unicode-prop-parity-${{ env.HEAD_SHA }}-${{ github.run_id }}"
          path = "${{ runner.temp }}/unicode-prop-parity/"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
