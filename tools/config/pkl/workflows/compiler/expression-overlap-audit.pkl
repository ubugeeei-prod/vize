import "../../Actions.pkl" as ci

name = "Expression overlapping speculation audit"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/expression-overlap-audit.yml"
      ".github/scripts/workflows/expression-overlap-audit/**"
      ".github/scripts/workflows/shared/**"
      "tools/support/compat/parser/**"
      "upstream/forks/oxc_parser/**"
      "tests/fuzz/regressions/js_ts_expression/issue-10845*"
    }
  }
  workflow_dispatch {}
}
permissions { contents = "read" }
concurrency {
  group = "expression-overlap-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  source {
    name = "Expression overlap ${{ matrix.role }}"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    strategy {
      `fail-fast` = false
      matrix {
        role = List("baseline", "candidate")
      }
    }
    env {

      CARGO_INCREMENTAL = "0"
      CARGO_TERM_COLOR = "never"
      ROLE = "${{ matrix.role }}"
      DRIVER_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
      SOURCE_SHA = "${{ matrix.role == 'baseline' && '9157b9fa83dbdc98100be084be288f21d0d1bc18' || github.event.pull_request.head.sha || github.sha }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("expression-overlap-audit")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ env.DRIVER_SHA }}"
          path = "driver"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ env.SOURCE_SHA }}"
          path = "source"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "driver/package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = "dtolnay/rust-toolchain@e2a55d2ffb04f378e9626c28d38b36d230d1e12f"  // master
        with { toolchain = "nightly-2026-10-23" }
      }
      new Dynamic {
        uses = "actions/cache/restore@27d5ce7f107fe9357f9df03efb73ab90386fccae"  // v5
        with {
          path = """
          ~/.cargo/registry
          ~/.cargo/git

          """
          key = "expression-overlap-downloads-${{ runner.os }}"
        }
      }
      new Dynamic {
        name = "Freeze driver, original cases and source provenance"
        run = ci.workflowScript("freeze-driver-original-cases-and-source-provenance.sh")
      }
      new Dynamic {
        name = "Build immutable optimized source and frozen drivers"
        id = "build"
        `working-directory` = "source"
        env { CARGO_PROFILE_CI_OPT_DEBUG = "1" }
        run = ci.workflowScript("build-immutable-optimized-source-and-frozen-drivers.sh")
      }
      new Dynamic {
        name = "Compare complete observable packets and separate admission from parser work"
        run = ci.workflowScript("compare-complete-observable-packets-and-separate-admission-from-parser-w.sh")
      }
      ci.command("Install source profiler", ci.workflowScript("install-source-profiler.sh"))
      new Dynamic {
        name = "Count immutable-source instructions with line attribution"
        run = ci.workflowScript("count-immutable-source-instructions-with-line-attribution.sh")
      }
      new Dynamic {
        name = "Observe all private source facts and require candidate parser regressions"
        `working-directory` = "source"
        env {
          VIZE_EXPRESSION_OVERLAP_CASES = "${{ github.workspace }}/evidence/cases"
          VIZE_EXPRESSION_OVERLAP_FACTS = "${{ github.workspace }}/evidence/private-source-facts.txt"
        }
        run = ci.workflowScript("observe-all-private-source-facts-and-require-candidate-parser-regression.sh")
      }
      new Dynamic {
        name = "Replay original libFuzzer address sanitizer resource regime"
        `working-directory` = "source"
        run = ci.workflowScript("replay-original-libfuzzer-address-sanitizer-resource-regime.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "expression-overlap-${{ matrix.role }}-${{ env.SOURCE_SHA }}"
          path = "evidence/"
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
  acceptance {
    name = "Expression overlap complete packets and instruction reduction"
    needs = "source"
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    steps = new Listing {
      ...ci.stageWorkflowScripts("expression-overlap-audit")
      new Dynamic {
        uses = ci.downloadArtifact
        with {
          pattern = "expression-overlap-*"
          path = "evidence"
        }
      }
      new Dynamic {
        name = "Require complete packet parity and at least eightfold shared-work reduction"
        run = ci.workflowScript("require-complete-packet-parity-and-at-least-eightfold-shared-work-reduct.sh")
      }
    }
  }
}
