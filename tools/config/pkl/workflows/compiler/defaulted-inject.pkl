import "../../Actions.pkl" as ci

name = "Optional inject fallback contracts"
on {
  pull_request {
    branches = List("main")
    paths = new Listing {
      "crates/vize_croquis_cf/**"
      "crates/vize_croquis/src/provide.rs"
      "crates/vize_croquis/src/script_parser/**"
      "tools/support/compat/defaulted-inject/**"
      "tests/tooling/defaulted-inject-snapshot-transition.test.ts"
      ".github/workflows/defaulted-inject.yml"
      ".github/scripts/workflows/defaulted-inject/**"
    }
  }
  push {
    branches = List("main")
    paths = new Listing {
      "crates/vize_croquis_cf/**"
      "tools/support/compat/defaulted-inject/**"
      "tests/tooling/defaulted-inject-snapshot-transition.test.ts"
      ".github/workflows/defaulted-inject.yml"
      ".github/scripts/workflows/defaulted-inject/**"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "defaulted-inject-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  producer { uses = "./.github/workflows/full-source-cli.yml" }
  packets {
    needs = "producer"
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/defaulted-inject"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.workspaceVp()
      new Dynamic { run = "vp install --frozen-lockfile --prefer-offline" }
      ci.rust("stable")
      ci.wild()
      new Dynamic {
        name = "Preserve the consumer checkout before source restoration"
        run = ci.workflowScript("preserve-the-consumer-checkout-before-source-restoration.sh")
      }
      new Dynamic {
        uses = "./.github/actions/restore-source-cli"
        with { producer = "${{ toJSON(needs.producer.outputs) }}" }
      }
      new Dynamic {
        name = "Preserve public before provenance"
        run = ci.workflowScript("preserve-public-before-provenance.sh")
      }
      new Dynamic {
        name = "Require original and mutation whole packets with unchanged facts"
        env {
          VIZE_DEFAULTED_INJECT_PROOF = "${{ runner.temp }}/defaulted-inject-proof/packets.json"
          VIZE_DEFAULTED_INJECT_BEFORE_CLI = "${{ runner.temp }}/defaulted-inject-before/node_modules/.bin/vize"
        }
        run = ci.workflowScript("require-original-and-mutation-whole-packets-with-unchanged-facts.sh")
      }
      new Dynamic {
        name = "Preserve every input, full process and unchanged source identity"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "defaulted-inject-${{ github.event.pull_request.head.sha || github.sha }}"
          path = "${{ runner.temp }}/defaulted-inject-proof"
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
}
