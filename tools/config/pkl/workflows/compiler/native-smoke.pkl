import "../../../../ci/lib/Actions.pkl" as ci

local nativeHostEnv = new Dynamic { NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169" }

local nativeHostSteps = new Listing {
  ci.use(ci.checkout)
  ci.workspaceVp()
  new Dynamic {
    name = "Setup MSVC toolchain (Windows)"
    `if` = "runner.os == 'Windows'"
    uses = "ilammy/msvc-dev-cmd@0b201ec74fa43914dc39ae48a89fd1d8cb592756"  // v1
    with { arch = "${{ matrix.msvc_arch }}" }
  }
  ci.rust("stable")
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    `if` = "runner.os == 'Linux'"
    with { `wild-version` = "0.9.0" }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    `if` = "runner.os == 'Linux'"
    with {
      key = "native-smoke-${{ matrix.target }}"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    uses = "Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32"  // v2
    `if` = "runner.os != 'Linux'"
    with {
      `shared-key` = "native-smoke-${{ matrix.target }}"
      `cache-workspace-crates` = "true"
    }
  }
  ci.use("./.github/actions/setup-rust-script")
  ci.command("Install native package dependencies", "vp install --frozen-lockfile --prefer-offline --filter './npm/native...'")
  new Dynamic {
    name = "Test native image token producer"
    `if` = "github.event_name == 'workflow_dispatch' && inputs.host_only && inputs.target == 'darwin-arm64'"
    run = "node --test tests/tooling/native-build-token.test.ts"
  }
  ci.command("Build CLI", "cargo build --profile ci -p vize")
  new Dynamic {
    name = "Smoke CLI"
    shell = "bash"
    run = ci.workflowScript("smoke-cli.sh")
  }
  ci.command("Build @vizejs/native", "vp run --filter './npm/native' build:ci")
  new Dynamic {
    name = "Verify GNU native glibc compatibility"
    `if` = "runner.os == 'Linux' && endsWith(matrix.target, '-gnu')"
    run = "node tools/ci/commands/github/verify-glibc-symbols.ts --max 2.36 npm/native/*.linux-*-gnu.node"
  }
  new Dynamic {
    name = "Smoke @vizejs/native"
    run = #"node "${{ env.VIZE_CI_FILES }}/smoke-vizejs-native.cjs""#
  }
  new Dynamic {
    name = "Package-install smoke for host native package"
    `if` = "runner.os == 'Linux'"
    run = "node tools/commands/release/npm/smoke-release-install.ts --prepare-manifests npm/native"
  }
  new Dynamic {
    name = "Capture selected native image authority"
    `if` = "github.event_name == 'workflow_dispatch' && inputs.host_only && inputs.target == 'darwin-arm64'"
    run = "node npm/native/scripts/native-build-receipt.mjs"
  }
  new Dynamic {
    name = "Preserve selected native image"
    `if` = "github.event_name == 'workflow_dispatch' && inputs.host_only && inputs.target == 'darwin-arm64'"
    uses = ci.uploadArtifact
    with {
      name = "native-image-${{ github.sha }}-${{ matrix.target }}-${{ github.run_attempt }}"
      `if-no-files-found` = "error"
      `include-hidden-files` = true
      path = """
      npm/native/*.node
      npm/native/index.js
      npm/native/index.d.ts
      npm/native/native-binding.js
      npm/native/native-binding-identity.js
      npm/native/native-targets.js
      npm/native/.artifacts/native/build-token-receipt.json

      """
    }
  }
}

name = "Native Smoke"

on {
  workflow_dispatch {
    inputs {
      target {
        description = "Native producer scope; default retains the full smoke matrix"
        type = "choice"
        options = List("all", "darwin-arm64")
        ["default"] = "all"
      }
      host_only {
        description = "Produce one selected host artifact; not full matrix qualification"
        type = "boolean"
        ["default"] = false
      }
    }
  }
  // Full native/fresh-install smoke is release evidence, not a per-push gate.
  // Keep it on a weekly cadence plus manual runs so normal PR pushes stay
  // fast while release promotion still has a reproducible matrix check.
  schedule = new Listing {
    new Dynamic { cron = "17 3 * * 1" }
  }
}

concurrency {
  group = "native-smoke-${{ github.workflow }}-${{ github.ref }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env {
  CARGO_INCREMENTAL = 0
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  // One Linux/Node 24 fresh-install row builds the complete graph so the packed
  // Nuxt consumer and its LSP run before release, not only in the release job.
  RELEASE_JS_PACKAGES = "npm/cli npm/create-fresco npm/builder/vite npm/linter/oxlint npm/builder/unplugin npm/fresco npm/mcp-musea npm/builder/vite-musea npm/builder/rspack npm/framework/musea-nuxt npm/framework/nuxt-lint-config npm/framework/nuxt npm/marquette npm/compose/core npm/compose/router npm/compose/data npm/ui npm/plugin-sdk npm/builder/babel"
}

jobs {
  `host-native-smoke` {
    `if` = "github.event_name != 'workflow_dispatch' || !inputs.host_only || inputs.target != 'darwin-arm64'"
    name = "Native host smoke (${{ matrix.target }})"
    `runs-on` = "${{ matrix.runner }}"
    `timeout-minutes` = 30
    strategy {
      `fail-fast` = false
      matrix {
        include = new Listing {
          new Dynamic {
            runner = "ubuntu-22.04"
            target = "linux-x64-gnu"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = "ubuntu-22.04-arm"
            target = "linux-arm64-gnu"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = "macos-15-intel"
            target = "darwin-x64"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = ci.macos
            target = "darwin-arm64"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = ci.windows
            target = "win32-x64-msvc"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = "windows-11-arm"
            target = "win32-arm64-msvc"
            msvc_arch = "arm64"
          }
        }
      }
    }
    env = (nativeHostEnv) {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/native-smoke"
    }
    steps = nativeHostSteps
  }

  `fresh-install-smoke` {
    `if` = "github.event_name != 'workflow_dispatch' || !inputs.host_only || inputs.target != 'darwin-arm64'"
    name = "Fresh install smoke (${{ matrix.platform.target }}, Node ${{ matrix.node-version }})"
    `runs-on` = "${{ matrix.platform.runner }}"
    `timeout-minutes` = 45
    strategy {
      `fail-fast` = false
      matrix {
        `node-version` = List("22", "24")
        platform = new Listing {
          new Dynamic {
            runner = "ubuntu-22.04"
            target = "linux-x64-gnu"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = "ubuntu-22.04-arm"
            target = "linux-arm64-gnu"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = "macos-15-intel"
            target = "darwin-x64"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = ci.macos
            target = "darwin-arm64"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = ci.windows
            target = "win32-x64-msvc"
            msvc_arch = "amd64"
          }
          new Dynamic {
            runner = "windows-11-arm"
            target = "win32-arm64-msvc"
            msvc_arch = "arm64"
          }
        }
      }
    }
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/native-smoke"
      NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
    }
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        name = "Setup runtime package managers"
        uses = "./.github/actions/setup-runtime-package-managers"
        with { `node-version` = "${{ matrix.node-version }}" }
      }
      new Dynamic {
        name = "Setup MSVC toolchain (Windows)"
        `if` = "runner.os == 'Windows'"
        uses = "ilammy/msvc-dev-cmd@0b201ec74fa43914dc39ae48a89fd1d8cb592756"  // v1
        with { arch = "${{ matrix.platform.msvc_arch }}" }
      }
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        `if` = "runner.os == 'Linux'"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        `if` = "runner.os == 'Linux'"
        with {
          key = "fresh-install-smoke-${{ matrix.platform.target }}-node-${{ matrix.node-version }}"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        uses = "Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32"  // v2
        `if` = "runner.os != 'Linux'"
        with {
          `shared-key` = "fresh-install-smoke-${{ matrix.platform.target }}"
          `cache-workspace-crates` = "true"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        name = "Install package dependencies"
        shell = "bash"
        run = ci.workflowScript("install-package-dependencies.sh")
      }
      ci.command("Build @vizejs/native", "vp run --filter './npm/native' build:ci")
      new Dynamic {
        name = "Prepare native platform packages"
        shell = "bash"
        run = "node tools/support/github/stage-built-native-packages.ts npm/native"
      }
      new Dynamic {
        name = "Build npm runtime packages"
        `if` = "${{ matrix.platform.target != 'linux-x64-gnu' || matrix.node-version != '24' }}"
        shell = "bash"
        run = ci.workflowScript("build-npm-runtime-packages.sh")
      }
      new Dynamic {
        name = "Build the packed Nuxt release graph"
        `if` = "${{ matrix.platform.target == 'linux-x64-gnu' && matrix.node-version == '24' }}"
        uses = "./.github/actions/release-build-packages"
      }
      new Dynamic {
        name = "Fresh install and runtime smoke published tarballs"
        `if` = "${{ matrix.platform.target != 'linux-x64-gnu' || matrix.node-version != '24' }}"
        env { VIZE_SMOKE_TIMING_FILE = "${{ runner.temp }}/packed-smoke-timing.jsonl" }
        shell = "bash"
        run = ci.workflowScript("fresh-install-and-runtime-smoke-published-tarballs.sh")
      }
      new Dynamic {
        name = "Fresh packed Nuxt init, check, and LSP smoke"
        `if` = "${{ matrix.platform.target == 'linux-x64-gnu' && matrix.node-version == '24' }}"
        env { VIZE_SMOKE_TIMING_FILE = "${{ runner.temp }}/packed-smoke-timing.jsonl" }
        shell = "bash"
        run = ci.workflowScript("fresh-packed-nuxt-init-check-and-lsp-smoke.sh")
      }
      new Dynamic {
        name = "Retain packed smoke timing"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "packed-smoke-timing-${{ matrix.platform.target }}-node${{ matrix.node-version }}"
          path = "${{ runner.temp }}/packed-smoke-timing.jsonl"
          `if-no-files-found` = "warn"
          `retention-days` = 14
        }
      }
    }
  }

  `fresh-install-musl-smoke` {
    `if` = "github.event_name != 'workflow_dispatch' || !inputs.host_only || inputs.target != 'darwin-arm64'"
    name = "Fresh install smoke (${{ matrix.platform }}, Node 24)"
    `runs-on` = "${{ matrix.runner }}"
    `timeout-minutes` = 60
    strategy {
      `fail-fast` = false
      matrix {
        include = new Listing {
          new Dynamic {
            runner = ci.linux
            target = "x86_64-unknown-linux-musl"
            platform = "linux-x64-musl"
          }
          new Dynamic {
            runner = "ubuntu-22.04-arm"
            target = "aarch64-unknown-linux-musl"
            platform = "linux-arm64-musl"
          }
        }
      }
    }
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/native-smoke"
    }
    steps = new Listing {
      ci.use(ci.checkout)
      new Dynamic {
        name = "Read the package version"
        id = "version"
        shell = "bash"
        run = ci.workflowScript("read-the-package-version.sh")
      }
      new Dynamic {
        name = "Cross-build the musl native binding"
        uses = "./.github/actions/build-release-native"
        with {
          target = "${{ matrix.target }}"
          `release-version` = "${{ steps.version.outputs.version }}"
          `cross-compile` = "true"
          `upload-artifacts` = "false"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        name = "Install packed runtime dependencies"
        shell = "bash"
        run = ci.workflowScript("install-package-dependencies.sh")
      }
      new Dynamic {
        name = "Prepare the musl native platform package"
        shell = "bash"
        env { NATIVE_PLATFORM = "${{ matrix.platform }}" }
        run = ci.workflowScript("prepare-the-musl-native-platform-package.sh")
      }
      new Dynamic {
        name = "Build packed runtime packages"
        shell = "bash"
        run = ci.workflowScript("build-npm-runtime-packages.sh")
      }
      new Dynamic {
        name = "Fresh install and runtime smoke in Alpine"
        shell = "bash"
        env {
          NATIVE_PACKAGE = "${{ format('@vizejs/native-{0}', matrix.platform) }}"
          NATIVE_PLATFORM = "${{ matrix.platform }}"
        }
        run = ci.workflowScript("fresh-install-and-runtime-smoke-in-alpine.sh")
      }
      new Dynamic {
        name = "Retain packed musl smoke evidence"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "packed-smoke-timing-${{ matrix.platform }}-node24"
          path = """
          ${{ runner.temp }}/musl-smoke.log
          ${{ runner.temp }}/packed-smoke-timing.jsonl

          """
          `if-no-files-found` = "warn"
          `retention-days` = 14
        }
      }
    }
  }

  `selected-host-native-producer` {
    `if` = "github.event_name == 'workflow_dispatch' && inputs.host_only && inputs.target == 'darwin-arm64'"
    name = "Selected native producer (darwin-arm64)"
    `runs-on` = ci.macos
    `timeout-minutes` = 30
    strategy {
      matrix {
        include = new Listing {
          new Dynamic {
            runner = ci.macos
            target = "darwin-arm64"
            msvc_arch = "amd64"
          }
        }
      }
    }
    env = (nativeHostEnv) {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/native-smoke"
    }
    steps = nativeHostSteps
  }
}
