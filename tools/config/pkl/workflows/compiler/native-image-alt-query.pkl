import "../../Actions.pkl" as ci

name = "Native image-alt query source evidence"

on {
  pull_request {
    paths = new Listing {
      "crates/vize_patina/src/attribute_policy/**"
      "crates/vize_patina/src/native/img_alt.rs"
      "crates/vize_patina/src/native/canonical.rs"
      "crates/vize_patina/src/native/canonical/**"
      "crates/vize_patina/src/native/tabindex_no_positive.rs"
      "crates/vize_patina/tests/canonical_rule_group/**"
      "crates/vize_patina/Cargo.toml"
      "davinci/vize_l2/Cargo.toml"
      "davinci/vize_l2/src/artifact.rs"
      "davinci/vize_l2/src/walk.rs"
      "davinci/vize_l2/src/walk/**"
      "crates/vize_patina/examples/native_image_alt_*.rs"
      "crates/vize_patina/examples/image_alt_measurement/**"
      ".github/workflows/native-image-alt-query.yml"
      ".github/scripts/workflows/native-image-alt-query/**"
    }
  }
}

permissions { contents = "read" }
concurrency {
  group = "native-image-alt-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}

jobs {
  `source-evidence` {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUSTC_WRAPPER = ""
      RUSTC_WORKSPACE_WRAPPER = ""
      BASE_SHA = "${{ github.event.pull_request.base.sha }}"
      HEAD_SHA = "${{ github.event.pull_request.head.sha }}"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("native-image-alt-query")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.event.pull_request.head.sha }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      ci.wild()
      new Dynamic {
        uses = ci.cache
        with {
          path = """
          ~/.cargo/registry
          ~/.cargo/git

          """
          key = "native-image-alt-registry-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('Cargo.lock') }}"
        }
      }
      new Dynamic {
        name = "Build immutable source observers before measuring"
        shell = "bash"
        run = ci.workflowScript("build-immutable-source-observers-before-measuring.sh")
      }
      new Dynamic {
        name = "Observe original-owner before and after, then independent canonical phases"
        shell = "bash"
        run = ci.workflowScript("observe-original-owner-before-and-after-then-independent-canonical-phase.sh")
      }
      new Dynamic {
        name = "Require full original-owner packet equality and explicit phase custody"
        shell = "bash"
        run = ci.workflowScript("require-full-original-owner-packet-equality-and-explicit-phase-custody.sh")
      }
      new Dynamic {
        name = "Compare canonical accessibility diagnostics with the original rule pair"
        shell = "bash"
        run = ci.workflowScript("compare-canonical-accessibility-diagnostics-with-the-original-rule-pair.sh")
      }
      new Dynamic {
        name = "Compare the separately linked original public event and node consumer"
        shell = "bash"
        run = ci.workflowScript("compare-the-separately-linked-original-public-event-and-node-consumer.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "native-image-alt-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/native-image-alt"
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }
}
