import "../../Actions.pkl" as ci

name = "Native beta diagnostic DTO"
on {
  pull_request {
    paths = new Listing {
      "crates/vize_canon/src/lsp_client/**"
      "tests/_fixtures/differential/typechecker/snapshot-source-text/**"
      "tests/tooling/support/native-beta-dto/**"
      ".github/workflows/native-beta-diagnostic-dto.yml"
      ".github/scripts/workflows/native-beta-diagnostic-dto/**"
      "Cargo.toml"
      "Cargo.lock"
    }
  }
  workflow_dispatch {}
}
permissions { contents = "read" }
concurrency {
  group = "native-beta-dto-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}
jobs {
  `actual-source-wire` {
    name = "${{ matrix.role == 'before' && matrix.sdk.version == '7.1.0-beta' && 'Baseline DTO refusal observation' || matrix.role == 'before' && matrix.sdk.version == '7.0.2' && 'Baseline registration boundary observation' || 'Functional source control' }} (${{ matrix.role }}, ${{ matrix.sdk.version }})"
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    strategy {
      `fail-fast` = false
      matrix {
        role = List("before", "after")
        sdk = new Listing {
          new Dynamic {
            version = "7.0.2"
            sha256 = "4f2de678286401759b3fb4475bafe35b8f32b4b3a07d92642bbf37eadc9b34a4"
          }
          new Dynamic {
            version = "7.1.0-beta"
            sha256 = "a183b1956edbe7e7d98f2249858eedf2d8a9790809cc4909db1276e202faaa70"
          }
        }
      }
    }
    env {

      HEAD_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
      BASE_SHA = "13fa41356d075047a229f580014b637d3bbeb57f"
      ROLE = "${{ matrix.role }}"
      SDK_VERSION = "${{ matrix.sdk.version }}"
      SDK_SHA256 = "${{ matrix.sdk.sha256 }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("native-beta-diagnostic-dto")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ env.HEAD_SHA }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.99.1"
          components = "clippy"
        }
      }
      ci.wild()
      new Dynamic {
        name = "Install exact official SDK into an isolated consumer"
        `working-directory` = "${{ runner.temp }}"
        run = ci.workflowScript("install-exact-official-sdk-into-an-isolated-consumer.sh")
      }
      new Dynamic {
        name = "Pin before production bytes and identical observer separately"
        run = "node tests/tooling/support/native-beta-dto/prepare-role.ts"
      }
      new Dynamic {
        name = "Pin actual native image and retain all raw process streams"
        run = "node tests/tooling/support/native-beta-dto/provider.ts"
      }
      new Dynamic {
        name = "Exercise same source and SDK error, repair, hover, refs and foreign-file control"
        shell = "bash"
        run = ci.workflowScript("exercise-same-source-and-sdk-error-repair-hover-refs-and-foreign-file-co.sh")
      }
      new Dynamic {
        name = "Verify closed raw native frames and exact per-file request shapes"
        `if` = "${{ !cancelled() }}"
        run = "node tests/tooling/support/native-beta-dto/audit-wire.ts"
      }
      new Dynamic {
        name = "Keep strict known DTO, unknown fields, source ownership and both envelope controls"
        `if` = "${{ matrix.role == 'after' && matrix.sdk.version == '7.0.2' }}"
        run = ci.workflowScript("keep-strict-known-dto-unknown-fields-source-ownership-and-both-envelope.sh")
      }
      new Dynamic {
        uses = "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"  // v4
        `if` = "always()"
        with {
          name = "native-beta-dto-${{ matrix.role }}-${{ matrix.sdk.version }}-${{ env.HEAD_SHA }}"
          path = "target/vize-tests/native-beta-dto/"
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }
}
