import "../../Actions.pkl" as ci

name = "Public mapper comparison"

on {
  workflow_dispatch {
    inputs {
      `base-sha` {
        description = "Exact fixed public baseline source SHA"
        required = true
        type = "string"
      }
      `head-sha` {
        description = "Exact public dispatcher candidate source SHA"
        required = true
        type = "string"
      }
    }
  }
  pull_request {
    paths = new Listing {
      ".github/workflows/template-alias-paired-11822.yml"
      ".github/scripts/workflows/template-alias-paired-11822/**"
      "tools/benchmarks/scripts/template-alias-paired-11822*"
      "tests/_helpers/template-alias-typescript-11822.ts"
      "tests/_fixtures/tooling/public-mapper-provider/**"
    }
  }
}

permissions { contents = "read" }
concurrency {
  group = "mapper-campaign-contracts-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = false
}
env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = "true" }

jobs {
  contracts {
    name = "Mapper campaign functional contracts"
    `if` = "github.event_name == 'pull_request'"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      new Dynamic {
        uses = ci.setupVp
        with {
          version = "1.3.0"
          `node-version` = "26.12.1"
          `run-install` = false
          cache = false
        }
      }
      new Dynamic {
        name = "Install source-pinned JavaScript qualification tools"
        run = "vp install --frozen-lockfile --filter . --filter @vize/tests --filter ./npm/cli..."
      }
      new Dynamic {
        name = "Require strict harness types, complete declarations and negative controls"
        run = "node tools/benchmarks/scripts/template-alias-paired-11822-contracts.ts"
      }
    }
  }
  paired {
    name = "Public dispatcher comparison"
    `if` = "github.event_name == 'workflow_dispatch'"
    `runs-on` = ci.linux
    `timeout-minutes` = 60
    env {

      BASE_SHA = "${{ inputs.base-sha }}"
      HEAD_SHA = "${{ inputs.head-sha }}"
      DRIVER_SHA = "${{ github.sha }}"
      TEMPLATE_ALIAS_RUNNER = ci.linux
      CARGO_BUILD_JOBS = "32"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("template-alias-paired-11822")
      new Dynamic {
        name = "Establish shared processing deadline and original artifact directory"
        run = #". "${{ env.VIZE_CI_FILES }}/establish-shared-processing-deadline-and-original-artifact-directory.sh""#
      }
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.sha }}"
          path = "driver"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ inputs.base-sha }}"
          path = "base"
          `persist-credentials` = false
          `fetch-depth` = 0
        }
      }
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ inputs.head-sha }}"
          path = "candidate"
          `persist-credentials` = false
          `fetch-depth` = 0
        }
      }
      new Dynamic {
        uses = ci.setupVp
        with {
          version = "1.3.0"
          `node-version` = "26.12.1"
          `run-install` = false
          cache = false
        }
      }
      ci.rust("1.100.0")
      new Dynamic {
        name = "Qualify public driver and install independent public provider"
        `working-directory` = "driver"
        run = #". "${{ env.VIZE_CI_FILES }}/qualify-public-driver-and-install-independent-public-provider.sh""#
      }
      new Dynamic {
        name = "Build independent normal Node CLI and NAPI source capsules"
        `working-directory` = "driver"
        run = #". "${{ env.VIZE_CI_FILES }}/build-independent-normal-node-cli-and-napi-source-capsules.sh""#
      }
      new Dynamic {
        name = "Run normal paired cohorts, separate full protocol and sampled tree memory populations"
        `working-directory` = "driver"
        run = #". "${{ env.VIZE_CI_FILES }}/run-normal-paired-cohorts-separate-full-protocol-and-sampled-tree-memory.sh""#
      }
      new Dynamic {
        name = "Retain source-bound stages and original observations"
        `if` = "always()"
        uses = "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"  // v4
        with {
          name = "public-mapper-${{ github.run_id }}"
          `retention-days` = 14
          `if-no-files-found` = "error"
          path = """
          ${{ runner.temp }}/mapper-public-stages/
          ${{ runner.temp }}/mapper-public-output/
          !${{ runner.temp }}/mapper-public-output/**/node_modules/**
          !${{ runner.temp }}/mapper-public-output/**/.empty-cache/**
          !${{ runner.temp }}/mapper-public-output/**/.empty-tmp/**
          base/target/template-alias-11822/*.json
          base/target/template-alias-11822/*.stdout
          base/target/template-alias-11822/*.stderr
          candidate/target/template-alias-11822/*.json
          candidate/target/template-alias-11822/*.stdout
          candidate/target/template-alias-11822/*.stderr

          """
        }
      }
    }
  }
}
