import "../../Actions.pkl" as ci

name = "CSS color literal hover"

on {
  pull_request {
    paths = new Listing {
      ".github/workflows/css-color-literal-hover.yml"
      ".github/scripts/workflows/css-color-literal-hover/**"
      "crates/vize_maestro/src/server/annotations.rs"
      "crates/vize_maestro/src/server/annotations/document_color.rs"
      "crates/vize_maestro/src/server/annotations/document_color/**"
      "crates/vize_maestro/src/server/handlers/typed.rs"
      "tests/tooling/lsp-css-color-literal-hover.test.ts"
      "tests/tooling/lsp-css-color-declaration-admission.test.ts"
      "tests/_fixtures/differential/lsp/css-color-declaration-admission-10562/**"
      "tests/_fixtures/differential/lsp/css-concrete-color-hover-10556/**"
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "css-color-literal-hover-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}

jobs {
  `source-packets` {
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    env {

      CARGO_BUILD_JOBS = "12"
      CARGO_TERM_COLOR = "always"
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
      SOURCE_SHA = "${{ github.event.pull_request.head.sha }}"
      VIZE_LSP_BIN = "target/ci/vize"
      VIZE_LSP_REQUIRE_SOURCE_BUILD = "1"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("css-color-literal-hover")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.event.pull_request.head.sha }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      ci.workspaceVp()
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "test-scripts"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic { run = "vp install --frozen-lockfile --prefer-offline" }
      new Dynamic {
        name = "Build and receipt the exact source CLI"
        run = ci.workflowScript("build-and-receipt-the-exact-source-cli.sh")
      }
      new Dynamic {
        name = "Retain full current hovers and original color-provider contracts"
        shell = "bash"
        run = ci.workflowScript("retain-full-current-hovers-and-original-color-provider-contracts.sh")
      }
      new Dynamic {
        name = "Verify selected parser and publication boundaries with actual source work"
        shell = "bash"
        env {
          VIZE_CSS_SELECTED_WORK_CAPTURE = "${{ github.workspace }}/target/vize-tests/css-color-literal-hover/scanner-work.json"
        }
        run = ci.workflowScript("verify-selected-parser-and-publication-boundaries-with-actual-source-wor.sh")
      }
      new Dynamic {
        name = "Retain owned complete packets, source work and provider receipt"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "css-color-hover-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.event.pull_request.head.sha }}"
          path = """
          target/vize-tests/css-color-literal-hover/
          target/vize-tests/css-color-declaration-admission/
          target/differential/lsp-sessions/
          target/ci/vize.differential-build.json

          """
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }
}
