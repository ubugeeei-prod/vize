import "../../Actions.pkl" as ci

name = "Native LSP overlay custody"

on {
  pull_request {
    types = List("opened", "synchronize", "reopened")
    paths = new Listing {
      "crates/vize_canon/src/lsp_client.rs"
      "crates/vize_canon/src/lsp_client/**"
      "crates/vize_canon/src/corsa_bridge.rs"
      "crates/vize_canon/src/corsa_bridge/overlay_namespace_tests.rs"
      "crates/vize_canon/src/corsa_bridge/bridge/initial_diagnostics/**"
      "crates/vize_canon/src/corsa_bridge/vue_document/build.rs"
      "crates/vize_canon/src/corsa_bridge/vue_document/build/tests.rs"
      "crates/vize_canon/src/corsa_bridge/vue_document/build/tests/windows_overlays.rs"
      "tests/_fixtures/differential/typechecker/windows-verbatim-overlay-11145/input.json"
      ".github/workflows/lsp-overlay-custody.yml"
      ".github/scripts/workflows/lsp-overlay-custody/**"
      ".github/actions/lsp-overlay-custody/**"
      ".github/actions/setup-rust-sticky-cache/**"
      "tests/tooling/lsp-overlay-custody-workflow.test.ts"
      "tests/package.json"
      "pnpm-workspace.yaml"
      "pnpm-lock.yaml"
      "crates/vize/tests/lsp_cli/overlay_storage.rs"
      "crates/vize/tests/lsp_cli.rs"
      "crates/vize/tests/main.rs"
      "crates/vize/tests/support/**"
      "crates/vize/Cargo.toml"
      "Cargo.toml"
      "Cargo.lock"
      "crates/vize_canon/Cargo.toml"
      "tools/support/compat/github/full-rust-runtime.ts"
      "tests/_fixtures/differential/typechecker/native-overlay-input-custody-11145/**"
      "tests/_fixtures/differential/lsp/default-log-installation-custody-11145/**"
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "lsp-overlay-custody-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = false
}

env {
  CARGO_INCREMENTAL = "0"
  CARGO_TERM_COLOR = "never"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
}

jobs {
  `native-overlay` {
    name = "Actual overlay storage and configuration (${{ matrix.os }})"
    `runs-on` = "${{ matrix.runner }}"
    `timeout-minutes` = 45
    strategy {
      `fail-fast` = false
      matrix {
        include = new Listing {
          new Dynamic {
            os = "Linux"
            runner = ci.linux
          }
          new Dynamic {
            os = "Windows"
            runner = ci.windows
          }
        }
      }
    }
    defaults {
      run { shell = "bash" }
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("lsp-overlay-custody")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      ci.workspaceVp()
      ci.command("Install frozen source dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.rust("1.100.0")
      new Dynamic {
        uses = ci.setupWild
        `if` = "runner.os == 'Linux'"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "lsp-overlay-custody"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Select the exact locked platform native provider"
        env { EXPECTED_SOURCE = "${{ github.event.pull_request.head.sha }}" }
        run = ci.workflowScript("select-the-exact-locked-platform-native-provider.sh")
      }
      new Dynamic {
        name = "Exercise native authored logical namespace and retained physical policy controls"
        env {
          VIZE_PRIVATE_OVERLAY_CAPTURE = "${{ runner.temp }}/lsp-overlay-custody"
          EXPECTED_SOURCE = "${{ github.event.pull_request.head.sha }}"
          SOURCE_SHA = "${{ github.event.pull_request.head.sha }}"
          VIZE_INLAY_HINT_CAPTURE = "${{ runner.temp }}/lsp-overlay-custody/processes"
        }
        run = ci.workflowScript("exercise-native-authored-logical-namespace-and-retained-physical-policy.sh")
      }
      new Dynamic {
        name = "Require URI identity review regressions"
        `if` = "${{ always() && runner.os == 'Linux' }}"
        `timeout-minutes` = 15
        env {
          EXPECTED_SOURCE = "${{ github.event.pull_request.head.sha }}"
          VIZE_TEST_REQUIRE_TSGO = "1"
          VIZE_PRIVATE_OVERLAY_CAPTURE = "${{ runner.temp }}/lsp-overlay-custody"
        }
        run = ci.workflowScript("require-uri-identity-review-regressions.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "lsp-overlay-custody-${{ matrix.os }}-${{ github.event.pull_request.head.sha }}-${{ github.run_attempt }}"
          path = """
          ${{ runner.temp }}/lsp-overlay-custody/
          target/nextest/full/native-runtime-provider.json

          """
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
