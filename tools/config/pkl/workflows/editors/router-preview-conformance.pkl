import "../../Actions.pkl" as ci

name = "Router preview source provider"

on {
  pull_request {
    paths = new Listing {
      ".github/workflows/router-preview-conformance.yml"
      ".github/scripts/workflows/router-preview-conformance/**"
      ".github/actions/check-router-page-types/**"
      "tests/snapshots/check/vue-router-page-route-oracle.ts"
      "tests/fixtures/typechecker/page-route-types/**"
      "tests/fixtures/typechecker/experimental-router-preview-593d7ad/**"
      "tests/fixtures/typechecker/experimental-router-mapper-host/**"
      "tests/fixtures/typechecker/experimental-router-project-capability/**"
      "tests/_fixtures/differential/typechecker/router-mapper-capability-10579/**"
      "tests/tooling/router-preview-*.ts"
      "tests/tooling/router-page-workflow.test.ts"
      "tests/tooling/router-experimental-*.ts"
      "tests/tooling/support/router-preview/**"
      "tests/tooling/support/router-experimental-provider.ts"
      "crates/vize_canon/src/batch/virtual_project/typed_router/**"
      "crates/vize_canon/src/batch/virtual_project/typed_router.rs"
      "crates/vize_canon/src/virtual_ts/mapping/model/generated_ranges.rs"
      "crates/vize_canon/src/batch/virtual_project/content_mapper_config.rs"
      "crates/vize_canon/src/batch/virtual_project/content_mapper_config/**"
      "crates/vize_canon/src/batch/virtual_project/content_mapper/project_context.rs"
      "crates/vize_canon/src/batch/virtual_project/content_mapper.rs"
      "crates/vize_canon/src/batch/virtual_project/content_mapper/typed_router_profile_tests.rs"
      "crates/vize/src/commands/content_mapper/project.rs"
      "crates/vize/src/commands/content_mapper/dispatch.rs"
      "crates/vize_canon/src/batch/virtual_project/tsconfig_gen/compiler_inputs.rs"
      "crates/vize_canon/src/batch/virtual_project/tsconfig_gen/compiler_inputs/**"
      "crates/vize/src/commands/content_mapper/typed_router_tests.rs"
      "crates/vize/src/commands/content_mapper/typed_router_tests/**"
      "npm/cli/package.json"
    }
  }
  workflow_dispatch {
    inputs {
      `expected-source-sha` {
        description = "Exact Vize source revision to qualify"
        type = "string"
        required = true
      }
    }
  }
}

permissions {
  contents = "read"
  actions = "read"
}
concurrency {
  group = "router-preview-593d7ad-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  ROUTER_PREVIEW_REVISION = "593d7ad9ff99e95c24be28e962717df0fb2be763"
}

jobs {
  `source-cli` {
    name = "Original source CLI"
    uses = "./.github/workflows/full-source-cli.yml"
  }

  provider {
    name = "Build the actual pinned upstream provider"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    outputs {
      `receipt-sha256` = "${{ steps.build.outputs.receipt-sha256 }}"
      `producer-attempt` = "${{ github.run_attempt }}"
    }
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/router-preview-conformance"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        name = "Require the selected source revision"
        `if` = "github.event_name == 'workflow_dispatch'"
        env { EXPECTED_SOURCE_SHA = "${{ inputs.expected-source-sha }}" }
        run = ci.workflowScript("require-the-selected-source-revision.sh")
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.14.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Checkout the immutable Router source"
        uses = ci.checkout
        with {
          repository = "vuejs/router"
          ref = "${{ env.ROUTER_PREVIEW_REVISION }}"
          path = "target/router-preview-upstream"
          `persist-credentials` = false
        }
      }
      new Dynamic {
        name = "Install the source-declared package manager"
        uses = "pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413"  // v6.1.0
        with {
          version = "12.14.0"
          package_json_file = "target/router-preview-upstream/package.json"
          run_install = false
          cache = true
          cache_dependency_path = "target/router-preview-upstream/pnpm-lock.yaml"
        }
      }
      new Dynamic {
        name = "Build and attest the unchanged upstream package"
        id = "build"
        run = #"node tests/tooling/support/router-preview/build-provider.ts "$GITHUB_WORKSPACE/target/router-preview-upstream" "$RUNNER_TEMP/router-preview-provider""#
      }
      new Dynamic {
        name = "Retain actual provider bytes and raw build observations"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "router-preview-provider-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/router-preview-provider/"
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }

  `manual-helper-probe` {
    name = "Qualify manually explicit real helpers"
    needs = List("source-cli", "provider")
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/router-preview-conformance"
      VIZE_SOURCE_CLI_RECEIPT_SHA256 = "${{ needs.source-cli.outputs.receipt-sha256 }}"
      VIZE_ROUTER_PREVIEW_RECEIPT_SHA256 = "${{ needs.provider.outputs.receipt-sha256 }}"
      VIZE_ROUTER_PREVIEW_PRODUCER_ATTEMPT = "${{ needs.provider.outputs.producer-attempt }}"
      VIZE_TEST_BIN = "${{ github.workspace }}/target/ci/vize"
      VIZE_LSP_BIN = "${{ github.workspace }}/target/ci/vize"
      VIZE_LSP_REQUIRE_SOURCE_BUILD = "1"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.workspaceVp()
      ci.command("Install frozen Vize tooling dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.command("Test frozen provider and whole packet guards", "vp node --test tests/tooling/router-preview-provider.test.ts")
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/restore-source-cli"
        with { producer = "${{ toJSON(needs.source-cli.outputs) }}" }
      }
      new Dynamic {
        name = "Restore the same-run actual provider"
        uses = ci.downloadArtifact
        with {
          name = "router-preview-provider-${{ github.run_id }}-${{ needs.provider.outputs.producer-attempt }}"
          path = "${{ runner.temp }}/router-preview-provider"
          `digest-mismatch` = "error"
        }
      }
      new Dynamic {
        name = "Capture every manual-helper control before strict acceptance"
        id = "probe"
        `continue-on-error` = true
        env { VIZE_ROUTER_PREVIEW_PROVIDER = "${{ runner.temp }}/router-preview-provider" }
        run = "vp node tests/tooling/router-preview-probe.ts"
      }
      new Dynamic {
        name = "Compare automatic route props with vue-tsc and both real plugins"
        id = "automatic"
        `continue-on-error` = true
        env { VIZE_ROUTER_PREVIEW_PROVIDER = "${{ runner.temp }}/router-preview-provider" }
        run = "vp node tests/tooling/router-preview-automatic.ts"
      }
      new Dynamic {
        name = "Retain complete provider, input, process, and source custody"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "router-preview-manual-${{ github.run_id }}-${{ github.run_attempt }}"
          path = """
          target/differential/router-preview-593d7ad/
          target/ci/vize.differential-build.json
          target/ci/vize.source-build.json
          target/ci/vize.source-use.json

          """
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
      new Dynamic {
        name = "Refuse discovery as qualification credit"
        `if` = "always()"
        env {
          PROBE_OUTCOME = "${{ steps.probe.outcome }}"
          AUTOMATIC_OUTCOME = "${{ steps.automatic.outcome }}"
        }
        run = ci.workflowScript("refuse-discovery-as-qualification-credit.sh")
      }
    }
  }

  `page-route-cli-editor` {
    name = "Published Router 5.1 page CLI and editor"
    needs = List("source-cli")
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/router-preview-conformance"
      VIZE_SOURCE_CLI_RECEIPT_SHA256 = "${{ needs.source-cli.outputs.receipt-sha256 }}"
      VIZE_TEST_BIN = "${{ github.workspace }}/target/ci/vize"
      VIZE_LSP_BIN = "${{ github.workspace }}/target/ci/vize"
      VIZE_LSP_REQUIRE_SOURCE_BUILD = "1"
      VIZE_TEST_REQUIRE_TSGO = "1"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        name = "Require the reviewed source revision"
        `if` = "github.event_name == 'workflow_dispatch'"
        env { EXPECTED_SOURCE_SHA = "${{ inputs.expected-source-sha }}" }
        run = ci.workflowScript("require-the-selected-source-revision.sh")
      }
      ci.workspaceVp()
      ci.command("Install frozen source dependencies", "vp install --frozen-lockfile --prefer-offline")
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/restore-source-cli"
        with { producer = "${{ toJSON(needs.source-cli.outputs) }}" }
      }
      new Dynamic {
        name = "Check the unchanged published page CLI and editor oracle"
        uses = "./.github/actions/check-router-page-types"
      }
      new Dynamic {
        name = "Retain complete page inputs, raw observations and source custody"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "router-page-cli-editor-${{ github.run_id }}-${{ github.run_attempt }}"
          path = """
          target/differential/experimental-router-check/
          target/differential/router-page-types/
          target/differential/router-page-types-secondary/
          target/ci/vize.differential-build.json
          target/ci/vize.source-build.json
          target/ci/vize.source-use.json

          """
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }
}
