import "../../Actions.pkl" as ci

name = "VS Code VSIX validation"

on {
  pull_request {
    paths = new Listing {
      ".github/workflows/vscode-vsix-validation.yml"
      "editors/vscode/package.json"
      "tools/commands/editors/vscode/assert-vsix-package.rs"
      "tools/support/lib.rs"
      "tools/support/editors/vsix_configuration.rs"
      "tests/tooling/vscode-vsix-configuration.test.ts"
    }
  }
  // Not a required check, so a queue run gated nothing while it competed with
  // every queue entry for runners. Each main commit is still validated in full;
  // cancel-in-progress coalesces a burst of merges into one run of the newest.
  push {
    branches = List("main")
  }
  workflow_dispatch = null
}
concurrency {
  group = "vscode-vsix-validation-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

jobs {
  validate {
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version-file` = "package.json"
          `run-install` = false
          cache = true
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      ci.command("Install locked dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Exercise the real Rust validator and unchanged initialization behavior"
        run = "vp node --test tests/tooling/vscode-vsix-configuration.test.ts tests/tooling/vscode-extension-core-behavior.test.ts"
      }
      ci.command("Package and validate the production VSIX through rust-script", "vp run --workspace-root package:vscode-extension")
      new Dynamic {
        uses = ci.uploadArtifact
        with {
          name = "validated-vsix-${{ github.event.pull_request.head.sha || github.sha }}"
          path = """
          editors/vscode/dist/vize.vsix
          editors/vscode/dist/extension.cjs

          """
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }
}
