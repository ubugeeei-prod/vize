import "../../Actions.pkl" as ci

name = "Authored editor script queries"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/editor-script-queries.yml"
      ".github/scripts/workflows/editor-script-queries/**"
      "davinci/vize_l0/src/source*"
      "davinci/vize_l0/src/line_index*"
      "davinci/vize_l0/src/line_index/**"
      "davinci/vize_l1/Cargo.toml"
      "davinci/vize_l1/src/embed.rs"
      "davinci/vize_l1/src/embed/authored_program.rs"
      "crates/vize_patina/Cargo.toml"
      "crates/vize_patina/src/rules/script.rs"
      "crates/vize_patina/src/rules/script/**"
      "crates/vize_patina/tests/authored_script_rules/**"
      "crates/vize_canon/Cargo.toml"
      "crates/vize_canon/src/script_parse.rs"
      "crates/vize_canon/src/script_parse/**"
      "crates/vize_canon/src/sfc_typecheck/runner.rs"
      "crates/vize_glyph/Cargo.toml"
      "crates/vize_glyph/src/formatter.rs"
      "crates/vize_glyph/src/formatter/**"
      "crates/vize_glyph/src/options.rs"
      "crates/vize_glyph/src/script/**"
      "crates/vize_maestro/Cargo.toml"
      "crates/vize_maestro/src/source_project.rs"
      "crates/vize_maestro/src/source_project/snapshot*"
      "crates/vize_maestro/src/source_project/script_queries*"
      "crates/vize_maestro/src/source_project/script_queries/**"
      "crates/vize_maestro/src/ide/file_rename*"
      "crates/vize_maestro/src/ide/file_rename/**"
      "crates/vize_maestro/src/server/document_structure/symbols*"
      "crates/vize_maestro/src/server/document_structure/symbols/**"
      "tests/_fixtures/differential/lint/oxlint-script-safe-carrier-7903/ScriptEnd.vue.txt"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "authored-script-queries-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `editor-products` {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("editor-script-queries")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = ci.cache
        with {
          path = """
          ~/.cargo/registry
          ~/.cargo/git

          """
          key = "editor-script-cargo-${{ runner.os }}-${{ runner.arch }}-${{ env.RUSTUP_TOOLCHAIN }}-${{ hashFiles('Cargo.lock') }}"
        }
      }
      new Dynamic {
        name = "Check both original editor readers and their shared parse"
        run = ci.workflowScript("check-both-original-editor-readers-and-their-shared-parse.sh")
      }
      new Dynamic {
        name = "Compare configured script lint results on original Programs"
        run = ci.workflowScript("compare-configured-script-lint-results-on-original-programs.sh")
      }
      new Dynamic {
        name = "Compare the checker diagnostics and both editor products on the same source revision"
        run = ci.workflowScript("compare-the-checker-diagnostics-and-both-editor-products-on-the-same-sou.sh")
      }
      new Dynamic {
        name = "Compare all configured script readers and full formatter products on each revision"
        run = ci.workflowScript("compare-all-configured-script-readers-and-full-formatter-products-on-eac.sh")
      }
    }
  }
}
