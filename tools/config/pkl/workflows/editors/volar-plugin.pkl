import "../../../../ci/lib/Actions.pkl" as ci

name = "Volar Plugin"

// #6830: off the PR tier; main runs it nightly.
on {
  schedule = new Listing {
    new Dynamic { cron = "7 4 * * *" }
  }
  workflow_dispatch {}
}

permissions { contents = "read" }
concurrency {
  group = "volar-plugin-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}

jobs {
  `native-volar-service` {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {

      VIZE_SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("volar-plugin")
      ci.checkoutAt("${{ env.VIZE_SOURCE_SHA }}")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.rust("stable")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "test-js-packages"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Install exact official Volar and TypeScript service providers"
        `working-directory` = "${{ runner.temp }}"
        run = ci.workflowScript("install-exact-official-volar-and-typescript-service-providers.sh")
      }
      new Dynamic {
        name = "Build the actual reviewed native source"
        run = ci.workflowScript("build-the-actual-reviewed-native-source.sh")
      }
      ci.command("Retain immutable source and actual loaded native identity", "node npm/volar/test/source-receipt.js")
      ci.command("Check portable native projection boundaries", "node --test npm/native/test/language-projection.test.cjs")
      ci.command("Exercise actual Volar context and TypeScript language service", "node --test npm/volar/test/service.test.js")
      new Dynamic {
        name = "Check public package declarations"
        run = ci.workflowScript("check-public-package-declarations.sh")
      }
      ci.command("Exercise fresh packed consumers without source loader overrides", "node npm/volar/test/packed-consumer.js")
      new Dynamic {
        uses = "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"  // v4
        `if` = "always()"
        with {
          name = "volar-plugin-${{ env.VIZE_SOURCE_SHA }}"
          path = "${{ runner.temp }}/volar-plugin-evidence"
          `if-no-files-found` = "error"
          `compression-level` = 0
          overwrite = true
        }
      }
    }
  }
}
