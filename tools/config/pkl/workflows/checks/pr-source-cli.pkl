import "../../Actions.pkl" as ci

name = "PR source CLI producer"
on {
  workflow_call {
    inputs {
      `run-cli` {
        required = true
        type = "boolean"
      }
    }
    outputs {
      sha256 { value = "${{ jobs.cli.outputs.sha256 }}" }
      `receipt-sha256` { value = "${{ jobs.cli.outputs.receipt-sha256 }}" }
      `producer-attempt` { value = "${{ jobs.cli.outputs.producer-attempt }}" }
    }
  }
}
permissions { contents = "read" }
env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}
jobs {
  cli {
    name = "Build shared source CLI and SFC oracle"
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    env { CARGO_BUILD_JOBS = "12" }
    outputs {
      sha256 = "${{ steps.pack.outputs.sha256 }}"
      `receipt-sha256` = "${{ steps.pack.outputs.receipt-sha256 }}"
      `producer-attempt` = "${{ steps.pack.outputs.producer-attempt }}"
    }
    steps = new Listing {
      new Dynamic {
        name = "Explain unrelated skip"
        `if` = "${{ !inputs.run-cli }}"
        run = #"echo 'Shared CLI build skipped because no tooling job is selected.' >> "$GITHUB_STEP_SUMMARY""#
      }
      new Dynamic {
        uses = ci.checkout
        `if` = "${{ inputs.run-cli }}"
      }
      new Dynamic {
        uses = "./.github/actions/cache-vp-bootstrap"
        `if` = "${{ inputs.run-cli }}"
      }
      new Dynamic {
        uses = ci.setupVp
        `if` = "${{ inputs.run-cli }}"
        with {
          `node-version-file` = "package.json"
          cache = false
          `run-install` = false
        }
      }
      new Dynamic {
        uses = ci.setupRust
        `if` = "${{ inputs.run-cli }}"
        with {
          toolchain = "1.100.0"
          components = "clippy,rust-src,rustfmt"
          targets = "wasm32-unknown-unknown,wasm32-wasip2"
        }
      }
      new Dynamic {
        uses = ci.setupWild
        `if` = "${{ inputs.run-cli }}"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        `if` = "${{ inputs.run-cli }}"
        with {
          key = "test-scripts"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Build vize CLI and SFC oracle with original receipts"
        `if` = "${{ inputs.run-cli }}"
        run = "cargo build --profile ci -p vize && vp exec node tests/differential/build-receipt.ts && cat target/ci/vize.differential-build.json && cargo build --profile ci -p vize_atelier_sfc --example cli_build_result_oracle"
      }
      new Dynamic {
        name = "Pack original source binaries and receipt"
        `if` = "${{ inputs.run-cli }}"
        id = "pack"
        run = #"node tools/support/compat/github/source-cli-artifact.ts pack "$RUNNER_TEMP/source-cli.tar.gz""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "${{ inputs.run-cli }}"
        with {
          name = "source-cli-${{ github.run_id }}-${{ steps.pack.outputs.producer-attempt }}"
          path = "${{ runner.temp }}/source-cli.tar.gz"
          `if-no-files-found` = "error"
          `compression-level` = 0
          `retention-days` = 7
        }
      }
    }
  }
}
