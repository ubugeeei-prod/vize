import "../../../../ci/lib/Actions.pkl" as ci

name = "Title Policy"

on {
  issues {
    types = List("opened", "edited", "reopened")
  }
  pull_request_target {
    types = List("opened", "edited", "reopened", "synchronize", "ready_for_review")
  }
}

concurrency {
  group = "title-policy-${{ github.event.issue.number || github.event.pull_request.number }}"
  `cancel-in-progress` = false
}

permissions {
  contents = "read"
  issues = "write"
  `pull-requests` = "write"
}

env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }

jobs {
  `issue-pr-title-policy` {
    name = "Normalize titles and assignees"
    `runs-on` = ci.linux
    `timeout-minutes` = 5
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.event.repository.default_branch }}"
          `sparse-checkout` = """
          tools/ci/commands/github/issue-pr-title-policy.ts

          """
          `sparse-checkout-cone-mode` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.14.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Apply issue and PR title policy"
        env {
          GH_TOKEN = "${{ secrets.GITHUB_TOKEN }}"
          GITHUB_TOKEN = "${{ secrets.GITHUB_TOKEN }}"
        }
        run = "node tools/ci/commands/github/issue-pr-title-policy.ts"
      }
    }
  }
}
