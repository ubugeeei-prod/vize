import "../../Actions.pkl" as ci

name = "Benchmark - Type checking gate"

// Fail-closed budget/report job for `vize check` (#3283): tools/benchmarks/scripts/check-gate.mjs
// refuses to emit any timing unless the measured binary reports every planted
// diagnostic in minimal plant projects and in a planted copy of the timed
// corpus, and it records the exact vize/tsgo/vue-tsc/vue versions, entry
// point, file count, byte count, per-row diagnostic counts, and backend
// readiness with the artifact. The full Check workflow runs the fixture parity
// suite on main and by dispatch; this lane also requires planted diagnostics
// before publishing any timing.
//
on {
  workflow_dispatch {
    inputs {
      check_file_count {
        description = "Generated SFC files for the measured corpus"
        required = true
        ["default"] = "500"
      }
      runs {
        description = "Measured runs per row"
        required = true
        ["default"] = "5"
      }
      warmups {
        description = "Warmup runs per row"
        required = true
        ["default"] = "2"
      }
    }
  }
  // Weekly report cadence refreshes the throughput/readiness artifact.
  schedule = new Listing {
    new Dynamic { cron = "17 6 * * 1" }
  }
}

concurrency {
  group = "check-bench-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  VIZE_CHECK_BENCH_FILE_COUNT = "${{ github.event_name == 'workflow_dispatch' && inputs.check_file_count || '500' }}"
  VIZE_CHECK_BENCH_RUNS = "${{ github.event_name == 'workflow_dispatch' && inputs.runs || '5' }}"
  VIZE_CHECK_BENCH_WARMUPS = "${{ github.event_name == 'workflow_dispatch' && inputs.warmups || '2' }}"
}

jobs {
  `check-bench` {
    name = "check-bench"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    permissions { contents = "read" }
    steps = new Listing {
      new Dynamic {
        name = "Checkout benchmark commit"
        uses = ci.checkout
        with {
          ref = "${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}"
        }
      }
      ci.rust("stable")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "check-bench"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.workspaceVp()
      ci.command("Test check benchmark report helpers", "node --test tools/benchmarks/scripts/check-gate-report.test.ts")
      ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
      // Same ci-opt settings the PR benchmark measures under, injected via
      // --config so the profile does not need to exist in Cargo.toml.
      new Dynamic {
        name = "Build Vize CLI"
        run = #"cargo build --profile ci-opt -p vize --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16'"#
      }
      ci.command("Generate benchmark corpus", #"node tools/benchmarks/scripts/generate.mjs "$VIZE_CHECK_BENCH_FILE_COUNT""#)
      new Dynamic {
        name = "Run the fail-closed check benchmark gate"
        env { VIZE_BENCH_REF = "${{ github.ref_name }}" }
        run = #"""
        node tools/benchmarks/scripts/check-gate.mjs \
          --input tools/benchmarks/scripts/__in__ \
          --vize-bin target/ci-opt/vize \
          --check-file-count "$VIZE_CHECK_BENCH_FILE_COUNT" \
          --runs "$VIZE_CHECK_BENCH_RUNS" \
          --warmups "$VIZE_CHECK_BENCH_WARMUPS" \
          --require-vue-tsc \
          --runner-label "blacksmith-32vcpu-ubuntu-2404" \
          --commit "${{ github.event_name == 'pull_request' && github.event.pull_request.head.sha || github.sha }}" \
          --ref "$VIZE_BENCH_REF" \
          --repository "${{ github.repository }}" \
          --out check-gate-summary.md \
          --json check-gate-results.json

        """#
      }
      ci.command("Write job summary", #"cat check-gate-summary.md >> "$GITHUB_STEP_SUMMARY""#)
      new Dynamic {
        name = "Upload check benchmark gate results"
        uses = ci.uploadArtifact
        with {
          name = "check-bench-gate"
          path = """
          check-gate-summary.md
          check-gate-results.json

          """
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
}
