import "../../Actions.pkl" as ci

name = "WSL2 type-check qualification"
`run-name` = "WSL2 type-check ${{ inputs.vize }} (${{ inputs.sizes }}; giant ${{ inputs.giant_blocks }}; monorepo ${{ inputs.monorepo_sfcs }})"

on {
  workflow_dispatch {
    inputs {
      vize {
        description = "Published vize npm spec to measure"
        type = "string"
        required = true
        ["default"] = "latest"
      }
      sizes {
        description = "Comma-separated SFC counts for ordinary projects"
        type = "string"
        ["default"] = "1000"
      }
      giant_blocks {
        description = "Template blocks in one oversized SFC (0 skips it)"
        type = "string"
        ["default"] = "10000"
      }
      monorepo_sfcs {
        description = "SFCs in the project-references monorepo (0 skips it)"
        type = "string"
        ["default"] = "1000"
      }
      runs {
        description = "Warm runs per lane and filesystem"
        type = "string"
        ["default"] = "3"
      }
      lsp_fixtures {
        description = "Generated editor fixtures measured on both filesystems"
        type = "string"
        ["default"] = "scale-1k scale-giant-sfc scale-monorepo"
      }
    }
  }
  pull_request {
    paths = List(".github/workflows/typecheck-wsl2.yml", ".github/scripts/workflows/typecheck-wsl2/**", "tools/benchmarks/scripts/typecheck-wsl2.ts")
  }
}

permissions { contents = "read" }
concurrency {
  group = "wsl2-typecheck-${{ github.event.pull_request.number || inputs.vize }}-${{ inputs.sizes }}-${{ inputs.giant_blocks }}-${{ inputs.monorepo_sfcs }}"
  `cancel-in-progress` = true
}

jobs {
  qualify {
    `if` = "github.event_name == 'workflow_dispatch'"
    // WSL2 needs nested virtualization; Blacksmith Windows runners lack it.
    `runs-on` = "windows-2025"
    `timeout-minutes` = 180
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/typecheck-wsl2"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = "Vampire/setup-wsl@d1da7f2c0322a5ee4f24975344f67fc0f5baf364"  // v7.0.0
        with {
          distribution = "Ubuntu-24.04"
          `wsl-version` = "2"
          `wsl-shell-user` = "root"
          `additional-packages` = "ca-certificates curl time xz-utils"
        }
      }
      new Dynamic {
        name = "Resolve the Windows mount"
        shell = "pwsh"
        run = ci.workflowScript("resolve-the-windows-mount.ps1")
      }
      new Dynamic {
        name = "Install Node 24 in WSL2"
        shell = "wsl-bash {0}"
        env {
          WSLENV = "VIZE_CI_FILES/p"
        }
        run = ci.wslScript("install-node-24-in-wsl2.sh")
      }
      new Dynamic {
        name = "Measure ext4 and Windows mount"
        shell = "wsl-bash {0}"
        env {
          WSLENV = "VIZE_SPEC/u:SIZES/u:GIANT_BLOCKS/u:MONOREPO_SFCS/u:RUNS/u:WSL_MOUNT_ROOT/u:GITHUB_STEP_SUMMARY/u:VIZE_CI_FILES/p"
          VIZE_SPEC = "${{ inputs.vize }}"
          SIZES = "${{ inputs.sizes }}"
          GIANT_BLOCKS = "${{ inputs.giant_blocks }}"
          MONOREPO_SFCS = "${{ inputs.monorepo_sfcs }}"
          RUNS = "${{ inputs.runs }}"
        }
        run = ci.wslScript("measure-ext4-and-windows-mount.sh")
      }
      new Dynamic {
        name = "Measure editor load, edits, requests and memory"
        shell = "wsl-bash {0}"
        env {
          WSLENV = "VIZE_SPEC/u:LSP_FIXTURES/u:WSL_MOUNT_ROOT/u:GITHUB_STEP_SUMMARY/u:VIZE_CI_FILES/p"
          VIZE_SPEC = "${{ inputs.vize }}"
          LSP_FIXTURES = "${{ inputs.lsp_fixtures }}"
        }
        run = ci.wslScript("measure-editor-load-edits-requests-and-memory.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "wsl2-typecheck-${{ github.run_id }}"
          path = "${{ runner.temp }}/vize-wsl2/results/"
          `if-no-files-found` = "warn"
          `retention-days` = 30
        }
      }
    }
  }
}
