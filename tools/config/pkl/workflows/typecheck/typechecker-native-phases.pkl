import "../../Actions.pkl" as ci

name = "Type checker native backend phases"
on {
  workflow_dispatch {
    inputs {
      source_sha {
        description = "Immutable main ancestor; production/dependency/corpus bytes must equal this main driver"
        required = true
        type = "string"
      }
      historical_projection_receipt {
        description = "Run the schedule-only template projection history qualification at the exact driver"
        required = false
        ["default"] = false
        type = "boolean"
      }
    }
  }
  schedule = new Listing {
    new Dynamic { cron = "37 18 * * *" }
  }
}
permissions { contents = "read" }
concurrency {
  group = "${{ github.workflow }}-${{ github.event_name }}-${{ github.ref }}-${{ inputs.source_sha || github.sha }}"
  `cancel-in-progress` = true
}
env {
  CARGO_TERM_COLOR = "always"
  CARGO_INCREMENTAL = "0"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  SOURCE_SHA = "${{ github.event_name == 'workflow_dispatch' && inputs.source_sha || github.sha }}"
  DRIVER_SHA = "${{ github.workflow_sha }}"
  HISTORICAL_PROJECTION_RECEIPT = "${{ inputs.historical_projection_receipt || false }}"
  CARGO_TARGET_DIR = "${{ github.workspace }}/target"
}
jobs {
  `native-phases` {
    name = "Actual CLI shard native phase evidence"
    `runs-on` = ci.linux
    `timeout-minutes` = 40
    steps = new Listing {
      ...ci.stageWorkflowScripts("typechecker-native-phases")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ env.DRIVER_SHA }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        name = "Pin immutable driver, source and freshly fetched main baseline"
        run = #". "${{ env.VIZE_CI_FILES }}/pin-immutable-driver-source-and-freshly-fetched-main-baseline.sh""#
      }
      new Dynamic {
        uses = ci.checkout
        `if` = "github.event_name == 'workflow_dispatch'"
        with {
          ref = "${{ env.SOURCE_SHA }}"
          path = ".native-phase-source"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        name = "Isolate the manual production checkout from driver outputs"
        `if` = "github.event_name == 'workflow_dispatch'"
        run = #". "${{ env.VIZE_CI_FILES }}/isolate-the-manual-production-checkout-from-driver-outputs.sh""#
      }
      new Dynamic {
        uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // stable
        with { toolchain = "stable" }
      }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "typechecker-native-phases"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
          `target-path` = "target"
        }
      }
      new Dynamic {
        uses = ci.setupVp
        with {
          `node-version-file` = "package.json"
          `run-install` = false
        }
      }
      new Dynamic {
        name = "Reject source, lock, corpus, workflow and baseline drift before installation"
        run = #"node tools/benchmarks/scripts/typechecker-native-source-custody.mjs "$RUNNER_TEMP/typechecker-native-source-custody.json""#
      }
      new Dynamic {
        name = "Install pinned native runtime and shared Vue dependencies"
        run = #". "${{ env.VIZE_CI_FILES }}/install-pinned-native-runtime-and-shared-vue-dependencies.sh""#
      }
      new Dynamic {
        name = "Qualify declared template emits and config-scoped Vue helpers in the source CLI and editor"
        `if` = "github.event_name == 'schedule' || (github.event_name == 'workflow_dispatch' && inputs.historical_projection_receipt)"
        env {
          VIZE_TEST_REQUIRE_TSGO = "1"
          VIZE_TEMPLATE_EMIT_CAPTURE = "${{ runner.temp }}/template-dollar-emit"
          VIZE_VUE_HELPER_CAPTURE = "${{ runner.temp }}/config-scoped-vue-helpers"
          VIZE_TSCONFIG_TYPES_CAPTURE = "${{ runner.temp }}/tsconfig-types-extends"
          VIZE_JSX_SLOT_CAPTURE = "${{ runner.temp }}/jsx-slot-parameter-types"
          VIZE_CANON_ALIAS_CAPTURE = "${{ runner.temp }}/canon-selected-alias"
          GH_TOKEN = "${{ github.token }}"
        }
        run = #". "${{ env.VIZE_CI_FILES }}/qualify-declared-template-emits-and-config-scoped-vue-helpers-in-the-sou.sh""#
      }
      new Dynamic {
        name = "Check exact neutral inputs, strict phase parser and projection probe"
        run = #". "${{ env.VIZE_CI_FILES }}/check-exact-neutral-inputs-strict-phase-parser-and-projection-probe.sh""#
      }
      new Dynamic {
        name = "Qualify original outside-import types with the source CLI and official native oracle"
        `if` = "github.event_name == 'schedule'"
        env {
          VIZE_TEST_REQUIRE_TSGO = "1"
          VIZE_TYPECHECK_REGRESSION_CAPTURE = "${{ runner.temp }}/outside-import-types"
        }
        run = #". "${{ env.VIZE_CI_FILES }}/qualify-original-outside-import-types-with-the-source-cli-and-official-n.sh""#
      }
      new Dynamic {
        name = "Verify the original L1 corpus and referenced JavaScript contracts"
        `if` = "github.event_name == 'schedule'"
        run = #". "${{ env.VIZE_CI_FILES }}/verify-the-original-l1-corpus-and-referenced-javascript-contracts.sh""#
      }
      new Dynamic {
        name = "Build the actual production CLI and standalone projection example"
        run = #". "${{ env.VIZE_CI_FILES }}/build-the-actual-production-cli-and-standalone-projection-example.sh""#
      }
      new Dynamic {
        name = "Verify the original reference-path project through native, batch and actual CLI checks"
        `if` = "github.event_name == 'schedule'"
        env {
          VIZE_TEST_REQUIRE_TSGO = "1"
          VIZE_REFERENCE_PATH_CAPTURE_DIR = "${{ runner.temp }}/reference-path-module"
        }
        run = "bash .github/actions/check-reference-path/run.sh"
      }
      new Dynamic {
        name = "Capture every actual shard with byte, map, diagnostic and freshness gates"
        env { RUNNER_LABEL = ci.linux }
        run = #". "${{ env.VIZE_CI_FILES }}/capture-every-actual-shard-with-byte-map-diagnostic-and-freshness-gates.sh""#
      }
      new Dynamic {
        name = "Qualify optional callable defaults in the source CLI and editor"
        `if` = "github.event_name == 'schedule'"
        env {
          VIZE_TEST_REQUIRE_TSGO = "1"
          VIZE_DEFAULT_PROP_CAPTURE = "${{ runner.temp }}/undefined-default-props"
        }
        run = #". "${{ env.VIZE_CI_FILES }}/qualify-optional-callable-defaults-in-the-source-cli-and-editor.sh""#
      }
      new Dynamic {
        name = "Pack complete native evidence and prove reconstruction"
        id = "native-artifact-pack"
        `if` = "always()"
        run = #". "${{ env.VIZE_CI_FILES }}/pack-complete-native-evidence-and-prove-reconstruction.sh""#
      }
      new Dynamic {
        name = "Upload raw native phases, memberships, full reports and generated sources"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "typechecker-native-phases"
          path = "${{ steps.native-artifact-pack.outcome == 'success' && format('{0}/native-phase-artifact', runner.temp) || steps.native-artifact-pack.outputs.raw_paths }}"
          `compression-level` = "${{ steps.native-artifact-pack.outcome == 'success' && '0' || '6' }}"
          `if-no-files-found` = "error"
          `retention-days` = 30
          `include-hidden-files` = true
        }
      }
    }
  }
}
