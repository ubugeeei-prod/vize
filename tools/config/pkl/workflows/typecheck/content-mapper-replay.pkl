import "../../Actions.pkl" as ci

name = "Content mapper replay"
`run-name` = "Content mapper replay ${{ inputs.head || github.sha }} vs ${{ inputs.base || 'merge base' }}"
// Two commits answer the request streams tsc sends for real corpora. Replies
// must match byte for byte; the report times the native CLI and the npm
// launcher, counts allocations and syscalls, and profiles the head CLI with perf.
// A push to bench/content-mapper-replay/** measures the pushed commit against
// its merge base with main, or against the commit a `Replay-Base: <sha>`
// trailer of the pushed commit names, on every corpus with every option on.
on {
  push {
    branches = List("bench/content-mapper-replay/**")
  }
  workflow_dispatch {
    inputs {
      base {
        description = #"Full 40-hex commit measured first (the "before")"#
        type = "string"
        required = true
      }
      head {
        description = "Full 40-hex commit compared against it"
        type = "string"
        required = true
      }
      corpora {
        description = "Comma-separated corpora (misskey, n8n, reka-ui, nuxt-ui)"
        type = "string"
        ["default"] = "misskey,n8n,reka-ui,nuxt-ui"
      }
      runs {
        description = "Alternating timed runs per mapper and mode"
        type = "string"
        ["default"] = "5"
      }
      launcher {
        description = "Also replay through the npm launcher and a release build of @vizejs/native"
        type = "boolean"
        ["default"] = true
      }
      profile {
        description = "Also perf-profile the head CLI and count allocations (--features profiling) and syscalls"
        type = "boolean"
        ["default"] = true
      }
      allow_output_change {
        description = "Publish timing even when the builds answer differently"
        type = "boolean"
        ["default"] = false
      }
      host_runs {
        description = "Alternating tsc and tsrs --fast runs per mapper through a timing proxy (0 skips)"
        type = "string"
        ["default"] = "3"
      }
    }
  }
  // Registers the dispatch-only workflow from its PR; only the tests run there.
  pull_request {
    paths = new Listing {
      ".github/workflows/content-mapper-replay.yml"
      ".github/scripts/workflows/content-mapper-replay/**"
      "tools/benchmarks/scripts/content-mapper-replay*.ts"
      "tests/tooling/content-mapper-replay*.test.ts"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "content-mapper-replay-${{ github.event.pull_request.number || github.ref }}-${{ inputs.head }}-${{ inputs.base }}"
  `cancel-in-progress` = true
}
env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  CARGO_TERM_COLOR = "always"
  CARGO_INCREMENTAL = "0"
}
jobs {
  test {
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic { run = "node --test tests/tooling/content-mapper-replay.test.ts" }
    }
  }

  resolve {
    `if` = "github.event_name != 'pull_request'"
    needs = "test"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    outputs {
      base = "${{ steps.shas.outputs.base }}"
      head = "${{ steps.shas.outputs.head }}"
    }
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/content-mapper-replay"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with {
          `persist-credentials` = false
          `fetch-depth` = 0
        }
      }
      new Dynamic {
        id = "shas"
        env {
          BASE = "${{ inputs.base }}"
          HEAD = "${{ inputs.head || github.sha }}"
        }
        run = ci.workflowScript("shas.sh")
      }
    }
  }

  // cli: the shipped CLI profile. alloc: the same with --features profiling,
  // which counts allocations. perf: head only, with line tables, symbols and
  // frame pointers (C dependencies included) for perf's frame-pointer unwinder.
  build {
    needs = "resolve"
    `runs-on` = ci.linux
    `timeout-minutes` = 90
    strategy {
      matrix {
        variant = List("cli", "alloc", "perf")
      }
    }
    env {

      BASE = "${{ needs.resolve.outputs.base }}"
      HEAD = "${{ needs.resolve.outputs.head }}"
      RUSTUP_TOOLCHAIN = "1.100.0"
      VARIANT = "${{ matrix.variant }}"
      PROFILE_INPUT = "${{ github.event_name == 'push' || inputs.profile }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("content-mapper-replay")
      new Dynamic {
        name = "Validate inputs"
        run = ci.workflowScript("validate-inputs.sh")
      }
      new Dynamic {
        uses = ci.checkout
        `if` = "env.VARIANT == 'cli' || env.PROFILE_INPUT == 'true'"
        with { `persist-credentials` = false }
      }
      new Dynamic {
        uses = ci.setupRust
        `if` = "env.VARIANT == 'cli' || env.PROFILE_INPUT == 'true'"
        with { toolchain = "1.100.0" }
      }
      new Dynamic {
        uses = ci.setupWild
        `if` = "env.VARIANT == 'cli' || env.PROFILE_INPUT == 'true'"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Build"
        `if` = "env.VARIANT == 'cli' || env.PROFILE_INPUT == 'true'"
        run = ci.workflowScript("build.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "env.VARIANT == 'cli' || env.PROFILE_INPUT == 'true'"
        with {
          name = "replay-bin-${{ matrix.variant }}"
          path = "replay-bin/"
          `retention-days` = 7
        }
      }
    }
  }

  replay {
    needs = List("resolve", "build")
    `runs-on` = ci.linux
    `timeout-minutes` = 120
    env {

      BASE = "${{ needs.resolve.outputs.base }}"
      HEAD = "${{ needs.resolve.outputs.head }}"
      CORPORA = "${{ inputs.corpora || 'misskey,n8n,reka-ui,nuxt-ui' }}"
      RUNS = "${{ inputs.runs || '5' }}"
      LAUNCHER = "${{ github.event_name == 'push' || inputs.launcher }}"
      PROFILE = "${{ github.event_name == 'push' || inputs.profile }}"
      ALLOW = "${{ inputs.allow_output_change && '--allow-output-change' || '' }}"
      HOST_RUNS = "${{ inputs.host_runs || '3' }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("content-mapper-replay")
      new Dynamic {
        name = "Validate inputs"
        run = ci.workflowScript("validate-inputs-2.sh")
      }
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.workspaceVp()
      new Dynamic {
        uses = ci.setupRust
        `if` = "env.LAUNCHER == 'true'"
        with { toolchain = "1.100.0" }
      }
      new Dynamic {
        uses = ci.setupWild
        `if` = "env.LAUNCHER == 'true'"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-script"
        `if` = "env.LAUNCHER == 'true'"
      }
      new Dynamic {
        uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
        with {
          pattern = "replay-bin-*"
          path = "replay-bin"
          `merge-multiple` = true
        }
      }
      new Dynamic {
        name = "Hydrate the corpora and install the locked hosts and corpus packages"
        run = ci.workflowScript("hydrate-the-corpora-and-install-the-locked-hosts-and-corpus-packages.sh")
      }
      new Dynamic {
        name = "Build the npm launcher and the native binding for base and head"
        `if` = "env.LAUNCHER == 'true'"
        run = ci.workflowScript("build-the-npm-launcher-and-the-native-binding-for-base-and-head.sh")
      }
      new Dynamic {
        name = "Record tsc's request streams"
        run = ci.workflowScript("record-tsc-s-request-streams.sh")
      }
      new Dynamic {
        name = "Replay"
        run = ci.workflowScript("replay.sh")
      }
      new Dynamic {
        name = "Host runs through a timing proxy"
        `if` = "env.HOST_RUNS != '0'"
        run = ci.workflowScript("host-runs-through-a-timing-proxy.sh")
      }
      new Dynamic {
        name = "Count allocations"
        `if` = "env.PROFILE == 'true'"
        run = ci.workflowScript("count-allocations.sh")
      }
      new Dynamic {
        name = "Profile the head CLI and count syscalls"
        `if` = "env.PROFILE == 'true'"
        run = ci.workflowScript("profile-the-head-cli-and-count-syscalls.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "replay-out"
          path = "${{ runner.temp }}/replay-out/"
          `if-no-files-found` = "warn"
        }
      }
    }
  }
}
