import "../../Actions.pkl" as ci

name = "Content Mapper worker stack"

on {
  workflow_dispatch = null
  pull_request {
    types = List("opened", "synchronize", "reopened")
    paths = new Listing {
      ".github/workflows/content-mapper-worker-stack.yml"
      ".github/scripts/workflows/content-mapper-worker-stack/**"
      "tools/benchmarks/scripts/content-mapper-worker-stack.ts"
      "tools/benchmarks/scripts/content-mapper-worker-stack-core.ts"
      "tests/tooling/content-mapper-worker-stack.test.ts"
      "tools/support/compat/content-mapper/admission-hosts*.ts"
      "tests/tooling/content-mapper-admission-hosts*.test.ts"
      "tests/_fixtures/tooling/content-mapper-admission-provider/**"
      "crates/vize/src/commands/content_mapper.rs"
      "crates/vize/src/commands/content_mapper/dispatch.rs"
      "crates/vize/src/commands/content_mapper/dispatch/**"
      "crates/vize_croquis/src/scope/**"
      "crates/vize_canon/src/virtual_ts/scope.rs"
      "crates/vize_canon/src/virtual_ts/scope/**"
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "content-mapper-worker-stack-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env {
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
}

jobs {
  calibrate {
    name = "Nested closure stack (${{ matrix.profile }})"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    strategy {
      `fail-fast` = false
      matrix {
        profile = List("ci", "ci-opt")
      }
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("content-mapper-worker-stack")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ env.SOURCE_SHA }}"
          `persist-credentials` = false
          `fetch-depth` = 0
        }
      }
      ci.rust("1.100.0")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.command("Verify calibration protocol and limit contracts", "node --test tests/tooling/content-mapper-worker-stack.test.ts")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "content-mapper-worker-stack"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}-${{ matrix.profile }}"
        }
      }
      new Dynamic {
        name = "Witness the native admission regression on the known comparison source"
        `if` = "github.event_name == 'pull_request'"
        env {
          BUILD_PROFILE = "${{ matrix.profile }}"
          COMPARISON_SHA = "${{ github.event.pull_request.base.sha }}"
        }
        run = ci.workflowScript("witness-the-native-admission-regression-on-the-known-comparison-source.sh")
      }
      new Dynamic {
        name = "Build exact mapper source"
        env { BUILD_PROFILE = "${{ matrix.profile }}" }
        run = ci.workflowScript("build-exact-mapper-source.sh")
      }
      new Dynamic {
        name = "Verify worker spawn and admission release scoped threads"
        env { BUILD_PROFILE = "${{ matrix.profile }}" }
        run = ci.workflowScript("verify-worker-spawn-and-admission-release-scoped-threads.sh")
      }
      new Dynamic {
        name = "Probe bounded child processes and retain complete packets"
        env { BUILD_PROFILE = "${{ matrix.profile }}" }
        run = ci.workflowScript("probe-bounded-child-processes-and-retain-complete-packets.sh")
      }
      new Dynamic {
        name = "Retain complete source and process evidence"
        `if` = "always()"
        uses = "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"  // v4
        with {
          name = "content-mapper-worker-stack-${{ matrix.profile }}-${{ env.SOURCE_SHA }}"
          path = """
          ${{ runner.temp }}/worker-stack
          ${{ runner.temp }}/worker-spawn-${{ matrix.profile }}.log
          ${{ runner.temp }}/worker-admission-before-${{ matrix.profile }}.log
          ${{ runner.temp }}/worker-admission-before-${{ matrix.profile }}.jsonl
          ${{ runner.temp }}/worker-admission-head-${{ matrix.profile }}.jsonl

          """
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }

  `host-pipes` {
    name = "Normal Node mapper pipes with both pinned Go hosts"
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    steps = new Listing {
      ...ci.stageWorkflowScripts("content-mapper-worker-stack")
      new Dynamic {
        name = "Reserve five minutes for functional raw retention"
        run = ci.workflowScript("reserve-five-minutes-for-functional-raw-retention.sh")
      }
      ci.checkoutAt("${{ env.SOURCE_SHA }}")
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        uses = ci.setupVp
        with {
          `node-version` = "26.12.1"
          `run-install` = false
          cache = true
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "test-js-packages"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Build the reviewed normal Node and NAPI endpoint with a frozen provider"
        env {
          CARGO_INCREMENTAL = "0"
          CARGO_BUILD_JOBS = "16"
        }
        run = ci.workflowScript("build-the-reviewed-normal-node-and-napi-endpoint-with-a-frozen-provider.sh")
      }
      new Dynamic {
        name = "Require normal host completion, complete packets and authored negative controls"
        run = ci.workflowScript("require-normal-host-completion-complete-packets-and-authored-negative-co.sh")
      }
      new Dynamic {
        name = "Preserve functional packets before accepting the run"
        `if` = "always()"
        uses = "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"  // v4
        with {
          name = "content-mapper-admission-hosts-${{ env.SOURCE_SHA }}"
          path = """
          ${{ runner.temp }}/mapper-admission
          !${{ runner.temp }}/mapper-admission/**/project/node_modules/**

          """
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }
}
