import "../../Actions.pkl" as ci

name = "Checker constructor emitter parity"

on {
  workflow_dispatch {
    inputs {
      `base-sha` {
        description = "Exact source baseline for complete existing projection parity"
        required = true
        type = "string"
      }
      `measure-source` {
        description = "Capture optimized source-API allocation requests and paired timing"
        type = "boolean"
        ["default"] = false
      }
    }
  }
  pull_request {
    paths = new Listing {
      "crates/vize_canon/src/virtual_ts/generator/component_constructors.rs"
      "crates/vize_canon/src/virtual_ts/generator/component_constructors/**"
      "crates/vize_canon/src/virtual_ts/props.rs"
      "crates/vize_canon/tests/constructor_emission_projection.rs"
      ".github/workflows/checker-constructor-emitter.yml"
      ".github/scripts/workflows/checker-constructor-emitter/**"
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "constructor-emitter-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

jobs {
  parity {
    `if` = "github.event_name == 'workflow_dispatch' || startsWith(github.event.pull_request.title, 'refactor(canon)') || startsWith(github.event.pull_request.title, 'perf(canon)')"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      BASE_SHA = "${{ inputs.base-sha || github.event.pull_request.base.sha }}"
      HEAD_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("checker-constructor-emitter")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.event.pull_request.head.sha || github.sha }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.rust("stable")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "test-scripts"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      new Dynamic {
        name = "Capture exact base and head through the identical observation harness"
        shell = "bash"
        run = ci.workflowScript("capture-exact-base-and-head-through-the-identical-observation-harness.sh")
      }
      new Dynamic {
        name = "Retain isolated compiled observer custody"
        shell = "bash"
        run = ci.workflowScript("retain-isolated-compiled-observer-custody.sh")
      }
      new Dynamic {
        name = "Compare complete generated bytes, projection mappings and semantic links"
        shell = "bash"
        run = ci.workflowScript("compare-complete-generated-bytes-projection-mappings-and-semantic-links.sh")
      }
      new Dynamic {
        name = "Measure optimized source APIs on the identical base and head observer"
        `if` = "${{ github.event_name == 'workflow_dispatch' && inputs.measure-source }}"
        shell = "bash"
        run = ci.workflowScript("measure-optimized-source-apis-on-the-identical-base-and-head-observer.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "constructor-emitter-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/constructor-emitter"
          `if-no-files-found` = "error"
          `retention-days` = 7
        }
      }
    }
  }
}
