import "../../Actions.pkl" as ci

name = "Retained TSRX module products"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/retained-tsrx.yml"
      ".github/scripts/workflows/retained-tsrx/**"
      "davinci/vize_l1/src/markup/tsrx*"
      "davinci/vize_l1/src/markup/tsrx/**"
      "davinci/vize_l1_to_l2/Cargo.toml"
      "davinci/vize_l1_to_l2/src/lower.rs"
      "davinci/vize_l1_to_l2/src/lower/tsrx.rs"
      "davinci/vize_l4/tests/tsrx_retained.rs"
      "davinci/vize_l2/Cargo.toml"
      "davinci/vize_l2/src/lang/tsrx*"
      "davinci/vize_l2/src/lang/tsrx/**"
      "davinci/vize_l4/Cargo.toml"
      "davinci/vize_l4/src/lang/tsrx*"
      "davinci/vize_l4/src/lang/tsrx/**"
      "crates/vize_patina/Cargo.toml"
      "crates/vize_patina/src/linter/engine/tsrx*"
      "crates/vize_patina/src/linter/engine/tsrx/**"
      "crates/vize_patina/tests/prepared_tsrx/**"
      "crates/vize_patina/src/markup/**"
      "tests/_fixtures/tsrx/**"
      "tests/tooling/tsrx-oracle/**"
      "tests/tooling/tsrx-oracle.test.ts"
      "tests/tooling/tsrx-mount.test.ts"
      "tests/tooling/jsx-vapor-oracle/tsrx-mount.ts"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "retained-tsrx-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `shared-regions` {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("retained-tsrx")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      ci.use("./.github/actions/cache-vp-bootstrap")
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version-file` = "package.json"
          cache = true
          `cache-save` = false
          `run-install` = false
        }
      }
      new Dynamic {
        name = "Install the pinned reference compiler and Vue mount oracle"
        run = "node tools/support/github/vp-install.ts --filter @vize/tsrx-oracle --filter @vize/jsx-vapor-oracle --filter './tests'"
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Compare retained and independent producers and the mounted reference"
        shell = "bash"
        run = ci.workflowScript("compare-retained-and-independent-producers-and-the-mounted-reference.sh")
      }
    }
  }
}
