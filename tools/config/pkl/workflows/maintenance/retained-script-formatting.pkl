import "../../Actions.pkl" as ci

name = "Retained script formatting"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/retained-script-formatting.yml"
      "crates/vize_glyph/Cargo.toml"
      "crates/vize_glyph/src/lib.rs"
      "crates/vize_glyph/src/script*"
      "crates/vize_glyph/src/script/**"
      "crates/vize_glyph/src/options*"
      "crates/vize_glyph/src/options/**"
      "crates/vize_glyph/src/sort_imports.rs"
      "crates/vize_glyph/tests/program_snapshot/**"
      "crates/vize_glyph/tests/selected_script_programs/**"
      "davinci/vize_l1/Cargo.toml"
      "davinci/vize_l1/src/container/vue.rs"
      "davinci/vize_l1/src/container/vue/**"
      "davinci/vize_l1/src/embed/source.rs"
      "davinci/vize_l2/Cargo.toml"
      "davinci/vize_l2/src/query/vue.rs"
      "davinci/vize_l2/src/query/vue/**"
      "davinci/vize_l1/src/embed/syntax.rs"
      "davinci/vize_l1/src/embed/syntax/**"
      "upstream/forks/oxc_formatter/**"
    }
  }
}

permissions { contents = "read" }
concurrency {
  group = "retained-script-formatting-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}

jobs {
  `retained-format` {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
    }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      ci.rust("1.100.0")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Compare formatter results on original files and record paired requests"
        env {
          VIZE_RETAINED_FORMAT_SAMPLE = "${{ runner.temp }}/retained-format-files"
          VIZE_RETAINED_FORMAT_MANIFEST = "${{ runner.temp }}/retained-format-files"
        }
        run = """
        set -euo pipefail
        flags=(--locked --profile ci-opt -p vize_glyph --features retained-script)
        cargo test "${flags[@]}" --lib script::snapshot::
        cargo test "${flags[@]}" --test auto_line_endings --test sfc_empty_script_blocks --test import_sorting --test program_snapshot
        git ls-files -z -- '*.vue' '*.vue.txt' '*.js' '*.mjs' '*.cjs' '*.jsx' '*.ts' '*.mts' '*.cts' '*.tsx' > "$VIZE_RETAINED_FORMAT_MANIFEST"
        cargo test "${flags[@]}" --lib script::snapshot::tests::corpus::original_sources -- --exact --ignored --nocapture
        cargo test "${flags[@]}" --lib script::snapshot::tests::profile::paired_formatter_requests -- --exact --ignored --nocapture
        cargo test "${flags[@]}" --lib script::snapshot::tests::profile::corpus::original_formatter_requests -- --exact --ignored --nocapture

        """
      }
      new Dynamic {
        name = "Compare shared Vue Program inputs through semantic and formatter APIs"
        env {
          VIZE_SCRIPT_PROGRAMS_MANIFEST = "${{ runner.temp }}/vue-script-inputs"
          VIZE_SCRIPT_PROGRAMS_SAMPLE = "${{ runner.temp }}/vue-script-inputs"
        }
        run = """
        set -euo pipefail
        cargo test --locked --profile ci-opt -p vize_l1 --features script-queries --lib container::vue::programs::
        cargo test --locked --profile ci-opt -p vize_l2 --features script-queries --lib query::vue::
        flags=(--locked --profile ci-opt -p vize_glyph --features retained-script,vize_l2/script-queries --test selected_script_programs)
        git ls-files -z -- '*.vue' '*.vue.txt' > "$VIZE_SCRIPT_PROGRAMS_MANIFEST"
        cargo test "${flags[@]}"
        cargo test "${flags[@]}" original_sources -- --exact --ignored --nocapture
        cargo test "${flags[@]}" profile::shared_program_requests -- --exact --ignored --nocapture
        cargo test "${flags[@]}" profile::corpus::original_program_requests -- --exact --ignored --nocapture

        """
      }
    }
  }
}
