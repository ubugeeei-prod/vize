import "../../Actions.pkl" as ci

name = "Tool codegen equivalence"
on {
  workflow_dispatch {
    inputs {
      base {
        description = "Full base commit SHA"
        required = true
        type = "string"
      }
      head {
        description = "Full candidate commit SHA"
        required = true
        type = "string"
      }
      package {
        description = "Workspace library package to compare"
        required = true
        ["default"] = "vize_maestro"
        type = "string"
      }
      product {
        description = "Library (lib), binary (bin:NAME), or packaged native image (node-addon)"
        required = true
        ["default"] = "lib"
        type = "string"
      }
    }
  }
  pull_request {
    paths = new Listing {
      ".github/workflows/tool-codegen-equivalence.yml"
      ".github/scripts/workflows/tool-codegen-equivalence/**"
      "tools/commands/levels/codegen-equivalence.ts"
      "tests/tooling/levels-codegen-equivalence.test.ts"
    }
  }
}
permissions { contents = "read" }
jobs {
  compare {
    name = "Compare ${{ inputs.package || 'vize_maestro' }} ${{ inputs.product || 'lib' }} ${{ matrix.mode }}"
    `runs-on` = ci.linux
    `timeout-minutes` = 35
    strategy {
      `fail-fast` = false
      matrix {
        mode = List("default", "portable")
      }
    }
    env {

      BASE_SHA = "${{ inputs.base || github.event.pull_request.base.sha }}"
      HEAD_SHA = "${{ inputs.head || github.event.pull_request.head.sha }}"
      PACKAGE = "${{ inputs.package || 'vize_maestro' }}"
      PRODUCT = "${{ inputs.product || 'lib' }}"
      MODE = "${{ matrix.mode }}"
      CARGO_BUILD_JOBS = "24"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("tool-codegen-equivalence")
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      new Dynamic {
        uses = ci.setupNode
        with { `node-version` = "24.14.0" }
      }
      ci.rust("1.100.0")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Verify comparison controls and fetch both commits"
        run = #". "${{ env.VIZE_CI_FILES }}/verify-comparison-controls-and-fetch-both-commits.sh""#
      }
      new Dynamic {
        name = "Compare independently compiled products"
        run = #". "${{ env.VIZE_CI_FILES }}/compare-independently-compiled-products.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "tool-codegen-${{ matrix.mode }}"
          path = "${{ runner.temp }}/codegen-${{ matrix.mode }}.json"
          `if-no-files-found` = "ignore"
        }
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "failure() && (startsWith(env.PRODUCT, 'bin:') || env.PRODUCT == 'node-addon')"
        with {
          name = "tool-executable-difference-${{ matrix.mode }}"
          path = "${{ runner.temp }}/codegen-${{ matrix.mode }}.json.executables-*/*"
          `retention-days` = 7
          `if-no-files-found` = "ignore"
        }
      }
    }
  }
}
