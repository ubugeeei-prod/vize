import "../../Actions.pkl" as ci

name = "Packed browser tool equivalence"
on {
  workflow_dispatch {
    inputs {
      base {
        description = "Full base commit SHA"
        required = true
        type = "string"
      }
      head {
        description = "Full candidate commit SHA"
        required = true
        type = "string"
      }
    }
  }
  pull_request {
    paths = new Listing {
      ".github/workflows/packed-browser-equivalence.yml"
      "tools/commands/levels/packed-browser-equivalence.ts"
      "tools/support/compat/npm/wasm-responses.ts"
      "tests/tooling/packed-browser-equivalence.test.ts"
    }
  }
}
permissions { contents = "read" }
jobs {
  compare {
    name = "Compare packed browser tool outputs"
    `runs-on` = ci.linux
    `timeout-minutes` = 45
    env {
      BASE_SHA = "${{ inputs.base || github.event.pull_request.base.sha }}"
      HEAD_SHA = "${{ inputs.head || github.event.pull_request.head.sha }}"
      RUSTUP_TOOLCHAIN = "1.100.0"
      CARGO_BUILD_JOBS = "24"
    }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version` = "24.14.0"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          targets = "wasm32-unknown-unknown"
        }
      }
      new Dynamic {
        uses = "taiki-e/install-action@184183c2401be73c3bf42c2e61268aa5855379c1"
        with { tool = "wasm-bindgen-cli@0.2.129" }
      }
      new Dynamic {
        name = "Compare immutable builds and execute the unpacked public APIs"
        run = #"""
        set -euo pipefail
        node --test tests/tooling/packed-browser-equivalence.test.ts
        [[ "$BASE_SHA" =~ ^[0-9a-f]{40}$ && "$HEAD_SHA" =~ ^[0-9a-f]{40}$ ]]
        git fetch --no-tags --depth=1 origin "$BASE_SHA" "$HEAD_SHA"
        node tools/commands/levels/packed-browser-equivalence.ts \
          "$BASE_SHA" "$HEAD_SHA" "$RUNNER_TEMP/browser-package.json" | tee -a "$GITHUB_STEP_SUMMARY"

        """#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "packed-browser-equivalence"
          path = "${{ runner.temp }}/browser-package.json"
          `if-no-files-found` = "ignore"
        }
      }
    }
  }
}
