import "../../Actions.pkl" as ci

name = "Plugin and Doctor template products"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/plugin-template-products.yml"
      "crates/vize/Cargo.toml"
      "crates/vize/src/plugin_template.rs"
      "crates/vize/tests/plugin_template_products/**"
      "crates/vize/tests/inspector_template_products/**"
      "crates/vize_curator/Cargo.toml"
      "crates/vize_curator/src/inspector.rs"
      "crates/vize_curator/src/inspector/feed.rs"
      "crates/vize_curator/src/inspector/payload.rs"
      "crates/vize_curator/src/inspector/stages.rs"
      "crates/vize_curator/src/inspector/stages/**"
      "davinci/vize_l1/src/markup/**"
      "davinci/vize_l1_to_l2/src/pass.rs"
      "davinci/vize_l1_to_l2/src/dialect/vue/pass/**"
      "crates/vize_atelier_sfc/src/parse/**"
      "crates/vize_patina/src/plugin_batch/**"
      "crates/vize_patina/Cargo.toml"
      "crates/vize_croquis/src/sfc/**"
      "crates/vize_croquis_cf/Cargo.toml"
      "crates/vize_croquis_cf/src/analyzer/core/files.rs"
      "crates/vize_croquis_cf/src/analyzer/core/files/**"
      "crates/vize_croquis_cf/src/analyzer/core/deps.rs"
      "crates/vize_croquis_cf/src/rules/complexity/**"
      "crates/vize_doctor/src/application_analysis*"
      "crates/vize_doctor/src/application_analysis/**"
      "examples/cli/src/**/*.vue"
      "examples/html-conformance/src/**/*.vue"
      "examples/vite-musea/src/**/*.vue"
      "davinci/vize_l1_to_l2/src/pass/cfg*"
      "davinci/vize_l1_to_l2/src/pass/cfg/**"
      "davinci/vize_l1_to_l2/src/dialect/vue/lower.rs"
      "davinci/vize_l2/src/analysis/static_facts/**"
      "davinci/vize_l1_to_l2/tests/cfg_complexity_oracle/**"
      "davinci/vize_l1_to_l2/tests/composed_template_alloc.rs"
      "davinci/vize_l2/src/analysis/template_complexity*"
      "davinci/vize_l2/src/analysis/template_complexity/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "plugin-template-products-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `plugin-products` {
    name = "Plugin and Doctor ${{ matrix.suite }}"
    strategy {
      `fail-fast` = false
      matrix {
        suite = List("correctness", "performance")
      }
    }
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = ci.cache
        with {
          path = """
          ~/.cargo/registry
          ~/.cargo/git

          """
          key = "plugin-products-cargo-${{ runner.os }}-${{ runner.arch }}-${{ env.RUSTUP_TOOLCHAIN }}-${{ hashFiles('Cargo.lock') }}"
        }
      }
      ci.command("Select original Vue documents", #"git ls-files -z -- '*.vue' '*.vue.txt' > "$RUNNER_TEMP/plugin-templates""#)
      new Dynamic {
        name = "Compare original SDK reports and Doctor component records"
        `if` = "matrix.suite == 'correctness'"
        run = """
        set -euo pipefail
        flags=(--locked --profile ci-opt)
        suite=(-p vize --features plugin-project-facts --test plugin_template_products)
        export VIZE_PLUGIN_TEMPLATE_INPUTS="$RUNNER_TEMP/plugin-templates"
        cargo clippy "${flags[@]}" -p vize_patina --features plugin-template-facts --lib --no-deps -- -D warnings
        cargo clippy "${flags[@]}" -p vize --features plugin-project-facts --lib --no-deps -- -D warnings
        cargo test "${flags[@]}" -p vize_patina --features plugin-template-facts --lib plugin_batch::
        cargo test "${flags[@]}" -p vize_doctor --features application-analysis --test application_complexity
        cargo test "${flags[@]}" "${suite[@]}" -- --test-threads=1
        cargo test "${flags[@]}" "${suite[@]}" original_packets_and_component_records_match -- --ignored --nocapture --test-threads=1

        """
      }
      new Dynamic {
        name = "Measure complete plugin and Doctor responses"
        `if` = "matrix.suite == 'performance'"
        run = """
        set -euo pipefail
        export VIZE_PLUGIN_TEMPLATE_INPUTS="$RUNNER_TEMP/plugin-templates"
        cargo test --locked --profile ci-opt -p vize --features plugin-project-facts --test plugin_template_products measure_complete_ -- --ignored --nocapture --test-threads=1

        """
      }
      new Dynamic {
        name = "Qualify standalone and composed static facts and complexity"
        `if` = "matrix.suite == 'correctness'"
        run = """
        set -euo pipefail
        flags=(--locked --profile ci-opt -p vize_l1_to_l2)
        export VIZE_COMPOSED_TEMPLATE_FILES="$RUNNER_TEMP/authored-static-templates"
        git ls-files -z -- '*.vue' > "$VIZE_COMPOSED_TEMPLATE_FILES"
        cargo test "${flags[@]}" --test cfg_complexity_oracle composed:: -- --include-ignored --nocapture --test-threads=1
        cargo test "${flags[@]}" --test composed_template_alloc

        """
      }
    }
  }

  `inspector-products` {
    name = "Inspector and Doctor template products"
    `runs-on` = ci.linux
    `timeout-minutes` = 35
    env {
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Compare public stage feeds, Doctor component records and complete request costs"
        run = """
        set -euo pipefail
        flags=(--locked --profile ci-opt)
        export VIZE_INSPECTOR_TEMPLATE_INPUTS="$RUNNER_TEMP/inspector-templates"
        git ls-files -z -- '*.vue' '*.vue.txt' > "$VIZE_INSPECTOR_TEMPLATE_INPUTS"
        cargo clippy "${flags[@]}" -p vize_curator --features inspector-template-products --lib --no-deps -- -D warnings
        cargo test "${flags[@]}" -p vize_curator --features inspector-template-products --lib inspector:: -- --include-ignored --nocapture --test-threads=1
        cargo test "${flags[@]}" -p vize --no-default-features --features inspector-template-products --test inspector_template_products -- --include-ignored --nocapture --test-threads=1

        """
      }
    }
  }
}
