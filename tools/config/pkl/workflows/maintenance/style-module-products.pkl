import "../../Actions.pkl" as ci

name = "Style module products"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/style-module-products.yml"
      "davinci/vize_l1/Cargo.toml"
      "davinci/vize_l1/src/container/lang.rs"
      "davinci/vize_l1/src/css.rs"
      "davinci/vize_l1/src/css/**"
      "crates/vize_patina/Cargo.toml"
      "crates/vize_patina/src/rules/css.rs"
      "crates/vize_patina/src/rules/css/**"
      "crates/vize_patina/src/linter/css_rules.rs"
      "crates/vize_canon/Cargo.toml"
      "crates/vize_canon/src/batch/virtual_project/build/css_modules.rs"
      "crates/vize_canon/src/batch/virtual_project/build/css_modules/**"
      "crates/vize_maestro/Cargo.toml"
      "crates/vize_maestro/src/document/store.rs"
      "crates/vize_maestro/src/ide/context.rs"
      "crates/vize_maestro/src/ide/completion.rs"
      "crates/vize_maestro/src/ide/completion/template.rs"
      "crates/vize_maestro/src/ide/completion/template/css_modules.rs"
      "crates/vize_maestro/src/ide/completion/template/css_modules/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "style-module-products-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `style-modules` {
    name = "Style module products ${{ matrix.suite }}"
    strategy {
      `fail-fast` = false
      matrix {
        suite = List("correctness", "performance")
      }
    }
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    env {
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = ci.cache
        with {
          path = """
          ~/.cargo/registry
          ~/.cargo/git

          """
          key = "style-module-products-cargo-${{ runner.os }}-${{ runner.arch }}-${{ env.RUSTUP_TOOLCHAIN }}-${{ hashFiles('Cargo.lock') }}"
        }
      }
      ci.command("Select original Vue sources", #"git ls-files -z -- '*.vue' '*.vue.txt' > "$RUNNER_TEMP/style-module-sources""#)
      new Dynamic {
        name = "Compare original checker options and completion responses"
        `if` = "matrix.suite == 'correctness'"
        run = """
        set -euo pipefail
        flags=(--locked --profile ci-opt)
        editor=(-p vize_maestro --features experimental-style-lint-products,micro-profiling --lib)
        cargo clippy "${flags[@]}" -p vize_patina --features observed-style-rules --lib --no-deps -- -D warnings
        cargo test "${flags[@]}" -p vize_patina --features observed-style-rules --lib rules::css
        cargo clippy "${flags[@]}" -p vize_canon --features observed-style-modules --lib --no-deps -- -D warnings
        cargo clippy "${flags[@]}" "${editor[@]}" --no-deps -- -D warnings
        cargo test "${flags[@]}" -p vize_l1 --features observed-styles --lib css::lang::
        cargo test "${flags[@]}" -p vize_canon --features observed-style-modules --lib css_module
        cargo test "${flags[@]}" "${editor[@]}" css_module
        export VIZE_STYLE_MODULE_INPUTS="$RUNNER_TEMP/style-module-sources"
        cargo test "${flags[@]}" "${editor[@]}" original_style_module_products_match -- --ignored --nocapture --test-threads=1
        cargo test "${flags[@]}" "${editor[@]}" original_style_lint_products_match -- --ignored --nocapture --test-threads=1

        """
      }
      new Dynamic {
        name = "Measure complete original and shared member requests"
        `if` = "matrix.suite == 'performance'"
        run = """
        export VIZE_STYLE_MODULE_INPUTS="$RUNNER_TEMP/style-module-sources"
        cargo test --locked --profile ci-opt -p vize_maestro --features experimental-style-lint-products,micro-profiling --lib paired_style_module_requests -- --ignored --nocapture --test-threads=1
        cargo test --locked --profile ci-opt -p vize_maestro --features experimental-style-lint-products,micro-profiling --lib paired_style_lint_requests -- --ignored --nocapture --test-threads=1

        """
      }
    }
  }
}
