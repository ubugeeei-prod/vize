import "../../Actions.pkl" as ci

name = "Style module products"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/style-module-products.yml"
      ".github/scripts/workflows/style-module-products/**"
      "davinci/vize_l0/Cargo.toml"
      "davinci/vize_l0/src/line_index.rs"
      "davinci/vize_l0/src/line_index/lsp_breaks.rs"
      "davinci/vize_l0/src/line_index/lsp_breaks/**"
      "davinci/vize_l0/src/line_index/line_breaks.rs"
      "davinci/vize_l0/tests/lsp_line_breaks.rs"
      "davinci/vize_l1/src/container/vue/descriptor/style_blocks.rs"
      "davinci/vize_l1_to_l2/src/lower/text/component.rs"
      "davinci/vize_l1_to_l2/src/native/text.rs"
      "davinci/vize_l2/src/style.rs"
      "davinci/vize_l2/src/lang/scss.rs"
      "davinci/vize_l2/src/lang/scss/**"
      "davinci/vize_l4/src/targets/css_rules.rs"
      "davinci/vize_l4/src/targets/scss.rs"
      "crates/vize_atelier_sfc/src/native.rs"
      "crates/vize_atelier_sfc/src/native/scope.rs"
      "crates/vize_atelier_sfc/src/native/styles.rs"
      "crates/vize_atelier_sfc/src/native/style_products.rs"
      "crates/vize_atelier_sfc/tests/component_scss/**"
      "crates/vize_atelier_sfc/tests/native_sfc_scss.rs"
      "crates/vize_atelier_sfc/tests/bundler_toolchain_session.rs"
      "crates/vize_maestro/src/source_project/scoped_component.rs"
      "crates/vize_maestro/src/source_project/toolchain_session.rs"
      "crates/vize_maestro/src/source_project/toolchain_session/**"
      "crates/vize_incremental/providers/graph/tests/incremental.rs"
      "crates/vize_incremental/providers/graph/tests/incremental/**"
      "tests/fixtures/shared-toolchain/**"
      "npm/builder/parcel/package.json"
      "davinci/vize_l4/src/write/source_map/indexed.rs"
      "davinci/vize_l4/src/write/source_map/indexed/**"
      "crates/vize_maestro/src/source_project/style_format.rs"
      "crates/vize_maestro/src/source_project/style_format/**"
      "tests/formal/source-map/**"
      "crates/vize_maestro/src/ide/diagnostics/corsa/ambient_project/positions.rs"
      "tests/formal/style-format/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "style-module-products-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `authored-coordinates` {
    name = "Authored coordinates and style header proofs"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ...ci.stageWorkflowScripts("style-module-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          command = "kani"
          args = "davinci/vize_l4/src/write/source_map/indexed/kani.rs --output-format=terse"
        }
      }
      ci.command("Verify authored style attribute names, values and ordering", "kani crates/vize_maestro/src/source_project/style_format/kani.rs --output-format=terse")
      new Dynamic {
        name = "Verify source positions and style attributes for arbitrary finite input"
        run = ci.workflowScript("verify-source-coordinates-and-style-headers.sh")
      }
    }
  }

  `nearest-line-starts` {
    name = "Prove nearest LSP line starts on ARM64"
    `runs-on` = "blacksmith-32vcpu-ubuntu-2404-arm"
    `timeout-minutes` = 10
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          args = "--manifest-path davinci/vize_l0/Cargo.toml --features lsp-line-break-search --tests --lib --harness nearest_lsp_line_starts_match_every_short_byte_slice --output-format=terse"
        }
      }
    }
  }

  `scoped-components` {
    name = "Scoped compiler output and editor revisions"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("style-module-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      ci.rust("1.100.0")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      ci.command("Compare scoped output to Vue and replay the editor revisions", ci.workflowScript("check-scoped-components.sh"))
    }
  }
}
