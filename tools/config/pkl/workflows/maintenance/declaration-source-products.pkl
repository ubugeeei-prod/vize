import "../../Actions.pkl" as ci

name = "Declaration source products"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/declaration-source-products.yml"
      ".github/scripts/workflows/declaration-source-products/**"
      "davinci/vize_l0/src/source_frame.rs"
      "davinci/vize_l1/Cargo.toml"
      "davinci/vize_l1/src/embed.rs"
      "davinci/vize_l1/src/embed/authored_program.rs"
      "davinci/vize_l1/src/embed/declaration_program.rs"
      "davinci/vize_l2/Cargo.toml"
      "davinci/vize_l2/src/query/script.rs"
      "davinci/vize_l2/src/query/script/**"
      "crates/vize_croquis/src/sfc/types.rs"
      "crates/vize_canon/src/virtual_ts.rs"
      "crates/vize_canon/src/virtual_ts/generated_names.rs"
      "crates/vize_canon/src/virtual_ts/generator.rs"
      "crates/vize_canon/src/virtual_ts/generator/script_module.rs"
      "crates/vize_canon/src/virtual_ts/generator/script_module/**"
      "crates/vize_canon/src/virtual_ts/text_buf.rs"
      "crates/vize_canon/src/literal_assignments.rs"
      "crates/vize_patina/Cargo.toml"
      "crates/vize_patina/src/checked_prefer_const.rs"
      "crates/vize_patina/src/rules/opinionated/vue/script_unused/**"
      "crates/vize_maestro/src/source_project/recovered_script*"
      "crates/vize_maestro/src/source_project/recovered_script/**"
      "crates/vize_maestro/src/source_project/literal_products*"
      "crates/vize_maestro/src/source_project/literal_products/**"
      "tools/support/compat/davinci/primitive-assignments-oracle.ts"
      "tools/support/compat/davinci/literal-hover-oracle.ts"
      "tools/support/compat/davinci/select-broken-scripts.ts"
      "tests/formal/primitive-assignments/**"
      "crates/vize_canon/Cargo.toml"
      "crates/vize_canon/src/batch.rs"
      "crates/vize_canon/src/batch/declaration*.rs"
      "crates/vize_canon/src/batch/declaration_path/**"
      "crates/vize_canon/src/batch/vue_template_ref*.rs"
      "crates/vize_maestro/Cargo.toml"
      "crates/vize_maestro/src/server.rs"
      "crates/vize_maestro/src/server/state.rs"
      "crates/vize_maestro/src/server/state/workspace_project_files.rs"
      "crates/vize_maestro/src/server/state/workspace_project_files/**"
      "crates/vize_maestro/src/server/state/global_components*"
      "crates/vize_maestro/src/server/state/global_components/**"
      "crates/vize_maestro/src/ide/hover.rs"
      "crates/vize_maestro/src/ide/hover/**"
      "tests/differential/lsp-history.ts"
      "crates/vize_maestro/src/ide/diagnostics.rs"
      "crates/vize_maestro/src/ide/diagnostics/corsa*"
      "crates/vize_maestro/src/ide/diagnostics/corsa/**"
      "crates/vize_canon/src/corsa_bridge.rs"
      "crates/vize_canon/src/corsa_bridge/bridge.rs"
      "crates/vize_canon/src/batch/virtual_project.rs"
      "crates/vize_canon/src/batch/virtual_project/ambient_declarations*"
      "crates/vize_canon/src/corsa_bridge/editor_session.rs"
      "crates/vize_canon/src/corsa_bridge/vue_dependencies_alias/context/build.rs"
      "tests/_fixtures/differential/typechecker/ambient-global-slot-host-3011/**"
      "crates/vize_maestro/src/server/state/global_tag_names*"
      "crates/vize_maestro/src/server/state/global_tag_names/**"
      "crates/vize_maestro/src/source_project/snapshot.rs"
      "**/*.d.ts"
      "**/*.d.mts"
      "**/*.d.cts"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "declaration-source-products-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  declarations {
    name = "Declaration products ${{ matrix.suite }}"
    strategy {
      `fail-fast` = false
      matrix {
        suite = List("correctness", "performance")
      }
    }
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("declaration-source-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = ci.cache
        with {
          path = """
          ~/.cargo/registry
          ~/.cargo/git

          """
          key = "declaration-products-cargo-${{ runner.os }}-${{ runner.arch }}-${{ env.RUSTUP_TOOLCHAIN }}-${{ hashFiles('Cargo.lock') }}"
        }
      }
      new Dynamic {
        name = "Select tracked original TypeScript declarations"
        run = #". "${{ env.VIZE_CI_FILES }}/select-tracked-original-typescript-declarations.sh""#
      }
      new Dynamic {
        name = "Compare the projected TypeScript, provider identity and workspace completion"
        `if` = "matrix.suite == 'correctness'"
        run = #". "${{ env.VIZE_CI_FILES }}/compare-the-projected-typescript-provider-identity-and-workspace-complet.sh""#
      }
      new Dynamic {
        name = "Measure complete products for each original declaration"
        `if` = "matrix.suite == 'performance'"
        run = #". "${{ env.VIZE_CI_FILES }}/measure-complete-products-for-each-original-declaration.sh""#
      }
    }
  }

  `plain-script-bridges` {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("declaration-source-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Compare original plain-script projections and editor links"
        run = #". "${{ env.VIZE_CI_FILES }}/compare-original-plain-script-projections-and-editor-links.sh""#
      }
    }
  }

  `ambient-component-project` {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUSTUP_TOOLCHAIN = "1.100.0"
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_TSGO_PATH = "${{ github.workspace }}/node_modules/@typescript/typescript-linux-x64/lib/tsc"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("declaration-source-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      ci.use("./.github/actions/cache-vp-bootstrap")
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version-file` = "package.json"
          cache = true
          `cache-save` = false
          `run-install` = true
        }
      }
      new Dynamic {
        name = "Check authored ambient components in live native editor sessions"
        run = #". "${{ env.VIZE_CI_FILES }}/check-authored-ambient-components-in-live-native-editor-sessions.sh""#
      }
    }
  }

  `checked-literal-products` {
    name = "Original TypeScript assignments and checked tool products"
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("declaration-source-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Compare primitive types, lint and UTF-16 diagnostics with original tools"
        run = #". "${{ env.VIZE_CI_FILES }}/compare-primitive-types-lint-and-utf-16-diagnostics-with-original-tools.sh""#
      }
      new Dynamic {
        name = "Replay the complete typed hover through the ordinary editor"
        run = #". "${{ env.VIZE_CI_FILES }}/replay-the-complete-typed-hover-through-the-ordinary-editor.sh""#
      }
      new Dynamic {
        name = "Read original TypeScript 6.0.3 compiler and conformance fixtures"
        uses = ci.checkout
        with {
          repository = "microsoft/TypeScript"
          ref = "050880ce59e30b356b686bd3144efe24f875ebc8"
          path = ".typescript-fixtures"
          `persist-credentials` = false
          `sparse-checkout` = """
          tests/cases/compiler
          tests/cases/conformance

          """
        }
      }
      new Dynamic {
        name = "Compare restored document cursors and broken suffixes with TypeScript"
        env {
          VIZE_PREFIX_INPUT = "${{ runner.temp }}/original-scripts.jsonl"
          VIZE_PREFIX_OUTPUT = "${{ runner.temp }}/original-edits.jsonl"
          VIZE_RECOVERED_HOVERS = "${{ runner.temp }}/recovered-hovers.json"
          CORSA_PATH = "${{ runner.temp }}/typed-editor/node_modules/@typescript/typescript-linux-x64/lib/tsc"
          VIZE_FIRST_OPEN_INPUT = "${{ runner.temp }}/upstream-broken-scripts.jsonl"
          NODE_PATH = "${{ runner.temp }}/checked-ts/node_modules"
        }
        run = #". "${{ env.VIZE_CI_FILES }}/compare-restored-document-cursors-and-broken-suffixes-with-typescript.sh""#
      }
    }
  }

  `primitive-assignability-proof` {
    name = "Verify primitive literal membership in Kani"
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    steps = new Listing {
      ...ci.stageWorkflowScripts("declaration-source-products")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          command = "kani"
          args = "davinci/vize_l2/src/query/script/assignments/kani.rs --output-format=terse"
        }
      }
      new Dynamic {
        name = "Check immutable binding traces and witness unsafe scopes"
        env { ALLOY_SHA256 = "6037cbeee0e8423c1c468447ed10f5fcf2f2743a2ffc39cb1c81f2905c0fdb9d" }
        run = #". "${{ env.VIZE_CI_FILES }}/check-immutable-binding-traces-and-witness-unsafe-scopes.sh""#
      }
      new Dynamic {
        name = "Verify source relocation for the full 32-bit byte domain"
        uses = "model-checking/kani-github-action@f838096619a707b0f6b2118cf435eaccfa33e51f"
        with {
          `kani-version` = "0.68.0"
          command = "kani"
          args = "davinci/vize_l2/src/query/script/assignments/prefix/kani.rs --output-format=terse"
        }
      }
    }
  }
}
