import "../../Actions.pkl" as ci

name = "Art source products"
on {
  pull_request {
    paths = new Listing {
      "crates/vize_musea/**"
      "crates/vize_croquis/src/sfc/**"
      "crates/vize_croquis/src/script_parser/**"
      "davinci/vize_l1/src/container/**"
      "davinci/vize_l1/src/markup/**"
      "**/*.art.vue"
      "**/*.art.vue.txt"
      ".github/workflows/art-source-products.yml"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "art-source-products-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `gallery-products` {
    name = "Gallery ${{ matrix.suite }}"
    strategy {
      `fail-fast` = false
      matrix {
        suite = List("correctness", "performance")
      }
    }
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    env {
      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUST_MIN_STACK = "16777216"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = ci.cache
        with {
          path = """
          ~/.cargo/registry
          ~/.cargo/git

          """
          key = "art-products-cargo-${{ runner.os }}-${{ runner.arch }}-${{ env.RUSTUP_TOOLCHAIN }}-${{ hashFiles('Cargo.lock') }}"
        }
      }
      new Dynamic {
        name = "Select original Vue and colocated gallery sources"
        run = #"git ls-files -z -- '*.vue' '*.vue.txt' > "$RUNNER_TEMP/gallery-sources""#
      }
      new Dynamic {
        name = "Compare original gallery records, generated modules, Markdown and public warnings"
        `if` = "matrix.suite == 'correctness'"
        run = """
        set -euo pipefail
        flags=(--locked --profile ci-opt -p vize_musea)
        cargo test "${flags[@]}" --lib
        cargo clippy "${flags[@]}" --features art-source-products --lib --no-deps -- -D warnings
        suite=(--features art-source-products --test art_source_products)
        export VIZE_ART_SOURCE_INPUTS="$RUNNER_TEMP/gallery-sources"
        cargo test "${flags[@]}" "${suite[@]}"
        cargo test "${flags[@]}" "${suite[@]}" descriptor_warnings_and_complete_gallery_products_on_original_files -- --ignored --nocapture --test-threads=1

        """
      }
      new Dynamic {
        name = "Measure descriptor and warning time, allocations and peak on an independent runner"
        `if` = "matrix.suite == 'performance'"
        run = """
        set -euo pipefail
        export VIZE_ART_SOURCE_INPUTS="$RUNNER_TEMP/gallery-sources"
        cargo test --locked --profile ci-opt -p vize_musea --features art-source-products --test art_source_products complete_responses_share_the_original_art_surface -- --ignored --nocapture --test-threads=1

        """
      }
    }
  }
}
