import "../../../../ci/lib/Actions.pkl" as ci

name = "Language project fixture laws"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/language-project-fixtures.yml"
      ".github/workflows/typescript-plugin.yml"
      ".github/scripts/workflows/typescript-plugin/**"
      ".github/workflows/typescript-provider-vsix.yml"
      ".github/scripts/workflows/typescript-provider-vsix/**"
      "crates/vize_vitrine/src/napi/language_code.rs"
      "npm/typescript-plugin/**"
      "npm/native/language-projection.js"
      "editors/vscode/test/run-typescript-provider-host.mjs"
      "editors/vscode/test/suite/typescript-provider-host.cjs"
      "tests/typescript-plugin/**"
      "tools/support/compat/github/**"
      "tests/tooling/language-project-*.test.ts"
      "tests/_fixtures/tooling/language-project-source-pairs-10740.json"
      "tests/_fixtures/tooling/typescript-classification-*/**"
      "editors/vscode/test/suite/classification-provider.cjs"
      "tests/_fixtures/differential/typechecker/**"
    }
  }
  // Not a required check, so a queue run gated nothing while it competed with
  // every queue entry for runners. Each main commit is still validated in full;
  // cancel-in-progress coalesces a burst of merges into one run of the newest.
  push {
    branches = List("main")
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "language-project-fixtures-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  `language-project-fixtures` {
    `runs-on` = ci.hostedLinux
    `timeout-minutes` = 5
    env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      new Dynamic {
        uses = ci.setupNode
        with {
          `node-version-file` = "package.json"
          `package-manager-cache` = false
        }
      }
      new Dynamic {
        name = "Check original source pairs and complete language project registration"
        run = "node --test tests/tooling/language-project-fixtures.test.ts tests/tooling/language-project-registration.test.ts tests/tooling/language-project-classification-successor.test.ts tests/tooling/language-project-classification-runtime.test.ts tests/tooling/language-project-classification-position.test.ts tests/tooling/language-project-classification-records.test.ts"
      }
    }
  }
}
