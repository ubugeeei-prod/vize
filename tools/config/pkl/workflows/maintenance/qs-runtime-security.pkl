import "../../Actions.pkl" as ci

name = "qs runtime security contracts"
on {
  pull_request {
    branches = List("main")
    paths = new Listing {
      "pnpm-workspace.yaml"
      "pnpm-lock.yaml"
      "npm/mcp-musea/**"
      "tools/support/security/qs-runtime-*.ts"
      ".github/workflows/qs-runtime-security.yml"
      ".github/scripts/workflows/qs-runtime-security/**"
    }
  }
  push {
    branches = List("main")
    paths = new Listing {
      "pnpm-workspace.yaml"
      "pnpm-lock.yaml"
      "npm/mcp-musea/**"
      "tools/support/security/qs-runtime-*.ts"
      ".github/workflows/qs-runtime-security.yml"
      ".github/scripts/workflows/qs-runtime-security/**"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "qs-runtime-security-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
jobs {
  runtime {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {
      VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/qs-runtime-security"
      EXPECTED_SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
    }
    steps = new Listing {
      new Dynamic {
        uses = ci.checkout
        with { `persist-credentials` = false }
      }
      ci.workspaceVp()
      ci.command("Install exact source dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Build and pack the actual MCP server"
        run = #". "${{ env.VIZE_CI_FILES }}/build-and-pack-the-actual-mcp-server.sh""#
      }
      new Dynamic {
        name = "Require original negative, repaired runtime, full upstream and fresh consumer contracts"
        run = """
        node tools/support/security/qs-runtime-consumer.ts "$RUNNER_TEMP/qs-runtime-proof" "$RUNNER_TEMP"/qs-runtime-pack/*.tgz

        """
      }
      new Dynamic {
        name = "Preserve full sources, producer identities, graphs and raw process packets"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "qs-runtime-security-${{ github.event.pull_request.head.sha || github.sha }}"
          path = """
          ${{ runner.temp }}/qs-runtime-proof
          ${{ runner.temp }}/qs-runtime-pack

          """
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
