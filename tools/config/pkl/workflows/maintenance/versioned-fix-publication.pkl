import "../../Actions.pkl" as ci

name = "Versioned diagnostic fix publication"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/versioned-fix-publication.yml"
      ".github/scripts/workflows/versioned-fix-publication/**"
      "davinci/vize_l0/Cargo.toml"
      "davinci/vize_l0/src/line_index*"
      "davinci/vize_l0/src/line_index/**"
      "davinci/vize_l1/Cargo.toml"
      "davinci/vize_l1/src/edit.rs"
      "davinci/vize_l1/src/edit/**"
      "crates/vize_maestro/Cargo.toml"
      "crates/vize_maestro/src/document/store*"
      "crates/vize_maestro/src/document/store/**"
      "crates/vize_maestro/src/source_project.rs"
      "crates/vize_maestro/src/source_project/edit*"
      "crates/vize_maestro/src/source_project/positioned.rs"
      "crates/vize_maestro/src/source_project/positioned/**"
      "crates/vize_maestro/src/source_project/snapshot.rs"
      "crates/vize_maestro/tests/versioned_fix_publication/**"
      "crates/vize_patina/tests/fixtures/issue-7905*/**"
      "tests/_fixtures/differential/linter/lint-fix-passes-7906/**"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "versioned-fix-publication-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}
jobs {
  `versioned-edits` {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env {

      CARGO_BUILD_JOBS = "24"
      CARGO_INCREMENTAL = "0"
      RUSTUP_TOOLCHAIN = "1.100.0"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("versioned-fix-publication")
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        name = "Compare complete editor changes and every resulting authored byte"
        run = ci.workflowScript("compare-complete-editor-changes-and-every-resulting-authored-byte.sh")
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "versioned-edit-times-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/versioned-edit-times"
          `if-no-files-found` = "warn"
          `retention-days` = 7
        }
      }
    }
  }
}
