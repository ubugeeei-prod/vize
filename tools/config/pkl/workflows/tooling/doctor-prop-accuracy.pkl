import "../../Actions.pkl" as ci

name = "Doctor prop accuracy"
`run-name` = "Doctor prop contracts @ ${{ github.event.pull_request.head.sha || github.sha }}"
on {
  workflow_dispatch = null
  pull_request {
    types = List("opened", "synchronize", "reopened")
    paths = new Listing {
      ".github/workflows/doctor-prop-accuracy.yml"
      ".github/scripts/workflows/doctor-prop-accuracy/**"
      ".github/scripts/workflows/shared/**"
      "crates/vize_croquis_cf/src/rules/props_validation.rs"
      "crates/vize_croquis_cf/src/rules/props_validation/**"
      "crates/vize_croquis_cf/src/rules/emit.rs"
      "crates/vize_croquis_cf/src/rules/fallthrough/usage.rs"
      "crates/vize/tests/doctor_prop_accuracy_cli.rs"
    }
  }
}
permissions { contents = "read" }
concurrency {
  group = "doctor-prop-accuracy-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
env {
  CARGO_INCREMENTAL = "0"
  CARGO_BUILD_JOBS = "12"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}
jobs {
  `complete-cli-packets` {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    strategy {
      `fail-fast` = false
      matrix {
        role = List("baseline", "source")
      }
    }
    env {

      ROLE = "${{ matrix.role }}"
      BASELINE_SHA = "bd905e766c37ad5bacabaacbec02c90def36726e"
      EXPECTED_SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("doctor-prop-accuracy")
      new Dynamic {
        uses = ci.checkout
        with {
          ref = "${{ github.event.pull_request.head.sha || github.sha }}"
          `fetch-depth` = 0
          `persist-credentials` = false
        }
      }
      new Dynamic {
        uses = ci.setupRust
        with {
          toolchain = "1.100.0"
          components = "clippy"
        }
      }
      ci.wild()
      new Dynamic {
        name = "Prepare isolated source and initially absent Cargo target"
        shell = "bash"
        run = ci.workflowScript("prepare-isolated-source-and-initially-absent-cargo-target.sh")
      }
      new Dynamic {
        name = "Observe exact baseline reproduction and complete JSON"
        `if` = "${{ matrix.role == 'baseline' }}"
        shell = "bash"
        run = ci.workflowScript("observe-exact-baseline-reproduction-and-complete-json.sh")
      }
      new Dynamic {
        name = "Verify source rule and complete CLI contracts"
        `if` = "${{ matrix.role == 'source' }}"
        shell = "bash"
        run = ci.workflowScript("verify-source-rule-and-complete-cli-contracts.sh")
      }
      new Dynamic {
        name = "Preserve binary identity"
        `if` = "${{ always() }}"
        shell = "bash"
        run = ci.workflowScript("preserve-binary-identity.sh")
      }
      new Dynamic {
        name = "Preserve every complete report and measurement"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "doctor-prop-accuracy-${{ matrix.role }}-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/doctor-prop-packets"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
