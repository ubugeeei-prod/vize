import "../../Actions.pkl" as ci

name = "VueFes SSR style dependencies"

on {
  workflow_dispatch {
    inputs {
      target_sha {
        description = "Exact source SHA; the dispatch ref must point at it"
        required = true
        type = "string"
      }
    }
  }
}

concurrency {
  group = "vuefes-ssr-style-dependencies-${{ github.ref }}"
  `cancel-in-progress` = true
}

permissions { contents = "read" }

env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  CARGO_TERM_COLOR = "always"
  QUALIFIER_SHA = "${{ inputs.target_sha }}"
  VIZE_NATIVE_CI_FORMATTER_HISTORY = "1"
}

jobs {
  `vuefes-ssr-style-dependencies` {
    `runs-on` = ci.linux
    `timeout-minutes` = 90
    steps = new Listing {
      ...ci.stageWorkflowScripts("vuefes-ssr-style-dependencies")
      ci.checkoutAt("${{ env.QUALIFIER_SHA }}")
      new Dynamic {
        name = "Authenticate the source and retain original declarations"
        env { RUN_HEAD_SHA = "${{ github.sha }}" }
        run = ci.workflowScript("authenticate-the-source-and-retain-original-declarations.sh")
      }
      new Dynamic {
        name = "Original full VueFes VRT, with one native build"
        uses = "./.github/actions/app-e2e-row"
        with {
          profile = "full"
          suite = "vrt"
          shard = "vuefes"
          task = "test:vrt:vuefes"
          timeout = "15m"
          `needs-playwright` = "true"
          `cache-key` = "app-e2e-full-vrt-vuefes"
          `worktree-id` = "ci-app-e2e-full-vrt-vuefes"
          `artifact-stem` = "full-vrt-vuefes"
        }
      }
      new Dynamic {
        name = "Preserve complete generated declarations"
        `if` = "${{ always() }}"
        run = ci.workflowScript("preserve-complete-generated-declarations.sh")
      }
      new Dynamic {
        name = "Install exact original Vue runtime oracle"
        `if` = "${{ !cancelled() }}"
        `working-directory` = "tools/support/compat/vuefes/fixtures/heading-cascade"
        run = "npm ci --no-audit --no-fund"
      }
      new Dynamic {
        name = "Install exact Nuxt component transform oracle"
        `if` = "${{ !cancelled() }}"
        `working-directory` = "tools/support/compat/vuefes/fixtures/app-component-order"
        run = "npm ci --ignore-scripts --no-audit --no-fund"
      }
      new Dynamic {
        name = "Complete original VueFes app component import differential"
        `if` = "${{ !cancelled() }}"
        run = "node tools/support/compat/vuefes/app-component-order.ts"
      }
      new Dynamic {
        name = "Native metadata corpus and existing Vite contracts"
        `if` = "${{ !cancelled() }}"
        run = ci.workflowScript("native-metadata-corpus-and-existing-vite-contracts.sh")
      }
      new Dynamic {
        name = "Complete official/native SSR, DOM and hydration differential"
        `if` = "${{ !cancelled() }}"
        run = "node tools/support/compat/vuefes/ssr-style-dependencies.ts"
      }
      new Dynamic {
        name = "Retain all qualification evidence"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "vuefes-ssr-style-dependencies-${{ github.run_id }}-${{ github.run_attempt }}"
          path = """
          target/vuefes-ssr-style-dependencies/
          !target/vuefes-ssr-style-dependencies/project-*/node_modules/**
          npm/native/.artifacts/native/formatter-history/*.json
          npm/native/.artifacts/native/formatter-history/*.bin
          npm/native/.artifacts/native/formatter-history/*.diff
          npm/native/.artifacts/native/formatter-history/*.node
          npm/native/*.node
          target/**/ci/libvize_vitrine.so
          target/app-e2e-logs/
          .vize/artifacts/vuefes-vrt/
          tests/app/results/

          """
          `if-no-files-found` = "error"
          `retention-days` = 7
          `include-hidden-files` = true
        }
      }
    }
  }
}
