import "../../../../ci/lib/Actions.pkl" as ci

name = "Void build"
on {
  pull_request {
    branches = List("main")
    paths = new Listing {
      ".github/workflows/void-build.yml"
      "tools/support/compat/void/**"
      "tools/support/compat/nuxt/source-binding*"
      "npm/builder/vite/**"
      "npm/native/**"
      "crates/vize/src/commands/check/**"
      "crates/vize/src/commands/fmt/**"
      "crates/vize/src/commands/lint/**"
    }
  }
  push {
    branches = List("main")
    paths = new Listing {
      ".github/workflows/void-build.yml"
      "tools/support/compat/void/**"
      "tools/support/compat/nuxt/source-binding*"
      "npm/builder/vite/**"
      "npm/native/**"
      "crates/**"
      "Cargo.toml"
      "Cargo.lock"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }

concurrency {
  group = "void-build-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env { FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true }

jobs {
  `void-vue` {
    name = "Void + Vue build, SSR, HMR and tooling"
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    steps = new Listing {
      ci.use(ci.checkout)
      ci.workspaceVp()
      ci.command("Install workspace tooling", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // master
        with { toolchain = "1.100.0" }
      }
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "void-source-native"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      ci.command("Build and capture the actual source native compiler", "vp run --no-cache --filter './npm/native' build:debug")
      new Dynamic {
        name = "Build the candidate Vite adapter"
        `working-directory` = "npm/builder/vite"
        run = "vp pack"
      }
      ci.command("Build the candidate CLI", "cargo build --profile ci -p vize")
      new Dynamic {
        name = "Install the pinned Void app"
        `working-directory` = "tools/support/compat/void/fixtures/void-vue"
        run = "npm ci --no-audit --no-fund"
      }
      ci.use("./.github/actions/setup-ubuntu-archive")
      new Dynamic {
        name = "Install Chromium for hydration and HMR"
        `working-directory` = "tests"
        run = "vize-ci-apt-retry vp exec playwright install --with-deps chromium"
      }
      new Dynamic {
        name = "Verify build, workerd SSR, dev HMR, check parity, lint and fmt"
        run = #"vp env exec node tools/support/compat/void/void-vue-build.ts "$RUNNER_TEMP/void-vue-proof" target/ci/vize"#
      }
      new Dynamic {
        name = "Upload Void evidence"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "void-vue-proof-${{ github.sha }}"
          path = "${{ runner.temp }}/void-vue-proof"
          `if-no-files-found` = "ignore"
        }
      }
    }
  }
}
