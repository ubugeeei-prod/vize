import "../../Actions.pkl" as ci

name = "Plain-script import ref runtime"
on {
  pull_request {
    paths = new Listing {
      ".github/workflows/plain-script-import-ref.yml"
      ".github/scripts/workflows/plain-script-import-ref/**"
      "tools/support/compat/plain-script-import-ref.ts"
      "tests/tooling/support/setup-component-bracket-reference.ts"
      "tests/tooling/support/typescript-erasure-reference.ts"
      "tests/tooling/support/plain-script-project-metadata-reference.ts"
      "tests/tooling/plain-script-project-metadata-reference.test.ts"
      "tests/_fixtures/differential/compiler/plain-script-import-10903/**"
      "tests/_fixtures/differential/compiler/plain-script-project-metadata-11885/**"
      "crates/vize_atelier_sfc/src/**"
      "crates/vize_atelier_core/src/codegen/**"
      "npm/builder/vite/**"
      "npm/native/**"
      "Cargo.lock"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }
concurrency {
  group = "plain-script-import-ref-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}
env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  CARGO_BUILD_JOBS = "4"
  RAYON_NUM_THREADS = "2"
}
jobs {
  `public-before` {
    `runs-on` = ci.linux
    `timeout-minutes` = 15
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha || github.sha }}")
      new Dynamic {
        uses = ci.setupNode
        with { `node-version` = "26.6.0" }
      }
      new Dynamic {
        name = "Preserve public 0.589.0 failure and official Vue controls"
        env {
          VIZE10903_MODE = "public"
          VIZE10903_EXPECT = "before"
          VIZE10903_PROOF = "/tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/public-before"
        }
        run = "node tools/support/compat/plain-script-import-ref.ts"
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "plain-script-public-before-${{ github.run_id }}"
          path = """
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/public-before/*.json
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/public-before/host/package*.json
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/public-before/projects/*/src/
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/public-before/actual-vite-native/

          """
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
  `source-before` {
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {

      SOURCE_SHA = "db5c35c12124086f034563b6800dbdab8605cdc0"
      VIZE10903_MODE = "source"
      VIZE10903_EXPECT = "before"
      VIZE10903_PROOF = "/tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/source-before"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("plain-script-import-ref")
      ci.checkoutAt("db5c35c12124086f034563b6800dbdab8605cdc0")
      new Dynamic {
        name = "Read qualification sources separately from the frozen compiler"
        uses = ci.checkout
        with {
          ref = "${{ github.event.pull_request.head.sha || github.sha }}"
          path = "qualification"
          `persist-credentials` = false
          `sparse-checkout` = """
          .github/actions/setup-rust-script
          .github/actions/setup-wild-http-recovery
          tools/support/compat/plain-script-import-ref.ts
          tests/_fixtures/differential/compiler/plain-script-import-10903

          """
        }
      }
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version` = "26.6.0"
          `run-install` = false
          cache = true
          `cache-save` = false
        }
      }
      ci.rust("1.99.1")
      new Dynamic {
        uses = "./qualification/.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "plain-script-import-ref"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./qualification/.github/actions/setup-rust-script")
      new Dynamic {
        name = "Build the unchanged baseline native image and real Vite adapter"
        run = #". "${{ env.VIZE_CI_FILES }}/build-the-unchanged-baseline-native-image-and-real-vite-adapter.sh""#
      }
      new Dynamic {
        name = "Capture the actual baseline regression before candidate acceptance"
        env {
          VIZE10903_FIXTURES = "${{ github.workspace }}/qualification/tests/_fixtures/differential/compiler/plain-script-import-10903"
        }
        run = "node qualification/tools/support/compat/plain-script-import-ref.ts"
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "plain-script-source-before-${{ github.run_id }}"
          path = """
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/source-before/*.json
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/source-before/host/package*.json
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/source-before/projects/*/src/
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/source-before/actual-vite-native/

          """
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
  candidate {
    needs = List("public-before", "source-before")
    `runs-on` = ci.linux
    `timeout-minutes` = 25
    env {

      SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
      VIZE10903_MODE = "source"
      VIZE10903_EXPECT = "after"
      VIZE10903_PROOF = "/tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/candidate"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("plain-script-import-ref")
      ci.checkoutAt("${{ env.SOURCE_SHA }}")
      new Dynamic {
        uses = ci.setupVp121
        with {
          version = "latest"
          `node-version` = "26.6.0"
          `run-install` = false
          cache = true
          `cache-save` = false
        }
      }
      ci.rust("1.100.0")
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "plain-script-import-ref"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.use("./.github/actions/setup-rust-script")
      new Dynamic {
        name = "Build the exact candidate native image and real Vite adapter"
        run = #". "${{ env.VIZE_CI_FILES }}/build-the-unchanged-baseline-native-image-and-real-vite-adapter.sh""#
      }
      new Dynamic {
        name = "Verify exact import classifications and merge flags"
        run = #". "${{ env.VIZE_CI_FILES }}/verify-exact-import-classifications-and-merge-flags.sh""#
      }
      new Dynamic {
        name = "Verify full modules maps and original production/dev browser behavior"
        run = "node tools/support/compat/plain-script-import-ref.ts"
      }
      new Dynamic {
        name = "Replay project metadata packets and refusal cases"
        run = "node --test tests/tooling/plain-script-project-metadata-reference.test.ts"
      }
      new Dynamic {
        uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
        with {
          name = "plain-script-source-before-${{ github.run_id }}"
          path = "/tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/before-evidence"
        }
      }
      new Dynamic {
        name = "Record same-work performance without a speed threshold"
        env {
          BEFORE = "/tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/before-evidence/performance.json"
        }
        run = #". "${{ env.VIZE_CI_FILES }}/record-same-work-performance-without-a-speed-threshold.sh""#
      }
      new Dynamic {
        uses = ci.uploadArtifact
        `if` = "always()"
        with {
          name = "plain-script-candidate-${{ github.run_id }}"
          path = """
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/candidate/*.json
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/candidate/*.log
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/candidate/host/package*.json
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/candidate/projects/*/src/
          /tmp/vize-plain-script-${{ github.run_id }}-${{ github.run_attempt }}/candidate/actual-vite-native/

          """
          `if-no-files-found` = "error"
          `retention-days` = 30
        }
      }
    }
  }
}
