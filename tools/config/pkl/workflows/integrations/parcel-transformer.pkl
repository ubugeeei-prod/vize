import "../../../../ci/lib/Actions.pkl" as ci

name = "Parcel transformer"

on {
  push {
    tags = List("v*")
  }
  pull_request {
    paths = new Listing {
      "npm/builder/parcel/**"
      "npm/builder/parcel-native/**"
      "npm/native/**"
      "crates/**"
      "davinci/**"
      "Cargo.toml"
      "Cargo.lock"
      "tools/support/compat/parcel/**"
      ".github/workflows/parcel-transformer.yml"
      ".github/scripts/workflows/parcel-transformer/**"
    }
  }
  // Hosted macOS arm64 capacity is scarce, so pull requests build the per-platform
  // packages only when the native plugin itself changes; main still builds every
  // target nightly, and tags and dispatches always do.
  schedule = new Listing {
    new Dynamic { cron = "37 2 * * *" }
  }
  workflow_dispatch {
    inputs {
      publish {
        description = "Publish every native package through npm trusted publishing"
        type = "boolean"
        ["default"] = false
      }
      version {
        description = "Exact package version override for a manual release recovery"
        type = "string"
        ["default"] = ""
      }
      `default-cache-frontier` {
        description = "Exercise the known default development HTTP-cache frontier"
        type = "boolean"
        ["default"] = false
      }
    }
  }
}

permissions { contents = "read" }

concurrency {
  group = "parcel-transformer-${{ github.event.pull_request.number || github.ref }}"
  `cancel-in-progress` = true
}

env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  CARGO_TERM_COLOR = "always"
  CARGO_INCREMENTAL = "0"
  VIZE_NATIVE_CI_FORMATTER_HISTORY = "1"
  SOURCE_SHA = "${{ github.sha }}"
  TRIGGER_HEAD_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
}

jobs {
  `packaging-changes` {
    name = "Plan native packaging"
    `if` = "${{ github.event_name == 'pull_request' }}"
    `runs-on` = ci.linuxSmall
    `timeout-minutes` = 5
    permissions {
      contents = "read"
      `pull-requests` = "read"
    }
    outputs { packages = "${{ steps.changes.outputs.packages }}" }
    steps = new Listing {
      new Dynamic {
        name = "Detect native plugin package changes"
        id = "changes"
        uses = "dorny/paths-filter@7b450fff21473bca461d4b92ce414b9d0420d706"  // v4.0.2
        with {
          filters = """
          packages:
            - 'npm/builder/parcel-native/**'
            - 'crates/vize_parcel_transformer/**'
            - '.github/workflows/parcel-transformer.yml'

          """
        }
      }
    }
  }

  // The build and publish jobs of parcel-bundler/parcel's reusable native-plugin
  // workflow at the commit below (v3.0.0-alpha.2), for this repository's one Rust
  // plugin. Its packaging scripts run from that commit; every action is pinned to
  // the commit its tag named, and npm and cargo-zigbuild to exact releases. The
  // per-target builds run on the hosted runners Parcel's matrix names; reading
  // targets, packing and publishing do no compilation.
  `native-plugin-matrix` {
    name = "Read targets"
    needs = "packaging-changes"
    `if` = "${{ !cancelled() && (github.event_name != 'pull_request' || needs.packaging-changes.outputs.packages == 'true') }}"
    `runs-on` = "ubuntu-24.04"
    permissions { contents = "read" }
    outputs {
      matrix = "${{ steps.matrix.outputs.matrix }}"
      plugins = "${{ steps.matrix.outputs.plugins }}"
      name = "${{ steps.matrix.outputs.name }}"
      version = "${{ steps.matrix.outputs.version }}"
      language = "${{ steps.matrix.outputs.language }}"
      // Publish only in this repository: for a pushed v* tag, or for a dispatch that asks
      // for it on main or on a v* tag. release.yml dispatches on the release tag.
      publish = "${{ github.repository == 'ubugeeei-prod/vize' && ((github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')) || (github.event_name == 'workflow_dispatch' && inputs.publish == true && (github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/v')))) }}"
    }
    steps = new Listing {
      ...nativePluginSetup
      new Dynamic {
        name = "Compute build matrix"
        id = "matrix"
        shell = "bash"
        env {
          PLUGIN_DIRS = nativePluginPaths
          LANGUAGE = ""
          PARCEL_PLUGIN_VERSION = "${{ inputs.version }}"
        }
        run = #"node "$RUNNER_TEMP/native-plugin/matrix.mjs" --dirs "$PLUGIN_DIRS" --language "$LANGUAGE""#
      }
    }
  }

  `native-plugin-build` {
    name = "${{ matrix.plugin }} (${{ matrix.target }})"
    needs = "native-plugin-matrix"
    `if` = "${{ !cancelled() && needs.native-plugin-matrix.result == 'success' }}"
    `runs-on` = "${{ matrix.runner }}"
    permissions { contents = "read" }
    strategy {
      `fail-fast` = false
      matrix = "${{ fromJSON(needs.native-plugin-matrix.outputs.matrix) }}"
    }
    steps = new Listing {
      ...nativePluginSetup
      new Dynamic {
        name = "Install Rust"
        `if` = "${{ matrix.language == 'rust' }}"
        uses = "dtolnay/rust-toolchain@df2a88e9fe4098bad09cb42c3dec7187f15861fc"  // master
        with {
          toolchain = "1.100.0"
          targets = "${{ matrix.target }}"
        }
      }
      new Dynamic {
        `if` = "${{ matrix.language == 'rust' }}"
        uses = "Swatinem/rust-cache@d1527c8f67ef9af357290475d4af4b0fab8f12e0"  // v2.9.3
        with {
          workspaces = "${{ matrix.dir }}"
          `shared-key` = "${{ matrix.plugin }}-${{ matrix.target }}"
        }
      }
      // Linux targets are cross compiled with Zig so that glibc builds link
      // against an old enough glibc to run on distros older than the runner.
      new Dynamic {
        name = "Install Zig"
        `if` = "${{ matrix.builder == 'zig' }}"
        uses = "goto-bus-stop/setup-zig@222d316fd35ce56a4141fe4a869e1aeefc7f3590"  // v1.4.0
        with { version = "0.14.0" }
      }
      new Dynamic {
        name = "Install cargo-zigbuild"
        `if` = "${{ matrix.builder == 'zig' && matrix.language == 'rust' }}"
        uses = "taiki-e/install-action@073e1fd0bc889c9aee68dbaaa927cde1b5653a83"  // v2.90.11
        env { GITHUB_TOKEN = "${{ github.token }}" }
        with { tool = "cargo-zigbuild@0.24.1" }
      }
      new Dynamic {
        name = "Build (Rust)"
        `if` = "${{ matrix.language == 'rust' }}"
        shell = "bash"
        `working-directory` = "${{ matrix.dir }}"
        env {
          TARGET = "${{ matrix.target }}"
          ZIG_TARGET = "${{ matrix.zigTarget }}"
          BUILDER = "${{ matrix.builder }}"
          CARGO_ARGS = ""
          EXTRA_RUSTFLAGS = " ${{ matrix.rustflags }}"
          EXT = "${{ matrix.ext }}"
        }
        run = ci.workflowScript("build-the-native-plugin-library.sh")
      }
      new Dynamic {
        name = "Pack ${{ matrix.package }}"
        shell = "bash"
        env {
          PLUGIN_DIR = "${{ matrix.dir }}"
          TARGET = "${{ matrix.target }}"
          PARCEL_PLUGIN_VERSION = "${{ inputs.version }}"
        }
        run = ci.workflowScript("pack-the-native-plugin-target.sh")
      }
      // Namespaced by plugin, as the reusable workflow names them.
      new Dynamic {
        uses = uploadArtifactV4
        with {
          name = "native-artifact-${{ matrix.plugin }}-${{ matrix.target }}"
          path = "${{ runner.temp }}/artifacts/${{ matrix.target }}.tgz"
          `if-no-files-found` = "error"
        }
      }
    }
  }

  `native-plugin-pack` {
    name = "Pack ${{ matrix.name }}"
    needs = List("native-plugin-matrix", "native-plugin-build")
    `if` = "${{ !cancelled() && needs.native-plugin-matrix.result == 'success' && needs.native-plugin-build.result == 'success' }}"
    `runs-on` = "ubuntu-24.04"
    permissions { contents = "read" }
    strategy {
      `fail-fast` = false
      matrix = "${{ fromJSON(needs.native-plugin-matrix.outputs.plugins) }}"
    }
    steps = new Listing {
      ...nativePluginSetup
      new Dynamic {
        name = "Download artifact packages"
        uses = downloadArtifactV4
        with {
          pattern = "native-artifact-${{ matrix.plugin }}-*"
          path = "${{ runner.temp }}/artifacts"
          `merge-multiple` = true
        }
      }
      // Also verifies that every target declared in parcel.artifacts produced a
      // tarball, before anything is published.
      new Dynamic {
        name = "Pack plugin package"
        shell = "bash"
        env {
          PLUGIN_DIR = "${{ matrix.dir }}"
          PARCEL_PLUGIN_VERSION = "${{ inputs.version }}"
        }
        run = ci.workflowScript("pack-the-native-plugin-package.sh")
      }
      new Dynamic {
        uses = uploadArtifactV4
        with {
          name = "native-plugin-main-${{ matrix.plugin }}"
          path = "${{ runner.temp }}/main/*.tgz"
          `if-no-files-found` = "error"
        }
      }
    }
  }

  `native-plugin-publish` {
    name = "Publish to npm"
    needs = List("native-plugin-matrix", "native-plugin-pack")
    `if` = "${{ !cancelled() && needs.native-plugin-pack.result == 'success' && needs.native-plugin-matrix.outputs.publish == 'true' }}"
    `runs-on` = "ubuntu-24.04"
    permissions {
      contents = "read"
      // npm trusted publishing
      `id-token` = "write"
    }
    steps = new Listing {
      ...ci.stageWorkflowScripts("parcel-transformer")
      ...nativePluginScripts
      new Dynamic {
        uses = "actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020"  // v4.4.0
        with {
          `node-version` = "24"
          `registry-url` = "https://registry.npmjs.org"
        }
      }
      // Trusted publishing (and the provenance attestation it generates)
      // requires npm 11.5.1 or later.
      new Dynamic {
        name = "Update npm"
        shell = "bash"
        run = "npm install -g npm@12.2.3"
      }
      // Left unmerged: across plugins the tarballs inside share names, so each
      // artifact keeps its own subdirectory.
      new Dynamic {
        name = "Download artifact packages"
        uses = downloadArtifactV4
        with {
          pattern = "native-artifact-*"
          path = "${{ runner.temp }}/artifacts"
        }
      }
      new Dynamic {
        name = "Download plugin packages"
        uses = downloadArtifactV4
        with {
          pattern = "native-plugin-main-*"
          path = "${{ runner.temp }}/main"
        }
      }
      // Platform packages go first: the plugin package's optionalDependencies
      // point at exact versions of its artifacts, so it must never be resolvable
      // before they are.
      new Dynamic {
        name = "Publish artifact packages"
        shell = "bash"
        env { TAG = "" }
        run = #"node "$RUNNER_TEMP/native-plugin/publish.mjs" --tag "$TAG" "$RUNNER_TEMP"/artifacts/*/*.tgz"#
      }
      new Dynamic {
        name = "Publish plugin packages"
        shell = "bash"
        env { TAG = "" }
        run = #"node "$RUNNER_TEMP/native-plugin/publish.mjs" --tag "$TAG" "$RUNNER_TEMP"/main/*/*.tgz"#
      }
    }
  }

  `native-consumer` {
    `runs-on` = ci.linux
    `timeout-minutes` = 20
    steps = new Listing {
      ...ci.stageWorkflowScripts("parcel-transformer")
      ci.checkoutAt("${{ env.SOURCE_SHA }}")
      new Dynamic {
        uses = ci.setupVp
        with {
          version = ci.vpVersion
          `node-version-file` = "package.json"
          `run-install` = false
        }
      }
      new Dynamic {
        uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // stable
        with { toolchain = "1.100.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      ci.use("./.github/actions/setup-ubuntu-archive")
      new Dynamic {
        name = "Install the locked Parcel 3 consumer"
        run = "vp install --frozen-lockfile --prefer-offline --filter './npm/builder/parcel-native...'"
      }
      new Dynamic {
        name = "Check the native transformer crate"
        run = ci.workflowScript("check-the-native-transformer-crate.sh")
      }
      ci.command("Build in a real Parcel 3 consumer", "vp run --filter './npm/builder/parcel-native' test:host")
    }
  }

  `packed-host` {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    steps = new Listing {
      ...ci.stageWorkflowScripts("parcel-transformer")
      ci.checkoutAt("${{ env.SOURCE_SHA }}")
      new Dynamic {
        uses = ci.setupVp
        with {
          version = ci.vpVersion
          `node-version-file` = "package.json"
          `run-install` = false
        }
      }
      new Dynamic {
        uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // stable
        with { toolchain = "1.100.0" }
      }
      new Dynamic {
        uses = "./.github/actions/setup-wild-http-recovery"
        with { `wild-version` = "0.9.0" }
      }
      ci.use("./.github/actions/setup-ubuntu-archive")
      ci.command("Install locked workspace providers", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Authenticate committed source and observe the actual absent Cargo target"
        run = ci.workflowScript("authenticate-committed-source-and-observe-the-actual-absent-cargo-target.sh")
      }
      ci.command("Build the actual native source", "vp run --filter './npm/native' build:ci")
      new Dynamic {
        name = "Bind target absence to the actual compiler artifact"
        run = #"node tools/support/compat/parcel/native-target.mjs after "$GITHUB_WORKSPACE""#
      }
      new Dynamic {
        name = "Build the published adapter shape"
        `working-directory` = "npm/builder/parcel"
        run = "vp pack"
      }
      new Dynamic {
        name = "Validate geometry and configuration"
        run = "node --test npm/builder/parcel/src/*.test.ts tools/support/compat/parcel/profile-analysis.test.ts tools/support/compat/parcel/native-analysis.test.ts tools/support/compat/parcel/native-target.test.mjs tools/support/compat/parcel/reporter-config.test.ts"
      }
      new Dynamic {
        name = "Install the fixture browser"
        `working-directory` = "npm/builder/parcel"
        run = "vize-ci-apt-retry vp exec playwright install --with-deps chromium"
      }
      new Dynamic {
        name = "Qualify packed packages in a fresh Parcel consumer"
        run = ci.workflowScript("qualify-packed-packages-in-a-fresh-parcel-consumer.sh")
      }
      new Dynamic {
        name = "Exercise the default cache frontier without disabling browser caching"
        `if` = "github.event_name == 'workflow_dispatch' && inputs.default-cache-frontier"
        run = #"vp run --no-cache --filter './npm/builder/parcel' test:recovery-frontier -- "$RUNNER_TEMP/parcel-default-cache-frontier""#
      }
      new Dynamic {
        name = "Preserve source samples and seal the complete evidence"
        `if` = "${{ always() && !cancelled() }}"
        run = ci.workflowScript("preserve-source-samples-and-seal-the-complete-evidence.sh")
      }
      new Dynamic {
        name = "Preserve complete source and host evidence"
        `if` = "always()"
        uses = ci.uploadArtifact
        with {
          name = "parcel-transformer-${{ env.SOURCE_SHA }}"
          `include-hidden-files` = true
          `if-no-files-found` = "error"
          `retention-days` = 7
          path = """
          ${{ runner.temp }}/parcel-proof/
          !${{ runner.temp }}/parcel-proof/**/node_modules/**
          ${{ runner.temp }}/parcel-cpu/
          ${{ runner.temp }}/parcel-default-cache-frontier/
          !${{ runner.temp }}/parcel-default-cache-frontier/**/node_modules/**
          npm/native/.artifacts/native/formatter-history/

          """
        }
      }
    }
  }
}

local nativePluginPaths = "npm/builder/parcel-native"
local nativePluginCommit = "2bcfb43e725b2688b787e497e0b0b4105c353222"  // v3.0.0-alpha.2
local checkoutV4 = "actions/checkout@11d5960a326750d5838078e36cf38b85af677262"  // v4.4.0
local uploadArtifactV4 = "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02"  // v4.6.2
local downloadArtifactV4 = "actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093"  // v4.3.0

/// The packaging scripts of the pinned Parcel commit, moved out of the workspace.
local nativePluginScripts: Listing<Dynamic> = new {
  new Dynamic {
    name = "Check out packaging scripts"
    uses = checkoutV4
    with {
      repository = "parcel-bundler/parcel"
      ref = nativePluginCommit
      path = ".parcel-native-plugin-scripts"
      `sparse-checkout` = ".github/scripts/native-plugin"
      `sparse-checkout-cone-mode` = false
      filter = "blob:none"
    }
  }
  new Dynamic {
    name = "Move packaging scripts out of the workspace"
    shell = "bash"
    run = ci.workflowScript("move-the-native-plugin-scripts-out-of-the-workspace.sh")
  }
}

/// The source checkout, the packaging scripts and the Node.js they run on.
local nativePluginSetup: Listing<Dynamic> = new {
  ...ci.stageWorkflowScripts("parcel-transformer")
  ci.use(checkoutV4)
  ...nativePluginScripts
  new Dynamic {
    uses = "actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020"  // v4.4.0
    with { `node-version` = "24" }
  }
}
