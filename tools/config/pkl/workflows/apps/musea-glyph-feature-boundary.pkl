import "../../Actions.pkl" as ci

name = "Musea glyph feature boundary"

on {
  pull_request {
    paths = new Listing {
      "crates/vize/**"
      "Cargo.toml"
      "Cargo.lock"
      ".github/workflows/musea-glyph-feature-boundary.yml"
    }
  }
}

permissions { contents = "read" }
concurrency {
  group = "musea-glyph-boundary-${{ github.event.pull_request.number }}"
  `cancel-in-progress` = true
}

jobs {
  `cli-feature-sets` {
    `runs-on` = ci.linux
    `timeout-minutes` = 30
    env { CARGO_INCREMENTAL = "0" }
    steps = new Listing {
      ci.checkoutAt("${{ github.event.pull_request.head.sha }}")
      ci.rust("stable")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "musea-glyph-boundary"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.command("Check the CLI without default features", "cargo check --locked -p vize --bin vize --no-default-features")
      ci.command("Check the CLI with glyph", "cargo check --locked -p vize --bin vize --features glyph")
    }
  }
}
