import "../../Actions.pkl" as ci

name = "Mounted runtime devtools comparison"

on {
  pull_request {
    paths = new Listing {
      "tests/tooling/support/mounted-runtime-devtools.ts"
      "tests/tooling/mounted-runtime-devtools.test.ts"
      "tests/tooling/support/davinci-mounted-trace.mjs"
      "tests/tooling/support/davinci-transition-trace.mjs"
      "tests/tooling/support/vue-vapor-release.mjs"
      "tests/tooling/support/mounted-runtime-source.ts"
      "tests/tooling/support/mounted-runtime-producer.ts"
      "tests/tooling/support/mounted-runtime-native-boundary.ts"
      "tests/tooling/support/mounted-runtime-native-exit.mjs"
      "tests/tooling/support/patterned-template-runtime.mjs"
      "tests/tooling/mounted-runtime-source.test.ts"
      "tools/support/compat/github/compare-mounted-runtime-devtools.ts"
      "tools/support/compat/github/verify-mounted-runtime-boundary.ts"
      ".github/workflows/mounted-runtime-devtools-comparison.yml"
    }
  }
  workflow_dispatch = null
}
permissions { contents = "read" }

env {
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
  CARGO_BUILD_JOBS = "12"
  VIZE_TEST_REQUIRE_TSGO = "1"
}

jobs {
  compare {
    name = "Baseline and fresh observer runtime parity"
    `runs-on` = ci.linux
    `timeout-minutes` = 10
    steps = new Listing {
      ci.use(ci.checkout)
      ci.rust("1.100.0")
      ci.wild()
      new Dynamic {
        uses = "./.github/actions/setup-rust-sticky-cache"
        with {
          key = "nextest-ci"
          `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
        }
      }
      ci.workspaceVp()
      ci.command("Install exact pinned dependencies", "vp install --frozen-lockfile --prefer-offline")
      new Dynamic {
        name = "Build the unchanged Transition parity test once"
        run = "cargo test --profile ci --package vize_atelier_vapor --test davinci_transition_parity --no-run"
      }
      new Dynamic {
        name = "Compare complete traces and all fresh subprocesses"
        run = #"vp exec node tools/support/compat/github/compare-mounted-runtime-devtools.ts "$RUNNER_TEMP/mounted-runtime-devtools-comparison""#
      }
      new Dynamic {
        name = "Verify complete producer exits and the pure JavaScript observer"
        `if` = "${{ !cancelled() }}"
        run = #"vp exec node tools/support/compat/github/verify-mounted-runtime-boundary.ts "$RUNNER_TEMP/mounted-runtime-devtools-comparison/boundary""#
      }
      new Dynamic {
        name = "Retain complete traces, lifecycle events and timing evidence"
        `if` = "${{ always() }}"
        uses = ci.uploadArtifact
        with {
          name = "mounted-runtime-devtools-comparison-${{ github.run_id }}-${{ github.run_attempt }}"
          path = "${{ runner.temp }}/mounted-runtime-devtools-comparison/"
          `if-no-files-found` = "error"
          `retention-days` = 14
        }
      }
    }
  }
}
