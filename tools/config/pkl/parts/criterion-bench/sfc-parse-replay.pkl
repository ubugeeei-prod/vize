`if` = "${{ !inputs.sfc_optional_lifecycle_only && inputs.historical_sfc_parse && !inputs.level_memory_only && !inputs.sfc_member_only }}"
name = "SFC parse replay (measurement ${{ matrix.repetition }})"
strategy {
  `fail-fast` = false
  matrix {
    repetition = List(1, 2, 3)
  }
}
uses = "./.github/workflows/sfc-parse-replay.yml"
with {
  base_sha = "${{ inputs.base_sha }}"
  head_sha = "${{ inputs.head_sha }}"
  repetition = "${{ matrix.repetition }}"
  conflicting_modes = "${{ inputs.production_only || inputs.vapor_only }}"
}
