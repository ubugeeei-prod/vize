import "../../Actions.pkl" as ci

`if` = "${{ !inputs.sfc_optional_lifecycle_only && inputs.production_only && !inputs.historical_sfc_parse && !inputs.level_memory_only && !inputs.sfc_member_only }}"
name = "Production pairs (measurement ${{ matrix.repetition }})"
`runs-on` = ci.linux
`timeout-minutes` = 30
permissions { contents = "read" }
strategy {
  `fail-fast` = false
  matrix {
    repetition = List(1, 2, 3)
  }
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with {
      ref = "${{ inputs.head_sha }}"
      `fetch-depth` = 0
      `persist-credentials` = false
    }
  }
  new Dynamic {
    name = "Validate exact production comparison head"
    env {
      BASE_SHA = "${{ inputs.base_sha }}"
      HEAD_SHA = "${{ inputs.head_sha }}"
      DISPATCH_SHA = "${{ github.sha }}"
    }
    run = """
    set -euo pipefail
    [[ "$BASE_SHA" =~ ^[0-9a-f]{40}$ ]]
    [[ "$HEAD_SHA" =~ ^[0-9a-f]{40}$ ]]
    [[ "$HEAD_SHA" == "$DISPATCH_SHA" ]]
    [[ "$(git rev-parse HEAD)" == "$HEAD_SHA" ]]
    git merge-base --is-ancestor "$BASE_SHA" "$HEAD_SHA"

    """
  }
  new Dynamic {
    uses = ci.setupRust
    with {
      toolchain = "stable"
      components = "clippy"
    }
  }
  ci.wild()
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "davinci-production-pairs-${{ matrix.repetition }}"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      `run-install` = false
    }
  }
  new Dynamic {
    name = "Check scoped selector and benchmark compile contract"
    run = """
    vp exec cargo test -p vize_atelier_vapor --features davinci-benchmark --lib compile::benchmark::tests
    vp exec cargo clippy -p vize_atelier_sfc --features davinci-production-bench --example davinci_production_perf -- -D warnings -D clippy::wildcard_imports

    """
  }
  new Dynamic {
    name = "Build before timed windows"
    run = "vp exec cargo build --profile ci-opt -p vize_atelier_sfc --features davinci-production-bench --example davinci_production_perf"
  }
  new Dynamic {
    name = "Measure shipping adapter pairs"
    env { VIZE_BENCH_HEAD_SHA = "${{ inputs.head_sha }}" }
    run = """
    mkdir -p production-perf
    target/ci-opt/examples/davinci_production_perf production-perf/samples.json
    {
      git rev-parse HEAD
      rustc --version --verbose
      uname -a
      lscpu
    } > production-perf/runner.txt

    """
  }
  new Dynamic {
    name = "Collect detailed bridge attribution in a separate binary"
    `if` = "${{ matrix.repetition == 1 }}"
    env { VIZE_BENCH_HEAD_SHA = "${{ inputs.head_sha }}" }
    run = """
    vp exec cargo clippy -p vize_l1_to_l2 --features davinci-benchmark-profile --lib -- -D warnings -D clippy::wildcard_imports
    vp exec cargo clippy -p vize_atelier_sfc --features davinci-production-profile --example davinci_production_perf -- -D warnings -D clippy::wildcard_imports
    vp exec cargo build --profile ci-opt -p vize_atelier_sfc --features davinci-production-profile --example davinci_production_perf
    target/ci-opt/examples/davinci_production_perf production-perf/bridge-attribution.json --attribution-only

    """
  }
  new Dynamic {
    name = "Upload raw samples and separate attribution profiles"
    `if` = "always()"
    uses = ci.uploadArtifact
    with {
      name = "davinci-production-perf-${{ matrix.repetition }}"
      path = "production-perf/"
      `if-no-files-found` = "warn"
      `retention-days` = 30
    }
  }
}
