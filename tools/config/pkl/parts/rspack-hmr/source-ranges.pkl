import "../../../../ci/lib/Actions.pkl" as ci

// External `src` block ranges keep complete modules and source maps.
env {
  SOURCE_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
  CARGO_TERM_COLOR = "always"
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24 = true
}
`runs-on` = ci.linux
`timeout-minutes` = 20
steps = new Listing {
  ...ci.stageWorkflowScripts("rspack-hmr")
  ci.checkoutAt("${{ env.SOURCE_SHA }}")
  new Dynamic {
    uses = ci.setupVp121
    with {
      version = "latest"
      `node-version-file` = "package.json"
      cache = true
      `cache-save` = false
      `run-install` = false
    }
  }
  ci.rust("1.100.0")
  ci.wild()
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "clippy-test"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.use("./.github/actions/setup-rust-script")
  new Dynamic {
    name = "Install the locked adapter and native dependencies"
    run = "vp install --frozen-lockfile --prefer-offline --filter '@vizejs/rspack-plugin...' --filter '@vizejs/builder-shared...' --filter '@vizejs/native...'"
  }
  new Dynamic {
    name = "Prepare the exact source native image"
    run = ci.workflowScript("src-ranges-prepare-the-exact-source-native-image.sh")
  }
  new Dynamic {
    name = "Retain original src boundaries, complete modules and source maps"
    run = ci.workflowScript("src-ranges-retain-original-src-boundaries-complete-modules-and-source-maps.sh")
  }
}
