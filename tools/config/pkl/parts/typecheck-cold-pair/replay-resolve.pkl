import "../../Actions.pkl" as ci

`if` = "github.event_name == 'push' || github.event_name == 'workflow_dispatch' && inputs.mode == 'content-mapper-replay'"
needs = "test"
`runs-on` = ci.linux
`timeout-minutes` = 10
outputs {
  base = "${{ steps.shas.outputs.base }}"
  head = "${{ steps.shas.outputs.head }}"
}
env {
  VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/typecheck-cold-pair"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with {
      `persist-credentials` = false
      `fetch-depth` = 0
    }
  }
  new Dynamic {
    id = "shas"
    env {
      BASE = "${{ inputs.base }}"
      HEAD = "${{ inputs.head || github.sha }}"
    }
    run = ci.workflowScript("replay-shas.sh")
  }
}
