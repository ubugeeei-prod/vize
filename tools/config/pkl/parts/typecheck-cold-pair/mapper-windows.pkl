import "../../../../ci/lib/Actions.pkl" as ci
local buildSteps = import("mapper-build.pkl").steps

needs = "mapper-build-windows"
`runs-on` = ci.windows
`timeout-minutes` = 90
env {
  VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/typecheck-cold-pair"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { `persist-credentials` = false }
  }
  new Dynamic {
    uses = ci.setupNode
    with {
      `node-version-file` = "package.json"
      `package-manager-cache` = false
    }
  }
  new Dynamic {
    uses = ci.downloadArtifact
    with {
      name = "pair-bin-windows"
      path = "pair-bin"
    }
  }
  new Dynamic {
    name = "Measure"
    shell = "pwsh"
    env {
      SIZES = "${{ inputs.sizes }}"
      RUNS = "${{ inputs.runs }}"
      ALLOW = "${{ inputs.allow_output_change && '--allow-output-change' || '' }}"
      REFERENCE = "${{ inputs.reference_mapper }}"
    }
    run = ci.workflowScript("mapper-measure.ps1")
  }
  new Dynamic {
    name = "Probe Windows burst costs"
    `if` = "inputs.windows_probe"
    shell = "pwsh"
    env { SIZES = "${{ inputs.sizes }}" }
    run = ci.workflowScript("mapper-probe-windows-burst-costs.ps1")
  }
  new Dynamic {
    uses = ci.uploadArtifact
    `if` = "always()"
    with {
      name = "pair-windows"
      path = "${{ runner.temp }}/pair-out/"
      `if-no-files-found` = "warn"
    }
  }
}
