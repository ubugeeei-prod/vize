import "../../../../ci/lib/Actions.pkl" as ci
local buildSteps = import("mapper-build.pkl").steps

// Linux and Windows build separately so the Linux and WSL2 cells start
// without waiting for the slower Windows build.
`if` = "github.event_name == 'workflow_dispatch' && inputs.mode == 'content-mapper'"
needs = "test"
`runs-on` = ci.linux
`timeout-minutes` = 90
env {

  BASE = "${{ inputs.base }}"
  HEAD = "${{ inputs.head }}"
  RUSTUP_TOOLCHAIN = "1.100.0"
  PAIR_OS = "linux"
  PAIR_EXE = "vize"
}
steps = new Listing {
  ...ci.stageWorkflowScripts("typecheck-cold-pair")
  ...buildSteps
}
