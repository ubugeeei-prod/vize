import "../../../../ci/lib/Actions.pkl" as ci

name = "test-report"
`runs-on` = "ubuntu-24.04"
`timeout-minutes` = 5
`if` = "${{ always() && (github.event_name == 'pull_request' || github.event_name == 'merge_group') }}"
needs = new Listing {
  "iteration-plan"
  "fmt-rust"
  "check-js"
  "security-audit"
  "node-engine-compat"
  "check-vize-apps"
  "pr-source-checks"
  "instruction-counts"
  "level-dependency-direction"
}
permissions {
  contents = "read"
  // Writes the PR's test report comment. Fork PR tokens stay read-only.
  `pull-requests` = "write"
  actions = "read"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with {
      `fetch-depth` = 1
      // The gate and downloaded-packet reporter need no product source checkout.
      `sparse-checkout-cone-mode` = false
      `sparse-checkout` = """
      /package.json
      /tools/support/compat/github/require-needs-success.ts
      /tools/support/compat/github/comment-test-report.ts
      /tools/support/compat/github/test-cases.ts
      /tools/support/compat/github/test-report-markdown.ts
      /tools/support/compat/github/test-areas.ts
      /tools/support/json-value.ts

      """
    }
  }
  new Dynamic {
    uses = ci.setupNode
    with {
      `node-version-file` = "package.json"
      `package-manager-cache` = false
    }
  }
  new Dynamic {
    name = "Require every needed job to succeed"
    id = "gate"
    env { NEEDS_JSON = "${{ toJSON(needs) }}" }
    run = "node tools/support/compat/github/require-needs-success.ts --check-report"
  }
  // Only the gate decides this check; the steps after it never change it.
  new Dynamic {
    name = "Download test case reports"
    id = "cases"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      pattern = "test-cases-*"
      path = "${{ runner.temp }}/test-cases"
    }
  }
  new Dynamic {
    name = "Report test results"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    env {
      GITHUB_TOKEN = "${{ github.token }}"
      TEST_REPORT_GATE = "${{ steps.gate.outcome }}"
      TEST_REPORT_CASES = "${{ steps.cases.outcome }}"
      TEST_REPORT_CASES_DIR = "${{ runner.temp }}/test-cases"
      TEST_REPORT_HEAD_SHA = "${{ github.event.pull_request.head.sha || github.event.merge_group.head_sha }}"
      // Empty without a write token: fork PRs and merge groups get only the step summary.
      TEST_REPORT_PR_NUMBER = "${{ github.event.pull_request.head.repo.full_name == github.repository && github.event.pull_request.number || '' }}"
    }
    run = "node tools/support/compat/github/comment-test-report.ts"
  }
}
