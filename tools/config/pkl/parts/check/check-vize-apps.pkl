import "../../Actions.pkl" as ci

`runs-on` = "${{ needs.iteration-plan.outputs.apps == 'true' && 'blacksmith-32vcpu-ubuntu-2404' || 'ubuntu-24.04' }}"
needs = "iteration-plan"
`timeout-minutes` = 20
env { NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169" }
steps = new Listing {
  ci.use(ci.checkout)
  new Dynamic {
    name = "Check affected product applications"
    `if` = "${{ needs.iteration-plan.outputs.apps == 'true' }}"
    uses = "./.github/actions/check-vize-apps"
  }
  new Dynamic {
    name = "Report unaffected applications"
    `if` = "${{ needs.iteration-plan.outputs.apps != 'true' }}"
    run = #"echo 'Product application inputs are unchanged.' >> "$GITHUB_STEP_SUMMARY""#
  }
}
