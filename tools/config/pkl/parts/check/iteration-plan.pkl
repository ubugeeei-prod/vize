import "../../../../ci/lib/Actions.pkl" as ci

`runs-on` = "ubuntu-24.04"
`timeout-minutes` = 2
outputs {
  apps = "${{ steps.plan.outputs.apps }}"
  dependencies = "${{ steps.plan.outputs.dependencies }}"
  engines = "${{ steps.plan.outputs.engines }}"
}
steps = new Listing {
  ...ci.stageWorkflowScripts("check")
  new Dynamic {
    uses = ci.checkout
    with {
      `fetch-depth` = 2
      // Plan diffs read Git trees; only the selector runtime needs blobs.
      `sparse-checkout-cone-mode` = false
      `sparse-checkout` = """
      /package.json
      /tools/support/compat/github/plan-check-inputs.ts
      /tools/support/compat/github/comparison-base.ts
      /tools/support/github/opinionated-source-inputs.ts

      """
    }
  }
  new Dynamic {
    uses = ci.setupNode
    with {
      `node-version-file` = "package.json"
      `package-manager-cache` = false
    }
  }
  new Dynamic {
    name = "Validate explicit release qualification"
    `if` = "${{ github.event_name == 'workflow_dispatch' && inputs.release-qualification }}"
    env { RELEASE_QUALIFICATION_REF = "${{ github.ref }}" }
    run = #". "${{ env.VIZE_CI_FILES }}/validate-explicit-release-qualification.sh""#
  }
  new Dynamic {
    id = "plan"
    name = "Select product and dependency checks"
    env {
      EVENT_BASE_SHA = "${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }}"
      PR_HEAD_SHA = "${{ github.event.pull_request.head.sha }}"
    }
    run = "node tools/support/compat/github/plan-check-inputs.ts"
  }
}
