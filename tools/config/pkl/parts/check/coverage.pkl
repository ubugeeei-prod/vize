import "../../../../ci/lib/Actions.pkl" as ci

`runs-on` = ci.linux
`if` = "${{ github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' }}"
`timeout-minutes` = 30
steps = new Listing {
  ci.use(ci.checkout)
  ci.rust("stable")
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "coverage"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    uses = ci.setupVp
    with {
      version = ci.vpVersion
      `node-version-file` = "package.json"
      `run-install` = false
    }
  }
  // The fixture-coverage runner evaluates the SFC Pkl fixtures.
  ci.command("Install Pkl CLI", "npm install --global @pkl-community/pkl@0.27.2")
  ci.command("Coverage report", "node tools/ci/commands/github/write-coverage-summary.ts")
}
