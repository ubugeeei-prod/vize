steps = new Listing {
  new Dynamic {
    name = "Test complete native snapshot text and owner refusals"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-complete-native-snapshot-text-and-owner-refusals.sh""#
  }
  new Dynamic {
    name = "Test real compiler-kind diagnostics against complete native pull packets"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-real-compiler-kind-diagnostics-against-complete-native-pull-packets.sh""#
  }
  new Dynamic {
    name = "Test legacy projection anchors and complete diagnostic ranges"
    shell = "bash"
    env { VIZE_DAVINCI_DIFFERENTIAL_CORPUS = "${{ github.workspace }}" }
    run = "cargo test --locked --profile ci -p vize_canon --features legacy-differential --test davinci_projection_differential -- --nocapture"
  }
  new Dynamic {
    name = "Test complete model event overload contracts with the native checker"
    shell = "bash"
    env { VIZE_TEST_REQUIRE_TSGO = "1" }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-complete-model-event-overload-contracts-with-the-native-checker.sh""#
  }
  new Dynamic {
    name = "Test declared public-instance member types with the native checker"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-declared-public-instance-member-types-with-the-native-checker.sh""#
  }
  new Dynamic {
    name = "Test capture-free component instances with exact native member diagnostics"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_UNKNOWN_COMPAT_CAPTURE = "${{ runner.temp }}/capture-free-instance"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-capture-free-component-instances-with-exact-native-member-diagnosti.sh""#
  }
  new Dynamic {
    name = "Test authored Options API module augmentations with the native checker"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-authored-options-api-module-augmentations-with-the-native-checker.sh""#
  }
  new Dynamic {
    name = "Test plain Options API globals and record selected dialect observations"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-plain-options-api-globals-and-record-selected-dialect-observations.sh""#
  }
  new Dynamic {
    name = "Test repeated loop source reads and public-instance alias shadowing"
    shell = "bash"
    env { VIZE_TEST_REQUIRE_TSGO = "1" }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-repeated-loop-source-reads-and-public-instance-alias-shadowing.sh""#
  }
  new Dynamic {
    name = "Test typed legacy mixin methods without erasing native findings"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-typed-legacy-mixin-methods-without-erasing-native-findings.sh""#
  }
  new Dynamic {
    name = "Test typed external props in the selected legacy dialect"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source"
    }
    run = #". "$GITHUB_ACTION_PATH/scripts/test-typed-external-props-in-the-selected-legacy-dialect.sh""#
  }
}
