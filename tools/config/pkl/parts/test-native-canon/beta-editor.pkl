import "../../Actions.pkl" as ci

steps = new Listing {
  new Dynamic {
    name = "Test exact beta editor owner diagnostics and clean EOF shutdown"
    `if` = "${{ !cancelled() }}"
    shell = "bash"
    env {
      VIZE_TEST_NATIVE_BETA_TSGO = "${{ runner.temp }}/native-beta-10741/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      VIZE_NATIVE_BETA_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/beta-shutdown-10741"
    }
    run = #"""
    set -euo pipefail
    unset VIZE_TEST_DISABLE_TSGO
    provider="$RUNNER_TEMP/native-beta-10741"
    capture="$VIZE_NATIVE_BETA_CAPTURE_DIR"
    mkdir -p "$provider" "$capture"
    printf '%s\n' '{"private":true,"devDependencies":{"typescript":"7.1.0-beta"}}' >"$provider/package.json"
    npm install --prefix "$provider" --ignore-scripts --no-audit --no-fund
    cp "$provider/package.json" "$capture/provider-package.json"
    cp "$provider/package-lock.json" "$capture/provider-package-lock.json"
    if ! command -v strace >/dev/null; then sudo apt-get update && sudo apt-get install -y strace; fi
    cargo test --locked --profile ci -p vize_canon --lib --no-run --message-format=json >"$capture/build.jsonl"
    node tests/tooling/support/native-beta-shutdown/source.mjs

    """#
  }
  new Dynamic {
    name = "Test guarded listeners and generic component casts with the authenticated beta checker"
    `if` = "${{ !cancelled() }}"
    shell = "bash"
    env {
      VIZE_TEST_CONTENT_MAPPER_TSGO = "${{ runner.temp }}/native-beta-10741/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      VIZE_NESTED_FUNCTION_GUARD_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/nested-function-guard-11853"
      VIZE_GENERIC_COMPONENT_CAST_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/generic-component-cast-11966"
      VIZE_VFOR_CONST_LISTENER_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/vfor-const-listener-narrowing-11973"
    }
    run = """
    set -euo pipefail
    unset VIZE_TEST_DISABLE_TSGO
    cargo test --locked --profile ci -p vize --test integration -- content_mapper_tsgo_cli::nested_function_guard_11853::standard_tsgo_nested_function_guards_keep_listener_reads_and_real_errors --ignored --exact --nocapture
    cargo test --locked --profile ci -p vize --test integration -- content_mapper_tsgo_cli::generic_component_cast_11966::standard_tsgo_accepts_generic_slots_and_emits_component_cast --ignored --exact --nocapture
    cargo test --locked --profile ci -p vize --test integration -- content_mapper_tsgo_cli::vfor_const_listener_narrowing_11973::standard_tsgo_keeps_v_for_const_narrowing_in_listener_callbacks content_mapper_tsgo_cli::replayed_pattern_duplicates::standard_tsgo_reports_each_replayed_pattern_diagnostic_once --ignored --exact --nocapture

    """
  }
  new Dynamic {
    name = "Test mixed script destructured static refs and authored ownership"
    `if` = "${{ !cancelled() }}"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_CONTENT_MAPPER_TSGO = "${{ runner.temp }}/native-beta-10741/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      VIZE_MIXED_STATIC_REF_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/mixed-script-static-ref-11811"
      VIZE_LOOSE_LISTENER_PACKET_DIR = "${{ runner.temp }}/native-snapshot-source/loose-listener-context-11600"
    }
    run = """
    set -uo pipefail
    unset VIZE_TEST_DISABLE_TSGO
    mixed_ref_status=0
    cargo test --locked --profile ci -p vize_croquis --lib script_parser::tests::destructure_spans::destructured_bindings_keep_authored_identifier_spans -- --exact --nocapture || mixed_ref_status=1
    cargo test --locked --profile ci -p vize_canon --features legacy --lib virtual_ts::tests::unused_refs::mixed_scripts:: -- --nocapture || mixed_ref_status=1
    cargo test --locked --profile ci -p vize_canon --features legacy --lib virtual_ts::scope::event_handler::contextual_listener::tests::contextual_listener_complete_projection_and_mapping_packets -- --exact --nocapture || mixed_ref_status=1
    cargo test --locked --profile ci -p vize --test integration -- content_mapper_tsgo_cli::dynamic_template_refs::mixed_scripts::native_cli_mixed_script_static_refs_keep_destructured_reads_and_true_unused --ignored --exact --nocapture || mixed_ref_status=1
    cargo test --locked --profile ci -p vize --test integration -- content_mapper_tsgo_cli::dynamic_template_refs::mixed_scripts::protocol::standard_tsgo_mixed_script_static_refs_keep_runtime_reads_and_authored_errors --ignored --exact --nocapture || mixed_ref_status=1
    exit "$mixed_ref_status"

    """
  }
  new Dynamic {
    name = "Test inherited Options API calls with the authenticated beta checker"
    `if` = "${{ !cancelled() }}"
    shell = "bash"
    env {
      CORSA_PATH = "${{ runner.temp }}/native-beta-10741/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_INHERITED_PROVIDER_ROLE = "a183-ts7.1"
      VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/inherited-options-beta"
      VIZE_CACHE_CUSTODY_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/inherited-options-beta/native-raw"
    }
    run = #"""
    set -euo pipefail
    unset VIZE_TEST_DISABLE_TSGO
    capture="$VIZE_SNAPSHOT_SOURCE_CAPTURE_DIR"
    mkdir -p "$capture"
    node --input-type=module - "$CORSA_PATH" "$capture" <<'NODE'
    import assert from 'node:assert/strict';
    import fs from 'node:fs';
    import path from 'node:path';
    import { createHash } from 'node:crypto';
    import { spawnSync } from 'node:child_process';
    const program = fs.realpathSync(process.argv[2]);
    const directory = process.argv[3];
    const manifestPath = path.join(path.dirname(path.dirname(program)), 'package.json');
    const manifestBytes = fs.readFileSync(manifestPath);
    const manifest = JSON.parse(manifestBytes);
    const sha256 = createHash('sha256').update(fs.readFileSync(program)).digest('hex');
    const save = (name, value) => fs.writeFileSync(path.join(directory, name), JSON.stringify(value, null, 2) + '\n', {flag: 'wx'});
    save('identity-preflight.json', {program, sha256, providerRole: process.env.VIZE_TEST_INHERITED_PROVIDER_ROLE, expectedDiagnosticExitCode: 2, manifestPath, manifestBytes: [...manifestBytes], scope: 'Authenticated supplemental source 7.1 control; reporter binary identity is unknown'});
    assert.equal(process.env.VIZE_TEST_INHERITED_PROVIDER_ROLE, 'a183-ts7.1');
    assert.equal(manifest.name, '@typescript/typescript-linux-x64');
    assert.equal(manifest.version, '7.1.0-beta');
    assert.equal(sha256, 'a183b1956edbe7e7d98f2249858eedf2d8a9790809cc4909db1276e202faaa70');
    const result = spawnSync(program, ['--version']);
    fs.writeFileSync(path.join(directory, 'version.stdout'), result.stdout ?? Buffer.alloc(0), {flag: 'wx'});
    fs.writeFileSync(path.join(directory, 'version.stderr'), result.stderr ?? Buffer.alloc(0), {flag: 'wx'});
    save('version-result.json', {program, sha256, args: ['--version'], status: result.status, signal: result.signal, pid: result.pid ?? null, error: result.error ? String(result.error) : null, companionOnly: true});
    assert.equal(result.error, undefined);
    assert.equal(result.status, 0);
    assert.equal(result.signal, null);
    assert.equal(result.stdout.toString(), 'Version 7.1.0-beta\n');
    assert.equal(result.stderr.length, 0);
    NODE
    set +e
    cargo test --locked --profile ci -p vize_canon --features cache-custody --lib batch::type_checker::tests::recent_issues::options_api_inherited_template_members:: -- --nocapture
    api_status=$?
    cargo test --locked --profile ci -p vize --test integration -- check_options_api_inherited_members_cli:: --nocapture
    cli_status=$?
    set -e
    printf '%s\n' "$api_status" >"$capture/api.status"
    printf '%s\n' "$cli_status" >"$capture/cli.status"
    sha256sum "$CORSA_PATH" >"$capture/native.after.sha256"
    test "$(cut -d ' ' -f 1 "$capture/native.after.sha256")" = a183b1956edbe7e7d98f2249858eedf2d8a9790809cc4909db1276e202faaa70
    test "$api_status" -eq 0
    test "$cli_status" -eq 0

    """#
  }
  new Dynamic {
    name = "Test legal SFC attribute boundaries with the existing beta checker"
    `if` = "${{ !cancelled() }}"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_RECOVERED_ATTRIBUTE_CONTENT_MAPPER_TSGO = "${{ runner.temp }}/native-beta-10741/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      VIZE_RECOVERED_ATTRIBUTE_CAPTURE_DIR = "${{ runner.temp }}/native-snapshot-source/recovered-attribute-boundary-11731"
    }
    run = #"""
    set -euo pipefail
    unset VIZE_TEST_DISABLE_TSGO
    capture="$VIZE_RECOVERED_ATTRIBUTE_CAPTURE_DIR"
    mkdir -p "$capture"
    set +e
    cargo test --locked --profile ci -p vize --test integration -- content_mapper_tsgo_cli::recovered_attribute_boundary_11731::legal_quoted_boundaries_keep_neighbor_and_unused_diagnostics --exact --nocapture --color never >"$capture/test.stdout" 2>"$capture/test.stderr"
    status=$?
    set -e
    printf '%s\n' "$status" >"$capture/test.status"
    cat "$capture/test.stdout"
    cat "$capture/test.stderr" >&2
    node --input-type=module - "$capture" <<'NODE'
    import assert from 'node:assert/strict';
    import fs from 'node:fs';
    import path from 'node:path';
    import {createHash} from 'node:crypto';
    import {execFileSync} from 'node:child_process';
    const dir = process.argv[2];
    const name = 'content_mapper_tsgo_cli::recovered_attribute_boundary_11731::legal_quoted_boundaries_keep_neighbor_and_unused_diagnostics';
    const digest = bytes => createHash('sha256').update(bytes).digest('hex');
    const stdout = fs.readFileSync(path.join(dir, 'test.stdout'));
    const stderr = fs.readFileSync(path.join(dir, 'test.stderr'));
    const status = fs.readFileSync(path.join(dir, 'test.status'), 'utf8');
    const wanted = new Set(['reported', 'valid', 'same-file', 'unused'].flatMap(variant => ['\n', '\r\n'].flatMap(newline => [false, true].map(unused => JSON.stringify([variant, newline, unused])))));
    const seen = new Set();
    let failure = null;
    let provider = null;
    try {
      assert.equal(status, '0\n');
      assert.equal(stdout.toString().split('\n').filter(line => line === `test ${name} ... ok`).length, 1);
      assert.equal([...stdout.toString().matchAll(/^test result: ok\. 1 passed; 0 failed; 0 ignored; /gm)].length, 1);
      const program = fs.realpathSync(process.env.VIZE_TEST_RECOVERED_ATTRIBUTE_CONTENT_MAPPER_TSGO);
      const manifest = JSON.parse(fs.readFileSync(path.join(path.dirname(path.dirname(program)), 'package.json'), 'utf8'));
      assert.equal(manifest.name, '@typescript/typescript-linux-x64');
      assert.equal(manifest.version, '7.1.0-beta');
      const sha256 = digest(fs.readFileSync(program));
      assert.equal(sha256, 'a183b1956edbe7e7d98f2249858eedf2d8a9790809cc4909db1276e202faaa70');
      provider = {program, sha256, package: manifest.name, version: manifest.version};
      for (const line of stderr.toString().split('\n').filter(line => line.startsWith('11731 cell '))) {
        const row = /^11731 cell variant=(\S+) newline=("(?:\\.|[^"])*") noUnusedLocals=(false|true) provider=(.+) status=exit status: (\d+) stdout=/.exec(line);
        assert.ok(row, line);
        const key = JSON.stringify([row[1], JSON.parse(row[2]), row[3] === 'true']);
        assert.ok(wanted.has(key) && !seen.has(key), key);
        assert.equal(row[4], process.env.VIZE_TEST_RECOVERED_ATTRIBUTE_CONTENT_MAPPER_TSGO);
        assert.equal(Number(row[5]), row[1] === 'valid' ? 0 : 2);
        seen.add(key);
      }
      assert.deepEqual(seen, wanted);
    } catch (error) {
      failure = String(error);
    }
    fs.writeFileSync(path.join(dir, 'test-run.json'), JSON.stringify({
      source: execFileSync('git', ['rev-parse', 'HEAD'], {encoding: 'utf8'}).trim(),
      githubSha: process.env.GITHUB_SHA, run: process.env.GITHUB_RUN_ID, attempt: process.env.GITHUB_RUN_ATTEMPT,
      name, status, cellCount: seen.size, inventory: [...seen], provider,
      stdoutSha256: digest(stdout), stderrSha256: digest(stderr), qualified: failure === null, failure
    }, null, 2) + '\n');
    if (failure !== null) throw new Error(failure);
    NODE

    """#
  }
  new Dynamic {
    name = "Test TypeScript 7.1 LSP editor answers over the content mapper"
    `if` = "${{ !cancelled() }}"
    shell = "bash"
    env {
      VIZE_TEST_CONTENT_MAPPER_TSGO = "${{ runner.temp }}/native-beta-10741/node_modules/@typescript/typescript-linux-x64/lib/tsc"
    }
    run = #"""
    set -euo pipefail
    test "$("$VIZE_TEST_CONTENT_MAPPER_TSGO" --version)" = "Version 7.1.0-beta"
    cargo test --locked --profile ci -p vize --test integration -- content_mapper_tsgo_editor_accuracy:: --nocapture 2>&1 | tee "$RUNNER_TEMP/editor-accuracy.log"
    grep -Eq '^test result: ok\. [1-9][0-9]* passed; 0 failed' "$RUNNER_TEMP/editor-accuracy.log"

    """#
  }
  new Dynamic {
    name = "Preserve actual native inputs and responses"
    `if` = "${{ always() }}"
    uses = ci.uploadArtifact
    with {
      name = "native-canon-${{ github.run_id }}-${{ github.run_attempt }}"
      path = """
      ${{ runner.temp }}/native-snapshot-source
      ${{ runner.temp }}/native-syntax-semantics
      target/vize-tests/flow-depth-isolation

      """
      `if-no-files-found` = "ignore"
      `retention-days` = 7
    }
  }
  new Dynamic {
    name = "Require imported markRaw callback diagnostics"
    id = "imported-raw-callback"
    shell = "bash"
    env {
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_IMPORTED_RAW_CAPTURE = "${{ runner.temp }}/imported-raw-callback"
    }
    run = "bash tools/support/github/test-imported-raw-callback.sh"
  }
  new Dynamic {
    name = "Preserve imported markRaw callback complete observations"
    `if` = "${{ always() && steps.imported-raw-callback.outcome != 'skipped' }}"
    uses = ci.uploadArtifact
    with {
      name = "imported-raw-callback-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.sha }}"
      path = "${{ runner.temp }}/imported-raw-callback"
      `if-no-files-found` = "error"
      `retention-days` = 7
    }
  }
}
