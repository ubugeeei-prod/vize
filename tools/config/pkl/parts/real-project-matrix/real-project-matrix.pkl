import "../../../../ci/lib/Actions.pkl" as ci

name = "real projects (${{ matrix.name }})"
needs = "plan-projects"
`runs-on` = ci.linux
`timeout-minutes` = 120
strategy {
  `fail-fast` = false
  // The hosted release fallback must fit the documented Free plan floor:
  // 20 concurrent standard hosted jobs, so 22 shards can take two waves.
  `max-parallel` = 6
  matrix = "${{ fromJSON(needs.plan-projects.outputs.matrix) }}"
}
env {
  VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/real-project-matrix"
  FIXTURE_SHARD_COUNT = "${{ matrix.shardCount || '22' }}"
  FIXTURE_SHARD_INDEX = "${{ matrix.shard }}"
  FIXTURE_REPORT_DIR = "real-project-results/shard-${{ matrix.shard }}"
}
steps = new Listing {
  new Dynamic {
    name = "Checkout matrix commit"
    uses = ci.checkout
    with {
      `persist-credentials` = false
      ref = "${{ github.sha }}"
    }
  }
  ci.workspaceVp()
  new Dynamic {
    name = "Setup Rust"
    uses = ci.setupRust
    with { toolchain = "stable" }
  }
  ci.use("./.github/actions/setup-rust-script")
  ci.command("Enable package manager shims", "corepack enable")
  new Dynamic {
    name = "Select and hydrate fixture shard"
    shell = "bash"
    run = #". "${{ env.VIZE_CI_FILES }}/select-and-hydrate-fixture-shard.sh""#
  }
  new Dynamic {
    name = "Install pinned typecheck baseline dependencies"
    id = "typecheck_dependencies"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    run = #". "${{ env.VIZE_CI_FILES }}/install-pinned-typecheck-baseline-dependencies.sh""#
  }
  new Dynamic {
    name = "Audit formatter waiver owners"
    id = "waiver_audit"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    env { GITHUB_TOKEN = "${{ github.token }}" }
    run = #". "${{ env.VIZE_CI_FILES }}/audit-formatter-waiver-owners.sh""#
  }
  new Dynamic {
    name = "Setup Wild linker"
    uses = "./.github/actions/setup-wild-http-recovery"
    with { `wild-version` = "0.9.0" }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "real-project-matrix-${{ matrix.shard }}"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.command("Install JavaScript dependencies", "vp install --frozen-lockfile --prefer-offline")
  // v0.450.0 lost a shard to a stalled crates.io download; retry only the fetch.
  new Dynamic {
    name = "Fetch Rust dependencies"
    env { CARGO_NET_RETRY = "10" }
    run = #". "${{ env.VIZE_CI_FILES }}/fetch-rust-dependencies.sh""#
  }
  ci.command("Build Vize CLI", "cargo build --profile ci -p vize")
  new Dynamic {
    name = "Classify pinned Misskey generated diagnostics"
    `if` = "${{ !cancelled() && contains(matrix.name, 'misskey') }}"
    env {
      CORSA_PATH = "${{ github.workspace }}/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      VIZE_TEST_MISSKEY_GENERATED_DIAGNOSTICS_9516 = "1"
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_FIX_HISTORY_CAPTURE_DIR = "${{ github.workspace }}/${{ env.FIXTURE_REPORT_DIR }}/misskey-generated-diagnostics-9516"
    }
    run = "cargo test --locked --profile ci -p vize_canon --lib pinned_misskey_preserves_current_and_tuple_diagnostic_boundaries -- --nocapture --test-threads=1"
  }
  new Dynamic {
    name = "Exercise real projects with every core tool"
    id = "core_tools"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    `timeout-minutes` = 60  // Green shards take at most 14 min; one project may use its 40.
    // Qualify Vize on the one supported checker, not a fixture's own preview.
    env {
      CORSA_PATH = "${{ github.workspace }}/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      CORE_TOOLS_TIMEOUT_MS = "${{ inputs.core_tools_timeout_ms || '2400000' }}"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/exercise-real-projects-with-every-core-tool.sh""#
  }
  new Dynamic {
    name = "Check real-project LSP lifecycle"
    id = "lsp"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    `timeout-minutes` = 30  // Green shards take at most 11 min.
    env {
      CORSA_PATH = "${{ github.workspace }}/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      REAL_PROJECT_LSP_TIMEOUT_MS = "600000"
      VIZE_LSP_BIN = "target/ci/vize"
      VIZE_LSP_REQUIRE_SOURCE_BUILD = "1"
      VIZE_LSP_BUILD_RECIPE = "cargo build --profile ci -p vize"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/check-real-project-lsp-lifecycle.sh""#
  }
  new Dynamic {
    name = "Validate source-bound LSP wire"
    `if` = "${{ always() }}"
    run = #"node tests/tooling/support/lsp/verify-session-captures.ts verify "$FIXTURE_REPORT_DIR/lsp-wire-before.json" "$FIXTURE_REPORT_DIR/lsp-wire-integrity.json""#
  }
  new Dynamic {
    name = "Measure real-project lint divergence"
    id = "lint_divergence"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    env {
      LINT_DIVERGENCE_MODE = "${{ inputs.lint_divergence_mode || 'enforce' }}"
      LINT_BASELINE_REFERENCE_MODE = "${{ inputs.lint_baseline_reference_mode || 'bounded' }}"
      LINT_BASELINE_SHARD_MAX_BYTES = "8388608"
      LINT_BASELINE_SHARD_MAX_FILES = "32"
      LINT_BASELINE_SHARD_MAX_OUTPUT_BYTES = "268435456"
      NODE_OPTIONS = "${{ inputs.lint_baseline_reference_mode == 'unbounded-6g' && '--max-old-space-size=6144' || '' }}"
      VIZE_LINT_BASELINE_PROGRESS = "1"
      VIZE_LINT_BASELINE_UNBOUNDED = "${{ inputs.lint_baseline_reference_mode == 'unbounded-6g' && '1' || '0' }}"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/measure-real-project-lint-divergence.sh""#
  }
  new Dynamic {
    name = "Record linter deletion-readiness evidence"
    `if` = "${{ !cancelled() }}"
    run = #". "${{ env.VIZE_CI_FILES }}/record-linter-deletion-readiness-evidence.sh""#
  }
  new Dynamic {
    name = "Check real-project syntax highlighting"
    id = "syntax_highlighter"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    env { SYNTAX_HIGHLIGHTER_TIMEOUT_MS = "600000" }
    run = #". "${{ env.VIZE_CI_FILES }}/check-real-project-syntax-highlighting.sh""#
  }
  new Dynamic {
    name = "Check glyph formatter corpus properties"
    id = "glyph"
    `if` = "${{ !cancelled() }}"
    `continue-on-error` = true
    env { VIZE_TEST_BIN = "target/ci/vize" }
    shell = "bash"
    run = #". "${{ env.VIZE_CI_FILES }}/check-glyph-formatter-corpus-properties.sh""#
  }
  new Dynamic {
    name = "Record formatter deletion-readiness evidence"
    `if` = "${{ !cancelled() }}"
    run = #". "${{ env.VIZE_CI_FILES }}/record-formatter-deletion-readiness-evidence.sh""#
  }
  new Dynamic {
    name = "Enforce typechecker baseline divergence"
    id = "typecheck_divergence"
    `if` = "${{ !cancelled() && (inputs.typecheck_divergence_mode || 'enforce') != 'skip' }}"
    `continue-on-error` = true
    `timeout-minutes` = 100
    env {
      BUDGET_MODE = "${{ inputs.typecheck_divergence_mode || 'enforce' }}"
      CORSA_PATH = "${{ github.workspace }}/node_modules/@typescript/typescript-linux-x64/lib/tsc"
      VIZE_TYPECHECK_DIVERGENCE_PROGRESS = "1"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/enforce-typechecker-baseline-divergence.sh""#
  }
  new Dynamic {
    name = "Enforce all real-project surface verdicts"
    id = "surface_verdict"
    `if` = "${{ always() }}"
    shell = "bash"
    env {
      CORE_TOOLS_MODE = "${{ inputs.core_tools_mode || 'enforce' }}"
      TYPECHECK_DEPENDENCIES_MODE = "${{ inputs.typecheck_dependencies_mode || 'enforce' }}"
      LINT_DIVERGENCE_MODE = "${{ inputs.lint_divergence_mode || 'enforce' }}"
      LSP_MODE = "${{ inputs.lsp_mode || 'enforce' }}"
      TYPECHECK_DIVERGENCE_MODE = "${{ inputs.typecheck_divergence_mode || 'enforce' }}"
      VIZE_WAIVER_AUDIT_OUTCOME = "${{ steps.waiver_audit.outcome }}"
      VIZE_TYPECHECK_DEPENDENCIES_OUTCOME = "${{ steps.typecheck_dependencies.outcome }}"
      VIZE_CORE_TOOLS_OUTCOME = "${{ steps.core_tools.outcome }}"
      VIZE_LSP_OUTCOME = "${{ steps.lsp.outcome }}"
      VIZE_LINT_DIVERGENCE_OUTCOME = "${{ steps.lint_divergence.outcome }}"
      VIZE_SYNTAX_HIGHLIGHTER_OUTCOME = "${{ steps.syntax_highlighter.outcome }}"
      VIZE_GLYPH_OUTCOME = "${{ steps.glyph.outcome }}"
      VIZE_TYPECHECK_DIVERGENCE_OUTCOME = "${{ steps.typecheck_divergence.outcome }}"
    }
    run = #"node tools/commands/fixtures/real-project-surface-verdict.ts --from-workflow-env --output "$FIXTURE_REPORT_DIR/surface-verdict.json""#
  }
  new Dynamic {
    name = "Publish shard summary"
    `if` = "${{ always() }}"
    shell = "bash"
    run = "node tools/ci/commands/github/publish-real-project-shard-summary.ts"
  }
  new Dynamic {
    name = "Upload shard report"
    `if` = "${{ always() }}"
    uses = ci.uploadArtifact
    with {
      name = "real-project-matrix-${{ matrix.shard }}"
      path = "${{ env.FIXTURE_REPORT_DIR }}"
      `if-no-files-found` = "error"
      `include-hidden-files` = false
      `retention-days` = 30
    }
  }
  new Dynamic {
    name = "Upload source-bound LSP wire evidence"
    `if` = "${{ always() }}"
    uses = ci.uploadArtifact
    with {
      name = "real-project-lsp-wire-${{ matrix.shard }}-${{ github.sha }}"
      path = """
      target/differential/lsp-sessions
      target/ci/vize.differential-build.json

      """
      `if-no-files-found` = "error"
      `retention-days` = 30
    }
  }
}
