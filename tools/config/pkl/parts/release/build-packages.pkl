import "../../../../ci/lib/Actions.pkl" as ci

name = "Build npm packages"
needs = "version"
`if` = "needs.version.outputs.ref != ''"
`runs-on` = ci.linux
`timeout-minutes` = 30
steps = new Listing {
  ci.checkoutAt("${{ needs.version.outputs.ref }}")
  ci.use("./.github/actions/release-build-packages")
}
