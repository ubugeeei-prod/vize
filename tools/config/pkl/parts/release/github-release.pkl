import "../../../../ci/lib/Actions.pkl" as ci

name = "Create GitHub Release"
needs = List("version", "tag", "publish-npm", "build-editor-platforms", "publication-quota", "release-sbom")
`if` = "${{ always() && needs.publication-quota.result == 'success' && needs.version.result == 'success' && needs.publish-npm.result == 'success' && needs.release-sbom.result == 'success' && (inputs.npm_resume_run != '' || needs.tag.result == 'success') }}"
`runs-on` = "ubuntu-24.04"
`timeout-minutes` = 15
// id-token mints the keyless cosign certificate.
permissions {
  actions = "read"
  contents = "write"
  `id-token` = "write"
}
env {

  RELEASE_TAG = "${{ needs.version.outputs.tag }}"
  RELEASE_SHA = "${{ needs.version.outputs.sha }}"
  // A failed platform build releases without its files rather than blocking.
  EDITOR_PLATFORMS = "${{ inputs.npm_resume_run != '' && needs.version.outputs.editor_platform_artifacts || needs.build-editor-platforms.result == 'success' && '1' || '0' }}"
}
steps = new Listing {
  ...ci.stageWorkflowScripts("release")
  ci.checkoutAt("${{ needs.version.outputs.tag }}")
  new Dynamic {
    `if` = "inputs.npm_resume_run == ''"
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      pattern = "cli-*"
      path = "cli-artifacts"
      `merge-multiple` = true
    }
  }
  new Dynamic {
    `if` = "inputs.npm_resume_run != ''"
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      pattern = "cli-*"
      path = "cli-artifacts"
      `merge-multiple` = true
      `run-id` = "${{ inputs.npm_resume_run }}"
      `github-token` = "${{ github.token }}"
      repository = "${{ github.repository }}"
    }
  }
  new Dynamic {
    `if` = "inputs.npm_resume_run == ''"
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "editor-extensions"
      path = "editor-extension-artifacts"
    }
  }
  new Dynamic {
    `if` = "inputs.npm_resume_run != ''"
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "editor-extensions"
      path = "editor-extension-artifacts"
      `run-id` = "${{ inputs.npm_resume_run }}"
      `github-token` = "${{ github.token }}"
      repository = "${{ github.repository }}"
    }
  }
  new Dynamic {
    `if` = "inputs.npm_resume_run == '' && env.EDITOR_PLATFORMS == '1'"
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      pattern = "editor-extension-platform-*"
      path = "editor-extension-artifacts/platform"
      `merge-multiple` = true
    }
  }
  new Dynamic {
    `if` = "inputs.npm_resume_run != '' && env.EDITOR_PLATFORMS == '1'"
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      pattern = "editor-extension-platform-*"
      path = "editor-extension-artifacts/platform"
      `merge-multiple` = true
      `run-id` = "${{ inputs.npm_resume_run }}"
      `github-token` = "${{ github.token }}"
      repository = "${{ github.repository }}"
    }
  }
  new Dynamic {
    uses = ci.downloadArtifact
    with { name = "release-sbom" }
  }
  new Dynamic {
    uses = "sigstore/cosign-installer@dc72c7d5c4d10cd6bcb8cf6e3fd625a9e5e537da"  // v3.7.0
    with { `cosign-release` = "v2.4.1" }
  }
  new Dynamic {
    uses = ci.setupNode
    with {
      `node-version-file` = "package.json"
      `package-manager-cache` = false
    }
  }
  new Dynamic {
    name = "Inspect existing release publication"
    id = "release-state"
    env {
      GH_TOKEN = "${{ github.token }}"
    }
    run = #"node "$VIZE_CI_FILES/publication.ts" inspect"#
  }
  new Dynamic {
    name = "Checksum and sign release artifacts"
    `if` = "steps.release-state.outputs.published != 'true'"
    env {
      COSIGN_YES = "true"
      VIZE_EDITOR_PLATFORM_ARTIFACTS = "${{ env.EDITOR_PLATFORMS }}"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/checksum-and-sign-release-artifacts.sh""#
  }
  new Dynamic {
    name = "Generate release notes"
    `if` = "steps.release-state.outputs.published != 'true'"
    env {
      GH_TOKEN = "${{ github.token }}"
      CRATES_PUBLICATION = "${{ needs.publication-quota.outputs.crates }}"
      CRATES_PUBLICATION_REASON = "${{ needs.publication-quota.outputs.crates_reason }}"
    }
    run = #"node tools/support/release/github_release_notes.ts "$RELEASE_TAG" "$RELEASE_SHA" "$RUNNER_TEMP/release-notes.md""#
  }
  new Dynamic {
    name = "Upload assets to draft release"
    id = "draft-release"
    `if` = "steps.release-state.outputs.published != 'true'"
    uses = "softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65"  // v2
    with {
      tag_name = "${{ needs.version.outputs.tag }}"
      body_path = "${{ runner.temp }}/release-notes.md"
      generate_release_notes = false
      draft = true
      prerelease = "${{ needs.version.outputs.prerelease }}"
      make_latest = "false"
      overwrite_files = true
      files = """
      cli-artifacts/*.tar.gz
      cli-artifacts/*.zip
      editor-extension-artifacts/editors/vscode/dist/*.vsix
      editor-extension-artifacts/platform/*.vsix
      editor-extension-artifacts/platform/*.receipt.json
      editor-extension-artifacts/*.tar.gz
      vize-${{ needs.version.outputs.tag }}-*.sbom.json
      cli-artifacts/*.sha256
      cli-artifacts/*.sig
      cli-artifacts/*.pem
      cli-artifacts/*.cosign.bundle
      editor-extension-artifacts/**/*.sha256
      editor-extension-artifacts/**/*.sig
      editor-extension-artifacts/**/*.pem
      editor-extension-artifacts/**/*.cosign.bundle
      vize-${{ needs.version.outputs.tag }}-*.sig
      vize-${{ needs.version.outputs.tag }}-*.pem
      vize-${{ needs.version.outputs.tag }}-*.cosign.bundle

      """
    }
  }
  new Dynamic {
    name = "Publish completed draft release"
    `if` = "steps.release-state.outputs.published != 'true'"
    env {
      GH_TOKEN = "${{ github.token }}"
      RELEASE_ID = "${{ steps.draft-release.outputs.id }}"
      RELEASE_MAKE_LATEST = "${{ needs.version.outputs.make_latest }}"
    }
    run = #"node "$VIZE_CI_FILES/publication.ts" publish"#
  }
}
