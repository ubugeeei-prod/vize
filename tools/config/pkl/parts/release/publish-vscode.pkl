import "../../../../ci/lib/Actions.pkl" as ci

name = "Publish VS Code extension"
needs = List("version", "tag", "publication-quota")
`runs-on` = "ubuntu-24.04"
`timeout-minutes` = 15
environment = "vscode-marketplace"
env {
  NPM_TAG = "${{ needs.version.outputs.npm_tag }}"
  VSCE_DLX_BIN = "npx"
}
steps = new Listing {
  ci.checkoutAt("${{ needs.version.outputs.tag }}")
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      `run-install` = false
    }
  }
  new Dynamic {
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "editor-extensions"
      path = "editor-extensions"
    }
  }
  new Dynamic {
    name = "Publish to the VS Code Marketplace"
    // Only this step reads the registry token.
    env { VSCE_PAT = "${{ secrets.VSCE_PAT }}" }
    run = "node tools/support/release/publish_vscode_extension/main.ts editor-extensions/editors/vscode/dist/vize.vsix"
  }
}
