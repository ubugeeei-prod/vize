import "../../../../ci/lib/Actions.pkl" as ci

`if` = "needs.version.outputs.ref != ''"
name = "Publish Open VSX extension - ${{ matrix.settings.target }}"
needs = List("version", "tag", "build-editor-platforms", "publication-quota")
`runs-on` = "ubuntu-24.04"
`timeout-minutes` = 35
environment = "open-vsx-registry"
strategy {
  `fail-fast` = false
  matrix { settings = "${{ fromJSON(needs.version.outputs.editor_matrix) }}" }
}
env {
  NPM_TAG = "${{ needs.version.outputs.npm_tag }}"
  VIZE_EXTENSION_TARGET = "${{ matrix.settings.target }}"
  VSIX_SOURCE_PATH = "${{ matrix.settings.sourcePath }}"
  // The publisher runs ovsx through `vp dlx`, whose deps have build scripts.
  PNPM_CONFIG_STRICT_DEP_BUILDS = "false"
  // Release 0.598.0 took over 12 min to expose every target after upload.
  // Allow 20 min of scans plus maintenance backoff within the job timeout.
  PUBLISH_RESOLUTION_RETRY_LIMIT = "120"
}
steps = new Listing {
  ci.checkoutAt("${{ needs.version.outputs.tag }}")
  new Dynamic {
    uses = ci.setupVp
    with {
      version = ci.vpVersion
      `node-version-file` = "package.json"
      `run-install` = false
    }
  }
  new Dynamic {
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "${{ matrix.settings.artifact }}"
      path = "editor-extensions"
    }
  }
  new Dynamic {
    name = "Publish to Open VSX"
    // Only this step reads the registry token.
    env { OVSX_PAT = "${{ secrets.OVSX_PAT }}" }
    run = #"node tools/support/release/publish_open_vsx_extension/main.ts "editor-extensions/$VSIX_SOURCE_PATH""#
  }
}
