import "../../../../ci/lib/Actions.pkl" as ci

name = "Build CLI - ${{ matrix.settings.target }}"
needs = "version"
`if` = "needs.version.outputs.ref != ''"
`runs-on` = "${{ matrix.settings.host }}"
`timeout-minutes` = 60
strategy {
  `fail-fast` = false
  matrix { settings = "${{ fromJSON(needs.version.outputs.cli_matrix) }}" }
}
steps = new Listing {
  ci.checkoutAt("${{ needs.version.outputs.ref }}")
  new Dynamic {
    uses = "./.github/actions/build-release-cli"
    with {
      target = "${{ matrix.settings.target }}"
      archive = "${{ matrix.settings.archive }}"
      `release-version` = "${{ needs.version.outputs.version }}"
      `authorized-release` = "true"
    }
  }
}
