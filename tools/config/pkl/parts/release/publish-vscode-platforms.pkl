import "../../../../ci/lib/Actions.pkl" as ci

`if` = "needs.version.outputs.ref != ''"
name = "Publish VS Code extension - ${{ matrix.settings.target }}"
needs = List("version", "tag", "build-editor-platforms", "publication-quota")
`runs-on` = "ubuntu-24.04"
`timeout-minutes` = 30
environment = "vscode-marketplace"
strategy {
  `fail-fast` = false
  matrix { settings = "${{ fromJSON(needs.version.outputs.editor_matrix) }}" }
}
env {
  NPM_TAG = "${{ needs.version.outputs.npm_tag }}"
  VIZE_EXTENSION_TARGET = "${{ matrix.settings.target }}"
  VSIX_SOURCE_PATH = "${{ matrix.settings.sourcePath }}"
  VSCE_DLX_BIN = "npx"
  // The Marketplace validates a platform upload before listing it: 0.584.0
  // took 6.5-9 min. Wait up to 20 min (120 x 10 s).
  PUBLISH_RESOLUTION_RETRY_LIMIT = "120"
}
steps = new Listing {
  ci.checkoutAt("${{ needs.version.outputs.tag }}")
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      `run-install` = false
    }
  }
  new Dynamic {
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "${{ matrix.settings.artifact }}"
      path = "editor-extensions"
    }
  }
  new Dynamic {
    name = "Publish to the VS Code Marketplace"
    // Only this step reads the registry token.
    env { VSCE_PAT = "${{ secrets.VSCE_PAT }}" }
    run = #"node tools/support/release/publish_vscode_extension/main.ts "editor-extensions/$VSIX_SOURCE_PATH""#
  }
}
