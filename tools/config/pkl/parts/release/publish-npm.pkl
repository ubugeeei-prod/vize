import "../../Actions.pkl" as ci

name = "Publish npm packages"
needs = List("version", "tag", "publication-quota")
`if` = "${{ always() && needs.publication-quota.result == 'success' && needs.version.result == 'success' && (inputs.npm_resume_run != '' || needs.tag.result == 'success') }}"
`runs-on` = "ubuntu-24.04"
`timeout-minutes` = 55
environment = "npm"
permissions {
  actions = "read"
  contents = "read"
  `id-token` = "write"
}
env {

  PUBLISH_RESOLUTION_RETRY_LIMIT = "180"
  PUBLISH_RESOLUTION_RETRY_DELAY = "10"
  NPM_PUBLISH_TAG = "${{ needs.version.outputs.publish_tag }}"
  NPM_ALLOW_NEWER_TAG = "${{ needs.version.outputs.allow_newer_tag }}"
}
outputs { packages = "${{ steps.publish.outputs.packages }}" }
steps = new Listing {
  ...ci.stageWorkflowScripts("release")
  ci.checkoutAt("${{ inputs.npm_resume_run != '' && github.sha || needs.version.outputs.tag }}")
  ci.workspaceVp()
  new Dynamic {
    uses = "./.github/actions/release-npm-artifacts"
    with {
      `run-id` = "${{ inputs.npm_resume_run }}"
      `github-token` = "${{ github.token }}"
      `release-tag` = "${{ inputs.npm_resume_run != '' && needs.version.outputs.tag || '' }}"
    }
  }
  new Dynamic {
    `if` = "inputs.npm_resume_run == ''"
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "npm-package-wasm"
      path = "npm/wasm"
    }
  }
  new Dynamic {
    `if` = "inputs.npm_resume_run != ''"
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "npm-package-wasm"
      path = "npm/wasm"
      `run-id` = "${{ inputs.npm_resume_run }}"
      `github-token` = "${{ github.token }}"
      repository = "${{ github.repository }}"
    }
  }
  new Dynamic {
    name = "Publish native platforms before dependent packages"
    id = "publish"
    run = #". "${{ env.VIZE_CI_FILES }}/publish-native-platforms-before-dependent-packages.sh""#
  }
}
