import "../../../../ci/lib/Actions.pkl" as ci

name = "Build editor provider - ${{ matrix.settings.target }}"
needs = List("version", "build-native")
`if` = "needs.version.outputs.ref != ''"
`runs-on` = ci.linux
`timeout-minutes` = 30
strategy {
  `fail-fast` = false
  matrix { settings = "${{ fromJSON(needs.version.outputs.editor_matrix) }}" }
}
steps = new Listing {
  ci.checkoutAt("${{ needs.version.outputs.ref }}")
  ci.workspaceVp()
  ci.command("Install packaging dependencies", "vp install --workspace-root --frozen-lockfile --prefer-offline")
  ci.rust("stable")
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      `reuse-target` = "true"
      `restore-trusted` = "true"
      key = "release-tools"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.use("./.github/actions/setup-rust-script")
  // The extension installs outside the root workspace; the universal VSIX
  // recipe installs its packager first, exactly as Build editor extensions does.
  ci.command("Install VS Code extension dependencies", "vp run --workspace-root package:vscode-extension")
  new Dynamic {
    uses = "actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"  // v8.0.1
    with {
      name = "bindings-${{ matrix.settings.rustTarget }}"
      path = "${{ runner.temp }}/native-provider"
    }
  }
  new Dynamic {
    name = "Package the exact target provider"
    env {
      RUST_TARGET = "${{ matrix.settings.rustTarget }}"
      VSIX_ARCHIVE = "${{ matrix.settings.archive }}"
      // A failed-job rerun may resolve a force-pushed candidate ref. The
      // receipt must match the attempt SHA the native artifacts were built for.
      VIZE_RELEASE_CANDIDATE_SHA = "${{ needs.version.outputs.sha }}"
    }
    run = #"node tools/support/editors/typescript-provider/package.ts "$RUST_TARGET" "$RUNNER_TEMP/native-provider" "$GITHUB_WORKSPACE/.artifacts/vscode/$VSIX_ARCHIVE""#
  }
  new Dynamic {
    uses = ci.uploadArtifact
    with {
      name = "${{ matrix.settings.artifact }}"
      path = ".artifacts/vscode/*"
      `if-no-files-found` = "error"
      `compression-level` = 0
    }
  }
}
