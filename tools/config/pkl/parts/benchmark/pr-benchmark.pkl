import "../../Actions.pkl" as ci

name = "pr-benchmark"
`runs-on` = ci.linux
`timeout-minutes` = 30
permissions { contents = "read" }
steps = new Listing {
  ...ci.stageWorkflowScripts("benchmark")
  new Dynamic {
    name = "Validate benchmark SHAs"
    `if` = "${{ github.event_name != 'pull_request' }}"
    env { RUN_HEAD_SHA = "${{ github.sha }}" }
    run = #". "${{ env.VIZE_CI_FILES }}/validate-benchmark-shas.sh""#
  }
  new Dynamic {
    name = "Checkout head"
    uses = ci.checkout
    with {
      path = "head"
      ref = "${{ env.BENCHMARK_HEAD_SHA }}"
      `fetch-depth` = "${{ github.event_name != 'pull_request' && '0' || '1' }}"
    }
  }
  new Dynamic {
    name = "Checkout base"
    uses = ci.checkout
    with {
      path = "base"
      ref = "${{ env.BENCHMARK_BASE_SHA }}"
    }
  }
  new Dynamic {
    name = "Check base checkout"
    id = "base-integrity"
    `working-directory` = "base"
    env {
      BASE_SHA = "${{ env.BENCHMARK_BASE_SHA }}"
      HEAD_SHA = "${{ env.BENCHMARK_HEAD_SHA }}"
      EVENT_NAME = "${{ github.event_name }}"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/check-base-checkout.sh""#
  }
  new Dynamic {
    name = "Install Rust toolchain"
    id = "rust-toolchain"
    uses = ci.setupRust
    with { toolchain = "stable" }
  }
  ci.wild()
  // The cache action's nested local action resolves from the workspace root,
  // and this job checks the repository out under head/.
  new Dynamic {
    name = "Expose the nested target action at the workspace root"
    run = #". "${{ env.VIZE_CI_FILES }}/expose-the-nested-target-action-at-the-workspace-root.sh""#
  }
  new Dynamic {
    uses = "./head/.github/actions/setup-rust-sticky-cache"
    with {
      key = "benchmark-head"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
      `target-path` = "head/target"
      `secondary-key` = "benchmark-base"
      `secondary-target-path` = "base/target"
      `secondary-cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "head/package.json"
      cache = true
      `run-install` = false
    }
  }
  new Dynamic {
    name = "Install JS dependencies"
    `working-directory` = "head"
    run = "vp install --frozen-lockfile --prefer-offline"
  }
  new Dynamic {
    name = "Validate base metadata"
    id = "validate-base"
    `if` = "steps.base-integrity.outputs.skip != 'true'"
    `continue-on-error` = true
    run = #". "${{ env.VIZE_CI_FILES }}/validate-base-metadata.sh""#
  }
  new Dynamic {
    name = "Skip benchmark when base metadata is invalid"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome != 'success'"
    run = #". "${{ env.VIZE_CI_FILES }}/skip-benchmark-when-base-metadata-is-invalid.sh""#
  }
  new Dynamic {
    name = "Cache base CLI"
    id = "cache-base-cli"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success'"
    uses = ci.cache
    with {
      path = "base/target/ci-opt/vize"
      key = "${{ runner.os }}-${{ runner.arch }}-benchmark-base-${{ env.VIZE_BENCH_BUILD_PROFILE_KEY }}-${{ steps.rust-toolchain.outputs.cachekey }}-${{ env.BENCHMARK_BASE_SHA }}"
    }
  }
  // Inject ci-opt so old bases build and both sides use identical settings.
  // This exact configuration is represented by the cache/profile key above.
  new Dynamic {
    name = "Build base CLI"
    id = "build-base"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.cache-base-cli.outputs.cache-hit != 'true'"
    `continue-on-error` = true
    run = #"cargo build --manifest-path base/Cargo.toml --profile ci-opt -p vize --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16'"#
  }
  // Skip an unbuildable base instead of hard-failing a hotfix PR.
  new Dynamic {
    name = "Skip benchmark when base CLI cannot be built"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome == 'failure'"
    run = #". "${{ env.VIZE_CI_FILES }}/skip-benchmark-when-base-cli-cannot-be-built.sh""#
  }
  new Dynamic {
    name = "Cache head CLI"
    id = "cache-head-cli"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    uses = ci.cache
    with {
      path = "head/target/ci-opt/vize"
      key = "${{ runner.os }}-${{ runner.arch }}-benchmark-head-${{ env.VIZE_BENCH_BUILD_PROFILE_KEY }}-${{ steps.rust-toolchain.outputs.cachekey }}-${{ env.BENCHMARK_HEAD_SHA }}"
    }
  }
  new Dynamic {
    name = "Build head CLI"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.cache-head-cli.outputs.cache-hit != 'true' && steps.build-base.outcome != 'failure'"
    run = #"cargo build --manifest-path head/Cargo.toml --profile ci-opt -p vize --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16'"#
  }
  new Dynamic {
    name = "Generate benchmark input"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    `working-directory` = "head"
    run = #"node tools/benchmarks/scripts/generate.mjs "$VIZE_BENCH_FILE_COUNT""#
  }
  new Dynamic {
    name = "Compare base and head"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    run = #". "${{ env.VIZE_CI_FILES }}/compare-base-and-head.sh""#
  }
  new Dynamic {
    name = "Observe CSS completion and hover on existing base and head CLIs"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    run = #"node head/tools/benchmarks/scripts/css-documentation.ts "$GITHUB_WORKSPACE/base/target/ci-opt/vize" "$GITHUB_WORKSPACE/head/target/ci-opt/vize" "$BENCHMARK_BASE_SHA" "$BENCHMARK_HEAD_SHA" "$GITHUB_WORKSPACE/css-documentation-observations.json""#
  }
  new Dynamic {
    name = "Record benchmark build provenance"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    run = #". "${{ env.VIZE_CI_FILES }}/record-benchmark-build-provenance.sh""#
  }
  new Dynamic {
    name = "Write job summary"
    run = #". "${{ env.VIZE_CI_FILES }}/write-job-summary.sh""#
  }
  new Dynamic {
    name = "Upload benchmark results"
    uses = ci.uploadArtifact
    with {
      name = "pr-benchmark"
      path = """
      benchmark-summary.md
      benchmark-results.json
      benchmark-provenance.txt
      css-documentation-observations.json

      """
      `if-no-files-found` = "warn"
      `retention-days` = 14
    }
  }
}
