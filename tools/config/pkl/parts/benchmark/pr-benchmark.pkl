import "../../Actions.pkl" as ci

name = "pr-benchmark"
`runs-on` = ci.linux
`timeout-minutes` = 30
permissions { contents = "read" }
steps = new Listing {
  new Dynamic {
    name = "Validate benchmark SHAs"
    `if` = "${{ github.event_name != 'pull_request' }}"
    env { RUN_HEAD_SHA = "${{ github.sha }}" }
    run = """
    full_sha='^[0-9a-f]{40}$'
    if [[ ! "$BENCHMARK_BASE_SHA" =~ $full_sha ]]; then
      echo "::error title=Invalid base_sha::base_sha must be a full lowercase 40-character commit SHA"
      exit 1
    fi
    if [[ ! "$BENCHMARK_HEAD_SHA" =~ $full_sha ]]; then
      echo "::error title=Invalid head_sha::head_sha must be a full lowercase 40-character commit SHA"
      exit 1
    fi
    if [[ "$BENCHMARK_BASE_SHA" == "$BENCHMARK_HEAD_SHA" ]]; then
      echo "::error title=Invalid benchmark range::base_sha must differ from head_sha"
      exit 1
    fi
    if [[ "$RUN_HEAD_SHA" != "$BENCHMARK_HEAD_SHA" ]]; then
      echo "::error title=Workflow ref mismatch::run head_sha must match $BENCHMARK_HEAD_SHA (got $RUN_HEAD_SHA)"
      exit 1
    fi

    """
  }
  new Dynamic {
    name = "Checkout head"
    uses = ci.checkout
    with {
      path = "head"
      ref = "${{ env.BENCHMARK_HEAD_SHA }}"
      `fetch-depth` = "${{ github.event_name != 'pull_request' && '0' || '1' }}"
    }
  }
  new Dynamic {
    name = "Checkout base"
    uses = ci.checkout
    with {
      path = "base"
      ref = "${{ env.BENCHMARK_BASE_SHA }}"
    }
  }
  new Dynamic {
    name = "Check base checkout"
    id = "base-integrity"
    `working-directory` = "base"
    env {
      BASE_SHA = "${{ env.BENCHMARK_BASE_SHA }}"
      HEAD_SHA = "${{ env.BENCHMARK_HEAD_SHA }}"
      EVENT_NAME = "${{ github.event_name }}"
    }
    run = #"""
    if [[ "$EVENT_NAME" != "pull_request" ]] && \
       ! git -C "$GITHUB_WORKSPACE/head" merge-base --is-ancestor "$BASE_SHA" "$HEAD_SHA"; then
      echo "::error title=Invalid benchmark range::base_sha must be an ancestor of head_sha"
      exit 1
    fi
    if git grep -n -E '^(<<<<<<<|=======$|>>>>>>>)' -- . ':(exclude)tests/_fixtures/_git/**'; then
      echo "skip=true" >> "$GITHUB_OUTPUT"
      {
        echo "## PR Benchmark"
        echo
        echo "Skipped because the base checkout contains unresolved merge conflict markers."
        echo
        echo "- Base: \`$BASE_SHA\`"
        echo "- Head: \`$HEAD_SHA\`"
      } > "$GITHUB_WORKSPACE/benchmark-summary.md"
      printf '{"skipped":true,"reason":"base_has_conflict_markers","base":"%s","head":"%s"}\n' "$BASE_SHA" "$HEAD_SHA" > "$GITHUB_WORKSPACE/benchmark-results.json"
    else
      echo "skip=false" >> "$GITHUB_OUTPUT"
    fi

    """#
  }
  new Dynamic {
    name = "Install Rust toolchain"
    id = "rust-toolchain"
    uses = ci.setupRust
    with { toolchain = "stable" }
  }
  ci.wild()
  // The cache action's nested local action resolves from the workspace root,
  // and this job checks the repository out under head/.
  new Dynamic {
    name = "Expose the nested target action at the workspace root"
    run = "mkdir -p .github/actions && cp -R head/.github/actions/{reuse-rust-target,setup-rust-sticky-cache} .github/actions/"
  }
  new Dynamic {
    uses = "./head/.github/actions/setup-rust-sticky-cache"
    with {
      key = "benchmark-head"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
      `target-path` = "head/target"
      `secondary-key` = "benchmark-base"
      `secondary-target-path` = "base/target"
      `secondary-cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "head/package.json"
      cache = true
      `run-install` = false
    }
  }
  new Dynamic {
    name = "Install JS dependencies"
    `working-directory` = "head"
    run = "vp install --frozen-lockfile --prefer-offline"
  }
  new Dynamic {
    name = "Validate base metadata"
    id = "validate-base"
    `if` = "steps.base-integrity.outputs.skip != 'true'"
    `continue-on-error` = true
    run = "cargo metadata --manifest-path base/Cargo.toml --format-version 1 --no-deps > /dev/null"
  }
  new Dynamic {
    name = "Skip benchmark when base metadata is invalid"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome != 'success'"
    run = #"""
    {
      echo "## PR Benchmark"
      echo
      echo "Base metadata could not be parsed, so the benchmark was skipped for this PR."
      echo
      echo "| status | reason |"
      echo "| --- | --- |"
      echo "| skipped | base checkout is not buildable |"
    } > benchmark-summary.md
    printf '{"skipped":true,"reason":"base_metadata_invalid","base":"%s","head":"%s"}\n' \
      "$BENCHMARK_BASE_SHA" \
      "$BENCHMARK_HEAD_SHA" \
      > benchmark-results.json

    """#
  }
  new Dynamic {
    name = "Cache base CLI"
    id = "cache-base-cli"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success'"
    uses = ci.cache
    with {
      path = "base/target/ci-opt/vize"
      key = "${{ runner.os }}-${{ runner.arch }}-benchmark-base-${{ env.VIZE_BENCH_BUILD_PROFILE_KEY }}-${{ steps.rust-toolchain.outputs.cachekey }}-${{ env.BENCHMARK_BASE_SHA }}"
    }
  }
  // Inject ci-opt so old bases build and both sides use identical settings.
  // This exact configuration is represented by the cache/profile key above.
  new Dynamic {
    name = "Build base CLI"
    id = "build-base"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.cache-base-cli.outputs.cache-hit != 'true'"
    `continue-on-error` = true
    run = #"cargo build --manifest-path base/Cargo.toml --profile ci-opt -p vize --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16'"#
  }
  // Skip an unbuildable base instead of hard-failing a hotfix PR.
  new Dynamic {
    name = "Skip benchmark when base CLI cannot be built"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome == 'failure'"
    run = #"""
    {
      echo "## PR Benchmark"
      echo
      echo "Base CLI could not be built, so the benchmark was skipped for this PR."
      echo
      echo "| status | reason |"
      echo "| --- | --- |"
      echo "| skipped | base checkout does not compile |"
    } > benchmark-summary.md
    printf '{"skipped":true,"reason":"base_not_buildable","base":"%s","head":"%s"}\n' \
      "$BENCHMARK_BASE_SHA" \
      "$BENCHMARK_HEAD_SHA" \
      > benchmark-results.json

    """#
  }
  new Dynamic {
    name = "Cache head CLI"
    id = "cache-head-cli"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    uses = ci.cache
    with {
      path = "head/target/ci-opt/vize"
      key = "${{ runner.os }}-${{ runner.arch }}-benchmark-head-${{ env.VIZE_BENCH_BUILD_PROFILE_KEY }}-${{ steps.rust-toolchain.outputs.cachekey }}-${{ env.BENCHMARK_HEAD_SHA }}"
    }
  }
  new Dynamic {
    name = "Build head CLI"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.cache-head-cli.outputs.cache-hit != 'true' && steps.build-base.outcome != 'failure'"
    run = #"cargo build --manifest-path head/Cargo.toml --profile ci-opt -p vize --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16'"#
  }
  new Dynamic {
    name = "Generate benchmark input"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    `working-directory` = "head"
    run = #"node tools/benchmarks/scripts/generate.mjs "$VIZE_BENCH_FILE_COUNT""#
  }
  new Dynamic {
    name = "Compare base and head"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    run = #"""
    node head/tools/benchmarks/scripts/compare-pr.ts \
      --input "$GITHUB_WORKSPACE/head/tools/benchmarks/scripts/__in__" \
      --base-bin "$GITHUB_WORKSPACE/base/target/ci-opt/vize" \
      --head-bin "$GITHUB_WORKSPACE/head/target/ci-opt/vize" \
      --base-label "$BENCHMARK_BASE_SHA" \
      --head-label "$BENCHMARK_HEAD_SHA" \
      --runs "$VIZE_BENCH_RUNS" \
      --warmups "$VIZE_BENCH_WARMUPS" \
      --threshold "$VIZE_BENCH_REGRESSION_THRESHOLD_PERCENT" \
      --out "$GITHUB_WORKSPACE/benchmark-summary.md" \
      --json "$GITHUB_WORKSPACE/benchmark-results.json"

    """#
  }
  new Dynamic {
    name = "Qualify type-aware project batching on existing optimized binaries"
    `if` = "github.event_name == 'workflow_dispatch' && inputs.patina_project_batch && steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    run = #"""
    node --test head/tools/benchmarks/scripts/patina-project-batch.test.mjs
    node head/tools/benchmarks/scripts/patina-project-batch.mjs \
      "$GITHUB_WORKSPACE/base/target/ci-opt/vize" \
      "$GITHUB_WORKSPACE/head/target/ci-opt/vize" \
      "$BENCHMARK_BASE_SHA" "$BENCHMARK_HEAD_SHA" \
      "$GITHUB_WORKSPACE/patina-project-batch"

    """#
  }
  new Dynamic {
    name = "Retain type-aware batch evidence including failed observations"
    `if` = "always() && github.event_name == 'workflow_dispatch' && inputs.patina_project_batch"
    uses = ci.uploadArtifact
    with {
      name = "patina-project-batch"
      path = """
      patina-project-batch/*.json
      patina-project-batch/*.jsonl
      patina-project-batch/*.stdout
      patina-project-batch/*.stderr
      patina-project-batch/*.resource.txt
      patina-project-batch/summary.md
      patina-project-batch/dependency-install.log

      """
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
  new Dynamic {
    name = "Observe CSS completion and hover on existing base and head CLIs"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    run = #"node head/tools/benchmarks/scripts/css-documentation.ts "$GITHUB_WORKSPACE/base/target/ci-opt/vize" "$GITHUB_WORKSPACE/head/target/ci-opt/vize" "$BENCHMARK_BASE_SHA" "$BENCHMARK_HEAD_SHA" "$GITHUB_WORKSPACE/css-documentation-observations.json""#
  }
  new Dynamic {
    name = "Record benchmark build provenance"
    `if` = "steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    run = #"""
    {
      printf 'profile=%s\n' "$VIZE_BENCH_BUILD_PROFILE_KEY"
      rustc --version --verbose
      sha256sum base/target/ci-opt/vize head/target/ci-opt/vize
    } > benchmark-provenance.txt

    """#
  }
  new Dynamic {
    name = "Replay conditional native type packets after observations"
    `if` = "github.event_name == 'workflow_dispatch' && inputs.patina_plain_type_packets && steps.base-integrity.outputs.skip != 'true' && steps.validate-base.outcome == 'success' && steps.build-base.outcome != 'failure'"
    run = #"""
    node --test head/tools/benchmarks/scripts/patina-plain-type-packets.test.mjs
    node head/tools/benchmarks/scripts/patina-plain-type-packets.mjs \
      "$GITHUB_WORKSPACE/base" "$GITHUB_WORKSPACE/head" \
      "$BENCHMARK_BASE_SHA" "$BENCHMARK_HEAD_SHA" \
      "$GITHUB_WORKSPACE/patina-plain-type-packets"

    """#
  }
  new Dynamic {
    name = "Retain complete native type packets and overlay custody"
    `if` = "always() && github.event_name == 'workflow_dispatch' && inputs.patina_plain_type_packets"
    uses = ci.uploadArtifact
    with {
      name = "patina-plain-type-packets"
      path = """
      patina-plain-type-packets/*.json
      patina-plain-type-packets/*.stdout
      patina-plain-type-packets/*.stderr
      patina-plain-type-packets/*.rs
      patina-plain-type-packets/summary.md

      """
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
  new Dynamic {
    name = "Write job summary"
    run = """
    cat benchmark-summary.md >> "$GITHUB_STEP_SUMMARY"
    if [[ -f patina-project-batch/summary.md ]]; then
      cat patina-project-batch/summary.md >> "$GITHUB_STEP_SUMMARY"
    fi
    if [[ -f patina-plain-type-packets/summary.md ]]; then
      cat patina-plain-type-packets/summary.md >> "$GITHUB_STEP_SUMMARY"
    fi

    """
  }
  new Dynamic {
    name = "Upload benchmark results"
    uses = ci.uploadArtifact
    with {
      name = "pr-benchmark"
      path = """
      benchmark-summary.md
      benchmark-results.json
      benchmark-provenance.txt
      css-documentation-observations.json

      """
      `if-no-files-found` = "warn"
      `retention-days` = 14
    }
  }
}
