import "../../Actions.pkl" as ci

name = "Complete checker diagnostic source pairs"
`if` = "github.event_name == 'workflow_dispatch' && inputs.check_diagnostic_messages"
`runs-on` = ci.linux
`timeout-minutes` = 40
permissions { contents = "read" }
env { CARGO_INCREMENTAL = "0" }
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with {
      path = "head"
      ref = "${{ env.BENCHMARK_HEAD_SHA }}"
      `fetch-depth` = 0
      `persist-credentials` = false
    }
  }
  new Dynamic {
    uses = ci.checkout
    with {
      path = "base"
      ref = "${{ env.BENCHMARK_BASE_SHA }}"
      `persist-credentials` = false
    }
  }
  new Dynamic {
    name = "Validate exact source roles"
    env { RUN_HEAD_SHA = "${{ github.sha }}" }
    run = """
    set -euo pipefail
    [[ "$BENCHMARK_BASE_SHA" =~ ^[0-9a-f]{40}$ && "$BENCHMARK_HEAD_SHA" =~ ^[0-9a-f]{40}$ ]]
    [[ "$BENCHMARK_BASE_SHA" != "$BENCHMARK_HEAD_SHA" && "$RUN_HEAD_SHA" == "$BENCHMARK_HEAD_SHA" ]]
    [[ "$(git -C base rev-parse HEAD)" == "$BENCHMARK_BASE_SHA" ]]
    [[ "$(git -C head rev-parse HEAD)" == "$BENCHMARK_HEAD_SHA" ]]
    git -C head merge-base --is-ancestor "$BENCHMARK_BASE_SHA" "$BENCHMARK_HEAD_SHA"

    """
  }
  ci.rust("stable")
  ci.wild()
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "head/package.json"
      cache = true
      `run-install` = false
    }
  }
  new Dynamic {
    name = "Install one pinned physical native runtime"
    `working-directory` = "head"
    run = "vp install --frozen-lockfile --prefer-offline"
  }
  new Dynamic {
    name = "Validate focused complete-packet observers"
    run = "node --test head/tools/benchmarks/scripts/check-diagnostic-messages.test.mjs"
  }
  new Dynamic {
    name = "Build sequential source and SHA roles without compilation caches"
    run = #"""
    set -euo pipefail
    mkdir check-message-build
    compiler="$(rustup which rustc)"
    cargo_binary="$(rustup which cargo)"
    "$compiler" -vV > check-message-build/rustc.txt
    "$cargo_binary" -V > check-message-build/cargo.txt
    sha256sum "$compiler" "$cargo_binary" > check-message-build/toolchain.sha256
    for role in base head; do
      sha="$(git -C "$role" rev-parse HEAD)"
      target="$RUNNER_TEMP/check-message-$role-$sha-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
      [[ ! -e "$target" && ! -L "$target" ]]
      printf '{"role":"%s","sourceSha":"%s","target":"%s","initialAbsent":true,"compilationCache":false,"profile":"ci-opt-release-thin-lto-cgu16"}\n' "$role" "$sha" "$target" > "check-message-build/$role.json"
      git -C "$role" status --porcelain > "check-message-build/$role-status-before.txt"
      [[ ! -s "check-message-build/$role-status-before.txt" ]]
      env -u CARGO_TARGET_DIR -u RUSTFLAGS -u CARGO_ENCODED_RUSTFLAGS \
        RUSTC="$compiler" RUSTC_WRAPPER= RUSTC_WORKSPACE_WRAPPER= \
        "$cargo_binary" build --manifest-path "$role/Cargo.toml" --locked --profile ci-opt -p vize --target-dir "$target" \
        --config 'profile.ci-opt.inherits="release"' --config 'profile.ci-opt.lto="thin"' --config 'profile.ci-opt.codegen-units=16' \
        > "check-message-build/$role.stdout" 2> "check-message-build/$role.stderr"
      git -C "$role" diff --exit-code
      sha256sum "$target/ci-opt/vize" > "check-message-build/$role-binary.sha256"
      printf 'MESSAGE_%s_BIN=%s\n' "${role^^}" "$target/ci-opt/vize" >> "$GITHUB_ENV"
    done

    """#
  }
  new Dynamic {
    name = "Compare whole reports, alternating latency and separate source observations"
    run = #"""
    node head/tools/benchmarks/scripts/check-diagnostic-messages.mjs \
      "$MESSAGE_BASE_BIN" "$MESSAGE_HEAD_BIN" "$BENCHMARK_BASE_SHA" "$BENCHMARK_HEAD_SHA" \
      "$GITHUB_WORKSPACE/check-message-evidence"
    cat check-message-evidence/summary.md >> "$GITHUB_STEP_SUMMARY"

    """#
  }
  new Dynamic {
    name = "Retain complete source qualification including failed observations"
    `if` = "always()"
    uses = ci.uploadArtifact
    with {
      name = "check-diagnostic-messages"
      path = """
      check-message-build/
      check-message-evidence/

      """
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
}
