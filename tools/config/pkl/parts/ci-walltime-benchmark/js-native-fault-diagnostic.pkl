import "../../Actions.pkl" as ci

`if` = "${{ github.event_name == 'pull_request' && github.event.action == 'labeled' && github.event.label.name == 'ci-native-fault-diagnostic' }}"
`runs-on` = ci.linux
`timeout-minutes` = 35
env {

  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
  CARGO_BUILD_JOBS = "12"
}
steps = new Listing {
  ...ci.stageWorkflowScripts("ci-walltime-benchmark")
  ci.checkoutAt("${{ github.sha }}")
  new Dynamic {
    name = "Retain diagnostic orchestration before checking out the failed source"
    run = #". "${{ env.VIZE_CI_FILES }}/retain-diagnostic-orchestration-before-checking-out-the-failed-source.sh""#
  }
  ci.checkoutAt("0b82a31fc9dd8634786fc17ec3bd3eeb8427ae6e")
  new Dynamic {
    name = "Authenticate the exact physical failed source"
    run = #". "${{ env.VIZE_CI_FILES }}/authenticate-the-exact-physical-failed-source.sh""#
  }
  ci.use("./.github/actions/cache-vp-bootstrap")
  new Dynamic {
    uses = ci.setupVp121
    // Pin the `latest` image used by the retained 2026-11-03 run.
    with {
      version = "1.4.0"
      `node-version-file` = "package.json"
      cache = true
      `cache-save` = false
      `run-install` = false
    }
  }
  ci.rust("stable")
  ci.wild()
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "test-js-packages"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.command("Install the unchanged builders dependencies", "node tools/support/compat/github/install-js-checks.ts builders")
  new Dynamic {
    name = "Observe the original mandatory JS command once"
    run = #"node "$RUNNER_TEMP/native-fault-evidence.ts" -- vp run --workspace-root test:js:builders"#
  }
  new Dynamic {
    name = "Preserve bounded diagnostics and original native build receipts"
    `if` = "${{ always() }}"
    uses = ci.uploadArtifact
    with {
      name = "js-native-fault-controlled-${{ github.sha }}-${{ github.run_attempt }}"
      path = """
      ${{ runner.temp }}/js-native-fault-evidence-*/**/*.json
      npm/native/.artifacts/native/formatter-history/*.json
      npm/native/.artifacts/native/formatter-history/*.log

      """
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
}
