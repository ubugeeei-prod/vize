import "../../Actions.pkl" as ci

`if` = "${{ github.event_name == 'workflow_dispatch' && inputs.component == 'n8n-preparation' }}"
`runs-on` = ci.linux
`timeout-minutes` = 60
env {
  CARGO_BUILD_JOBS = "12"
  VIZE_N8N_BASELINE_MODE = "partitioned"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { ref = "${{ github.sha }}" }
  }
  ci.use("./.github/actions/setup-js-package-tests")
  new Dynamic {
    name = "Build the same source native binary and bridge once"
    run = """
    vp run --workspace-root build:native:test
    vp run --filter './npm/linter/oxlint' build

    """
  }
  new Dynamic {
    name = "Sequential preparation with unchanged concurrent project hosts"
    run = "node npm/linter/oxlint/scripts/check-project-transport.mjs --host-mode concurrent --preparation-mode sequential --phase-walltime target/ci-walltime/n8n-preparation-sequential.json"
  }
  new Dynamic {
    name = "Overlapping preparation with unchanged concurrent project hosts"
    `if` = "${{ !cancelled() }}"
    run = "node npm/linter/oxlint/scripts/check-project-transport.mjs --host-mode concurrent --preparation-mode overlap --phase-walltime target/ci-walltime/n8n-preparation-overlap.json"
  }
  new Dynamic {
    name = "Preserve both complete preparation campaigns and the one native build"
    `if` = "${{ always() }}"
    uses = ci.uploadArtifact
    with {
      name = "ci-walltime-n8n-preparation-${{ github.sha }}"
      path = """
      target/ci-walltime/
      target/oxlint-original-project-transport/
      npm/native/.artifacts/native/formatter-history/build-receipt.json
      npm/native/.artifacts/native/formatter-history/build-process.json
      npm/native/.artifacts/native/formatter-history/cargo.stdout.bin
      npm/native/.artifacts/native/formatter-history/cargo.stderr.bin

      """
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
}
