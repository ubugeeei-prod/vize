import "../../../../ci/lib/Actions.pkl" as ci

`if` = "${{ github.event_name == 'workflow_dispatch' && inputs.component == 'artifact-payload' }}"
`runs-on` = ci.linux
`timeout-minutes` = 60
permissions {
  contents = "read"
  actions = "read"
}
env {
  PAYLOAD_ARTIFACT_ID = "${{ inputs.artifact_id }}"
  PAYLOAD_SOURCE_SHA = "${{ inputs.artifact_source_sha }}"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { ref = "${{ github.sha }}" }
  }
  ci.use("./.github/actions/measure-artifact-payload")
}
