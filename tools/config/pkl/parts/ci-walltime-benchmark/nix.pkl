import "../../Actions.pkl" as ci

`if` = "${{ github.event_name == 'workflow_dispatch' && inputs.component == 'nix' }}"
`runs-on` = ci.linux
`timeout-minutes` = 60
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { ref = "${{ github.sha }}" }
  }
  ci.use("./.github/actions/check-nix")
}
