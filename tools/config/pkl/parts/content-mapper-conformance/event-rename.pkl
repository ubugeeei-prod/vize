import "../../Actions.pkl" as ci

`if` = "github.event_name == 'workflow_dispatch' && inputs.targeted-test != 'generic-body-error' && inputs.targeted-test != 'reported-q16' && !inputs.router-experimental-only && inputs.event-rename-only && !inputs.official-css-options-only && !inputs.published-defaults-only"
`runs-on` = ci.linux
`timeout-minutes` = 20
steps = new Listing {
  ...ci.stageWorkflowScripts("content-mapper-conformance")
  new Dynamic {
    name = "Checkout Vize"
    uses = ci.checkout
    with { `persist-credentials` = false }
  }
  new Dynamic {
    name = "Checkout exact TypeScript Content Mapper revision"
    uses = ci.checkout
    with {
      repository = "microsoft/TypeScript"
      ref = "${{ env.CONTENT_MAPPER_TYPESCRIPT_SHA }}"
      path = "typescript-content-mapper"
      `persist-credentials` = false
    }
  }
  new Dynamic {
    name = "Setup Go"
    uses = "actions/setup-go@4dc6199c7b1a012772edbd06daecab0f50c9053c"  // v6.1.0
    with {
      `go-version-file` = "typescript-content-mapper/tsc/go.mod"
      `cache-dependency-path` = "typescript-content-mapper/tsc/go.sum"
    }
  }
  new Dynamic {
    name = "Setup Rust"
    uses = ci.setupRust
    with { toolchain = "1.100.0" }
  }
  ci.wild()
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "content-mapper-conformance"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    name = "Setup Vite Plus"
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      cache = true
      `run-install` = false
    }
  }
  ci.command("Install frozen dependencies", "vp install --frozen-lockfile --prefer-offline")
  new Dynamic {
    name = "Build exact upstream tsgo"
    `working-directory` = "typescript-content-mapper/tsc"
    run = #". "${{ env.VIZE_CI_FILES }}/build-exact-upstream-tsgo.sh""#
  }
  new Dynamic {
    name = "Preserve source and provider identity before queries"
    run = #". "${{ env.VIZE_CI_FILES }}/preserve-source-and-provider-identity-before-queries.sh""#
  }
  new Dynamic {
    name = "Run both whole event rename transaction targets"
    id = "transactions"
    `continue-on-error` = true
    env {
      SOURCE_SHA = "${{ github.sha }}"
      VIZE_TEST_REQUIRE_TSGO = "1"
      VIZE_TEST_CONTENT_MAPPER_TSGO = "${{ runner.temp }}/tsgo"
      VIZE_TEST_CONTENT_MAPPER_VUE = "${{ github.workspace }}/npm/cli/node_modules/vue"
      VIZE_TEST_FIX_HISTORY_CAPTURE_DIR = "${{ runner.temp }}/event-rename/packets"
      VIZE_INLAY_HINT_CAPTURE = "${{ runner.temp }}/event-rename/processes"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/run-both-whole-event-rename-transaction-targets.sh""#
  }
  new Dynamic {
    name = "Preserve actual CLI identity and complete artifact inventory"
    `if` = "always()"
    run = #". "${{ env.VIZE_CI_FILES }}/preserve-actual-cli-identity-and-complete-artifact-inventory.sh""#
  }
  new Dynamic {
    name = "Upload complete event rename observations before result gate"
    `if` = "always()"
    uses = ci.uploadArtifact
    with {
      name = "content-mapper-event-rename-${{ github.sha }}"
      path = """
      ${{ runner.temp }}/event-rename/
      ${{ runner.temp }}/event-rename-inventory.sha256

      """
      `if-no-files-found` = "error"
    }
  }
  new Dynamic {
    name = "Require both whole transaction targets"
    `if` = "always()"
    env { TRANSACTIONS_OUTCOME = "${{ steps.transactions.outcome }}" }
    run = #". "${{ env.VIZE_CI_FILES }}/require-both-transactions.sh""#
  }
}
