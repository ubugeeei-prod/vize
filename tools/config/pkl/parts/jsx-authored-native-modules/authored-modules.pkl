import "../../Actions.pkl" as ci

`runs-on` = ci.linux
`timeout-minutes` = 25
env {

  CARGO_BUILD_JOBS = "24"
  CARGO_INCREMENTAL = "0"
  QUALIFICATION_HEAD_SHA = "${{ github.event.pull_request.head.sha || github.sha }}"
  BASE_SHA = "${{ github.event.pull_request.base.sha || github.sha }}"
  RUSTUP_TOOLCHAIN = "1.100.0"
}
steps = new Listing {
  ...ci.stageWorkflowScripts("jsx-authored-native-modules")
  new Dynamic {
    uses = ci.checkout
    with {
      ref = "${{ github.event.pull_request.head.sha || github.sha }}"
      `fetch-depth` = 0
      `persist-credentials` = false
    }
  }
  ci.use("./.github/actions/cache-vp-bootstrap")
  new Dynamic {
    uses = ci.setupVp121
    with {
      version = "latest"
      `node-version-file` = "package.json"
      cache = true
      `cache-save` = false
      `run-install` = false
    }
  }
  new Dynamic {
    name = "Install the committed native oracle dependencies"
    run = "node tools/support/github/vp-install.ts --filter vize-workspace --filter './tests...' --filter './npm/ui...' --filter @vize/jsx-vapor-oracle --filter './npm/cli'"
  }
  ci.rust("1.100.0")
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    with { `wild-version` = "0.9.0" }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "test-scripts"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    name = "Compare reusable module regions with the original checker projection"
    run = #". "${{ env.VIZE_CI_FILES }}/compare-reusable-module-regions-with-the-original-checker-projection.sh""#
  }
  new Dynamic {
    name = "Check lexical component props against the Canon TypeScript generator"
    env { VIZE_MODULE_IR_MANIFEST = "${{ runner.temp }}/module-ir-paths" }
    run = #". "${{ env.VIZE_CI_FILES }}/check-lexical-component-props-against-the-canon-typescript-generator.sh""#
  }
  new Dynamic {
    name = "Original VDOM child values and parent block ownership before and after"
    env { INSTA_UPDATE = "new" }
    run = #". "${{ env.VIZE_CI_FILES }}/original-vdom-child-values-and-parent-block-ownership-before-and-after.sh""#
  }
  new Dynamic {
    name = "Genuine pre-review slot and sequence producer packets"
    `if` = "always()"
    run = #". "${{ env.VIZE_CI_FILES }}/genuine-pre-review-slot-and-sequence-producer-packets.sh""#
  }
  new Dynamic {
    name = "Complete native module and source-map oracles"
    `if` = "always()"
    env {
      VIZE_JSX_AUTHORED_NATIVE_CAPTURE = "${{ runner.temp }}/jsx-authored-native/packets.json"
      VIZE_JSX_ADMISSION_CAPTURE = "${{ runner.temp }}/jsx-authored-native/admission.json"
      VIZE_JSX_STATEFUL_SSR_CAPTURE = "${{ runner.temp }}/jsx-authored-native/stateful-vdom-ssr.json"
      INSTA_UPDATE = "new"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/complete-native-module-and-source-map-oracles.sh""#
  }
  new Dynamic {
    name = "Measure the exact old and new authored-module contracts"
    run = #". "${{ env.VIZE_CI_FILES }}/measure-the-exact-old-and-new-authored-module-contracts.sh""#
  }
  new Dynamic {
    name = "Verify measured contracts and source counters"
    run = #". "${{ env.VIZE_CI_FILES }}/verify-measured-contracts-and-source-counters.sh""#
  }
  new Dynamic {
    name = "Existing JSX library contracts"
    `if` = "always()"
    env { INSTA_UPDATE = "new" }
    run = "cargo test --locked --profile ci -p vize_atelier_jsx --lib"
  }
  new Dynamic {
    name = "Existing mode and Babel option producer contracts"
    `if` = "always()"
    env {
      INSTA_UPDATE = "new"
      VIZE_JSX_ADVERSARIAL_CAPTURE = "${{ runner.temp }}/jsx-authored-native/adversarial"
      VIZE_JSX_VDOM_SCOPED_SLOT_CAPTURE = "${{ runner.temp }}/jsx-authored-native/scoped-slot-vdom.json"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/existing-mode-and-babel-option-producer-contracts.sh""#
  }
  new Dynamic {
    name = "Exact pure Rust JSX adapter DTO test"
    `if` = "always()"
    env { INSTA_UPDATE = "new" }
    run = #". "${{ env.VIZE_CI_FILES }}/exact-pure-rust-jsx-adapter-dto-test.sh""#
  }
  new Dynamic {
    name = "Preserve complete source-native VDOM adapter modules"
    `if` = "always()"
    env { VIZE_JSX_VDOM_NAPI_CAPTURE = "${{ runner.temp }}/jsx-authored-native/napi-vdom-modules" }
    run = #". "${{ env.VIZE_CI_FILES }}/preserve-complete-source-native-vdom-adapter-modules.sh""#
  }
  new Dynamic {
    name = "Complete WASM JSX DTO and original refusal contracts"
    `if` = "always()"
    run = """
    cargo test --locked --profile ci -p vize_vitrine --no-default-features --features wasm --lib wasm::jsx::tests::

    """
  }
  new Dynamic {
    name = "Verify complete native fixture and historical custody"
    `if` = "always()"
    run = "node --test tests/tooling/jsx-authored-native-workflow-paths.test.ts tests/tooling/jsx-vdom-snapshot-custody.test.ts tests/tooling/jsx-vdom-slot-snapshot-custody.test.ts tests/tooling/jsx-vdom-consumer-snapshot-custody.test.ts tests/tooling/jsx-authored-module-fixture-custody.test.ts tests/tooling/jsx-child-golden-custody.test.ts tests/tooling/jsx-child-profile-contract.test.ts tests/tooling/jsx-child-api-fixtures.test.ts tests/tooling/vapor-third-party-reports.test.mjs"
  }
  new Dynamic {
    name = "Capture whole native fixture packets and genuine runtime traces"
    `if` = "always()"
    env {
      VIZE_FALSY_AND_CAPTURE = "${{ runner.temp }}/jsx-authored-native/falsy-producers.json"
      VIZE_JSX_FALSY_REFUSAL_CAPTURE = "${{ runner.temp }}/jsx-authored-native/falsy-original-refusals.json"
      VIZE_JSX_VALUE_CAPTURE = "${{ runner.temp }}/jsx-authored-native/falsy-modules.json"
      VIZE_JSX_FALSY_RECEIPT = "${{ runner.temp }}/jsx-authored-native/falsy-runtime.json"
      VIZE_JSX_NESTED_RUNTIME_CAPTURE = "${{ runner.temp }}/jsx-authored-native/nested-packets.json"
      VIZE_JSX_VAPOR_COMPAT_CAPTURE = "${{ runner.temp }}/jsx-authored-native/compat-modules.json"
      VIZE_JSX_VAPOR_COMPAT_TRACE_CAPTURE = "${{ runner.temp }}/jsx-authored-native/compat-runtime.json"
      VIZE_JSX_CHILD_MODULE_CAPTURE = "${{ runner.temp }}/jsx-authored-native/child-modules.json"
      VIZE_JSX_CHILD_TRACE_CAPTURE = "${{ runner.temp }}/jsx-authored-native/child-runtime.json"
      VIZE_L4_SSR_REQUIRE_NATIVE = "1"
      VIZE_MOUNTED_RUNTIME_PRODUCER_EVIDENCE = "${{ runner.temp }}/jsx-authored-native/runtime-producer"
    }
    run = #". "${{ env.VIZE_CI_FILES }}/capture-whole-native-fixture-packets-and-genuine-runtime-traces.sh""#
  }
  new Dynamic {
    uses = "./.github/actions/install-playwright-browsers"
    `if` = "always()"
    with { workspace = "./tests" }
  }
  new Dynamic {
    name = "Original VDOM values before and after in genuine Chromium"
    `if` = "always()"
    run = #"node tests/tooling/jsx-vapor-oracle/vdom-child-browser.ts "$RUNNER_TEMP/jsx-authored-native/vdom-child-values/base/block-controls-input.json" "$RUNNER_TEMP/jsx-authored-native/vdom-child-values/head/block-controls-input.json" "$RUNNER_TEMP/jsx-authored-native/vdom-child-values/chromium.json""#
  }
  new Dynamic {
    name = "Slot updates and sequence effects before and after in genuine Chromium"
    `if` = "always()"
    run = #"node tests/tooling/jsx-vapor-oracle/vdom-child-review-browser.ts "$RUNNER_TEMP/jsx-authored-native/vdom-review/base.json" "$RUNNER_TEMP/jsx-authored-native/vdom-review/head.json" "$RUNNER_TEMP/jsx-authored-native/vdom-review/chromium.json""#
  }
  new Dynamic {
    name = "Original child values and effect disposal in genuine Chromium"
    `if` = "always()"
    run = #"node tests/tooling/jsx-vapor-oracle/child-browser.ts "$RUNNER_TEMP/jsx-authored-native/child-modules.json" "$RUNNER_TEMP/jsx-authored-native/child-browser.json""#
  }
  new Dynamic {
    uses = ci.uploadArtifact
    `if` = "always()"
    with {
      name = "jsx-authored-native-${{ github.run_id }}-${{ github.run_attempt }}"
      path = """
      ${{ runner.temp }}/jsx-authored-native
      crates/vize_atelier_jsx/src/**/*.snap.new
      crates/vize_atelier_jsx/tests/**/*.snap.new
      crates/vize_vitrine/src/napi/snapshots/*.snap.new

      """
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
}
