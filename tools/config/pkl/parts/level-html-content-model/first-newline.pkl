import "../../Actions.pkl" as ci

`if` = "${{ !cancelled() && (github.event_name == 'workflow_dispatch' || needs.changes.outputs.first-newline == 'true') }}"
needs = "changes"
`runs-on` = ci.linux
`timeout-minutes` = 25
env {
  VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/level-html-content-model"
}
steps = new Listing {
  ci.use(ci.checkout)
  new Dynamic {
    uses = "dtolnay/rust-toolchain@7e38f4b43b4db5c8dd498af069a4f6196df1d067"  // master
    with { toolchain = "1.100.0" }
  }
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    with { `wild-version` = "0.9.0" }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "first-newline"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      `run-install` = true
    }
  }
  ci.use("./.github/actions/setup-ubuntu-archive")
  ci.command("Install Chromium", "vize-ci-apt-retry vp exec --filter './tests' -- playwright install --with-deps chromium")
  new Dynamic {
    name = "Build the actual CLI and run source-bound browser observations"
    env {
      VIZE_FIRST_NEWLINE_BIN = "${{ github.workspace }}/target/ci/vize"
      VIZE_FIRST_NEWLINE_CAPTURE = "${{ runner.temp }}/first-newline-observations.json"
    }
    run = ci.workflowScript("first-newline-build-the-actual-cli-and-run-source-bound-browser-observations.sh")
  }
  new Dynamic {
    uses = ci.uploadArtifact
    `if` = "always()"
    with {
      name = "first-newline-${{ github.sha }}-${{ github.run_attempt }}"
      path = """
      ${{ runner.temp }}/first-newline-source.txt
      ${{ runner.temp }}/first-newline-observations.json
      ${{ runner.temp }}/first-newline-tokenizer-*

      """
      `if-no-files-found` = "error"
      `retention-days` = 7
    }
  }
}
