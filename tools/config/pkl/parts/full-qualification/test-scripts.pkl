import "../../../../ci/lib/Actions.pkl" as ci

name = "Tooling (${{ matrix.name }})"
`runs-on` = ci.linux
`if` = "${{ !cancelled() && (github.event_name == 'schedule' || github.event_name == 'workflow_dispatch') }}"  // Preserve independent checks after producer failure; stop superseded runs.
`timeout-minutes` = 30
needs = List("full-source-cli", "tooling-plan")
strategy {
  `fail-fast` = false
  matrix = "${{ fromJSON(needs.tooling-plan.outputs.matrix) }}"
}
env {
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
  VIZE_SOURCE_CLI_RECEIPT_SHA256 = "${{ needs.full-source-cli.outputs.receipt-sha256 }}"
}
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with { `fetch-depth` = 0 }
  }
  new Dynamic {
    uses = "./.github/actions/test-full-tooling"
    with {
      producer = "${{ toJSON(needs.full-source-cli.outputs) }}"
      shard = "${{ matrix.index }}"
      total = "${{ matrix.total }}"
    }
  }
}
