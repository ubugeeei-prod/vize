import "../../Actions.pkl" as ci

`runs-on` = ci.linux
`if` = "${{ github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' }}"
`timeout-minutes` = 45
// Keep the strict nightly instrumentation gate on scheduled and explicit runs.
env {
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
  VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/full-qualification"
}
steps = new Listing {
  ci.use(ci.checkout)
  ci.workspaceVp()
  new Dynamic {
    uses = ci.setupRust
    with {
      toolchain = "nightly"
      components = "llvm-tools-preview"
    }
  }
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    with { `wild-version` = "0.9.0" }
  }
  ci.use("./.github/actions/setup-rust-script")
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "coverage-branch"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.command("Install JS dependencies", "vp install --frozen-lockfile --prefer-offline")
  ci.command("Install Pkl CLI", "npm install --global @pkl-community/pkl@0.27.2")
  new Dynamic {
    name = "Install cargo-llvm-cov"
    uses = "taiki-e/install-action@184183c2401be73c3bf42c2e61268aa5855379c1"  // v2
    with { tool = "cargo-llvm-cov" }
  }
  ci.command("Branch coverage report", "vp run --workspace-root coverage:source:branch")
  ci.command("Verify branch coverage summary", #". "${{ env.VIZE_CI_FILES }}/verify-branch-coverage-summary.sh""#)
  new Dynamic {
    name = "Upload branch coverage summary"
    `continue-on-error` = true
    uses = ci.uploadArtifact
    with {
      name = "rust-branch-coverage-summary"
      path = "target/llvm-cov/source-branch-summary.json"
      `if-no-files-found` = "error"
      `retention-days` = 14
    }
  }
}
