import "../../../../ci/lib/Actions.pkl" as ci

name = "Full JS package tests (${{ matrix.group }})"
strategy {
  `fail-fast` = false
  matrix {
    group = List("builders", "ui", "oxlint")
  }
}
`runs-on` = ci.linux
`if` = "${{ github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' }}"
`timeout-minutes` = 45
env { NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169" }
steps = new Listing {
  ci.use(ci.checkout)
  ci.use("./.github/actions/setup-js-package-tests")
  new Dynamic {
    name = "Test JS packages"
    `if` = "${{ !cancelled() }}"
    uses = "./.github/actions/test-js-packages-with-history"
    with { partition = "${{ matrix.group }}" }
  }
}
