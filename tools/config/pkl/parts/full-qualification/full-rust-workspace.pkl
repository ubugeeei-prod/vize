import "../../Actions.pkl" as ci

name = "Full Rust workspace and doctests"
`runs-on` = ci.linux
`if` = "${{ !cancelled() && (github.event_name == 'schedule' || github.event_name == 'workflow_dispatch') }}"
`timeout-minutes` = 45
outputs { `producer-attempt` = "${{ steps.workspace.outputs.producer-attempt }}" }
env {
  VIZE_CI_FILES = "${{ github.workspace }}/.github/scripts/workflows/full-qualification"
  CARGO_BUILD_JOBS = "24"
  RUST_TEST_THREADS = "4"
  VIZE_NUXT_CONFIG_ITERATIONS = "100"
  VIZE_TEST_REQUIRE_TSGO = "1"
}
steps = new Listing {
  ci.use(ci.checkout)
  new Dynamic {
    uses = ci.setupRust
    with {
      toolchain = "1.100.0"
      components = "clippy"
    }
  }
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    with { `wild-version` = "0.9.0" }
  }
  ci.use("./.github/actions/cache-vp-bootstrap")
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      cache = true
      `run-install` = true
    }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "nextest-ci"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.use("./.github/actions/setup-rust-script")
  new Dynamic {
    name = "Install Pkl CLI and hydrate pinned native fixture"
    run = #". "${{ env.VIZE_CI_FILES }}/install-pkl-cli-and-hydrate-pinned-native-fixture.sh""#
  }
  new Dynamic {
    name = "Install full-workspace nextest"
    uses = "taiki-e/install-action@184183c2401be73c3bf42c2e61268aa5855379c1"  // v2
    with { tool = "cargo-nextest@0.9.146" }
  }
  ci.command("Provision the locked Full Rust native runtime", "node tools/support/compat/github/full-rust-runtime.ts")
  new Dynamic {
    name = "Run the original test profile for same-source comparison"
    `if` = "${{ !cancelled() && github.event_name == 'workflow_dispatch' && inputs.compare-rust-test-profile }}"
    run = "node tools/support/compat/github/run-rust-workspace-tests.ts --cargo-profile test --output target/nextest/full/workspace-reference-timing.json"
  }
  new Dynamic {
    name = "Run and inventory every workspace test and doctest"
    id = "workspace"
    `if` = "${{ !cancelled() }}"
    run = "node tools/support/compat/github/run-rust-workspace-tests.ts --cargo-profile ci --capture-typechecker-workspace"
  }
  new Dynamic {
    name = "Preserve full-workspace test results and walltime"
    `if` = "${{ always() }}"
    uses = "./.github/actions/upload-rust-full-workspace-results"
  }
  new Dynamic {
    uses = "./.github/actions/retain-sfc-runtime"
    `if` = "${{ always() }}"
  }
}
