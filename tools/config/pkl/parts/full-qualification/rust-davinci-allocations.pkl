import "../../Actions.pkl" as ci

`runs-on` = ci.linux
`if` = "${{ github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' }}"
`timeout-minutes` = 45
env { VIZE_NUXT_CONFIG_ITERATIONS = "100" }
steps = new Listing {
  ci.use(ci.checkout)
  new Dynamic {
    uses = ci.setupRust
    with {
      toolchain = "stable"
      components = "clippy"
    }
  }
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    with { `wild-version` = "0.9.0" }
  }
  new Dynamic {
    uses = ci.setupVp
    with {
      `node-version-file` = "package.json"
      cache = true
      `run-install` = true
    }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    with {
      key = "clippy-test"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  ci.use("./.github/actions/setup-rust-script")
  new Dynamic {
    name = "Davinci allocation gate"
    run = "cargo bench -p vize_l1_to_l2 --bench davinci_storage -- --quick && cargo bench -p vize_patina --bench davinci_markup -- --quick && rust-script tools/commands/davinci/bench-compare.rs --bench s1_to_s2_lower_vfor_three_aliases --bench s1_to_s2_emit_von_two_per_bucket --bench s1_to_s2_emit_p2_11_dom_surface --bench s1_to_s2_emit_helper_rich_large --bench s1_to_s2_pass_template_complexity --bench patina_jsx_markup_one_root --bench patina_s2_markup_one_root && cargo bench -p vize_musea --bench davinci_art -- --quick && rust-script tools/commands/davinci/bench-compare.rs --bench musea_parse_art_define_art --bench musea_parse_art_legacy_attrs --bench musea_parse_art_inline"
  }
  new Dynamic {
    name = "Upload Davinci allocation bench reports"
    `if` = "${{ always() }}"
    uses = "./.github/actions/upload-davinci-compact-storage-bench-reports"
  }
}
