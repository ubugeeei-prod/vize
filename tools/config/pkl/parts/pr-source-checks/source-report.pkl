import "../../Actions.pkl" as ci

name = "PR source report"
permissions {
  contents = "read"
  actions = "read"
  `pull-requests` = "read"
}
// A superseded run reports nothing: its required check fails in test-report.
`if` = "${{ always() && !contains(needs.*.result, 'cancelled') }}"
// prettier-ignore
needs = new Listing {
  "pr-source-plan"
  "pr-rust-source"
  "pr-rust-products"
  "pr-js-packages"
  "pr-native-runtime"
  "pr-playground-test"
  "nuxt-module-qualification"
  "canonical-corpus"
  "ci-selection-tests"
  "wasm-release-check"
  "affected-tooling-report"
}
`runs-on` = "ubuntu-24.04"
`timeout-minutes` = 5
steps = new Listing {
  new Dynamic {
    uses = ci.checkout
    with {
      `fetch-depth` = 1
      // The source gate needs only its script closure, never product sources.
      `sparse-checkout-cone-mode` = false
      `sparse-checkout` = """
      /package.json
      /tools/support/compat/github/canonical-corpus-selection.mjs
      /tools/support/compat/github/plan-source-checks.ts
      /tools/support/compat/github/require-needs-success.ts

      """
    }
  }
  new Dynamic {
    uses = ci.setupNode
    with {
      `node-version-file` = "package.json"
      `package-manager-cache` = false
    }
  }
  new Dynamic {
    name = "Require every source gate to succeed"
    env {
      NEEDS_JSON = "${{ toJSON(needs) }}"
      GH_TOKEN = "${{ github.token }}"
    }
    run = "node tools/support/compat/github/canonical-corpus-selection.mjs --check"
  }
}
