import "../../Actions.pkl" as ci

name = "CI selection tests"
needs = "pr-source-plan"
`runs-on` = "${{ needs.pr-source-plan.outputs.tooling == 'true' && 'blacksmith-32vcpu-ubuntu-2404' || 'ubuntu-24.04' }}"
`timeout-minutes` = 5
steps = new Listing {
  new Dynamic {
    name = "Explain unrelated skip"
    `if` = "${{ needs.pr-source-plan.outputs.tooling != 'true' }}"
    run = #"echo 'No CI selection inputs changed.' >> "$GITHUB_STEP_SUMMARY""#
  }
  new Dynamic {
    uses = ci.checkout
    `if` = "${{ needs.pr-source-plan.outputs.tooling == 'true' }}"
  }
  new Dynamic {
    uses = ci.setupNode
    `if` = "${{ needs.pr-source-plan.outputs.tooling == 'true' }}"
    with {
      `node-version-file` = "package.json"
      `package-manager-cache` = false
    }
  }
  new Dynamic {
    name = "Test CI selection when its inputs change"
    id = "cases"
    `if` = "${{ needs.pr-source-plan.outputs.tooling == 'true' }}"
    env { TEST_CASES_JOB = "CI selection tests" }
    run = #"node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tools/support/compat/github/test-case-reporter.ts --test-reporter-destination="$RUNNER_TEMP/test-cases-ci-selection.json" tests/tooling/ci-iteration-plans.test.ts tests/tooling/pr-required-rust.test.ts tests/tooling/rust-test-cohorts.test.ts tests/tooling/rust-build-evidence.test.mjs tests/tooling/pinned-fixture-hydration.test.ts tests/tooling/native-preparation-identity.test.ts tests/tooling/native-formatter-build-custody.test.mjs tests/tooling/native-ci-formatter-custody.test.mjs tests/tooling/native-history-profile.test.ts tests/tooling/native-history-toolchain.test.ts tests/tooling/publish-npm-package*.test.ts tests/tooling/davinci-canonical-corpus-kernel-prefix.test.ts"#
  }
  new Dynamic {
    name = "Upload CI selection test cases"
    `if` = "${{ !cancelled() && steps.cases.outcome != 'skipped' }}"
    uses = ci.uploadArtifact
    with {
      name = "test-cases-ci-selection-${{ github.run_attempt }}"
      path = "${{ runner.temp }}/test-cases-ci-selection.json"
      `if-no-files-found` = "error"
      `retention-days` = 7
    }
  }
}
