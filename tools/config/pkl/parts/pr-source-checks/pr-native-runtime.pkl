import "../../Actions.pkl" as ci

name = "Native runtime (${{ matrix.lane }})"
needs = "pr-source-plan"
strategy {
  `fail-fast` = false
  matrix = "${{ fromJSON(needs.pr-source-plan.outputs.native-runtime-matrix) }}"
}
`runs-on` = "${{ matrix.lane != 'none' && 'blacksmith-32vcpu-ubuntu-2404' || 'ubuntu-24.04' }}"
`timeout-minutes` = 15
env {

  CARGO_BUILD_JOBS = "12"
  VIZE_NATIVE_RUST_TOOLCHAIN = "1.100.0"
  VIZE_NATIVE_RUST_COMPONENTS = "clippy,rust-src,rustfmt"
  VIZE_NATIVE_RUST_TARGETS = "wasm32-unknown-unknown,wasm32-wasip2"
  NODE_OPTIONS = "--disable-warning=DEP0040 --disable-warning=DEP0169"
  TEST_CASES_JOB = "Native runtime (${{ matrix.lane }})"
  VIZE_TEST_CASES = "test-cases-native-${{ matrix.lane }}.json"
}
steps = new Listing {
  ...ci.stageWorkflowScripts("pr-source-checks")
  new Dynamic {
    name = "Explain unrelated skip"
    `if` = "${{ matrix.lane == 'none' }}"
    run = #". "${{ env.VIZE_CI_FILES }}/explain-unrelated-skip-2.sh""#
  }
  new Dynamic {
    uses = ci.checkout
    `if` = "${{ matrix.lane != 'none' }}"
    with { `fetch-depth` = "${{ matrix.lane == 'attributes' && '0' || '1' }}" }
  }
  new Dynamic {
    uses = "./.github/actions/cache-vp-bootstrap"
    `if` = "${{ matrix.lane != 'none' }}"
  }
  new Dynamic {
    uses = ci.setupVp121
    `if` = "${{ matrix.lane != 'none' }}"
    with {
      version = "latest"
      `node-version-file` = "package.json"
      cache = true
      `cache-save` = false
      `run-install` = false
    }
  }
  new Dynamic {
    uses = ci.setupRust
    `if` = "${{ matrix.lane != 'none' }}"
    with {
      toolchain = "${{ env.VIZE_NATIVE_RUST_TOOLCHAIN }}"
      components = "${{ env.VIZE_NATIVE_RUST_COMPONENTS }}"
      targets = "${{ env.VIZE_NATIVE_RUST_TARGETS }}"
    }
  }
  new Dynamic {
    name = "Verify configured native runtime toolchain"
    `if` = "${{ matrix.lane != 'none' }}"
    shell = "bash"
    run = #". "${{ env.VIZE_CI_FILES }}/verify-configured-native-runtime-toolchain.sh""#
  }
  new Dynamic {
    uses = "./.github/actions/setup-wild-http-recovery"
    `if` = "${{ matrix.lane != 'none' }}"
    with { `wild-version` = "0.9.0" }
  }
  new Dynamic {
    uses = "./.github/actions/setup-rust-sticky-cache"
    `if` = "${{ matrix.lane != 'none' }}"
    with {
      key = "nextest-ci"
      `cache-key-suffix` = "${{ runner.os }}-${{ runner.arch }}"
    }
  }
  new Dynamic {
    name = "Install native runtime oracle dependencies"
    `if` = "${{ matrix.lane != 'none' }}"
    run = "node tools/support/github/vp-install.ts --filter vize-workspace --filter './npm/native...' --filter './npm/ui...' --filter './tests...'"
  }
  new Dynamic {
    name = "Prepare native runtime test case capture"
    `if` = "${{ matrix.lane != 'none' }}"
    run = #"node tools/support/compat/github/job-test-cases.ts setup "$RUNNER_TEMP/native-test-cases-${{ matrix.lane }}""#
  }
  new Dynamic {
    name = "Test native typechecker ownership and projection laws"
    `if` = "${{ matrix.lane == 'canon' }}"
    uses = "./.github/actions/test-native-canon"
  }
  new Dynamic {
    name = "Test actual source LSP feature and project responses"
    `if` = "${{ matrix.lane == 'lsp' }}"
    uses = "./.github/actions/test-native-lsp"
  }
  new Dynamic {
    name = "Replay complete formatter CLI stock semantics with the source CLI"
    `if` = "${{ success() && matrix.lane == 'lsp' }}"
    run = #". "${{ env.VIZE_CI_FILES }}/replay-complete-formatter-cli-stock-semantics-with-the-source-cli.sh""#
  }
  new Dynamic {
    name = "Preserve complete source formatter semantic observations"
    `if` = "${{ always() && matrix.lane == 'lsp' }}"
    uses = ci.uploadArtifact
    with {
      name = "source-formatter-semantics-${{ github.run_id }}-${{ github.run_attempt }}-${{ github.sha }}"
      path = """
      target/differential/formatter-expression-width-semantics.json
      target/differential/formatter-continuation-prefix-width.json
      target/differential/formatter-source.log
      target/ci/vize.differential-build.json

      """
      `if-no-files-found` = "error"
      `retention-days` = 7
    }
  }
  new Dynamic {
    name = "Test fresh native SSR modules"
    `if` = "${{ matrix.lane == 'ssr' }}"
    uses = "./.github/actions/test-native-ssr"
  }
  new Dynamic {
    name = "Verify native scoped CSS in real Vue"
    `if` = "${{ matrix.lane == 'scoped-css' }}"
    uses = "./.github/actions/test-native-scoped-css"
  }
  new Dynamic {
    name = "Test native setup modules and runtime"
    `if` = "${{ matrix.lane == 'setup' }}"
    uses = "./.github/actions/test-native-js-setup"
  }
  new Dynamic {
    name = "Test native Vapor modules and runtime"
    `if` = "${{ matrix.lane == 'vapor' }}"
    uses = "./.github/actions/test-native-vapor"
  }
  new Dynamic {
    name = "Test native attribute values across targets"
    `if` = "${{ matrix.lane == 'attributes' }}"
    uses = "./.github/actions/test-native-attribute-values-7502"
  }
  new Dynamic {
    name = "Execute original selected-template DOM modules"
    `if` = "${{ matrix.lane == 'selected-template' }}"
    uses = "./.github/actions/test-native-selected-template"
  }
  new Dynamic {
    name = "Collect and upload native runtime test cases"
    `if` = "${{ !cancelled() && matrix.lane != 'none' }}"
    uses = "./.github/actions/collect-job-test-cases"
    with { artifact = "test-cases-native-${{ matrix.lane }}-${{ github.run_attempt }}" }
  }
}
