[
  {
    "file": "src/Comp0.vue",
    "messages": [
      {
        "ruleId": "script/define-props-destructuring",
        "ruleDocsPath": "docs/content/rules/type-and-script.md",
        "severity": 1,
        "message": "[vize:script/define-props-destructuring] Prefer destructuring the return value of defineProps().",
        "line": 3,
        "column": 7,
        "endLine": 3,
        "endColumn": 12,
        "help": "Use const { prop = defaultValue } = defineProps<Props>(); Vue 3.5+ preserves reactivity."
      },
      {
        "ruleId": "type/no-floating-promises",
        "ruleDocsPath": "docs/content/rules/type-and-script.md",
        "severity": 1,
        "message": "[vize:type/no-floating-promises] Floating Promise must be awaited, returned, or explicitly ignored with `void`",
        "line": 6,
        "column": 1,
        "endLine": 6,
        "endColumn": 7,
        "help": "Add await, return the Promise, or prefix it with void when the fire-and-forget behavior is intentional."
      },
      {
        "ruleId": "vue/multi-word-component-names",
        "ruleDocsPath": "docs/content/rules/vue.md",
        "severity": 2,
        "message": "[vize:vue/multi-word-component-names] Component name \"Comp0\" should be multi-word to avoid conflicts with HTML elements",
        "line": 8,
        "column": 11,
        "endLine": 8,
        "endColumn": 11,
        "help": "Rename the component to use multiple words (e.g., \"TodoItem\" instead of \"Item\")"
      },
      {
        "ruleId": "a11y/click-events-have-key-events",
        "ruleDocsPath": "docs/content/rules/accessibility.md",
        "severity": 1,
        "message": "[vize:a11y/click-events-have-key-events] Non-interactive elements with @click must also have keyboard event handlers",
        "line": 10,
        "column": 5,
        "endLine": 10,
        "endColumn": 127,
        "help": "Why: Keyboard users cannot activate click-only handlers.\nBest solution: Use semantic elements:\n  <button @click=\"handleClick\">Click me</button>\nIf you must use a div:\n  <div\n  role=\"button\"\n  tabindex=\"0\"\n  @click=\"handleClick\"\n  @keydown.enter=\"handleClick\"\n  @keydown.space=\"handleClick\"\n  >\n  Click me\n  </div>"
      },
      {
        "ruleId": "a11y/no-static-element-interactions",
        "ruleDocsPath": "docs/content/rules/accessibility.md",
        "severity": 1,
        "message": "[vize:a11y/no-static-element-interactions] <li> is a static element and should not have interactive event handlers",
        "line": 10,
        "column": 5,
        "endLine": 10,
        "endColumn": 127,
        "help": "Why: Non-interactive elements (div, span, etc.) should not have click/keyboard handlers without a role.\nFix options:\n1. Use a native interactive element:\n  <button @click=\"handle\">Click me</button>\n2. Add role and tabindex:\n  <div role=\"button\" tabindex=\"0\" @click=\"handle\">\n  Click me\n  </div>"
      }
    ],
    "errorCount": 1,
    "warningCount": 4
  },
