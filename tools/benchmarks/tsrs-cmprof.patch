diff --git a/crates/tsrs_core/src/cmprof.rs b/crates/tsrs_core/src/cmprof.rs
new file mode 100644
index 0000000..002d924
--- /dev/null
+++ b/crates/tsrs_core/src/cmprof.rs
@@ -0,0 +1,75 @@
+// Local profiling patch (not for upstream): content-mapper event timeline, written to $TSRS_CM_PROFILE on dump().
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+struct Event {
+    kind: &'static str,
+    thread: u64,
+    start: u64,
+    end: u64,
+    bytes: u64,
+}
+
+fn epoch() -> Instant {
+    static EPOCH: OnceLock<Instant> = OnceLock::new();
+    *EPOCH.get_or_init(Instant::now)
+}
+
+fn events() -> &'static Mutex<Vec<Event>> {
+    static EVENTS: OnceLock<Mutex<Vec<Event>>> = OnceLock::new();
+    EVENTS.get_or_init(|| Mutex::new(Vec::with_capacity(1 << 16)))
+}
+
+pub fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        let _ = epoch();
+        std::env::var_os("TSRS_CM_PROFILE").is_some()
+    })
+}
+
+pub fn now() -> u64 {
+    if !enabled() {
+        return 0;
+    }
+    epoch().elapsed().as_nanos() as u64
+}
+
+fn thread_id() -> u64 {
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    thread_local!(static ID: u64 = NEXT.fetch_add(1, Ordering::Relaxed));
+    ID.with(|id| *id)
+}
+
+pub fn record(kind: &'static str, start: u64, bytes: u64) {
+    if !enabled() {
+        return;
+    }
+    let end = now();
+    let event = Event { kind, thread: thread_id(), start, end, bytes };
+    events().lock().unwrap_or_else(std::sync::PoisonError::into_inner).push(event);
+}
+
+pub fn record_duration(kind: &'static str, d: std::time::Duration) {
+    if !enabled() {
+        return;
+    }
+    let end = now();
+    record_at(kind, end.saturating_sub(d.as_nanos() as u64), end, 0);
+}
+
+fn record_at(kind: &'static str, start: u64, end: u64, bytes: u64) {
+    let event = Event { kind, thread: thread_id(), start, end, bytes };
+    events().lock().unwrap_or_else(std::sync::PoisonError::into_inner).push(event);
+}
+
+pub fn dump() {
+    let Some(path) = std::env::var_os("TSRS_CM_PROFILE") else { return };
+    let events = events().lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut out = String::from("kind,thread,start_ns,end_ns,bytes\n");
+    for e in events.iter() {
+        out.push_str(&format!("{},{},{},{},{}\n", e.kind, e.thread, e.start, e.end, e.bytes));
+    }
+    let _ = std::fs::write(path, out);
+}
