{
  "name": "vite-musea-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --config vite.app.config.ts",
    "build": "node ./scripts/package-tasks.cjs build",
    "preview": "vp preview --config vite.app.config.ts",
    "gallery:ui": "node ./scripts/package-tasks.cjs gallery:ui",
    "gallery:ui:build": "node ./scripts/package-tasks.cjs gallery:ui:build",
    "check": "node ./scripts/package-tasks.cjs check",
    "check:fix": "vp check --fix src vite.config.ts vite.app.config.ts playwright.config.ts",
    "fmt": "vp fmt --write src vite.config.ts vite.app.config.ts playwright.config.ts",
    "vrt": "musea-vrt",
    "vrt:update": "musea-vrt -u",
    "test:vrt": "playwright test",
    "test:vrt:update": "playwright test --update-snapshots",
    "gallery:globals": "vp dev --config vite.globals.config.ts"
  },
  "dependencies": {
    "vue": "catalog:vue-production"
  },
  "devDependencies": {
    "@playwright/test": "catalog:testing",
    "@vizejs/vite-plugin": "workspace:*",
    "@vizejs/vite-plugin-musea": "workspace:*",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite-stack",
    "vite-plus": "catalog:vite-stack",
    "vize": "workspace:*"
  }
}
