{
  "name": "vize-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:i18n": "node ./scripts/i18n/generate.ts --accept-machine-translation",
    "generate:rules": "node ./scripts/generate-patina-rules-page.mjs",
    "generate:reference": "node ../npm/ui/scripts/generate-reference-docs.ts",
    "generate:ui-previews": "node ./scripts/build-ui-previews.ts",
    "check:ui-docs": "node ./previews/ui/check-site.ts",
    "dev": "node ./scripts/ensure-browser.ts && pnpm generate:ui-previews && pnpm generate:reference && vp build && vp preview",
    "build": "node ./scripts/ensure-browser.ts && pnpm generate:ui-previews && pnpm generate:reference && vp build && pnpm check:ui-docs",
    "preview": "vp preview"
  },
  "devDependencies": {
    "@ox-content/vite-plugin": "catalog:integrations",
    "@vizejs/vite-plugin": "workspace:*",
    "playwright": "catalog:testing",
    "three": "catalog:content",
    "vite": "catalog:vite-stack",
    "vite-plus": "catalog:vite-stack",
    "vue": "catalog:vue-stable"
  }
}
