{
  "schema": "vize.htmlish-divergences",
  "dialects": {
    "document": {
      "files": ".html, in-DOM templates, petite-vue",
      "profile": "Document",
      "oracle": "WHATWG HTML parsing as Chromium DOMParser runs it (browser suite); parse5 over html5lib-tests as the browser-free engine",
      "norm": "WHATWG HTML"
    },
    "vue": {
      "files": ".vue <template>",
      "profile": "framework::vue::VueTemplate",
      "oracle": "@vue/compiler-dom 3.5 parse",
      "norm": "@vue/compiler-dom / @vue/compiler-sfc 3.5"
    }
  },
  "divergences": [
    {
      "id": "error-recovery",
      "decidedBy": "docs/davinci/decisions/2026-11-17-input-neutral-levels.md#htmlish-oracles-and-divergences",
      "summary": "Parsing never stops at a structural error: malformed input becomes typed holes so the editor and linter keep working (the L1 hole policy). Oracles that stop at the first structural error are compared only on inputs they accept.",
      "fixture": "levels/vize_l1/tests/surface_fidelity.rs",
      "fuzzExempt": "inputs an oracle rejects are compared only for vize's own fidelity (render(tree) == source), not against the oracle tree"
    },
    {
      "id": "document-structure-refusal",
      "decidedBy": "docs/davinci/decisions/2026-11-17-input-neutral-levels.md#htmlish-oracles-and-divergences",
      "summary": "The Document structure builder refuses, with a typed `DocumentHtmlRefusal`, a source whose browser tree it does not build exactly: recovered syntax, ends the browser implies or ignores (`</br>`), `plaintext`, `xmp`/`iframe`, `template` contents and script-data escapes. It never returns an approximate tree; the surface stays lossless.",
      "fixture": "levels/vize_l1/tests/htmlish_ledger.rs",
      "fuzzExempt": "document-dialect inputs vize refuses are compared only for fidelity (render(tree) == source), and each refusal is counted"
    },
    {
      "id": "vue-implied-end-tags",
      "decidedBy": "docs/davinci/decisions/2026-11-17-input-neutral-levels.md#htmlish-oracles-and-divergences",
      "summary": "In a Vue template vize closes `p`, `li`, `dt`/`dd`, `option`/`optgroup` and table parts at the start tags HTML's in-body rules name, without an error, as the shipped template parser does. The Vue oracle keeps authored nesting and reports the missing end tags. `IMPLIED_END_TAGS` governs the Document structure builder; the component surface applies these start-tag rules in every profile.",
      "fixture": "levels/vize_l1/tests/fixtures/htmlish/implied-end-tags.vue.json",
      "fuzzExempt": "vue-dialect inputs where an element HTML ends implicitly (`p`, `li`, `dt`, `dd`, `option`, `optgroup`, table parts) lacks its end tag"
    },
    {
      "id": "vue-void-end-tag-reported",
      "decidedBy": "docs/davinci/decisions/2026-11-17-input-neutral-levels.md#htmlish-oracles-and-divergences",
      "summary": "In the standard template syntax vize reports an end tag of a void element (`</br>`) as an invalid end tag; the Vue oracle drops it silently, and so does vize's quirks syntax. The tree is the same.",
      "fixture": "levels/vize_l1/tests/fixtures/htmlish/br-end-tag.vue.json",
      "fuzzExempt": "vue-dialect inputs with an end tag of a void element are compared on the tree, not on diagnostics"
    },
    {
      "id": "vue-declaration-reported",
      "decidedBy": "docs/davinci/decisions/2026-11-17-input-neutral-levels.md#htmlish-oracles-and-divergences",
      "summary": "vize reports a markup declaration in a Vue template (`<!DOCTYPE html>`) as an incorrectly opened comment, as WHATWG makes a DOCTYPE after the document start a parse error. The Vue oracle drops it silently. The tree is the same.",
      "fixture": "levels/vize_l1/tests/fixtures/htmlish/declarations.vue.json",
      "fuzzExempt": "vue-dialect inputs with a markup declaration are compared on the tree, not on diagnostics"
    },
    {
      "id": "comment-bang-close",
      "decidedBy": "docs/davinci/decisions/2026-11-17-input-neutral-levels.md#htmlish-oracles-and-divergences",
      "summary": "vize closes a comment at `--!>` in both dialects, with an incorrectly-closed-comment error, as WHATWG does. The Vue oracle closes only at `-->`, so its comment swallows the markup after `--!>`.",
      "fixture": "levels/vize_l1/tests/fixtures/htmlish/comment-edges.vue.json",
      "fuzzExempt": "vue-dialect inputs with `--!>` inside a comment"
    }
  ],
