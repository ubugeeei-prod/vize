{
  "schema": "vize.htmlish-divergences",
  "dialects": {
    "document": {
      "files": ".html, in-DOM templates, petite-vue",
      "profile": "Document",
      "oracle": "WHATWG HTML parsing as Chromium DOMParser runs it (browser suite); parse5 over html5lib-tests as the browser-free engine",
      "norm": "WHATWG HTML"
    },
    "vue": {
      "files": ".vue <template>",
      "profile": "framework::vue::VueTemplate",
      "oracle": "@vue/compiler-dom 3.5 parse",
      "norm": "@vue/compiler-dom / @vue/compiler-sfc 3.5"
    }
  },
  "divergences": [
    {
      "id": "error-recovery",
      "decidedBy": "docs/davinci/decisions/2026-11-17-input-neutral-levels.md#htmlish-oracles-and-divergences",
      "summary": "Parsing never stops at a structural error: malformed input becomes typed holes so the editor and linter keep working (the L1 hole policy). Oracles that stop at the first structural error are compared only on inputs they accept.",
      "fixture": "davinci/vize_l1/tests/surface_fidelity.rs",
      "fuzzExempt": "inputs an oracle rejects are compared only for vize's own fidelity (render(tree) == source), not against the oracle tree"
    }
  ],
