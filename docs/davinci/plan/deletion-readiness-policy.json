{
  "schema": "vize.deletion-readiness.policy",
  "version": 1,
  "minimumStableDays": 30,
  "maximumGapDays": 7,
  "dialects": [
    "vue0-template",
    "vue1-template",
    "vue2-sfc",
    "vue2.7-sfc",
    "vue3-sfc",
    "petite-vue",
    "pug-template",
    "jsx-babel",
    "jsx-vapor",
    "js",
    "ts",
    "jsx",
    "tsx",
    "vue-quirks"
  ],
  "targets": {
    "compiler": ["dom", "ssr", "vapor"],
    "linter": ["lint"],
    "formatter": ["fmt"],
    "typechecker": ["batch"],
    "lsp": ["stdio"]
  }
}
