  "sources": {
    "Panel.sync.vue.txt": "<script lang=\"ts\">\nimport { Vue } from 'vue-class-component'\nimport { Component, ModelSync, Prop, PropSync, VModel } from 'vue-property-decorator'\n\n@Component\nexport default class Panel extends Vue {\n  @Prop() readonly title!: string\n  @PropSync('open') synced!: boolean\n  @ModelSync('checked', 'change') checkedValue!: boolean\n  @VModel() text!: string\n  count = 0\n  get doubled() {\n    return this.count * 2\n  }\n  get ratio() {\n    return this.count\n  }\n  set ratio(value: number) {\n    this.count = value\n  }\n}\n</script>\n<template><button @click=\"synced = !synced; checkedValue = true; text = 'a'; ratio = 2; count++\">{{ title }}{{ doubled }}</button></template>\n",
    "Panel.sync-invalid.vue.txt": "<script lang=\"ts\">\nimport { Vue } from 'vue-class-component'\nimport { Component, PropSync } from 'vue-property-decorator'\n\n@Component\nexport default class Panel extends Vue {\n  @PropSync('open') synced!: boolean\n  count = 0\n  get doubled() {\n    return this.count * 2\n  }\n}\n</script>\n<template><button @click=\"synced = 'yes'; doubled = 3\">{{ count }}</button></template>\n",
    "vue-property-decorator.sync.index.d.ts.txt": "export declare function Component<T extends abstract new (...args: any[]) => unknown>(\n  target: T,\n  context?: ClassDecoratorContext<T>,\n): T\nexport declare function Prop(\n  options?: unknown,\n): (target: undefined, context: ClassFieldDecoratorContext) => void\nexport declare function PropSync(\n  propName: string,\n  options?: unknown,\n): (target: undefined, context: ClassFieldDecoratorContext) => void\nexport declare function ModelSync(\n  propName: string,\n  event: string,\n  options?: unknown,\n): (target: undefined, context: ClassFieldDecoratorContext) => void\nexport declare function VModel(\n  options?: unknown,\n): (target: undefined, context: ClassFieldDecoratorContext) => void\n"
  },
