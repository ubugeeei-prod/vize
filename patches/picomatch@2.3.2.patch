+/**
+ * Classify the body of a single-branch repeated extglob by its `*` wildcards.
+ * A `*` that opens a nested `*(...)` is not a wildcard and is left to the
+ * other checks.
+ *
+ *  - `none`: no wildcard star.
+ *  - `collapsible`: at least one wildcard star, and nothing else but literal
+ *    characters and `?`, none of which can match a slash. For such a body X,
+ *    two matches side by side are again one match: the star of the first
+ *    takes everything up to the last literal of the second. So `+(X)` matches
+ *    the same strings as `@(X)`, and `*(X)` the same as `?(X)`.
+ *  - `unsafe`: a wildcard star next to anything else. The repetition cannot
+ *    be dropped, and keeping it nests one unbounded quantifier in another.
+ */
+
+const classifyWildcardStarBranch = body => {
+  let star = false;
+  let simple = true;
+
+  for (let i = 0; i < body.length; i++) {
+    const ch = body[i];
+
+    if (ch === '\\') {
+      const next = body[++i];
+      if (next === undefined || next === '/') {
+        simple = false;
+      }
+      continue;
+    }
+
+    if (ch === '*' && body[i + 1] !== '(') {
+      star = true;
+      continue;
+    }
+
+    if (/[/()[\]{}|!+@"^$]/.test(ch)) {
+      simple = false;
+    }
+  }
+
+  if (star === false) {
+    return 'none';
+  }
+
+  return simple === true ? 'collapsible' : 'unsafe';
+};
