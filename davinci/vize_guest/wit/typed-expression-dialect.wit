package vize:contracts@0.1.3;

/// Producer-supplied types for foreign expression checking. The original
/// expression-dialect world remains available with its unchanged records.
interface typed-expression-analysis {
  use types.{span, page, diagnostic};

  record typed-binding {
    name: string,
    kind: string,
    /// A signature in the selected dialect, supplied by its typed producer.
    /// An absent/unknown type must never be replaced by a guessed signature.
    signature: string,
  }

  enum demand {
    value,
    show,
    condition,
    name,
    handler,
    statement,
  }

  record typed-expression {
    id: u32,
    source: string,
    span: span,
    /// Scope-local typed bindings; these shadow the block environment.
    locals: list<typed-binding>,
    expected: demand,
  }

  record typed-expression-batch {
    environment: list<typed-binding>,
    expressions: list<typed-expression>,
  }

  record typed-analysis {
    facts: page,
    projection: page,
    diagnostics: list<diagnostic>,
  }

  analyze-typed: func(batch: typed-expression-batch) -> typed-analysis;
}

world typed-expression-dialect {
  export handshake;
  export typed-expression-analysis;
}
