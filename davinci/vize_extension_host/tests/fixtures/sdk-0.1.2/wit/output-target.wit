package vize:contracts@0.1.2;

/// The output-target boundary: canonical S2 and S3 pages in, one
/// span-carrying S4 emission document out (P3-9).
///
/// The call is coarse-grained: one template crosses at once. The answer's
/// `document` is an `emit-document-page@1` folio — generated text plus the
/// generated↔authored links of an `EmitDocument`. Real S2 and S3 parsing is
/// the first consumer's job (P6-6); this world carries the pages.
interface emission {
  use types.{diagnostic, page};

  /// One template's canonical pages.
  record emit-request {
    /// `s2-page@1`.
    s2: page,
    /// `s3-page@1`.
    s3: page,
  }

  /// The target's emitted document.
  record emitted {
    /// `emit-document-page@1`: generated text and span links.
    document: page,
    /// Findings about the emission, in authored spans.
    diagnostics: list<diagnostic>,
  }

  /// Emit one template.
  emit: func(request: emit-request) -> emitted;
}

/// What an output-target guest component implements.
world output-target {
  export handshake;
  export emission;
}
